+bool retain_host_transfer_backing_owner(
+    const std::shared_ptr<array::Data>& data, std::shared_ptr<void> owner) {
+  if (!data) {
+    return false;
+  }
+  const auto* retained = data->d.target<HostTransferArrayDeleter>();
+  if (!retained || !retained->owner ||
+      data->buffer.ptr() != retained->owner->buffer().ptr() ||
+      retained->owner->allocation_generation() == 0) {
+    return false;
+  }
