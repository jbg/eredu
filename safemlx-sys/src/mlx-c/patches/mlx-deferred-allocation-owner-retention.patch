+void array::publish_deferred_allocation_owners(
+    const std::shared_ptr<Data>& data,
+    const std::shared_ptr<DeferredAllocationOwners>& owners) const {
+  if (!owners || !data) {
+    return;
+  }
+  if (!data->buffer.ptr() && size() == 0) {
+    return;
+  }
+  // Host storage can outlive every native Data wrapper. Certification here
+  // examines the named deleter directly; set_data runs before output status
+  // changes, and this path must never poll an event or evaluate another graph.
+  if (retain_host_transfer_backing_owner(data, owners)) {
+    return;
+  }
+  using NativeDeleter = void (*)(allocator::Buffer);
+  const auto* deleter = data->d.target<NativeDeleter>();
+  if (!deleter || *deleter != &allocator::free ||
+      !data->buffer.ptr() || data->allocation_generation == 0) {
+    throw std::runtime_error(
+        "Deferred allocation ownership requires certified owned backing.");
+  }
+  for (const auto& retained : data->allocation_owners) {
+    if (retained == owners) {
+      return;
+    }
+  }
+  data->allocation_owners.push_back(owners);
+}
+
+void array::retain_deferred_allocation_owner(std::shared_ptr<void> owner) const {
+  if (!owner) {
+    throw std::invalid_argument("Missing deferred allocation owner.");
+  }
+  auto owners = array_desc_->deferred_allocation_owners;
+  if (!owners) {
+    owners = std::make_shared<DeferredAllocationOwners>();
+  }
+  // Reserve before touching physical ownership. Once publication succeeds,
+  // insertion and descriptor installation cannot throw or consume ownership
+  // on a failed call. The C payload remains disarmed until this returns.
+  if (owners->size() == owners->max_size()) {
+    throw std::length_error("Too many deferred allocation owners.");
+  }
+  owners->reserve(owners->size() + 1);
+  publish_deferred_allocation_owners(array_desc_->data, owners);
+  owners->push_back(std::move(owner));
+  array_desc_->deferred_allocation_owners = std::move(owners);
+}
