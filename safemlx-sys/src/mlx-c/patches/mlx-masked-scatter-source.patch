+// Copyright © 2025 Apple Inc.
+// Static instantiations of the unchanged upstream masked row assignment.
+#include "mlx/backend/metal/kernels/utils.h"
+#include "mlx/backend/metal/kernels/indexing/masked_scatter.h"
+#define MASKED_ASSIGN_TYPE(name, type) \
+  instantiate_kernel("masked_assign_" #name "_true", masked_assign_impl, type, true) \
+  instantiate_kernel("masked_assign_" #name "_false", masked_assign_impl, type, false)
+MASKED_ASSIGN_TYPE(bool_, bool)
+MASKED_ASSIGN_TYPE(uint8, uint8_t)
+MASKED_ASSIGN_TYPE(int32, int32_t)
+MASKED_ASSIGN_TYPE(uint32, uint32_t)
+MASKED_ASSIGN_TYPE(float16, half)
+MASKED_ASSIGN_TYPE(bfloat16, bfloat16_t)
+MASKED_ASSIGN_TYPE(float32, float)
