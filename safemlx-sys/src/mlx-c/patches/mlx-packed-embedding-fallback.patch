+// A retained callback whose concrete object consumes the current Graph bank.
+// std::function stores only this shared pointer in its pinned small buffer.
+// The shared allocator and physical block keep the arena through the final
+// callable destructor; the callable never owns a Scope or its parent primitive.
+template<class F> struct GraphFunctionCapture {
+  std::shared_ptr<F> value;
+  template<class... Args> decltype(auto) operator()(Args&&... args) const {
+    return (*value)(std::forward<Args>(args)...);
+  }
+};
+template<class Signature, class F>
+size_t graph_function_control_bytes() noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L && !defined(_LIBCPP_ABI_OPTIMIZED_FUNCTION)
+  using Capture = GraphFunctionCapture<F>;
+  using Function = std::__function::__func<Capture, Signature>;
+  using Owner = std::__shared_ptr_emplace<F, GraphAllocator<F>>;
+  if constexpr (sizeof(Function) <= 3 * sizeof(void*) &&
+                std::is_nothrow_copy_constructible_v<Capture> &&
+                alignof(Owner) <= alignof(std::max_align_t)) return sizeof(Owner);
+#endif
+  return 0;
+}
+template<class Signature, class F>
+std::function<Signature> make_graph_function(F&& callable) {
+  using Value = std::remove_cvref_t<F>;
+  if (!current_graph_quota())
+    return std::function<Signature>(std::forward<F>(callable));
+  if (!graph_function_control_bytes<Signature, Value>())
+    throw GraphQuotaError(GraphFailure::invalid_layout);
+  auto owner = std::allocate_shared<Value>(GraphAllocator<Value>{},
+                                           std::forward<F>(callable));
+  return std::function<Signature>(GraphFunctionCapture<Value>{std::move(owner)});
+}
+
 } // namespace mlx::core::submission
