diff --git a/mlx/dequantize_fallback.h b/mlx/dequantize_fallback.h
new file mode 100644
--- /dev/null
+++ b/mlx/dequantize_fallback.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <algorithm>
+#include "mlx/array.h"
+#include "mlx/graph_quota.h"
+namespace mlx::core {
+struct AffineDequantizeFallback {
+  Shape wshape, sshape;
+  int group_size, bits;
+  Stream s;
+  ArrayVector operator()(const ArrayVector& inputs);
+};
+struct FloatingDequantizeFallback {
+  Shape wshape, sshape;
+  int group_size, bits;
+  Dtype out_type;
+  Stream s;
+  ArrayVector operator()(const ArrayVector& inputs);
+};
+inline size_t dequantize_fallback_control_bytes() noexcept {
+  const auto affine = submission::graph_function_control_bytes<
+      ArrayVector(ArrayVector), AffineDequantizeFallback>();
+  const auto floating = submission::graph_function_control_bytes<
+      ArrayVector(ArrayVector), FloatingDequantizeFallback>();
+  return affine && floating ? std::max(affine, floating) : 0;
+}
+inline size_t dequantize_fallback_frame_bytes() noexcept {
+  // One constructor at a time: moved source, shared owner, small-buffer
+  // capture, returned function and Quantize's by-value constructor argument.
+  return std::max(sizeof(AffineDequantizeFallback), sizeof(FloatingDequantizeFallback)) +
+      3 * sizeof(std::shared_ptr<AffineDequantizeFallback>) +
+      2 * sizeof(std::function<ArrayVector(ArrayVector)>) +
+      2 * sizeof(submission::GraphAllocator<AffineDequantizeFallback>) +
+      sizeof(submission::GraphQuota*) + sizeof(size_t);
+}
+} // namespace mlx::core
