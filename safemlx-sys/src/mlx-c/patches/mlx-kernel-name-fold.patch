diff --git a/mlx/backend/common/kernel_name.h b/mlx/backend/common/kernel_name.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/common/kernel_name.h
@@ -0,0 +1,29 @@
+// Copyright © 2023-2024 Apple Inc.
+
+// Shared kernel-name append worker; entry values preserve alias snapshots.
+#pragma once
+#include <string>
+#include <type_traits>
+
+namespace mlx::core {
+template <typename T>
+constexpr bool is_numeric_except_char = std::is_arithmetic_v<T> &&
+    !std::is_same_v<T, char> && !std::is_same_v<T, signed char> &&
+    !std::is_same_v<T, unsigned char> && !std::is_same_v<T, wchar_t>;
+
+template <typename T>
+void append_kernel_name_part(std::string& acc, const T& part) {
+  if constexpr (is_numeric_except_char<T>) {
+    acc += std::to_string(part);
+  } else {
+    acc += part;
+  }
+}
+
+template <typename T, typename... Args>
+void concatenate(std::string& acc, T first, Args... args) {
+  append_kernel_name_part(acc, first);
+  (append_kernel_name_part(acc, args), ...);
+}
+
+} // namespace mlx::core
