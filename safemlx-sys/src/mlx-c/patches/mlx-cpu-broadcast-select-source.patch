+// An additive source for the existing F32 Select over stored or broadcast
+// operands. Rank five is the actual GQA mask expansion; the legacy row source
+// and scalar Full contracts remain unchanged.
+bool select_broadcast_eval_layout(size_t rank,size_t elements,bool tracer,CopyEvalStorage& out) noexcept {
+  size_t bytes=0;
+  if(!rank||rank>5||!elements||elements>size_t(INT_MAX)||!product(elements,sizeof(float),bytes))return false;
+  EvalDispatchStorage dispatch;SingleOutputEvalStorage common;
+  if(!select_broadcast_dispatch_storage(rank,dispatch)||
+      !single_output_eval_layout(rank,3,tracer,&dispatch,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  const size_t controls=sizeof(rank)+sizeof(elements)+sizeof(tracer)+sizeof(out)+sizeof(bytes)+
+      sizeof(dispatch)+sizeof(common)+sizeof(value)+sizeof(const array*)*5+sizeof(size_t)*18+
+      sizeof(int)*3+sizeof(bool)*5+sizeof(Dtype)*3+sizeof(submission::FixedEvalPrologueGuard*)+
+      sizeof(submission::Record*)+sizeof(submission::GraphQuota*)+
+      sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls))return false;
+  out=value;return true;
+}
+static bool broadcast_selection_source(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_selection_eval_primitive(output)||typeid(output.primitive())!=typeid(Select)||
+      !output.siblings().empty()||output.inputs().size()!=3||output.dtype()!=float32)return false;
+  size_t elements=0;if(!shape(output,elements,5)||output.ndim()==0)return false;
+  for(size_t i=0;i!=3;++i) {
+    const auto& input=output.inputs()[i];size_t actual=0,span=1;
+    if(input.shape()!=output.shape()||!shape(input,actual,5)||actual!=elements||
+        input.dtype()!=(i==0?bool_:float32)||!canonical(input.dtype())||
+        !input.data_size()||input.data_size()>elements)return false;
+    for(size_t axis=0;axis!=size_t(input.ndim());++axis) {
+      size_t offset=0;
+      if(input.strides()[axis]<0||!product(size_t(input.shape(axis)-1),size_t(input.strides()[axis]),offset)||
+          !add(span,offset))return false;
+    }
+    if(span>input.data_size())return false;
+  }
+  return select_broadcast_eval_layout(output.ndim(),elements,output.is_tracer(),out);
+}
+bool selection_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  return row_selection_eval_storage(output,out)||broadcast_selection_source(output,out);
+}
