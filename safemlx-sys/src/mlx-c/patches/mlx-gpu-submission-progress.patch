--- /dev/null
+++ b/mlx/backend/gpu/submission_progress.h
@@ -0,0 +1,57 @@
+// Exact-stream accounting shared by native GPU encoders.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include "mlx/backend/gpu/eval.h"
+
+namespace mlx::core::gpu {
+class SubmissionState {
+ public:
+  void check_admission() const {
+    if (blocked_.load(std::memory_order_acquire)) {
+      throw std::runtime_error("GPU stream is blocked after submission failure.");
+    }
+    if (accepted_.load(std::memory_order_relaxed) == UINT64_MAX) {
+      throw std::overflow_error("GPU submission sequence exhausted.");
+    }
+  }
+  void open() noexcept { pending_.fetch_add(1, std::memory_order_acq_rel); }
+  void accept() noexcept { accepted_.fetch_add(1, std::memory_order_release); }
+  void finish() noexcept {
+    if (pending_.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+      // A producer opens its receipt before publishing accepted work. Reading
+      // that work with acquire also observes its open; the following zero
+      // check therefore cannot certify a still-live newly accepted receipt.
+      auto frontier = accepted_.load(std::memory_order_acquire);
+      if (pending_.load(std::memory_order_acquire) != 0) { return; }
+      auto old = completed_.load(std::memory_order_relaxed);
+      while (old < frontier && !completed_.compare_exchange_weak(
+                 old, frontier, std::memory_order_release,
+                 std::memory_order_relaxed)) {}
+    }
+  }
+  void fail() noexcept {
+    failed_.store(true, std::memory_order_release);
+    block();
+  }
+  void block() noexcept { blocked_.store(true, std::memory_order_release); }
+  bool blocked() const noexcept {
+    return blocked_.load(std::memory_order_acquire);
+  }
+  SubmissionProgress query() const noexcept {
+    // Read completed first so a concurrent new acceptance cannot be hidden.
+    auto completed = completed_.load(std::memory_order_acquire);
+    auto accepted = accepted_.load(std::memory_order_acquire);
+    return {accepted, completed, failed_.load(std::memory_order_acquire)};
+  }
+  bool idle() const noexcept {
+    return pending_.load(std::memory_order_acquire) == 0;
+  }
+ private:
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  std::atomic<uint64_t> accepted_{0}, completed_{0}, pending_{0};
+  std::atomic<bool> blocked_{false}, failed_{false};
+};
+} // namespace mlx::core::gpu
