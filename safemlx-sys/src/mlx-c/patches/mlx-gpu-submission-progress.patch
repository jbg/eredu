new file mode 100644
index 0000000..7be0d29
--- /dev/null
+++ b/mlx/backend/cuda/submission_marker.h
@@ -0,0 +1,56 @@
+// A one-shot, pre-work CUDA marker. Query errors never imply terminality.
+#pragma once
+#include <atomic>
+#include <cuda_runtime.h>
+#include "mlx/backend/cuda/utils.h"
+
+namespace mlx::core::cu {
+class SubmissionMarker {
+ public:
+  SubmissionMarker() {
+    CHECK_CUDA_ERROR(cudaEventCreateWithFlags(&event_, cudaEventDisableTiming));
+  }
+  ~SubmissionMarker() noexcept {
+    if (event_) { (void)cudaEventDestroy(event_); }
+  }
+  SubmissionMarker(const SubmissionMarker&) = delete;
+  SubmissionMarker& operator=(const SubmissionMarker&) = delete;
+  void record(cudaStream_t stream) {
+    // A failing record may have partially submitted work. Never retry it.
+    state_.store(State::attempted, std::memory_order_release);
+    auto status = cudaEventRecord(event_, stream);
+    if (status != cudaSuccess) {
+      state_.store(State::failed, std::memory_order_release);
+      CHECK_CUDA_ERROR(status);
+    }
+    state_.store(State::recorded, std::memory_order_release);
+  }
+  void progress() noexcept {
+    if (state_.load(std::memory_order_acquire) != State::recorded) { return; }
+    auto status = cudaEventQuery(event_);
+    auto expected = State::recorded;
+    if (status == cudaSuccess) {
+      state_.compare_exchange_strong(expected, State::terminal,
+          std::memory_order_release, std::memory_order_relaxed);
+    } else if (status != cudaErrorNotReady) {
+      state_.compare_exchange_strong(expected, State::failed,
+          std::memory_order_release, std::memory_order_relaxed);
+    }
+  }
+  bool terminal() const noexcept {
+    return state_.load(std::memory_order_acquire) == State::terminal;
+  }
+  bool failed() const noexcept {
+    return state_.load(std::memory_order_acquire) == State::failed;
+  }
+  void fail() noexcept { state_.store(State::failed, std::memory_order_release); }
+  // Only legal before any native launch/record attempt.
+  void cancel_unsubmitted() noexcept {
+    state_.store(State::terminal, std::memory_order_release);
+  }
+ private:
+  enum class State { prepared, attempted, recorded, terminal, failed };
+  cudaEvent_t event_{nullptr};
+  std::atomic<State> state_{State::prepared};
+};
+} // namespace mlx::core::cu
