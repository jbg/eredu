new file mode 100644
index 0000000..1199584
--- /dev/null
+++ b/tests/gpu_submission_progress_tests.cpp
@@ -0,0 +1,77 @@
+// CPU-only tests for native GPU receipt accounting; no GPU is initialized.
+#include "doctest/doctest.h"
+#include "mlx/backend/gpu/submission_progress.h"
+
+using mlx::core::gpu::SubmissionState;
+
+TEST_CASE("test GPU recovery receipt includes uncommitted encoded work") {
+  SubmissionState state;
+  state.check_admission();
+  state.open();
+  state.accept();
+  state.accept();
+  CHECK(state.query().accepted == 2);
+  CHECK(state.query().completed == 0);
+  CHECK_FALSE(state.idle());
+  state.finish();
+  CHECK(state.query().completed == 2);
+  CHECK(state.idle());
+}
+
+TEST_CASE("test GPU recovery frontier waits for every receipt handler") {
+  SubmissionState state;
+  state.open();
+  state.accept();
+  state.open();
+  state.accept();
+  // The later receipt may finish first; a count of completed buffers would
+  // incorrectly claim that the earlier accepted frontier is now terminal.
+  state.finish();
+  CHECK(state.query().completed == 0);
+  CHECK_FALSE(state.idle());
+  state.finish();
+  CHECK(state.query().completed == 2);
+  CHECK(state.idle());
+}
+
+TEST_CASE("test GPU recovery blocked stream rejects prework") {
+  SubmissionState state;
+  state.open();
+  state.accept();
+  state.block();
+  CHECK_THROWS_AS(state.check_admission(), std::runtime_error);
+  CHECK(state.query().accepted == 1);
+  CHECK_FALSE(state.query().failed);
+  state.finish();
+  CHECK(state.query().completed == 1);
+  CHECK_THROWS_AS(state.check_admission(), std::runtime_error);
+}
+
+TEST_CASE("test GPU recovery failure stays poisoned after terminal work") {
+  SubmissionState state;
+  state.open();
+  state.accept();
+  state.fail();
+  CHECK(state.query().failed);
+  CHECK_THROWS_AS(state.check_admission(), std::runtime_error);
+  state.finish();
+  CHECK(state.idle());
+  CHECK(state.query().completed == state.query().accepted);
+  CHECK(state.query().failed);
+  CHECK_THROWS_AS(state.check_admission(), std::runtime_error);
+}
+
+TEST_CASE("test GPU recovery later epoch cannot reuse an earlier terminal proof") {
+  SubmissionState state;
+  state.open();
+  state.accept();
+  state.finish();
+  CHECK(state.query().completed == 1);
+  state.open();
+  state.accept();
+  CHECK(state.query().accepted == 2);
+  CHECK(state.query().completed == 1);
+  state.finish();
+  CHECK(state.query().completed == 2);
+}
