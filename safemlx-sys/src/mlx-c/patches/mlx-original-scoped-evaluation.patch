+
+namespace mlx::core::metal {
+struct EmbeddedMetallib;
+enum class DeviceInitializationCause : unsigned {
+  success = 0, unsupported = 1, invalid = 2, busy = 3,
+  allocation_failed = 4, no_device = 5, ordinary_predecessor = 6,
+  already_initialized = 7, identity_mismatch = 8, identity_exhausted = 9,
+  unqualified_source = 10, source_changed = 11, residency_failed = 12,
+  decompression_failed = 13, dispatch_failed = 14, library_failed = 15,
+  invalid_architecture = 16,
+};
+class DeviceInitializationError final : public std::exception {
+ public:
+  explicit DeviceInitializationError(DeviceInitializationCause cause) noexcept : cause_(cause) {}
+  DeviceInitializationCause cause() const noexcept { return cause_; }
+  const char* what() const noexcept override { return "prepared Metal Device initialization failed"; }
+ private:
+  DeviceInitializationCause cause_;
+};
+struct DeviceInitializationLayout {
+  size_t object_bytes{0}, decoded_bytes{0}, scratch_bytes{0};
+  size_t dispatch_copy_bytes{0}, override_bytes{0}, controls{0};
+};
+struct DeviceInitializationStaticLayout {
+  size_t bytes{0}; bool qualified{false}; bool required{false};
+};
+struct DeviceInitializationOwner { void* value{nullptr}; void (*retire)(void*){nullptr}; };
+// These functions do not register sources, install handlers or create a Device.
+MLX_API DeviceInitializationStaticLayout device_initialization_static_layout() noexcept;
+MLX_API DeviceInitializationCause device_initialization_layout(
+    const EmbeddedMetallib&, DeviceInitializationLayout&) noexcept;
+MLX_API DeviceInitializationCause initialize_device(const EmbeddedMetallib&,
+    const DeviceInitializationLayout&, DeviceInitializationOwner, uint64_t&) noexcept;
+MLX_API DeviceInitializationCause borrow_initialized_device(uint64_t) noexcept;
+} // namespace mlx::core::metal
