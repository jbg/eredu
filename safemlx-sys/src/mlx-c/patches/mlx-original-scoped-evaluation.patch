+ScopedEvaluation evaluation_progress(submission::ScopedProgress value) noexcept {
+  using P = submission::ScopedProgress;
+  switch (value) {
+    case P::observed: return ScopedEvaluation::complete;
+    case P::funded_progress: return ScopedEvaluation::funded_progress;
+    case P::busy: return ScopedEvaluation::busy;
+    case P::failed: return ScopedEvaluation::failed;
+    default: return ScopedEvaluation::unobservable;
+  }
+}
+ScopedEvaluation evaluation_event(EventObservation value) noexcept {
+  switch (value) {
+    case EventObservation::ready: return ScopedEvaluation::complete;
+    case EventObservation::pending: return ScopedEvaluation::pending;
+    case EventObservation::failed: return ScopedEvaluation::failed;
+    case EventObservation::busy: return ScopedEvaluation::busy;
+    default: return ScopedEvaluation::unobservable;
+  }
+}
+bool Completion::matches_failure(const FailureCarrier* failure) const noexcept {
+  return !event_ || event_->failure_owner().get() == failure;
+}
+ScopedEvaluation query_scoped_completion(
+    submission::Scope& scope, const Completion& completion) noexcept {
+  if (!scope.on_owner_thread() || !scope.scoped_observation_only() ||
+      !scope.identity() || !scope.failure_owner() ||
+      !completion.matches_failure(scope.failure_owner().get()))
+    return ScopedEvaluation::domain;
+  const auto progress = evaluation_progress(scope.progress_scoped());
+  if (progress != ScopedEvaluation::complete) return progress;
+  if (scope.failure_owner().get()->borrow()) return ScopedEvaluation::failed;
+  if (scope.failure_owner().get()->pending_publication()) return ScopedEvaluation::busy;
+  if (scope.query().failed) return ScopedEvaluation::unobservable;
+  return evaluation_event(completion.observe());
+}
+ScopedEvaluation wait_scoped_completion(
+    submission::Scope& scope, const Completion& completion) noexcept {
+  for (;;) {
+    const auto result = query_scoped_completion(scope, completion);
+    // Only owned, observable pending work may yield. This never commits or
+    // retires unrelated work and never spins on funded-progress/busy/unknown.
+    if (result != ScopedEvaluation::pending) return result;
+    std::this_thread::yield();
+  }
+}
+ScopedEvaluation validate_scoped_array(const array& value, submission::Scope& scope) noexcept {
+  if (!scope.on_owner_thread() || !scope.scoped_observation_only() || !scope.failure_owner())
+    return ScopedEvaluation::domain;
+  if (value.status() == array::Status::unscheduled) return ScopedEvaluation::invalid;
+  if (value.event().valid()) {
+    if (value.status() != array::Status::available &&
+        value.event().failure_owner().get() != scope.failure_owner().get())
+      return ScopedEvaluation::domain;
+    const auto result = value.status() == array::Status::available
+        ? ScopedEvaluation::complete : evaluation_event(value.event().observe());
+    if (result != ScopedEvaluation::complete) return result;
+    value.detach_event();
+  }
+  value.set_status(array::Status::available);
+  return ScopedEvaluation::complete;
+}
+ScopedEvaluation evaluate_scoped_array(array& value, submission::Scope& scope) noexcept {
+  const auto controls = submission::current_native_controls();
+  if (submission::current_scope() != &scope || !controls.original ||
+      controls.failure != submission::NativeControlFailure::none ||
+      controls.scope_identity != scope.identity() || !scope.on_owner_thread())
+    return ScopedEvaluation::domain;
+  // A preexisting retained cause is never overwritten by a new attempt.
+  if (scope.failure_owner().get()->borrow()) return ScopedEvaluation::failed;
+  if (scope.failure_owner().get()->pending_publication()) return ScopedEvaluation::busy;
+  if (scope.query().failed) return ScopedEvaluation::unobservable;
+  if (value.status() == array::Status::available)
+    return validate_scoped_array(value, scope);
+  if (value.event().valid() &&
+      value.event().failure_owner().get() != controls.carrier)
+    return ScopedEvaluation::domain;
