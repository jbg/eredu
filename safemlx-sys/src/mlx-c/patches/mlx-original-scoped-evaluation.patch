+    case ScopedEvaluation::domain: return "scoped evaluation domain mismatch";
+    case ScopedEvaluation::pending: return "scoped evaluation remains pending";
+    case ScopedEvaluation::failed: return "scoped evaluation retained native failure";
+    case ScopedEvaluation::funded_progress: return "scoped evaluation requires funded progress";
+    case ScopedEvaluation::busy: return "scoped evaluation runtime busy";
+    default: return "scoped evaluation is unobservable";
+  }
