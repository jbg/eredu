+    ArrayVector outputs{submission::GraphAllocator<array>(controls.graph)};
+    outputs.reserve(1);
+    outputs.emplace_back(value);
+    auto result = evaluation_progress(evaluate_with_completion_scoped(
+        std::move(outputs), scope, completion, false));
+    if (result != ScopedEvaluation::complete) return result;
+    result = wait_scoped_completion(scope, completion);
+    return result == ScopedEvaluation::complete ? validate_scoped_array(value, scope) : result;
+  } catch (...) {
+    // No error handler, what(), new carrier or authority. Partial work is still
