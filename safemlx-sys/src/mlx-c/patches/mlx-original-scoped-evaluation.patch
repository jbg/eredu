+#pragma once
+#include <exception>
+#include "mlx/api.h"
+#include "mlx/completion.h"
+#include "mlx/submission.h"
+
+namespace mlx::core {
+// Fixed transport shared by root completion and synchronous borrowed-array
+// evaluation. A refusal is not terminal recovery or a native source substitute.
+enum class ScopedEvaluation : unsigned {
+  complete = 0, invalid = 1, capacity = 2, allocation = 3, domain = 4,
+  spent = 5, pending = 6, failed = 7, funded_progress = 8,
+  unobservable = 9, busy = 10,
+};
+class MLX_API ScopedEvaluationError final : public std::exception {
+ public:
+  explicit ScopedEvaluationError(ScopedEvaluation value) noexcept : value_(value) {}
+  ScopedEvaluation outcome() const noexcept { return value_; }
+  const char* what() const noexcept override;
+ private:
+  ScopedEvaluation value_;
+};
+MLX_API ScopedEvaluation evaluation_progress(submission::ScopedProgress) noexcept;
+MLX_API ScopedEvaluation evaluation_event(EventObservation) noexcept;
+MLX_API ScopedEvaluation query_scoped_completion(
+    submission::Scope&, const Completion&) noexcept;
+MLX_API ScopedEvaluation wait_scoped_completion(
+    submission::Scope&, const Completion&) noexcept;
+MLX_API ScopedEvaluation validate_scoped_array(const array&, submission::Scope&) noexcept;
+// Current original-required Scope only; no replacement owner or collector.
+MLX_API ScopedEvaluation evaluate_scoped_array(array&, submission::Scope&) noexcept;
+// TLS read only. A nonnull result still requires genuine configured authority.
+MLX_API submission::Scope* original_evaluation_scope() noexcept;
+}
