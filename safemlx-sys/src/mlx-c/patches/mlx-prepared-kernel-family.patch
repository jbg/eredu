+bool specialization_equal(const KernelSpecialization& a, const KernelSpecialization& b,
+    size_t inputs, size_t outputs) noexcept {
+  if (a.template_count != b.template_count) return false;
+  for (size_t i = 0; i < inputs; ++i) {
+    if (a.inputs[i].dtype != b.inputs[i].dtype || a.inputs[i].scalar != b.inputs[i].scalar ||
+        a.inputs[i].constant != b.inputs[i].constant) return false;
+  }
+  for (size_t i = 0; i < outputs; ++i) if (a.outputs[i] != b.outputs[i]) return false;
+  for (size_t i = 0; i < a.template_count; ++i) if (a.templates[i] != b.templates[i]) return false;
