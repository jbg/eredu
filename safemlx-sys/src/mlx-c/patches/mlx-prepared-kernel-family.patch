+class SourceWriter {
+ public:
+  SourceWriter(char* data = nullptr, size_t capacity = 0) : data_(data), capacity_(capacity) {}
+  void append(const char* data, size_t size) noexcept {
+    if (!good_ || size > std::numeric_limits<size_t>::max() - size_) { good_ = false; return; }
+    if (data_) {
+      if (!data || size_ + size > capacity_) { good_ = false; return; }
+      if (size) std::memcpy(data_ + size_, data, size);
+    }
+    size_ += size;
+  }
+  SourceWriter& operator+=(std::string_view value) noexcept { append(value.data(), value.size()); return *this; }
+  template<class Integer> void decimal(Integer value, bool identifier = false) noexcept {
+    char buffer[32];
+    auto [end, error] = std::to_chars(buffer, buffer + sizeof(buffer), value);
+    if (error != std::errc{}) { good_ = false; return; }
+    if (identifier) for (auto* p = buffer; p != end; ++p) if (*p == '-') *p = '_';
+    append(buffer, size_t(end - buffer));
+  }
+  size_t size() const noexcept { return size_; }
+  bool good() const noexcept { return good_; }
+ private:
+  char* data_;
+  size_t capacity_, size_{0};
+  bool good_{true};
+};
