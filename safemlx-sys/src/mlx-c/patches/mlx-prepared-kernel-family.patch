+MTL::ComputePipelineState* Device::get_prepared_kernel(
+    const fast::PreparedKernelBorrow& source, const CompileOptions& options) {
+  auto& slot = source.pipeline();
+  std::unique_lock lock(slot.mutex);
+  if (slot.device && slot.device != this)
+    throw PreparedKernelError("prepared Metal kernel belongs to another Device", nullptr, source);
+  if (slot.pipeline) return static_cast<MTL::ComputePipelineState*>(slot.pipeline);
+  if (!slot.library) {
+    auto library = build_library_(source.compilation_source(), options, &source);
+    slot.device = this;
+    slot.retire = retire_prepared_pipeline;
+    library->retain();
