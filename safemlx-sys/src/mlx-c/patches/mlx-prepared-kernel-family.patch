+      slot->name = text; text += source.name_bytes + 1;
+      slot->full_source = text;
+      slot->prefix_bytes = platform.prefix_bytes;
+      slot->source_bytes = source.source_bytes;
+      if (platform.prefix_bytes) std::memcpy(text, platform.prefix, platform.prefix_bytes);
+      if (!source.write(plan, signature, slot->name, text + platform.prefix_bytes)) {
+        release_kernel_family(family); return MetalKernelDefinitionStatus::invalid;
+      }
+      text += platform.prefix_bytes + source.source_bytes + 1;
+    }
+  } catch (...) { release_kernel_family(family); return MetalKernelDefinitionStatus::allocation_failed; }
+  family->owner = owner; family->retire = retire;
+  result = family;
+  return MetalKernelDefinitionStatus::success;
+}
+PreparedKernelBorrow::PreparedKernelBorrow(PreparedKernelSlot* slot) noexcept : slot_(slot) {
+  if (slot_) retain_kernel_family(slot_->family);
+}
+PreparedKernelBorrow::PreparedKernelBorrow(const PreparedKernelBorrow& other) noexcept : PreparedKernelBorrow(other.slot_) {}
+PreparedKernelBorrow::PreparedKernelBorrow(PreparedKernelBorrow&& other) noexcept : slot_(std::exchange(other.slot_, nullptr)) {}
+PreparedKernelBorrow::~PreparedKernelBorrow() { if (slot_) release_kernel_family(slot_->family); }
+const char* PreparedKernelBorrow::name() const noexcept { return slot_->name; }
+std::string_view PreparedKernelBorrow::source() const noexcept {
+  return {slot_->full_source + slot_->prefix_bytes, slot_->source_bytes};
+}
+const char* PreparedKernelBorrow::compilation_source() const noexcept { return slot_->full_source; }
+std::span<const ShapeUsage> PreparedKernelBorrow::shape_infos() const noexcept {
+  auto* d = slot_->family->definition;
+  return {d->shape_infos.data(), d->input_count};
+}
+PreparedPipeline& PreparedKernelBorrow::pipeline() const noexcept { return slot_->compiled; }
+ArrayVector apply_kernel_family(const PreparedKernelFamily& family, const ArrayVector& inputs,
+    std::span<const Shape> shapes, std::span<const Dtype> dtypes,
+    std::tuple<int, int, int> grid, std::tuple<int, int, int> group,
+    TemplateArgsView templates, StreamOrDevice stream) {
+  auto* definition = family.definition;
+  auto invalid = [] { throw submission::NativeControlError(submission::NativeControlFailure::unsupported_backend); };
+  if (inputs.size() != definition->input_count || shapes.size() != definition->output_count ||
+      dtypes.size() != definition->output_count || templates.size() > 4) invalid();
+  KernelSpecialization actual;
+  for (size_t i = 0; i < inputs.size(); ++i)
+    actual.inputs[i] = {inputs[i].dtype(), inputs[i].ndim() == 0, inputs[i].size() < max_constant_array_size};
+  for (size_t i = 0; i < dtypes.size(); ++i) actual.outputs[i] = dtypes[i];
+  actual.template_count = templates.size();
+  for (size_t i = 0; i < templates.size(); ++i) actual.templates[i] = templates[i];
+  PreparedKernelSlot* selected = nullptr;
+  auto* slots = family_slots(family);
+  for (size_t i = 0; i < family.slot_count; ++i)
+    if (specialization_equal(actual, slots[i].signature, inputs.size(), dtypes.size())) { selected = slots + i; break; }
+  if (!selected) invalid();
+  auto resolved = resolve_metal_kernel_stream(stream);
+  return array::make_arrays_borrowed(shapes, dtypes,
+      submission::make_graph_primitive<CustomKernel>(resolved, PreparedKernelBorrow(selected),
+          grid, group, definition->contiguous, definition->atomic,
+          definition->options), inputs);
+}
+
