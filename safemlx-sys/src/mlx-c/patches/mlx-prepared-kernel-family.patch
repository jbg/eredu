+  if (status != MetalKernelDefinitionStatus::success) return status;
+  const auto platform = prepared_kernel_platform_layout();
+  if (!platform.qualified) return MetalKernelDefinitionStatus::unknown_layout;
+  if (signatures.empty() || signatures.size() > maximum_specializations)
+    return MetalKernelDefinitionStatus::invalid;
+  size_t bytes = slot_offset() + signatures.size() * sizeof(PreparedKernelSlot);
+  try {
+    for (size_t i = 0; i < signatures.size(); ++i) {
+      const auto& signature = signatures[i];
+      if (signature.template_count > 4) return MetalKernelDefinitionStatus::invalid;
+      for (size_t j = 0; j < plan.inputs.size(); ++j)
+        if (signature.inputs[j].scalar && !signature.inputs[j].constant) return MetalKernelDefinitionStatus::invalid;
+      for (size_t j = 0; j < signature.template_count; ++j)
