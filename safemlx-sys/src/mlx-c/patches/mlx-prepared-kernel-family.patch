+      sizeof(SignatureView) * 2 + sizeof(NameListView) * 2 + sizeof(TemplateArgsView) * 2 +
+      sizeof(InputSignature) + sizeof(std::span<const KernelSpecialization>) +
+      sizeof(std::span<const Dtype>) * 2 + sizeof(std::span<const ShapeUsage>) +
