+  // Keep the successful library prefix in this same admitted slot if later
+  // function/pipeline construction fails. A retry never creates a new row.
+  auto function = get_function_(source.name(), static_cast<MTL::Library*>(slot.library));
+  auto pipeline = get_kernel_(source.name(), function.get(), &source);
+  pipeline->retain();
+  slot.pipeline = pipeline.get();
+  return pipeline.get();
+}
