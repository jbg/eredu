+size_t RecordQuota::minimum_split_bytes() noexcept {
+  return sizeof(Block) + sizeof(size_t) + alignment;
+}
+
+bool RecordQuota::fresh_capacity_for_extents(size_t extents, size_t& out) noexcept {
+  size_t capacity, minimum;
+  if (extents % alignment || !add(extents, minimum_split_bytes(), capacity) ||
+      !minimum_capacity(minimum)) return false;
+  capacity = std::max(capacity, minimum);
+  RecordQuotaLayout checked;
+  if (!layout(capacity, checked)) return false;
+  out = capacity;
   return true;
