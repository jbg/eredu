@@ -0,0 +1,20 @@
+#pragma once
+#include <cstdint>
+
+namespace mlx::core::metal {
+// These predicates are consumed by the actual dispatch and its cold receipt.
+// All dimensions/groups have passed the convolution constructor's validation.
+inline bool implicit_convolution_channels(int channels, int outputs, int groups) {
+  const int c = channels / groups;
+  const int o = outputs / groups;
+  return (c <= 4 || c % 16 == 0) && (o <= 16 || o % 16 == 0);
+}
+inline bool winograd_convolution_2d(int batch, int height, int width,
+    int channels, int outputs, int kernel_h, int kernel_w,
+    bool stride_one, bool kernel_dilation_one, bool input_dilation_one, bool flip) {
+  return !flip && stride_one && kernel_dilation_one && input_dilation_one &&
+      kernel_h == 3 && kernel_w == 3 && channels % 32 == 0 && outputs % 32 == 0 &&
+      static_cast<int64_t>(batch) * height * width >= 4096 &&
+      static_cast<int64_t>(channels) + outputs >= 256;
+}
+} // namespace mlx::core::metal
