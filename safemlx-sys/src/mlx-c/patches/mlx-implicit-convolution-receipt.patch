+bool resident_convolution_layout(const ResidentConvolutionSource& source,
+    ResidentConvolutionLayout& result) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return false;
+#else
+  const auto dims = source.spatial_dimensions;
+  if ((dims != 1 && dims != 2) || source.groups <= 0) return false;
+  for (size_t axis = 0; axis != 4; ++axis) {
+    if (source.input[axis] <= 0 || source.weight[axis] <= 0) return false;
+  }
+  for (size_t axis = 0; axis != 2; ++axis) {
+    if (source.stride[axis] <= 0 || source.dilation[axis] <= 0 || source.padding[axis] < 0)
+      return false;
+  }
+  if (dims == 1 && (source.input[2] != 1 || source.weight[2] != 1 ||
+      source.stride[1] != 1 || source.dilation[1] != 1 || source.padding[1] != 0))
+    return false;
+  const int batch = source.input[0], channels = source.input[3];
+  const int outputs = source.weight[0], groups = source.groups;
+  if (static_cast<int64_t>(source.weight[3]) * groups != channels || outputs % groups)
+    return false;
+  ResidentConvolutionLayout value;
+  value.output[0] = batch; value.output[3] = outputs;
+  for (size_t axis = 0; axis != 2; ++axis) {
+    // conv_out_shape_axes uses signed int for the padded input and dilated
+    // kernel before dividing; qualify those actual constructor intermediates.
+    const int64_t padded = int64_t(source.input[axis + 1]) + 2 * int64_t(source.padding[axis]);
+    const int64_t kernel = 1 + int64_t(source.dilation[axis]) * (source.weight[axis + 1] - 1);
+    if (padded > INT_MAX || kernel > INT_MAX) return false;
+    const int64_t numerator = padded - kernel;
+    if (numerator < 0) return false;
+    const int64_t extent = numerator / source.stride[axis] + 1;
+    if (extent <= 0 || extent > INT_MAX) return false;
+    value.output[axis + 1] = static_cast<int>(extent);
+  }
+  // Constructor and native parameter arithmetic have real signed extents.
+  // These checks mirror their selected worker expressions, rather than
+  // turning telemetry or an arbitrary tensor-size ceiling into authority.
+  auto product = [](int64_t a, int64_t b, int64_t limit, int64_t& out) {
+    if (a < 0 || b < 0 || (a && b > limit / a)) return false;
+    out = a * b; return true;
+  };
+  const bool separable = dims == 1 && groups == channels && groups == outputs &&
+      source.stride[0] == 1 && source.dilation[0] == 1 && source.padding[0] == 0;
+  if (!separable) {
+    int64_t rows, source_rows, kernel_area, reduction;
+    if (!product(batch, value.output[1], INT_MAX, rows) ||
+        !product(rows, value.output[2], INT_MAX, rows) ||
+        !product(batch, source.input[1], INT64_MAX, source_rows) ||
+        !product(source_rows, source.input[2], INT64_MAX, source_rows) ||
+        !product(source.weight[1], source.weight[2], INT_MAX, kernel_area) ||
+        !product(kernel_area, source.weight[3], INT_MAX, reduction)) return false;
+    // The implicit loader computes output * stride - padding and then adds
+    // kernel * dilation in signed int. A selected depthwise tile can read
+    // the last partial 4-by-8 output tile before masking its outputs.
+    const bool tiled_depthwise = dims == 2 && groups > 1 &&
+        channels == groups && outputs == groups && channels % 16 == 0 &&
+        source.weight[1] <= 7 && source.weight[2] <= 7 &&
+        source.dilation[0] == 1 && source.dilation[1] == 1 &&
+        source.stride[0] <= 2 && source.stride[1] <= 2;
+    for (size_t axis = 0; axis != 2; ++axis) {
+      const int64_t tile = tiled_depthwise ? (axis == 0 ? 4 : 8) : 1;
+      const int64_t padded_extent = ((int64_t(value.output[axis + 1]) + tile - 1) / tile) * tile;
+      const int64_t output_span = (padded_extent - 1) * source.stride[axis];
+      const int64_t kernel_span = int64_t(source.weight[axis + 1] - 1) * source.dilation[axis];
+      if (int64_t(value.output[axis + 1]) + tile - 1 > INT_MAX ||
+          output_span > INT_MAX || kernel_span > INT_MAX ||
+          output_span - source.padding[axis] + kernel_span > INT_MAX) return false;
+    }
+    if (!metal::implicit_convolution_channels(channels, outputs, groups)) return false;
+    if (groups == 1 && metal::winograd_convolution_2d(batch,
+            source.input[1], source.input[2], channels, outputs,
+            source.weight[1], source.weight[2],
+            source.stride[0] == 1 && source.stride[1] == 1,
+            source.dilation[0] == 1 && source.dilation[1] == 1, true, false)) return false;
+    const int c = channels / groups, n = outputs / groups;
+    const int bm = rows >= 8192 && c >= 64 ? 64 : 32;
+    const int bn = n <= 16 ? 8 : (bm == 64 || n >= 64 ? 64 : 32);
+    if (rows > INT_MAX - (bm - 1) || n > INT_MAX - (bn - 1) || c > INT_MAX - 15)
+      return false;
+    int64_t iterations;
+    if (c <= 2) {
+      if (reduction > INT_MAX - 15) return false;
+    } else if (c <= 4) {
+      if (!product(kernel_area, 4, INT_MAX - 15, iterations)) return false;
+    } else if (!product(kernel_area, (c + 15) / 16, INT_MAX, iterations)) {
+      return false;
+    }
+    // The shared ensure_row_contiguous worker canonicalizes singleton
+    // strides as well, so these are the actual selected input jump operands.
+    int64_t row_stride, jump_h, jump_w, filter_h, filter_w;
+    if (!product(source.input[2], channels, INT_MAX, row_stride) ||
+        !product(row_stride, source.dilation[0], INT_MAX, jump_h) ||
+        !product(dims == 1 ? 0 : channels, source.dilation[1], INT_MAX, jump_w) ||
+        !product(source.weight[1] - 1, jump_h, INT_MAX, filter_h) ||
+        !product(source.weight[2] - 1, jump_w, INT_MAX, filter_w) ||
+        filter_h + filter_w > INT_MAX + int64_t(17) ||
+        jump_h - filter_w < INT_MIN) return false;
+  }
+  // conv_general_axes: two possible AsType descriptors and Convolution.
+  // Each native caller may compact input and weight once; the selected
+  // separable/implicit worker creates no unfolded matrix or other tensor.
+  value.primitives = 3; value.edges = 4; value.backing_births = 5;
+  constexpr size_t worker_controls =
+      // eval_gpu, contiguous caller and their source/temporary loans.
+      2 * sizeof(array) + sizeof(ArrayVector) + 12 * sizeof(void*) +
+      sizeof(bool) + 2 * sizeof(size_t) +
+      sizeof(MLXConvParams<2>) + sizeof(mlx::steel::ImplicitGemmConv2DParams) +
+      // The implicit worker's 24 scalar selections, two grid extents,
+      // filter predicate, two MTL dimensions, and caller's branch scalars.
+      24 * sizeof(int) + 2 * sizeof(size_t) + sizeof(bool) + 2 * sizeof(MTL::Size) +
+      5 * sizeof(int) + 3 * sizeof(bool) +
+      // Separable 1D's possible wide-stride argument and 2D's function
+      // constants. Names/constants/concatenate recursion are paid by the
+      // existing per-kernel selector query, with these names included there.
+      3 * sizeof(int64_t) + 10 * sizeof(int) + sizeof(bool) +
+      // Native entrypoint arguments, including fixed two-axis pair wrappers.
+      3 * sizeof(std::pair<int, int>) + sizeof(int) + sizeof(StreamOrDevice);
+  constexpr size_t query_controls = sizeof(source) + sizeof(value) + sizeof(result) +
+      sizeof(decltype(product)) + 12 * sizeof(int64_t) + 10 * sizeof(int) +
+      3 * sizeof(size_t) + 3 * sizeof(bool) +
+      4 * sizeof(int64_t) + sizeof(int64_t*) +
+      sizeof(bool) + sizeof(size_t) + 6 * sizeof(int64_t);
+  value.named_control_bytes = worker_controls + query_controls;
+  result = value; return true;
+#endif
+}
