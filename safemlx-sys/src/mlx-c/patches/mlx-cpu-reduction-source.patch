diff --git a/mlx/backend/cpu/reduction_storage.cpp b/mlx/backend/cpu/reduction_storage.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/reduction_storage.cpp
@@ -0,0 +1,88 @@
+#include "mlx/backend/cpu/reduction_storage.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <climits>
+#include <typeinfo>
+namespace mlx::core::cpu {
+namespace {
+bool product(size_t a,size_t b,size_t& out) noexcept {
+  if(b&&a>size_t(PTRDIFF_MAX)/b)return false;out=a*b;return true;
+}
+bool add(size_t& total,size_t value) noexcept {
+  if(value>size_t(PTRDIFF_MAX)-total)return false;total+=value;return true;
+}
+}
+bool is_reduction_eval_primitive(const array& output) noexcept {
+  return output.has_primitive()&&output.primitive().stream().device==Device::cpu&&
+      typeid(output.primitive())==typeid(Reduce);
+}
+bool reduction_eval_layout(ReductionEvalKind kind,size_t rank,size_t width,
+    size_t rows,bool tracer,CopyEvalStorage& out) noexcept {
+  size_t elements=0,bytes=0;
+  if(!rank||rank>4||!width||!rows||!product(width,rows,elements)||
+      elements>size_t(INT_MAX)||!product(elements,sizeof(float),bytes))return false;
+  switch(kind) {
+    case ReductionEvalKind::BooleanAll:case ReductionEvalKind::BooleanAny:
+      if(rows!=1)return false;break;
+    case ReductionEvalKind::Float32Rows:break;
+    default:return false;
+  }
+  EvalDispatchStorage dispatch;SingleOutputEvalStorage common;
+  if(!reduction_dispatch_storage(kind,rank,dispatch)||
+      !single_output_eval_layout(rank,1,tracer,&dispatch,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  const size_t controls=sizeof(kind)+sizeof(rank)+sizeof(width)+sizeof(rows)+sizeof(tracer)+sizeof(out)+
+      sizeof(elements)+sizeof(bytes)+sizeof(dispatch)+sizeof(common)+sizeof(value)+
+      sizeof(const array*)*3+sizeof(const Reduce*)+sizeof(const Shape*)+
+      sizeof(size_t)*12+sizeof(bool)*4+sizeof(int)*3+sizeof(Reduce::ReduceType)+
+      sizeof(submission::FixedEvalPrologueGuard*)+sizeof(submission::Record*)+
+      sizeof(submission::GraphQuota*)+sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls))return false;
+  out=value;return true;
+}
+bool reduction_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_reduction_eval_primitive(output)||!output.siblings().empty()||output.inputs().size()!=1)return false;
+  const auto& input=output.inputs()[0];const size_t rank=input.ndim();
+  const auto& primitive=static_cast<const Reduce&>(output.primitive());
+  const auto kind=primitive.reduce_type();const auto& axes=primitive.axes_ref();
+  if(!rank||rank>4||output.ndim()!=rank||input.strides().size()!=rank)return false;
+  size_t elements=1,span=1,delta=0,bytes=0;
+  for(size_t axis=0;axis!=rank;++axis) {
+    if(input.shape(axis)<=0||input.strides()[axis]<0||
+        !product(elements,size_t(input.shape(axis)),elements)||
+        !product(size_t(input.shape(axis)-1),size_t(input.strides()[axis]),delta)||!add(span,delta))return false;
+  }
+  if(elements!=input.size()||elements>size_t(INT_MAX)||span>input.data_size()||
+      !product(span,size_t(input.itemsize()),bytes))return false;
+  ReductionEvalKind selected;size_t width=elements,rows=1;
+  if(kind==Reduce::And||kind==Reduce::Or) {
+    if(input.dtype()!=bool_||input.itemsize()!=sizeof(bool)||output.dtype()!=bool_||
+        output.itemsize()!=sizeof(bool)||input.data_size()!=elements||!input.flags().contiguous||
+        axes.size()!=rank||output.size()!=1)return false;
+    for(size_t axis=0;axis!=rank;++axis)
+      if(axes[axis]!=int(axis)||output.shape(axis)!=1)return false;
+    selected=kind==Reduce::And?ReductionEvalKind::BooleanAll:ReductionEvalKind::BooleanAny;
+  } else if(kind==Reduce::Sum) {
+    if(input.dtype()!=float32||input.itemsize()!=sizeof(float)||output.dtype()!=float32||
+        output.itemsize()!=sizeof(float)||!input.flags().row_contiguous||
+        axes.size()!=1||axes[0]!=int(rank)-1)return false;
+    width=size_t(input.shape(rank-1));rows=elements/width;
+    for(size_t axis=0;axis!=rank;++axis)
+      if(output.shape(axis)!=(axis+1==rank?1:input.shape(axis)))return false;
+    if(output.size()!=rows)return false;
+    selected=ReductionEvalKind::Float32Rows;
+  } else return false;
+  return reduction_eval_layout(selected,rank,width,rows,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_reduction_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::reduction_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
