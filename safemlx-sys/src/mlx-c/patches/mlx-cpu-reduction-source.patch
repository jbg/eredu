+      !PreparedInputLeaf::weak_copy_storage(rank,weak))return false;
+  EvalDispatchStorage value{task.task_bytes,task.task_alignment,0,0};
+  // Only the all-contiguous boolean branch or the existing early F32 row
+  // cascade is selected. Neither enters nd_loop/std::function or scratch-vector
+  // branches. The cascade array is the actual fixed four-level source object.
+  const size_t cascade=sizeof(float[4][4][4])+sizeof(size_t)*12+sizeof(float);
