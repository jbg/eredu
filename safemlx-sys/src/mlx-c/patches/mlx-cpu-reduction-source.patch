+      sizeof(ReductionTask)*2+sizeof(array)*3+sizeof(Shape)*2+sizeof(Strides)+
+      sizeof(Stream)+sizeof(CommandEncoder*)+sizeof(size_t)*7+sizeof(void*)*5+
+      sizeof(Reduce::ReduceType)*2+sizeof(Dtype)*2+sizeof(cascade)+sizeof(boolean)+sizeof(boolean_lanes)};
+  value.controls=sizeof(controls);
+  for(size_t control:controls) {
+    if(control>SIZE_MAX-value.controls)return false;value.controls+=control;
+  }
+  out=value;return true;
+}
