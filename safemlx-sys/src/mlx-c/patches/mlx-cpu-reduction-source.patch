+bool reduction_dispatch_storage(ReductionEvalKind kind,size_t rank,
+    EvalDispatchStorage& out) noexcept {
+  if(!rank||rank>4)return false;
+  switch(kind) {
+    case ReductionEvalKind::BooleanAll:case ReductionEvalKind::BooleanAny:
+    case ReductionEvalKind::Float32Rows:break;
+    default:return false;
+  }
+  DispatchLayout task;WeakCopyStorage weak;
