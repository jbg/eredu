diff --git a/mlx/backend/metal/kernels/indexing/scatter_axis.metal b/mlx/backend/metal/kernels/indexing/scatter_axis.metal
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/kernels/indexing/scatter_axis.metal
@@ -0,0 +1,17 @@
+// Copyright © 2025 Apple Inc.
+// Existing overwrite worker for floating scores and UInt32 argsort indices.
+#include "mlx/backend/metal/kernels/utils.h"
+#include "mlx/backend/metal/kernels/atomic.h"
+#include "mlx/backend/metal/kernels/reduction/ops.h"
+#include "mlx/backend/metal/kernels/indexing/scatter_axis.h"
+#define SCATTER_AXIS_WIDTH(tname, type, lname, location) \
+  instantiate_kernel("scatter_axis" #tname "uint32_none_" #lname "cc", scatter_axis, type, uint32_t, location, None, true, true) \
+  instantiate_kernel("scatter_axis" #tname "uint32_none_" #lname "cnc", scatter_axis, type, uint32_t, location, None, true, false) \
+  instantiate_kernel("scatter_axis" #tname "uint32_none_" #lname "ncc", scatter_axis, type, uint32_t, location, None, false, true) \
+  instantiate_kernel("scatter_axis" #tname "uint32_none_" #lname "ncnc", scatter_axis, type, uint32_t, location, None, false, false)
+#define SCATTER_AXIS_TYPE(tname, type) \
+  SCATTER_AXIS_WIDTH(tname, type, int, int) \
+  SCATTER_AXIS_WIDTH(tname, type, int64_t, int64_t)
+SCATTER_AXIS_TYPE(float32, float)
+SCATTER_AXIS_TYPE(float16, half)
+SCATTER_AXIS_TYPE(bfloat16, bfloat16_t)
