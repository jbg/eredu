+bool fixed_reshape_plan(const int* shape,const int64_t* strides,size_t rank,
+    bool row_contiguous,const int* output_shape,size_t output_rank,FixedReshapePlan& out) noexcept {
+  if(rank>5||output_rank>5||(rank&&(!shape||!strides))||(output_rank&&!output_shape))return false;
+  size_t source_elements=1,output_elements=1;
+  for(size_t i=0;i!=rank;++i) {
+    if(shape[i]<=0||strides[i]<0||source_elements>size_t(INT_MAX)/size_t(shape[i]))return false;
+    source_elements*=size_t(shape[i]);
+  }
+  for(size_t i=0;i!=output_rank;++i) {
+    if(output_shape[i]<=0||output_elements>size_t(INT_MAX)/size_t(output_shape[i]))return false;
+    output_elements*=size_t(output_shape[i]);
+  }
+  if(source_elements!=output_elements)return false;
+  FixedReshapePlan value;
+  if(row_contiguous||rank==0) {
+    int64_t stride=rank==0?0:1;
+    for(size_t i=output_rank;i--;) {value.strides[i]=stride;stride*=output_shape[i];}
+    out=value;return true;
+  }
+  // Same collapse_contiguous_dims order, singleton removal and divisibility
+  // decisions as the unbounded path below. All dimensions fit its int cap.
+  int64_t collapsed_shape[5]{},collapsed_strides[5]{};
+  size_t count=1;collapsed_shape[0]=shape[0];collapsed_strides[0]=strides[0];
+  for(size_t i=1;i!=rank;++i) {
+    if(shape[i]==1)continue;
+    if(strides[i]>INT64_MAX/shape[i])return false;
+    if(strides[i]*shape[i]!=collapsed_strides[count-1]) {
+      collapsed_shape[count]=shape[i];collapsed_strides[count]=strides[i];++count;
+    } else {collapsed_shape[count-1]*=shape[i];collapsed_strides[count-1]=strides[i];}
+  }
+  size_t j=0;
+  for(size_t i=0;i!=output_rank;++i) {
+    const int64_t dimension=output_shape[i];
+    if(j<count&&collapsed_shape[j]%dimension==0) {
+      collapsed_shape[j]/=dimension;
+      if(collapsed_shape[j]&&collapsed_strides[j]>INT64_MAX/collapsed_shape[j])return false;
+      value.strides[i]=collapsed_shape[j]*collapsed_strides[j];
+      j+=size_t(collapsed_shape[j]==1);
+    } else if(dimension==1&&i) {value.strides[i]=value.strides[i-1];}
+    else {value.copy=true;break;}
+  }
+  out=value;return true;
+}
