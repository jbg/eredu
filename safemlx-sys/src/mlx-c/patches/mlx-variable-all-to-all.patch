+void RingGroup::all_to_all_v(
+    const void* input,
+    void* output,
+    const std::vector<size_t>& send_offsets,
+    const std::vector<size_t>& send_sizes,
+    const std::vector<size_t>& recv_offsets,
+    const std::vector<size_t>& recv_sizes) {
+  for (size_t peer = 0; peer < send_sizes.size(); ++peer) {
+    if (send_sizes[peer] >
+            static_cast<size_t>(std::numeric_limits<int64_t>::max()) ||
+        recv_sizes[peer] >
+            static_cast<size_t>(std::numeric_limits<int64_t>::max())) {
+      throw std::overflow_error(
+          "[jaccl::ring::all_to_all_v] Peer byte count exceeds INT64_MAX.");
+    }
+  }
+  if (send_sizes[rank_] != recv_sizes[rank_]) {
+    throw std::invalid_argument(
+        "[jaccl::ring::all_to_all_v] Self send and receive byte counts must match.");
+  }
+
+  struct PacketHeader {
+    uint64_t bytes;
+    uint32_t source;
+    uint32_t destination;
+  };
+  auto* in = static_cast<const char*>(input);
+  auto* out = static_cast<char*>(output);
+  if (send_sizes[rank_] != 0) {
+    std::memcpy(
+        out + recv_offsets[rank_], in + send_offsets[rank_], send_sizes[rank_]);
+  }
+
+  int right = (rank_ + 1) % size_;
+  int left = (rank_ + size_ - 1) % size_;
+  for (int distance = 1; distance < size_; ++distance) {
+    int destination = (rank_ + distance) % size_;
+    PacketHeader current_header{
+        static_cast<uint64_t>(send_sizes[destination]),
+        static_cast<uint32_t>(rank_),
+        static_cast<uint32_t>(destination)};
+    std::vector<char> current(current_header.bytes);
+    if (!current.empty()) {
+      std::memcpy(
+          current.data(), in + send_offsets[destination], current.size());
+    }
+
+    for (int hop = 1; hop <= distance; ++hop) {
+      PacketHeader incoming_header{};
+      auto receive_header = std::async(std::launch::async, [&]() {
+        recv(&incoming_header, sizeof(incoming_header), left);
+      });
+      send(&current_header, sizeof(current_header), right);
+      receive_header.get();
+
+      if (incoming_header.bytes >
+          static_cast<uint64_t>(std::numeric_limits<size_t>::max())) {
+        throw std::overflow_error(
+            "[jaccl::ring::all_to_all_v] Routed packet exceeds size_t.");
+      }
+      std::vector<char> incoming(static_cast<size_t>(incoming_header.bytes));
+      std::future<void> receive_payload;
+      if (!incoming.empty()) {
+        receive_payload = std::async(std::launch::async, [&]() {
+          recv(incoming.data(), incoming.size(), left);
+        });
+      }
+      if (!current.empty()) {
+        send(current.data(), current.size(), right);
+      }
+      if (receive_payload.valid()) {
+        receive_payload.get();
+      }
+      current_header = incoming_header;
+      current = std::move(incoming);
+    }
+
+    if (current_header.destination != static_cast<uint32_t>(rank_) ||
+        current_header.source >= static_cast<uint32_t>(size_)) {
+      throw std::runtime_error(
+          "[jaccl::ring::all_to_all_v] Received invalid routing metadata.");
+    }
+    size_t source = current_header.source;
+    if (current.size() != recv_sizes[source]) {
+      std::ostringstream msg;
+      msg << "[jaccl::ring::all_to_all_v] Received " << current.size()
+          << " bytes from source " << source << ", expected "
+          << recv_sizes[source] << ".";
+      throw std::runtime_error(msg.str());
+    }
+    if (!current.empty()) {
+      std::memcpy(out + recv_offsets[source], current.data(), current.size());
+    }
+  }
+}
+
