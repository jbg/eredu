+TEST_CASE("test all_to_all_v JVP VJP and vmap") {
+  auto implementation = std::make_shared<TestGroup>(0, 2);
+  auto g = group(implementation);
+  auto function = [g](const array& input) {
+    return distributed::all_to_all_v(input, {1, 1}, {1, 1}, g);
+  };
+
+  auto primal = array({1.0f, 2.0f}, {2, 1});
+  auto tangent = array({3.0f, 4.0f}, {2, 1});
+  auto tangent_output = jvp(function, primal, tangent).second;
+  CHECK(array_equal(tangent_output, tangent).item<bool>());
+
+  auto cotangent = array({5.0f, 6.0f}, {2, 1});
+  auto gradient = vjp(function, primal, cotangent).second;
+  CHECK(array_equal(gradient, cotangent).item<bool>());
+  CHECK_EQ(implementation->last_send_counts, std::vector<size_t>({1, 1}));
+  CHECK_EQ(implementation->last_recv_counts, std::vector<size_t>({1, 1}));
+
+  auto batched =
+      array({1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f, 7.0f, 8.0f}, {4, 2, 1});
+  auto mapped = vmap(function)(batched);
+  CHECK(array_equal(mapped, batched).item<bool>());
+  auto axis_one_batched = moveaxis(batched, 0, 1);
+  auto axis_one_mapped = vmap(function, 1, 1)(axis_one_batched);
+  CHECK(array_equal(axis_one_mapped, axis_one_batched).item<bool>());
+  CHECK_THROWS_WITH(vmap(function, 3)(batched), "SmallVector out of range.");
+}
+
+TEST_CASE("test all_to_all_v lazy completion handoff") {
+  auto implementation = std::make_shared<TestGroup>(0, 2);
+  auto producer = new_thread_unsafe_stream(Device::cpu);
+  auto consumer = new_thread_unsafe_stream(Device::cpu);
+  auto output = distributed::all_to_all_v(
+      array({1.0f, 2.0f}, {2, 1}),
+      {1, 1},
+      {1, 1},
+      group(implementation),
+      producer);
+  CHECK_EQ(implementation->calls.load(), 0);
+  auto completion = async_eval_with_completion({output});
+  completion.wait(consumer);
+  auto downstream = add(output, array(1.0f), consumer);
+  eval(downstream);
+  CHECK(array_equal(downstream, array({2.0f, 3.0f}, {2, 1})).item<bool>());
+  CHECK(completion.is_complete());
+}
