+TEST_CASE("test all_to_all_v API validation and singleton") {
+  auto singleton_impl = std::make_shared<TestGroup>(0, 1);
+  auto singleton = group(singleton_impl);
+  auto x = array({1, 2, 3, 4}, {2, 2});
+  auto y = distributed::all_to_all_v(x, {2}, {2}, singleton);
+  CHECK_EQ(y.id(), x.id());
+  CHECK_EQ(singleton_impl->calls.load(), 0);
+
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(array(1), {1}, {1}, singleton),
+      "[all_to_all_v] Input must have a leading row dimension.");
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(x, {}, {2}, singleton),
+      "[all_to_all_v] send_counts and recv_counts must each have group.size() entries (expected 1, got 0 and 1).");
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(x, {-1}, {2}, singleton),
+      "[all_to_all_v] send_counts[0] must be nonnegative.");
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(x, {1}, {2}, singleton),
+      "[all_to_all_v] sum(send_counts)=1 does not equal input.shape(0)=2.");
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(x, {2}, {1}, singleton),
+      "[all_to_all_v] Singleton send and receive counts must match.");
+
+  auto size_three = group(std::make_shared<TestGroup>(0, 3));
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(
+          zeros({0, 1}), {0, 0, 0}, {1, 0, 0}, size_three),
+      "[all_to_all_v] Self send count 0 does not match self receive count 1.");
+  CHECK_THROWS_WITH(
+      distributed::all_to_all_v(
+          zeros({0, 1}),
+          {0, 0, 0},
+          {std::numeric_limits<int>::max(), 1, 0},
+          size_three),
+      "[all_to_all_v] Output leading dimension exceeds the MLX shape limit.");
+}
