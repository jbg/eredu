+TEST_CASE("test all_to_all_v asymmetric source order and trailing shape") {
+  auto implementation = std::make_shared<TestGroup>(
+      1, 3, as_bytes<int32_t>({10, 11, 12, 13, 30, 31}));
+  auto g = group(implementation);
+  auto input = array({100, 101, 200, 201, 202, 203}, {3, 2});
+  auto output = distributed::all_to_all_v(input, {0, 1, 2}, {2, 1, 0}, g);
+  CHECK_EQ(output.shape(), Shape({3, 2}));
+  CHECK_EQ(output.dtype(), int32);
+  CHECK_FALSE(output.is_available());
+  eval(output);
+  CHECK(array_equal(output, array({10, 11, 12, 13, 30, 31}, {3, 2}))
+            .item<bool>());
+  CHECK_EQ(implementation->last_send_counts, std::vector<size_t>({0, 1, 2}));
+  CHECK_EQ(implementation->last_recv_counts, std::vector<size_t>({2, 1, 0}));
+}
