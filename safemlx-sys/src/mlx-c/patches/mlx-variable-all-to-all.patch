+  int size() override {
+    return size_;
+  }
+  std::shared_ptr<GroupImpl> split(int, int) override {
+    throw std::runtime_error("unused");
+  }
+  void all_sum(const array&, array&, Stream) override {
+    throw std::runtime_error("unused");
+  }
+  void all_gather(const array&, array&, Stream) override {
+    throw std::runtime_error("unused");
+  }
+  void send(const array&, int, Stream) override {
+    throw std::runtime_error("unused");
+  }
+  void recv(array&, int, Stream) override {
+    throw std::runtime_error("unused");
+  }
+  void all_max(const array&, array&, Stream) override {
+    throw std::runtime_error("unused");
+  }
+  void all_min(const array&, array&, Stream) override {
+    throw std::runtime_error("unused");
+  }
+  void sum_scatter(const array&, array&, Stream) override {
+    throw std::runtime_error("unused");
+  }
+
+  void all_to_all_v(
+      const array& input,
+      array& output,
+      const std::vector<size_t>& send_counts,
+      const std::vector<size_t>& recv_counts,
+      Stream stream) override {
+    calls++;
+    saw_row_contiguous = input.flags().row_contiguous;
+    last_send_counts = send_counts;
+    last_recv_counts = recv_counts;
+    if (!result_.empty() && result_.size() != output.nbytes()) {
+      throw std::runtime_error("test result byte size mismatch");
+    }
+    auto* input_ptr = input.data<char>();
+    auto* output_ptr = output.data<char>();
+    auto result = result_;
+    auto input_bytes = input.nbytes();
+    auto output_bytes = output.nbytes();
+    auto& encoder = cpu::get_command_encoder(stream);
+    encoder.set_input_array(input);
+    encoder.set_output_array(output);
+    encoder.dispatch([input_ptr,
+                      output_ptr,
+                      input_bytes,
+                      output_bytes,
+                      result = std::move(result)]() {
+      if (!result.empty()) {
+        std::memcpy(output_ptr, result.data(), result.size());
+      } else if (output_bytes != 0) {
+        if (input_bytes != output_bytes) {
+          throw std::runtime_error("test identity byte size mismatch");
+        }
+        std::memcpy(output_ptr, input_ptr, output_bytes);
+      }
+    });
+  }
+
+  std::atomic<int> calls{0};
+  bool saw_row_contiguous{false};
+  std::vector<size_t> last_send_counts;
+  std::vector<size_t> last_recv_counts;
+
+ private:
+  int rank_;
+  int size_;
+  std::vector<char> result_;
+};
+
+template <typename T>
+std::vector<char> as_bytes(const std::vector<T>& values) {
+  std::vector<char> result(values.size() * sizeof(T));
+  std::memcpy(result.data(), values.data(), result.size());
+  return result;
+}
