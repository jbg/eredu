+TEST_CASE("test all_to_all_v empty and noncontiguous inputs") {
+  {
+    auto implementation = std::make_shared<TestGroup>(2, 3);
+    auto output = distributed::all_to_all_v(
+        zeros({0, 4}, float16), {0, 0, 0}, {0, 0, 0}, group(implementation));
+    eval(output);
+    CHECK_EQ(output.shape(), Shape({0, 4}));
+    CHECK_EQ(output.dtype(), float16);
+    CHECK_EQ(implementation->calls.load(), 1);
+  }
+  {
+    auto implementation = std::make_shared<TestGroup>(0, 2);
+    auto input = transpose(array({1, 2, 3, 4, 5, 6}, {2, 3}));
+    auto output =
+        distributed::all_to_all_v(input, {1, 2}, {1, 2}, group(implementation));
+    eval(output);
+    CHECK(implementation->saw_row_contiguous);
+    CHECK(array_equal(output, input).item<bool>());
+  }
+}
