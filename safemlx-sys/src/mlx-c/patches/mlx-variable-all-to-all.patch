+    std::memcpy(
+        out + recv_offsets[rank_], in + send_offsets[rank_], send_sizes[rank_]);
+  }
+  for (int step = 1; step < size_; ++step) {
+    int destination = (rank_ + step) % size_;
+    int source = (rank_ + size_ - step) % size_;
