+
+array all_to_all_v(
+    const array& x,
+    const std::vector<int64_t>& send_counts,
+    const std::vector<int64_t>& recv_counts,
+    std::optional<Group> group_ /* = std::nullopt */,
+    StreamOrDevice s /* = {} */) {
+  auto group = to_group(group_);
+  if (x.ndim() == 0) {
+    throw std::invalid_argument(
+        "[all_to_all_v] Input must have a leading row dimension.");
+  }
+  if (send_counts.size() != group.size() ||
+      recv_counts.size() != group.size()) {
+    std::ostringstream msg;
+    msg << "[all_to_all_v] send_counts and recv_counts must each have "
+        << "group.size() entries (expected " << group.size() << ", got "
+        << send_counts.size() << " and " << recv_counts.size() << ").";
+    throw std::invalid_argument(msg.str());
+  }
+
+  auto validate_counts = [](const std::vector<int64_t>& counts,
+                            const char* name) {
+    std::vector<size_t> converted;
+    converted.reserve(counts.size());
+    size_t total = 0;
+    for (size_t i = 0; i < counts.size(); ++i) {
+      if (counts[i] < 0) {
+        std::ostringstream msg;
+        msg << "[all_to_all_v] " << name << "[" << i
+            << "] must be nonnegative.";
+        throw std::invalid_argument(msg.str());
+      }
+      auto count = static_cast<uint64_t>(counts[i]);
+      if (count > std::numeric_limits<size_t>::max()) {
+        std::ostringstream msg;
+        msg << "[all_to_all_v] " << name << "[" << i << "] exceeds size_t.";
+        throw std::overflow_error(msg.str());
+      }
+      auto value = static_cast<size_t>(count);
+      if (value > std::numeric_limits<size_t>::max() - total) {
+        std::ostringstream msg;
+        msg << "[all_to_all_v] " << name << " sum exceeds size_t.";
+        throw std::overflow_error(msg.str());
+      }
+      total += value;
+      converted.push_back(value);
+    }
+    return std::pair{std::move(converted), total};
+  };
+
+  auto [send_rows, total_send_rows] =
+      validate_counts(send_counts, "send_counts");
+  auto [recv_rows, total_recv_rows] =
+      validate_counts(recv_counts, "recv_counts");
+  if (total_send_rows != static_cast<size_t>(x.shape(0))) {
+    std::ostringstream msg;
+    msg << "[all_to_all_v] sum(send_counts)=" << total_send_rows
+        << " does not equal input.shape(0)=" << x.shape(0) << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (total_recv_rows > std::numeric_limits<int>::max()) {
+    throw std::overflow_error(
+        "[all_to_all_v] Output leading dimension exceeds the MLX shape limit.");
+  }
+
+  size_t row_bytes = x.itemsize();
+  for (size_t axis = 1; axis < x.ndim(); ++axis) {
+    auto dimension = static_cast<size_t>(x.shape(axis));
+    if (dimension != 0 &&
+        row_bytes > std::numeric_limits<size_t>::max() / dimension) {
+      throw std::overflow_error("[all_to_all_v] Row byte size exceeds size_t.");
+    }
+    row_bytes *= dimension;
+  }
+  if (total_recv_rows != 0 &&
+      row_bytes > std::numeric_limits<size_t>::max() / total_recv_rows) {
+    throw std::overflow_error(
+        "[all_to_all_v] Output byte size exceeds size_t.");
+  }
+  for (size_t i = 0; i < group.size(); ++i) {
+    if ((send_rows[i] != 0 &&
+         row_bytes > std::numeric_limits<size_t>::max() / send_rows[i]) ||
+        (recv_rows[i] != 0 &&
+         row_bytes > std::numeric_limits<size_t>::max() / recv_rows[i])) {
+      throw std::overflow_error(
+          "[all_to_all_v] Peer transfer byte size exceeds size_t.");
+    }
+  }
+
+  if (group.size() == 1) {
+    if (total_recv_rows != total_send_rows) {
+      throw std::invalid_argument(
+          "[all_to_all_v] Singleton send and receive counts must match.");
+    }
+    return x;
+  }
+
+  if (send_rows[group.rank()] != recv_rows[group.rank()]) {
+    std::ostringstream msg;
+    msg << "[all_to_all_v] Self send count " << send_rows[group.rank()]
+        << " does not match self receive count " << recv_rows[group.rank()]
+        << ".";
+    throw std::invalid_argument(msg.str());
+  }
+
+  auto result_shape = x.shape();
+  result_shape[0] = static_cast<int>(total_recv_rows);
+  auto stream = detail::communication_stream(group, s);
+
+  return array(
+      std::move(result_shape),
+      x.dtype(),
+      std::make_shared<AllToAllV>(
+          stream, group, std::move(send_rows), std::move(recv_rows)),
+      {x});
+}
