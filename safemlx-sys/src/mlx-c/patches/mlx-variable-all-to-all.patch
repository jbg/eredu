+ByteLayout all_to_all_v_layout(
+    const array& x,
+    const std::vector<size_t>& counts,
+    const char* counts_name) {
+  size_t row_bytes = x.itemsize();
+  for (size_t axis = 1; axis < x.ndim(); ++axis) {
+    auto dimension = static_cast<size_t>(x.shape(axis));
+    if (dimension != 0 &&
+        row_bytes > std::numeric_limits<size_t>::max() / dimension) {
+      throw std::overflow_error("[all_to_all_v] Row byte size exceeds size_t.");
+    }
+    row_bytes *= dimension;
+  }
+
+  ByteLayout layout;
+  layout.offsets.reserve(counts.size());
+  layout.sizes.reserve(counts.size());
+  size_t offset = 0;
+  for (size_t peer = 0; peer < counts.size(); ++peer) {
+    if (counts[peer] != 0 &&
+        row_bytes > std::numeric_limits<size_t>::max() / counts[peer]) {
+      std::ostringstream msg;
+      msg << "[all_to_all_v] " << counts_name << "[" << peer
+          << "] byte size exceeds size_t.";
+      throw std::overflow_error(msg.str());
+    }
+    size_t bytes = counts[peer] * row_bytes;
+    if (bytes > std::numeric_limits<size_t>::max() - offset) {
+      std::ostringstream msg;
+      msg << "[all_to_all_v] " << counts_name
+          << " byte displacement exceeds size_t.";
+      throw std::overflow_error(msg.str());
+    }
+    layout.offsets.push_back(offset);
+    layout.sizes.push_back(bytes);
+    offset += bytes;
+  }
+  return layout;
+}
+
+void all_to_all_v(
+    Group group,
+    const array& input,
+    array& output,
+    const std::vector<size_t>& send_counts,
+    const std::vector<size_t>& recv_counts,
+    Stream stream) {
+  group.raw_group()->all_to_all_v(
+      input, output, send_counts, recv_counts, stream);
+}
+
