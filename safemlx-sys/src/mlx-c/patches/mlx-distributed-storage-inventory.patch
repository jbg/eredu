+// Immutable fields of the actual implementation, not a whole-communicator
+// fit. Values never include inferred std-library control blocks, OS resources,
+// mutable submission queues or an inherited terminal owner. Named unresolved
+// domains remain explicit until their real producers are qualified.
+enum class GroupStorageKind : unsigned { unknown, empty, ring, mpi, jaccl, nccl };
+enum GroupStorageUnresolved : unsigned {
+  group_shared_control = 1u << 0,
+  group_associative_storage = 1u << 1,
+  group_worker_runtime = 1u << 2,
+  group_submission_storage = 1u << 3,
+  group_backend_private = 1u << 4,
+  group_inherited_owner = 1u << 5,
+  group_unknown_implementation = 1u << 6,
+};
+struct GroupStorageInventory {
+  GroupStorageKind kind{GroupStorageKind::unknown};
+  unsigned unresolved{group_unknown_implementation | group_shared_control |
+                      group_backend_private | group_submission_storage};
+  size_t implementation_bytes{0};
+  size_t socket_handles{0}, socket_capacity_bytes{0}, buffer_bytes{0};
+  size_t pool_workers{0}, pool_worker_capacity_bytes{0};
+  size_t socket_workers{0}, socket_map_buckets{0};
 };
 
