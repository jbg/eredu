+void ensure_gpu_storage(const array& input, array& output, const Stream& stream) {
+  if (input.size() == 0) {
+    output.copy_shared_buffer(input);
+    return;
+  }
+  auto& encoder = cu::get_command_encoder(stream);
+  auto& device = encoder.device();
+  cudaPointerAttributes attributes{};
+  CHECK_CUDA_ERROR(cudaPointerGetAttributes(&attributes, gpu_ptr<void>(input)));
+  const bool local = attributes.type == cudaMemoryTypeDevice &&
+      attributes.device == device.cuda_device();
+  const bool managed = attributes.type == cudaMemoryTypeManaged &&
+      device.concurrent_managed_access();
+  const bool shared = device.coherent_host_memory() &&
+      (attributes.type == cudaMemoryTypeHost ||
+       attributes.type == cudaMemoryTypeUnregistered ||
+       attributes.type == cudaMemoryTypeManaged);
+  if (local || managed || shared) {
+    output.copy_shared_buffer(input);
+    return;
+  }
+  const bool contiguous = input.flags().contiguous && input.data_size() == input.size();
+  auto storage = cu::allocator().malloc_async(
+      output.nbytes(), device.cuda_device(), encoder.stream(), true);
+  if (contiguous) {
+    output.set_data(storage, input.data_size(), input.strides(), input.flags());
+    copy_bytes(input, output, stream);
+  } else {
+    output.set_data(storage);
+    copy_gpu_inplace(input, output, CopyType::General, stream);
+  }
+}
