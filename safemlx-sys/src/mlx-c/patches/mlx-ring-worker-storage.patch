+++ b/mlx/distributed/ring/worker_storage.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <limits>
+#include "mlx/distributed/distributed.h"
+#include "mlx/distributed/ring/socket_tasks.h"
+#include "mlx/distributed/ring/reduction_plan.h"
+#include "mlx/threadpool.h"
+
+namespace mlx::core::distributed::ring {
+// Counts actual worker allocations, not a graph arena grant or total collective
+// fit. The same concrete task/promise/vector producers supply every extent.
+class WorkerStorageCounter {
+ public:
+  template<class Job> bool pool(size_t count) noexcept {
+    threadpool_detail::TaskLayout layout{};
+    return ThreadPool::task_layout<Job>(layout) &&
+        add(value_.pool_jobs, count) && tasks(layout, count);
+  }
+  bool sockets(size_t count) noexcept {
+    SocketTaskLayout layout{};
+    return socket_task_layout(layout) && add(value_.socket_attempts, count) && tasks(layout, count);
+  }
+  template<class T> bool vector(size_t count) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L
+    if (count > static_cast<size_t>(std::numeric_limits<ptrdiff_t>::max()) / sizeof(T)) return false;
+    size_t extent = 0;
+    if (count && !submission::GraphQuota::allocation_extent(count * sizeof(T), alignof(T), extent)) return false;
+    return add(value_.destination_arrays, count != 0) && add(value_.destination_graph_extent, extent) &&
+        add(value_.controls, sizeof(submission::GraphVector<T>) + sizeof(submission::GraphAllocator<T>) + sizeof(size_t) * 3);
+#else
+    return false;
+#endif
+  }
+  bool plan(size_t items, size_t members, size_t item_bytes, size_t packet_bytes) noexcept {
+    ReductionPlanLayout layout{};
+    if (!PreparedReductionPlan::layout(items, members, item_bytes, packet_bytes, layout) ||
+        layout.geometry.steps > std::numeric_limits<size_t>::max() / 2) return false;
+    return vector<ReductionSpan>(layout.geometry.steps) && vector<ReductionSpan>(layout.geometry.steps) &&
+        sockets(2 * layout.geometry.steps) && add(value_.controls, layout.controls);
+  }
+  bool finish(size_t controls, GroupWorkerStorage& out) noexcept {
+    if (!add(value_.controls, controls) ||
+        !add(value_.controls, sizeof(*this) + sizeof(GroupWorkerStorage) + sizeof(size_t) * 5)) return false;
+    out = value_;
+    return true;
+  }
+ private:
+  static bool add(size_t& destination, size_t value) noexcept {
+    if (value > std::numeric_limits<size_t>::max() - destination) return false;
+    destination += value; return true;
+  }
+  static bool scaled(size_t& destination, size_t value, size_t count) noexcept {
+    return (!count || value <= std::numeric_limits<size_t>::max() / count) && add(destination, value * count);
+  }
+  template<class Layout> bool tasks(const Layout& layout, size_t count) noexcept {
+    return scaled(value_.task_graph_extent, layout.node_extent, count) &&
+        scaled(value_.task_graph_extent, layout.promise_extent, count) &&
+        scaled(value_.controls, layout.controls, count);
+  }
+  GroupWorkerStorage value_{};
+};
+} // namespace mlx::core::distributed::ring
