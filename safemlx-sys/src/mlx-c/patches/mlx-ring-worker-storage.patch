--- /dev/null
+++ b/mlx/distributed/ring/worker_geometry.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <algorithm>
+#include <limits>
+#include <utility>
+
+namespace mlx::core::distributed::ring {
+// Exact checked partitions used by both the actual workers and their source
+// query. No communicator, allocator, destination or authority is created here.
+struct WorkerPartitions {
+  size_t items, jobs, step;
+  std::pair<size_t, size_t> range(size_t index) const noexcept {
+    if (index >= jobs || (step && index > items / step)) return {items, items};
+    const auto start = index * step;
+    return {start, start + std::min(step, items - start)};
+  }
+};
+inline bool gather_partitions(size_t bytes, size_t sockets,
+    WorkerPartitions& out) noexcept {
+  if (!sockets) return false;
+  const auto jobs = std::max(std::min(sockets, bytes / 262144), size_t(1));
+  out = {bytes, jobs, bytes / jobs + (bytes % jobs != 0)};
+  return true;
+}
+struct ReductionWorkers { WorkerPartitions parts; bool padded; };
+inline bool reduction_workers(size_t items, size_t item_bytes, size_t members,
+    size_t sockets, ReductionWorkers& out) noexcept {
+  constexpr auto max = std::numeric_limits<size_t>::max();
+  if (!item_bytes || !members || !sockets || items > max / item_bytes) return false;
+  if (items < members) {
+    if (members > 1024 / item_bytes) return false;
+    out = {{members, 1, members}, true};
+    return true;
+  }
+  if (members > max / 262144) return false;
+  const auto jobs = std::max(std::min(sockets,
+      (items * item_bytes) / (members * 262144)), size_t(1));
+  out = {{items, jobs, items / jobs + (items % jobs != 0)}, false};
+  return true;
+}
+struct DirectWorkers { WorkerPartitions parts; size_t reserved_futures; };
+inline bool direct_workers(size_t bytes, size_t sockets, DirectWorkers& out) noexcept {
+  if (!sockets) return false;
+  const auto step = std::max(size_t(1024), bytes / sockets + (bytes % sockets != 0));
+  const auto jobs = bytes / step + (bytes % step != 0);
+  out = {{bytes, jobs, step}, sockets};
+  return true;
+}
+} // namespace mlx::core::distributed::ring
diff --git a/mlx/distributed/ring/worker_storage.h b/mlx/distributed/ring/worker_storage.h
