+enum class RecordCapacity : uint8_t { arena, streams, outputs, captures };
+
 class MLX_API RecordQuotaError final : public std::exception {
  public:
-  explicit RecordQuotaError(QuotaFailure cause) noexcept : cause_(cause) {}
+  explicit RecordQuotaError(
+      QuotaFailure cause, RecordCapacity capacity = RecordCapacity::arena) noexcept
+      : cause_(cause), capacity_(capacity) {}
   const char* what() const noexcept override;
   QuotaFailure cause() const noexcept { return cause_; }
  private:
   QuotaFailure cause_;
+  RecordCapacity capacity_;
