+
+// NVRTC emits device-specific cubins when possible. Module names alone do not
+// identify compatible binaries, even when the MLX version is unchanged.
+std::filesystem::path device_ptx_cache_dir(Device& device) {
+  const auto& root = ptx_cache_dir();
+  if (root.empty()) {
+    return {};
+  }
+  int major, minor, driver;
+  CHECK_NVRTC_ERROR(nvrtcVersion(&major, &minor));
+  CHECK_CUDA_ERROR(cuDriverGetVersion(&driver));
+  auto path = root / "eredu-jit-v1" / version() /
+      fmt::format(
+          "sm_{}{}-nvrtc_{}_{}-driver_{}",
+          device.compute_capability_major(),
+          device.compute_capability_minor(),
+          major,
+          minor,
+          driver);
+  std::error_code error;
+  std::filesystem::create_directories(path, error);
+  return error ? std::filesystem::path{} : path;
 }
 
