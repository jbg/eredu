@@ -0,0 +1,24 @@
+#pragma once
+#include "mlx/distributed/distributed.h"
+#include "mlx/graph_construction.h"
+
+namespace mlx::core::distributed {
+// Host requests of the existing exact native primitive/Eval worker. The copy
+// branch is bounded from immutable input shape, never a guess at lazy flags or
+// donation. Worker requests and logical backing bytes are separate populations.
+struct CpuDistributedStorage : submission::GraphConstructionLayout {
+  GroupWorkerOperation operation{GroupWorkerOperation::sum};
+  int peer{0};
+  size_t input_rank{0}, output_rank{0}, inputs{0};
+  bool tracer{false}, possible_copy{false};
+  size_t backing_births{0}, data_captures{0}, temporary_batches{0};
+  size_t logical_backing_bytes{0}, copy_backing_bytes{0}, output_backing_bytes{0};
+  size_t copy_worker_graph_extent{0}, communication_worker_graph_extent{0};
+  GroupWorkerStorage communication;
+};
+// Recognition is exact native dynamic type. It grants no group/source fit.
+MLX_API bool is_cpu_distributed_primitive(const array&) noexcept;
+// Includes the actual Group source query's fixed frames; no query or allocation.
+MLX_API size_t cpu_distributed_storage_inspection_controls(const array&) noexcept;
+MLX_API bool cpu_distributed_storage(const array&, CpuDistributedStorage&) noexcept;
+} // namespace mlx::core::distributed
