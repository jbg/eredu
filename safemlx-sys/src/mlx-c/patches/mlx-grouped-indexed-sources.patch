diff --git a/mlx/backend/metal/indexing_controls.h b/mlx/backend/metal/indexing_controls.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/indexing_controls.h
@@ -0,0 +1,15 @@
+#pragma once
+#include "mlx/array.h"
+
+namespace mlx::core::metal {
+inline constexpr int maximum_index_arrays = 20;
+// The selected one-index/rank-one worker stays entirely inline. Ordinary wider
+// indexing keeps the same growing range semantics through Graph's allocator.
+struct IndexMetadata {
+  Shape shapes;
+  Strides strides;
+  // Metal bool is one byte; char preserves contiguous storage and .data().
+  // Scalar-index ordinary calls may append one placeholder after all indices.
+  SmallVector<char, maximum_index_arrays + 1> contiguous;
+};
+} // namespace mlx::core::metal
