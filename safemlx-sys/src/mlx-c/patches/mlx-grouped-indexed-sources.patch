diff --git a/mlx/backend/metal/kernels/indexing/single_index.metal b/mlx/backend/metal/kernels/indexing/single_index.metal
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/kernels/indexing/single_index.metal
@@ -0,0 +1,94 @@
+// Copyright © 2023-2025 Apple Inc.
+// Precompiled wrappers of the existing generic rank-one, one-index workers.
+#include "mlx/backend/metal/kernels/utils.h"
+#include "mlx/backend/metal/kernels/atomic.h"
+#include "mlx/backend/metal/kernels/reduction/ops.h"
+#include "mlx/backend/metal/kernels/indexing/gather.h"
+#include "mlx/backend/metal/kernels/indexing/scatter.h"
+
+template <typename T, typename IdxT, typename LocT>
+
+[[kernel]] void single_index_gather(
+    const device T* src [[buffer(0)]],
+    device T* out [[buffer(1)]],
+    const constant int* src_shape [[buffer(2)]],
+    const constant int64_t* src_strides [[buffer(3)]],
+    const constant size_t& src_ndim [[buffer(4)]],
+    const constant int* slice_sizes [[buffer(5)]],
+    const constant int* axes [[buffer(6)]],
+    const constant int* idx_shapes [[buffer(7)]],
+    const constant int64_t* idx_strides [[buffer(8)]],
+    const constant bool* idx_contigs [[buffer(9)]],
+    const constant int& idx_ndim [[buffer(10)]],
+    const device IdxT* idx0 [[buffer(20)]],
+    uint3 index [[thread_position_in_grid]],
+    uint3 grid_dim [[threads_per_grid]]) {
+  Indices<IdxT, 1> idxs{
+    { idx0 }, idx_shapes, idx_strides, idx_contigs, idx_ndim};
+
+  return gather_impl<T, IdxT, 1, 1, LocT>(
+      src,
+      out,
+      src_shape,
+      src_strides,
+      src_ndim,
+      slice_sizes,
+      axes,
+      idxs,
+      index,
+      grid_dim);
+}
+
+template <typename T, typename IdxT, bool Contiguous, typename LocT>
+
+[[kernel]] void single_index_scatter(
+    const device T* updates [[buffer(1)]],
+    device mlx_atomic<T>* out [[buffer(2)]],
+    const constant int* upd_shape [[buffer(3)]],
+    const constant int64_t* upd_strides [[buffer(4)]],
+    const constant size_t& upd_ndim [[buffer(5)]],
+    const constant size_t& upd_size [[buffer(6)]],
+    const constant int* out_shape [[buffer(7)]],
+    const constant int64_t* out_strides [[buffer(8)]],
+    const constant size_t& out_ndim [[buffer(9)]],
+    const constant int* axes [[buffer(10)]],
+    const constant int* idx_shapes [[buffer(11)]],
+    const constant int64_t* idx_strides [[buffer(12)]],
+    const constant bool* idx_contigs [[buffer(13)]],
+    const constant int& idx_ndim [[buffer(14)]],
+    const constant size_t& idx_size [[buffer(15)]],
+    const device IdxT* idx0 [[buffer(20)]],
+    uint2 gid [[thread_position_in_grid]]) {
+  Indices<IdxT, 1> idxs{ { idx0 }, idx_shapes, idx_strides, idx_contigs, idx_ndim};
+
+  return scatter_impl<T, IdxT, None, 1, Contiguous, 1, LocT>(
+      updates,
+      out,
+      upd_shape,
+      upd_strides,
+      upd_ndim,
+      upd_size,
+      out_shape,
+      out_strides,
+      out_ndim,
+      axes,
+      idx_size,
+      idxs,
+      gid);
+}
+
+#define SINGLE_INDEX_WIDTH(tname, type, iname, index, lname, location) \
+  instantiate_kernel("gather" #tname #iname "_1_1_" #lname, single_index_gather, type, index, location) \
+  instantiate_kernel("scatter" #tname #iname "_none_1_updc_true_nwork1_" #lname, single_index_scatter, type, index, true, location) \
+  instantiate_kernel("scatter" #tname #iname "_none_1_updc_false_nwork1_" #lname, single_index_scatter, type, index, false, location)
+#define SINGLE_INDEX_TYPES(tname, type, iname, index) \
+  SINGLE_INDEX_WIDTH(tname, type, iname, index, int, int) \
+  SINGLE_INDEX_WIDTH(tname, type, iname, index, int64_t, int64_t)
+#define SINGLE_INDEX_DATA(tname, type) \
+  SINGLE_INDEX_TYPES(tname, type, int32, int32_t) \
+  SINGLE_INDEX_TYPES(tname, type, uint32, uint32_t)
+SINGLE_INDEX_DATA(float16, half)
+SINGLE_INDEX_DATA(bfloat16, bfloat16_t)
+SINGLE_INDEX_DATA(float32, float)
+SINGLE_INDEX_DATA(int32, int32_t)
+SINGLE_INDEX_DATA(uint32, uint32_t)
