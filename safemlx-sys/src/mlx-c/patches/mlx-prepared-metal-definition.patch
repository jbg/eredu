+    for (const auto& dtype : output_dtypes) {
+      kernel_name += "_";
+      kernel_name += get_type_string(dtype);
+    }
+
+    std::string kernel_source = write_signature(
+        kernel_name,
+        header,
+        source,
+        input_names,
+        inputs,
+        output_names,
+        output_dtypes,
+        template_args,
+        attributes,
+        shape_infos,
+        atomic_outputs);
