+static ArrayVector apply_metal_kernel(
+    std::string_view name, NameListView input_names, NameListView output_names,
+    std::string_view source, std::string_view header,
+    std::span<const ShapeUsage> shape_infos, std::span<const uint8_t> attributes,
+    bool ensure_row_contiguous, bool atomic_outputs, CompileOptions::Data compile_options,
+    const ArrayVector& inputs, std::span<const Shape> output_shapes,
+    std::span<const Dtype> output_dtypes, std::tuple<int, int, int> grid,
+    std::tuple<int, int, int> threadgroup, TemplateArgsView template_args,
+    std::optional<float> init_value, bool verbose, StreamOrDevice s_) {
+    if (inputs.size() != input_names.size()) {
+      std::ostringstream msg;
+      msg << "[metal_kernel] Expected `inputs` to have size "
