+// Equivalent to searching name + suffix, without temporary string allocation.
+bool uses_shape(std::string_view source, std::string_view name,
+                std::string_view suffix) noexcept {
+  size_t offset = 0;
+  while ((offset = source.find(name, offset)) != std::string_view::npos) {
+    const auto tail = offset + name.size();
+    if (source.substr(tail).starts_with(suffix)) return true;
+    if (offset == source.size()) break;
+    ++offset;
+  }
+  return false;
+}
+ShapeUsage shape_usage(std::string_view source, std::string_view name) noexcept {
+  return {uses_shape(source, name, "_shape"),
+          uses_shape(source, name, "_strides"),
+          uses_shape(source, name, "_ndim")};
+}
 
