+class PreparedMetalKernelDefinition {
+ public:
+  std::string_view name, source, header;
+  std::array<std::string_view, definition_inputs> inputs;
+  std::array<std::string_view, definition_outputs> outputs;
+  std::array<ShapeUsage, definition_inputs> shape_infos;
+  std::array<uint8_t, std::size(metal_attributes)> attributes;
+  size_t input_count, output_count, attribute_count;
+  bool contiguous, atomic;
+  CompileOptions::Data options;
+};
+
+size_t metal_kernel_definition_static_bytes() noexcept {
+  return sizeof(metal_attributes);
+}
+MetalKernelDefinitionStatus metal_kernel_definition_layout(
+    const MetalKernelDefinitionPlan& plan, MetalKernelDefinitionLayout& result) noexcept {
+  result = {};
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L
+  if (plan.inputs.size() > definition_inputs || plan.outputs.empty() ||
+      plan.outputs.size() > definition_outputs) return MetalKernelDefinitionStatus::invalid;
+  size_t bytes = sizeof(PreparedMetalKernelDefinition);
+  auto add = [&bytes](std::string_view text) {
+    if (text.size() > std::numeric_limits<size_t>::max() - bytes) return false;
+    bytes += text.size(); return true;
+  };
+  if (!add(plan.name) || !add(plan.source) || !add(plan.header))
+    return MetalKernelDefinitionStatus::overflow;
+  for (auto text : plan.inputs) if (!add(text)) return MetalKernelDefinitionStatus::overflow;
+  for (auto text : plan.outputs) if (!add(text)) return MetalKernelDefinitionStatus::overflow;
+  result = {bytes, alignof(PreparedMetalKernelDefinition),
+      sizeof(MetalKernelDefinitionPlan) + sizeof(MetalKernelDefinitionLayout) * 2 +
+      sizeof(MetalKernelDefinitionStatus) + sizeof(PreparedMetalKernelDefinition*) * 2 +
+      sizeof(std::string_view) * 3 + sizeof(ShapeUsage) + sizeof(size_t) * 5 +
+      sizeof(void*) + sizeof(decltype(add))};
+  return MetalKernelDefinitionStatus::success;
+#else
+  return MetalKernelDefinitionStatus::unknown_layout;
+#endif
+}
+MetalKernelDefinitionStatus prepare_metal_kernel_definition(
+    const MetalKernelDefinitionPlan& plan, PreparedMetalKernelDefinition*& result) noexcept {
+  result = nullptr;
+  MetalKernelDefinitionLayout layout;
+  const auto status = metal_kernel_definition_layout(plan, layout);
+  if (status != MetalKernelDefinitionStatus::success) return status;
+  static_assert(std::is_nothrow_default_constructible_v<PreparedMetalKernelDefinition>);
+  static_assert(alignof(PreparedMetalKernelDefinition) <= __STDCPP_DEFAULT_NEW_ALIGNMENT__);
+  auto* allocation = ::operator new(layout.requested_bytes, std::nothrow);
+  if (!allocation) return MetalKernelDefinitionStatus::allocation_failed;
+  auto* definition = ::new (allocation) PreparedMetalKernelDefinition{};
+  char* tail = reinterpret_cast<char*>(definition + 1);
+  auto copy = [&tail](std::string_view text) {
+    const std::string_view value(tail, text.size());
+    if (!text.empty()) std::memcpy(tail, text.data(), text.size());
+    tail += text.size(); return value;
+  };
+  definition->name = copy(plan.name);
+  definition->source = copy(plan.source);
+  definition->header = copy(plan.header);
+  definition->input_count = plan.inputs.size();
+  definition->output_count = plan.outputs.size();
+  for (size_t i = 0; i < plan.inputs.size(); ++i) {
+    definition->inputs[i] = copy(plan.inputs[i]);
+    definition->shape_infos[i] = shape_usage(definition->source, definition->inputs[i]);
+  }
+  for (size_t i = 0; i < plan.outputs.size(); ++i) definition->outputs[i] = copy(plan.outputs[i]);
+  for (uint8_t id = 0; id < std::size(metal_attributes); ++id) {
+    if (definition->source.find(metal_attributes[id].name) != std::string_view::npos)
+      definition->attributes[definition->attribute_count++] = id;
+  }
+  definition->contiguous = plan.ensure_row_contiguous;
+  definition->atomic = plan.atomic_outputs;
+  definition->options = plan.compile_options;
+  result = definition;
+  return MetalKernelDefinitionStatus::success;
+}
+void free_metal_kernel_definition(PreparedMetalKernelDefinition* definition) noexcept {
+  if (!definition) return;
+  definition->~PreparedMetalKernelDefinition();
+  ::operator delete(definition);
+}
+ArrayVector apply_metal_kernel_definition(
+    const PreparedMetalKernelDefinition& d, const ArrayVector& inputs,
+    std::span<const Shape> shapes, std::span<const Dtype> dtypes,
+    std::tuple<int, int, int> grid, std::tuple<int, int, int> threadgroup,
+    TemplateArgsView templates, StreamOrDevice stream) {
+  return apply_metal_kernel(d.name,
+      std::span<const std::string_view>(d.inputs.data(), d.input_count),
+      std::span<const std::string_view>(d.outputs.data(), d.output_count),
+      d.source, d.header, std::span<const ShapeUsage>(d.shape_infos.data(), d.input_count),
+      std::span<const uint8_t>(d.attributes.data(), d.attribute_count),
+      d.contiguous, d.atomic, d.options, inputs, shapes, dtypes, grid,
+      threadgroup, templates, std::nullopt, false, stream);
 }
 
