 namespace env {
 
+int sdpa_blocks_override() {
+  // Function-local static initialization is thread safe and initializes no
+  // device. Retain invalid input too: later environment edits cannot change
+  // the mechanism used by a previously inspected process.
+  static const int selected = []() {
+    const char* text = std::getenv("MLX_SDPA_BLOCKS");
+    if (!text) {
+      return 0;
+    }
+    errno = 0;
+    char* end = nullptr;
+    long value = std::strtol(text, &end, 10);
+    if (errno == ERANGE || value > INT_MAX || value < INT_MIN) {
+      return -1;
+    }
+    // The final Metal reduction visits groups of 32 blocks; a partial group
+    // silently drops values. Reject incompatible overrides at inspection.
+    if (value > 0 && value % 32 != 0) {
+      return -2;
+    }
+    // Preserve atoi's whitespace/sign/digit-prefix and nonpositive defaults.
+    return value > 0 ? static_cast<int>(value) : 0;
+  }();
+  if (selected == -1) {
+    throw std::invalid_argument("MLX_SDPA_BLOCKS exceeds native int range");
+  }
+  if (selected == -2) {
+    throw std::invalid_argument("MLX_SDPA_BLOCKS must be a positive multiple of 32");
+  }
+  return selected;
+}
