+namespace detail {
+// Each counter issues nonzero generations once and remains exhausted at zero.
+// The production counter has one out-of-line owner, never a header/DSO singleton.
+class AllocationGenerationCounter {
+ public:
+  explicit AllocationGenerationCounter(uint64_t first = 1) : next_(first) {}
+  uint64_t next() noexcept {
+    auto value = next_.load(std::memory_order_relaxed);
+    while (value != 0) {
+      const auto successor = value == UINT64_MAX ? uint64_t{0} : value + 1;
+      if (next_.compare_exchange_weak(
+              value, successor, std::memory_order_relaxed)) {
+        return value;
+      }
+    }
+    return 0;
+  }
+ private:
+  std::atomic<uint64_t> next_;
+};
+} // namespace detail
+
+// Runtime-local generations are never recycled, including after backing frees.
+// Zero means exhausted: allocation remains usable but cannot be certified.
+MLX_API uint64_t next_allocation_generation() noexcept;
 
 // Forward declaration
 class Primitive;
