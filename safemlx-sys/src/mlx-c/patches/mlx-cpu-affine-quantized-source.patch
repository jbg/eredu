+namespace submission {
+GraphFailure GraphConstruction::create_cpu_affine_quantized_eval(
+    const FixedEvalPrologueGuard& guard, GraphConstruction*& out) noexcept {
+  auto& record = guard.record();
+  auto* graph = record.graph_quota();
+  auto context = current_graph_construction_context();
+  if (out || !graph || !guard.cpu() || !context.scope || context.worker ||
+      context.dispatch != &record || current_graph_quota() != graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if (!cpu::affine_quantized_eval_storage(guard.current(), actual))
+    return GraphFailure::invalid_layout;
+  return create_layout(*graph, context.scope, &record, actual, out, true);
+}
