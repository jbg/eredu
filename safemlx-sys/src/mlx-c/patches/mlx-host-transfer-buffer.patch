+size_t host_transfer_page_size() {
+  static const size_t page_size = []() -> size_t {
+#ifdef _WIN32
+    SYSTEM_INFO info;
+    GetSystemInfo(&info);
+    return info.dwPageSize;
+#else
+    const auto value = ::sysconf(_SC_PAGESIZE);
+    return value > 0 ? static_cast<size_t>(value) : 4096;
+#endif
+  }();
+  return page_size;
+}
+
+size_t host_transfer_backing_size(size_t payload_size) {
+  if (payload_size == 0) {
+    return 0;
+  }
+  const auto page_size = host_transfer_page_size();
+  if (payload_size >
+      std::numeric_limits<size_t>::max() - sizeof(size_t) -
+          (page_size - 1)) {
+    throw std::overflow_error(
+        "Host transfer allocation size exceeds the addressable range.");
+  }
+  const auto with_header = payload_size + sizeof(size_t);
+  return page_size * ((with_header + page_size - 1) / page_size);
+}
+
+void* allocate_host_transfer_pages(size_t backing_size) {
+#ifdef _WIN32
+  void* ptr = VirtualAlloc(
+      nullptr, backing_size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+  if (ptr == nullptr) {
+    throw std::bad_alloc();
+  }
+  return ptr;
+#else
+  void* ptr = ::mmap(
+      nullptr,
+      backing_size,
+      PROT_READ | PROT_WRITE,
+      MAP_PRIVATE | MAP_ANONYMOUS,
+      -1,
+      0);
+  if (ptr == MAP_FAILED) {
+    throw std::bad_alloc();
+  }
+  return ptr;
+#endif
+}
+
+void free_host_transfer_pages(void* ptr, size_t backing_size) {
+#ifdef _WIN32
+  static_cast<void>(VirtualFree(ptr, 0, MEM_RELEASE));
+#else
+  static_cast<void>(::munmap(ptr, backing_size));
+#endif
+}
