+Buffer MetalAllocator::malloc_host_transfer(
+    size_t size,
+    allocator::HostTransferPolicy policy) {
+  if (policy == allocator::HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by Metal.");
+  }
+  if (size == 0) {
+    return Buffer{nullptr};
+  }
+  if (size > device_->maxBufferLength()) {
+    std::ostringstream msg;
+    msg << "[metal::malloc_host_transfer] Attempting to allocate " << size
+        << " bytes which is greater than the maximum allowed buffer size of "
+        << device_->maxBufferLength() << " bytes.";
+    throw std::runtime_error(msg.str());
+  }
+  if (size != 0) {
+    if (size > std::numeric_limits<size_t>::max() - (vm_page_size - 1)) {
+      throw std::overflow_error(
+          "Host transfer allocation size exceeds the addressable range.");
+    }
+    size = vm_page_size * ((size + vm_page_size - 1) / vm_page_size);
+  }
+  if (size > device_->maxBufferLength()) {
+    std::ostringstream msg;
+    msg << "[metal::malloc_host_transfer] Rounded allocation of " << size
+        << " bytes exceeds the maximum allowed buffer size of "
+        << device_->maxBufferLength() << " bytes.";
+    throw std::runtime_error(msg.str());
+  }
+
+  std::unique_lock lk(mutex_);
+  const size_t mem_required = get_active_memory() + get_cache_memory() + size;
+  if (mem_required >= gc_limit_ || num_resources_ >= resource_limit_) {
+    const size_t reclaim =
+        mem_required > gc_limit_ ? mem_required - gc_limit_ : 0;
+    num_resources_ -= buffer_cache_.release_cached_buffers(reclaim);
+  }
+  if (num_resources_ >= resource_limit_) {
+    std::ostringstream msg;
+    msg << "[metal::malloc_host_transfer] Resource limit ("
+        << resource_limit_ << ") exceeded.";
+    throw std::runtime_error(msg.str());
+  }
+  lk.unlock();
+  auto* buf = device_->newBuffer(size, resource_options);
+  if (!buf) {
+    std::ostringstream msg;
+    msg << "[metal::malloc_host_transfer] Unable to allocate " << size
+        << " bytes.";
+    throw std::runtime_error(msg.str());
+  }
+  lk.lock();
+  num_resources_++;
+  residency_set_.insert(buf);
+  active_memory_ += buf->length();
+  peak_memory_ = std::max(peak_memory_, active_memory_);
+  return Buffer{static_cast<void*>(buf)};
+}
+
+void MetalAllocator::free_host_transfer(
+    Buffer buffer,
+    allocator::HostTransferPolicy policy) {
+  if (policy == allocator::HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by Metal.");
+  }
+  release(buffer);
+}
+
+size_t MetalAllocator::host_transfer_capacity_upper_bound(
+    size_t size,
+    allocator::HostTransferPolicy policy) const {
+  if (policy == allocator::HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by Metal.");
+  }
+  if (size != 0) {
+    if (size > std::numeric_limits<size_t>::max() - (vm_page_size - 1)) {
+      return std::numeric_limits<size_t>::max();
+    }
+    size = vm_page_size * ((size + vm_page_size - 1) / vm_page_size);
+  }
+  return size;
+}
