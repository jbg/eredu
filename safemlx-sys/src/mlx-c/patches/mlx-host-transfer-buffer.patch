diff --git a/mlx/host_transfer.cpp b/mlx/host_transfer.cpp
new file mode 100644
index 000000000..7c9e8e03b
--- /dev/null
+++ b/mlx/host_transfer.cpp
@@ -0,0 +1,261 @@
+// Copyright © 2026 Apple Inc.
+
+#include "mlx/host_transfer.h"
+
+#include <array>
+#include <atomic>
+#include <limits>
+#include <stdexcept>
+
+#include "mlx/primitives.h"
+#include "mlx/ops.h"
+#include "mlx/transforms.h"
+
+namespace mlx::core {
+namespace {
+
+struct HostTransferCounters {
+  std::atomic<size_t> active_bytes{0};
+  std::atomic<size_t> peak_bytes{0};
+  std::atomic<size_t> active_allocations{0};
+  std::atomic<size_t> peak_allocations{0};
+};
+
+std::array<HostTransferCounters, 4> host_transfer_counters;
+
+size_t storage_kind_index(HostTransferStorageKind kind) {
+  switch (kind) {
+    case HostTransferStorageKind::cpu:
+      return 0;
+    case HostTransferStorageKind::metal_shared:
+      return 1;
+    case HostTransferStorageKind::cuda_pinned:
+      return 2;
+    case HostTransferStorageKind::cuda_managed:
+      return 3;
+  }
+  throw std::invalid_argument("Unknown HostTransferStorageKind value.");
+}
+
+void update_peak(std::atomic<size_t>& peak, size_t value) {
+  auto observed = peak.load(std::memory_order_relaxed);
+  while (observed < value &&
+         !peak.compare_exchange_weak(
+             observed,
+             value,
+             std::memory_order_relaxed,
+             std::memory_order_relaxed)) {}
+}
+
+void record_host_transfer_allocation(
+    HostTransferStorageKind kind,
+    size_t capacity) {
+  auto& counters = host_transfer_counters[storage_kind_index(kind)];
+  const auto bytes =
+      counters.active_bytes.fetch_add(capacity, std::memory_order_relaxed) +
+      capacity;
+  const auto allocations =
+      counters.active_allocations.fetch_add(1, std::memory_order_relaxed) + 1;
+  update_peak(counters.peak_bytes, bytes);
+  update_peak(counters.peak_allocations, allocations);
+}
+
+void record_host_transfer_free(
+    HostTransferStorageKind kind,
+    size_t capacity) {
+  auto& counters = host_transfer_counters[storage_kind_index(kind)];
+  counters.active_bytes.fetch_sub(capacity, std::memory_order_relaxed);
+  counters.active_allocations.fetch_sub(1, std::memory_order_relaxed);
+}
+
+} // namespace
+
+class HostTransferStorage {
+ public:
+  HostTransferStorage(size_t size, HostTransferPolicy policy)
+      : buffer_(allocator::allocator().malloc_host_transfer(size, policy)),
+        policy_(policy),
+        storage_kind_(
+            allocator::allocator().host_transfer_storage_kind(policy)),
+        capacity_(allocator::allocator().host_transfer_allocation_bytes(
+            buffer_, policy_)) {
+    record_host_transfer_allocation(storage_kind_, capacity_);
+  }
+
+  ~HostTransferStorage() {
+    allocator::allocator().free_host_transfer(buffer_, policy_);
+    record_host_transfer_free(storage_kind_, capacity_);
+  }
+
+  HostTransferStorage(const HostTransferStorage&) = delete;
+  HostTransferStorage& operator=(const HostTransferStorage&) = delete;
+
+  allocator::Buffer buffer() const {
+    return buffer_;
+  }
+  size_t capacity() const {
+    return capacity_;
+  }
+  HostTransferPolicy policy() const {
+    return policy_;
+  }
+  HostTransferStorageKind storage_kind() const {
+    return storage_kind_;
+  }
+
+ private:
+  allocator::Buffer buffer_;
+  HostTransferPolicy policy_;
+  HostTransferStorageKind storage_kind_;
+  size_t capacity_;
+};
+
+HostTransferMemoryStats host_transfer_memory_stats(
+    HostTransferStorageKind kind) {
+  auto& counters = host_transfer_counters[storage_kind_index(kind)];
+  return {
+      counters.active_bytes.load(std::memory_order_relaxed),
+      counters.peak_bytes.load(std::memory_order_relaxed),
+      counters.active_allocations.load(std::memory_order_relaxed),
+      counters.peak_allocations.load(std::memory_order_relaxed)};
+}
+
+void reset_host_transfer_peak_memory(HostTransferStorageKind kind) {
+  auto& counters = host_transfer_counters[storage_kind_index(kind)];
+  counters.peak_bytes.store(0, std::memory_order_relaxed);
+  counters.peak_allocations.store(0, std::memory_order_relaxed);
+  update_peak(
+      counters.peak_bytes,
+      counters.active_bytes.load(std::memory_order_relaxed));
+  update_peak(
+      counters.peak_allocations,
+      counters.active_allocations.load(std::memory_order_relaxed));
+}
+
+size_t host_transfer_capacity_upper_bound(
+    size_t nbytes,
+    HostTransferPolicy policy) {
+  return allocator::allocator().host_transfer_capacity_upper_bound(
+      nbytes, policy);
+}
+
+HostTransferBuffer::HostTransferBuffer(
+    Shape shape,
+    Dtype dtype,
+    HostTransferPolicy policy)
+    : shape_(std::move(shape)), dtype_(dtype) {
+  size_t elements = 1;
+  for (auto dimension : shape_) {
+    if (dimension < 0) {
+      throw std::invalid_argument(
+          "[HostTransferBuffer] Negative dimensions are not allowed.");
+    }
+    if (dimension != 0 &&
+        elements > std::numeric_limits<size_t>::max() /
+            static_cast<size_t>(dimension)) {
+      throw std::overflow_error("[HostTransferBuffer] Shape is too large.");
+    }
+    elements *= static_cast<size_t>(dimension);
+  }
+  if (elements > std::numeric_limits<size_t>::max() / size_of(dtype_)) {
+    throw std::overflow_error("[HostTransferBuffer] Byte size overflow.");
+  }
+  storage_ = std::make_shared<HostTransferStorage>(
+      elements * size_of(dtype_), policy);
+}
+
+void* HostTransferBuffer::data() {
+  if (!storage_) {
+    throw std::runtime_error("[HostTransferBuffer::data] Empty buffer.");
+  }
+  return storage_->buffer().raw_ptr();
+}
+
+const void* HostTransferBuffer::data() const {
+  return const_cast<HostTransferBuffer*>(this)->data();
+}
+
+const Shape& HostTransferBuffer::shape() const {
+  return shape_;
+}
+
+Dtype HostTransferBuffer::dtype() const {
+  return dtype_;
+}
+
+size_t HostTransferBuffer::size() const {
+  size_t count = 1;
+  for (auto dimension : shape_) {
+    count *= dimension;
+  }
+  return count;
+}
+
+size_t HostTransferBuffer::nbytes() const {
+  return size() * size_of(dtype_);
+}
+
+size_t HostTransferBuffer::capacity() const {
+  return storage_ ? storage_->capacity() : 0;
+}
+
+HostTransferPolicy HostTransferBuffer::policy() const {
+  if (!storage_) {
+    throw std::runtime_error("[HostTransferBuffer::policy] Empty buffer.");
+  }
+  return storage_->policy();
+}
+
+HostTransferStorageKind HostTransferBuffer::storage_kind() const {
+  if (!storage_) {
+    throw std::runtime_error(
+        "[HostTransferBuffer::storage_kind] Empty buffer.");
+  }
+  return storage_->storage_kind();
+}
+
+void HostTransferBuffer::attach(array& destination) const {
+  if (!storage_) {
+    throw std::runtime_error("[HostTransferBuffer::attach] Empty buffer.");
+  }
+  auto owner = storage_;
+  destination.set_data(
+      storage_->buffer(),
+      [owner = std::move(owner)](allocator::Buffer) mutable { owner.reset(); });
+}
+
+HostTransfer copy_to_host(
+    array source,
+    HostTransferPolicy policy,
+    StreamOrDevice stream) {
+  HostTransferBuffer buffer(source.shape(), source.dtype(), policy);
+  auto output = array(
+      source.shape(),
+      source.dtype(),
+      std::make_shared<CopyToHostTransfer>(to_stream(stream), buffer),
+      {contiguous(source, false, stream)});
+  auto completion = async_eval_with_completion({output});
+  return {std::move(buffer), std::move(completion)};
+}
+
+DeviceTransfer copy_from_host(
+    const HostTransferBuffer& source,
+    StreamOrDevice stream) {
+  if (!source) {
+    throw std::invalid_argument("[copy_from_host] Empty source buffer.");
+  }
+  auto input = array(
+      source.storage_->buffer(),
+      source.shape(),
+      source.dtype(),
+      [owner = source.storage_](allocator::Buffer) mutable { owner.reset(); });
+  auto output = array(
+      source.shape(),
+      source.dtype(),
+      std::make_shared<CopyFromHostTransfer>(to_stream(stream)),
+      {std::move(input)});
+  auto completion = async_eval_with_completion({output});
+  return {std::move(output), std::move(completion)};
+}
+
+} // namespace mlx::core
