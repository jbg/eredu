+Buffer CommonAllocator::malloc_host_transfer(
+    size_t size,
+    HostTransferPolicy policy) {
+  if (policy == HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by this backend.");
+  }
+  const auto backing_size = host_transfer_backing_size(size);
+  if (backing_size == 0) {
+    return Buffer{nullptr};
+  }
+  void* ptr = allocate_host_transfer_pages(backing_size);
+  *static_cast<size_t*>(ptr) = backing_size - sizeof(size_t);
+  std::unique_lock lk(mutex_);
+  active_memory_ += backing_size;
+  peak_memory_ = std::max(active_memory_, peak_memory_);
+  return Buffer{ptr};
+}
+
+void CommonAllocator::free_host_transfer(
+    Buffer buffer,
+    HostTransferPolicy policy) {
+  if (policy == HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by this backend.");
+  }
+  if (buffer.ptr() == nullptr) {
+    return;
+  }
+  const auto bytes = host_transfer_allocation_bytes(buffer, policy);
+  {
+    std::unique_lock lk(mutex_);
+    active_memory_ -= bytes;
+  }
+  free_host_transfer_pages(buffer.ptr(), bytes);
+}
+
+size_t CommonAllocator::host_transfer_allocation_bytes(
+    Buffer buffer,
+    HostTransferPolicy policy) const {
+  if (policy == HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by this backend.");
+  }
+  if (buffer.ptr() == nullptr) {
+    return 0;
+  }
+  return size(buffer) + sizeof(size_t);
+}
+
+size_t CommonAllocator::host_transfer_capacity_upper_bound(
+    size_t size,
+    HostTransferPolicy policy) const {
+  if (policy == HostTransferPolicy::managed) {
+    throw std::invalid_argument(
+        "Managed host transfer storage is not supported by this backend.");
+  }
+  return host_transfer_backing_size(size);
+}
