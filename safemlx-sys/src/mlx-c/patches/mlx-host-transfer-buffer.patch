@@ -0,0 +1,111 @@
+// Copyright © 2026 Apple Inc.
+#pragma once
+
+#include <memory>
+
+#include "mlx/allocator.h"
+#include "mlx/array.h"
+#include "mlx/completion.h"
+#include "mlx/dtype.h"
+#include "mlx/stream.h"
+#include "mlx/utils.h"
+
+namespace mlx::core {
+
+using HostTransferPolicy = allocator::HostTransferPolicy;
+using HostTransferStorageKind = allocator::HostTransferStorageKind;
+
+class HostTransferStorage;
+struct DeviceTransfer;
+
+struct MLX_API HostTransferMemoryStats {
+  size_t active_bytes;
+  size_t peak_bytes;
+  size_t active_allocations;
+  size_t peak_allocations;
+};
+
+/** Process-wide charged backing storage owned by buffers of one kind. */
+MLX_API HostTransferMemoryStats host_transfer_memory_stats(
+    HostTransferStorageKind kind);
+
+/** Reset one storage kind's high-water marks to its current occupancy. */
+MLX_API void reset_host_transfer_peak_memory(HostTransferStorageKind kind);
+
+/** Charged backing extent to reserve before allocating a logical payload. */
+MLX_API size_t host_transfer_capacity_upper_bound(
+    size_t nbytes,
+    HostTransferPolicy policy = HostTransferPolicy::transfer);
+
+/**
+ * Owned, host-addressable storage prepared for asynchronous backend transfers.
+ *
+ * The selected storage is backend-specific but its semantics are not:
+ * `transfer` selects CPU memory on CPU-only builds, shared Metal storage on
+ * Metal, and page-locked host storage on CUDA. `managed` is a separately named
+ * CUDA policy and is rejected by backends which cannot provide it.
+ *
+ * Copies share the allocation. The allocation remains alive while a submitted
+ * transfer or any copy of this object retains it.
+ */
+class MLX_API HostTransferBuffer {
+ public:
+  HostTransferBuffer() = default;
+  HostTransferBuffer(
+      Shape shape,
+      Dtype dtype,
+      HostTransferPolicy policy = HostTransferPolicy::transfer);
+
+  /** Host pointer. Do not access it until the producing completion finishes. */
+  void* data();
+  const void* data() const;
+
+  const Shape& shape() const;
+  Dtype dtype() const;
+  size_t size() const;
+  size_t nbytes() const;
+  /** Complete charged backing-allocation extent. */
+  size_t capacity() const;
+  HostTransferPolicy policy() const;
+  HostTransferStorageKind storage_kind() const;
+
+  explicit operator bool() const {
+    return storage_ != nullptr;
+  }
+
+ private:
+  void attach(array& destination) const;
+
+  std::shared_ptr<HostTransferStorage> storage_;
+  Shape shape_;
+  Dtype dtype_{float32};
+
+  friend class CopyToHostTransfer;
+  friend class CopyFromHostTransfer;
+  friend MLX_API DeviceTransfer copy_from_host(
+      const HostTransferBuffer& source,
+      StreamOrDevice stream);
+};
+
+struct MLX_API HostTransfer {
+  HostTransferBuffer buffer;
+  Completion completion;
+};
+
+struct MLX_API DeviceTransfer {
+  array value;
+  Completion completion;
+};
+
+/** Allocate a transfer buffer and asynchronously copy `source` into it. */
+MLX_API HostTransfer copy_to_host(
+    array source,
+    HostTransferPolicy policy = HostTransferPolicy::transfer,
+    StreamOrDevice stream = {});
+
+/** Asynchronously copy a host transfer buffer into a new MLX array. */
+MLX_API DeviceTransfer copy_from_host(
+    const HostTransferBuffer& source,
+    StreamOrDevice stream = {});
+
+} // namespace mlx::core
