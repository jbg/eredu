+namespace mlx::core {
+
+namespace {
+
+void copy_bytes(const array& input, array& output, const Stream& stream) {
+  auto& encoder = cu::get_command_encoder(stream);
+  encoder.set_input_array(input);
+  encoder.set_output_array(output);
+  encoder.add_memcpy_node(
+      gpu_ptr<void>(output),
+      gpu_ptr<void>(input),
+      input.nbytes(),
+      cudaMemcpyDefault);
+}
+
+} // namespace
+
+void copy_gpu_to_host(const array& input, array& output, const Stream& stream) {
+  copy_bytes(input, output, stream);
+}
+
+void copy_host_to_gpu(const array& input, array& output, const Stream& stream) {
+  auto& encoder = cu::get_command_encoder(stream);
+  output.set_data(cu::malloc_async(output.nbytes(), encoder));
+  copy_bytes(input, output, stream);
+}
+
+} // namespace mlx::core
