new file mode 100644
index 000000000..619112f0b
--- /dev/null
+++ b/tests/host_transfer_tests.cpp
@@ -0,0 +1,84 @@
+// Copyright © 2026 Apple Inc.
+
+#include "doctest/doctest.h"
+
+#include "mlx/host_transfer.h"
+#include "mlx/mlx.h"
+
+using namespace mlx::core;
+
+TEST_CASE("test CPU host transfer round trip") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto source = array({1.0f, 2.0f, 3.0f, 4.0f}, Shape{2, 2});
+
+  auto to_host = copy_to_host(source, HostTransferPolicy::transfer, stream);
+  CHECK(to_host.buffer.shape() == Shape{2, 2});
+  CHECK(to_host.buffer.dtype() == float32);
+  CHECK(to_host.buffer.size() == 4);
+  CHECK(to_host.buffer.nbytes() == 4 * sizeof(float));
+  CHECK(to_host.buffer.capacity() >= to_host.buffer.nbytes());
+  CHECK(to_host.buffer.policy() == HostTransferPolicy::transfer);
+  auto kind = to_host.buffer.storage_kind();
+  const bool is_transfer_storage =
+      kind == HostTransferStorageKind::cpu ||
+      kind == HostTransferStorageKind::metal_shared ||
+      kind == HostTransferStorageKind::cuda_pinned;
+  CHECK(is_transfer_storage);
+
+  to_host.completion.wait();
+  auto* values = static_cast<const float*>(to_host.buffer.data());
+  CHECK(values[0] == 1.0f);
+  CHECK(values[3] == 4.0f);
+
+  auto to_device = copy_from_host(to_host.buffer, stream);
+  to_device.completion.wait();
+  CHECK(to_device.value.shape() == Shape{2, 2});
+  auto* round_trip = to_device.value.data<float>();
+  CHECK(round_trip[0] == 1.0f);
+  CHECK(round_trip[1] == 2.0f);
+  CHECK(round_trip[2] == 3.0f);
+  CHECK(round_trip[3] == 4.0f);
+}
+
+TEST_CASE("test CPU host transfer policy and shape validation") {
+  try {
+    auto managed =
+        HostTransferBuffer(Shape{4}, float32, HostTransferPolicy::managed);
+    CHECK(managed.storage_kind() == HostTransferStorageKind::cuda_managed);
+  } catch (const std::invalid_argument& error) {
+    CHECK(
+        std::string(error.what()) ==
+        "Managed host transfer storage is not supported by this backend.");
+  }
+  CHECK_THROWS_WITH_AS(
+      HostTransferBuffer(Shape{-1}, float32),
+      "[HostTransferBuffer] Negative dimensions are not allowed.",
+      std::invalid_argument);
+}
+
+TEST_CASE("test host transfer physical telemetry and capacity bound") {
+  const auto kind = HostTransferBuffer(
+      Shape{1}, float32, HostTransferPolicy::transfer).storage_kind();
+  reset_host_transfer_peak_memory(kind);
+  const auto baseline = host_transfer_memory_stats(kind);
+  size_t capacity = 0;
+  {
+    HostTransferBuffer buffer(
+        Shape{1025}, float32, HostTransferPolicy::transfer);
+    capacity = buffer.capacity();
+    CHECK(capacity > buffer.nbytes());
+    CHECK(
+        host_transfer_capacity_upper_bound(
+            buffer.nbytes(), HostTransferPolicy::transfer) == capacity);
+    const auto live = host_transfer_memory_stats(kind);
+    CHECK(live.active_bytes == baseline.active_bytes + capacity);
+    CHECK(live.active_allocations == baseline.active_allocations + 1);
+    CHECK(live.peak_bytes >= live.active_bytes);
+    CHECK(live.peak_allocations >= live.active_allocations);
+  }
+  const auto released = host_transfer_memory_stats(kind);
+  CHECK(released.active_bytes == baseline.active_bytes);
+  CHECK(released.active_allocations == baseline.active_allocations);
+  CHECK(released.peak_bytes >= baseline.active_bytes + capacity);
+  CHECK(released.peak_allocations >= baseline.active_allocations + 1);
+}
