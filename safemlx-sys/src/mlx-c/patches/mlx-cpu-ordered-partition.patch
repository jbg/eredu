+bool cpu_argpartition_source_layout(size_t rank, size_t elements, bool tracer,
+    CpuArgPartitionLayout& output) noexcept {
+  if(rank<1||rank>3||!elements||elements>size_t(INT_MAX)||
+      Shape::inline_capacity<3||Strides::inline_capacity<3)return false;
+  CpuArgPartitionLayout value;
+  if(!cpu_argpartition_layout(tracer,value))return false;
+  // The base query also pays this shared source-validation frame so existing
+  // rank-two router callers retain the exact enlarged consumer census.
+  output=value;return true;
+}
+bool cpu_argpartition_source_storage(const array& output,CpuArgPartitionLayout& result) noexcept {
+  if(!output.has_primitive()||typeid(output.primitive())!=typeid(ArgPartition)||
+      output.primitive().stream().device!=Device::cpu||output.inputs().size()!=1||
+      !output.siblings().empty()||output.dtype()!=uint32||output.itemsize()!=4)return false;
+  const auto& input=output.inputs()[0];const size_t rank=input.ndim();
+  const auto* primitive=static_cast<const ArgPartition*>(&output.primitive());
+  const auto state=primitive->state();
+  if(rank<1||rank>3||output.ndim()!=rank||(rank!=2&&input.dtype()!=float32)||input.itemsize()<=0||
+      input.strides().size()!=rank||state.second!=int(rank)-1)return false;
+  size_t elements=1,span=1;
+  for(size_t i=0;i!=rank;++i) {
+    const auto extent=input.shape(i);const auto stride=input.strides()[i];
+    if(extent<=0||output.shape(i)!=extent||stride<0||size_t(extent)>size_t(INT_MAX)/elements)return false;
+    elements*=size_t(extent);
+    if(extent>1&&size_t(stride)>(size_t(PTRDIFF_MAX)-span)/size_t(extent-1))return false;
+    span+=size_t(stride)*size_t(extent-1);
+  }
+  const int columns=input.shape(rank-1);const int kth=state.first<0?state.first+columns:state.first;
+  if(kth<0||kth>=columns||elements!=input.size()||elements!=output.size()||
+      span>input.data_size()||span>size_t(PTRDIFF_MAX)/size_t(input.itemsize()))return false;
+  return cpu_argpartition_source_layout(rank,elements,output.is_tracer(),result);
+}
