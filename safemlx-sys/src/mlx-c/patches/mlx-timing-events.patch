diff --git a/mlx/backend/metal/timing.h b/mlx/backend/metal/timing.h
new file mode 100644
index 0000000..8b60013
--- /dev/null
+++ b/mlx/backend/metal/timing.h
@@ -0,0 +1,62 @@
+// Copyright © 2026 Apple Inc.
+#pragma once
+
+#include <condition_variable>
+#include <mutex>
+#include <optional>
+
+#include <Metal/Metal.hpp>
+
+namespace mlx::core::metal {
+
+struct TimerState {
+  void submitted() {
+    std::lock_guard lock(mutex);
+    pending++;
+  }
+
+  void stop_submitting() {
+    std::lock_guard lock(mutex);
+    stopped = true;
+    if (pending == 0) {
+      ready.notify_all();
+    }
+  }
+
+  void record(MTL::CommandBuffer* command_buffer) {
+    auto start = command_buffer->GPUStartTime();
+    auto stop = command_buffer->GPUEndTime();
+    {
+      std::lock_guard lock(mutex);
+      if (stop >= start) {
+        elapsed_seconds += stop - start;
+      }
+      pending--;
+      if (stopped && pending == 0) {
+        ready.notify_all();
+      }
+    }
+  }
+
+  double elapsed() const {
+    std::unique_lock lock(mutex);
+    ready.wait(lock, [this] { return stopped && pending == 0; });
+    return elapsed_seconds;
+  }
+
+  std::optional<double> try_elapsed() const {
+    std::lock_guard lock(mutex);
+    if (!stopped || pending != 0) {
+      return std::nullopt;
+    }
+    return elapsed_seconds;
+  }
+
+  mutable std::mutex mutex;
+  mutable std::condition_variable ready;
+  size_t pending{0};
+  bool stopped{false};
+  double elapsed_seconds{0.0};
+};
+
+} // namespace mlx::core::metal
