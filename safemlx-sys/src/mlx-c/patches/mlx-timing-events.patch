+
+#include "mlx/api.h"
+#include "mlx/stream.h"
+
+namespace mlx::core {
+
+/**
+ * A pair of timestamp markers recorded on one execution stream.
+ *
+ * Markers are encoded in stream order and never wait for device work on the
+ * calling thread. The elapsed value is defined only after stop() has executed.
+ */
+class MLX_API DeviceTimer {
+ public:
+  explicit DeviceTimer(Stream stream);
+
+  DeviceTimer(const DeviceTimer&) = delete;
+  DeviceTimer& operator=(const DeviceTimer&) = delete;
+  DeviceTimer(DeviceTimer&&) noexcept = default;
+  DeviceTimer& operator=(DeviceTimer&&) noexcept = default;
+  ~DeviceTimer() = default;
+
+  void start();
+  void stop();
+  double elapsed_seconds() const;
+  std::optional<double> try_elapsed_seconds() const;
+
+  const Stream& stream() const {
+    return stream_;
+  }
+
+ private:
+  Stream stream_;
+  std::shared_ptr<void> state_;
+};
+
+} // namespace mlx::core
