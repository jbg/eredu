+/**
+ * Asynchronously evaluate `outputs` between timestamp markers on `stream`.
+ *
+ * The selected output stream must exactly match `stream`. Work on dependency
+ * streams is allowed; waits encoded on `stream` are part of its measured
+ * execution-timeline interval. Empty and already available output sets return
+ * an immediately ready zero-duration completion.
+ */
+MLX_API Completion async_eval_with_timing(
+    std::vector<array> outputs,
+    Stream stream);
+
 template <typename... Arrays, typename = enable_for_arrays_t<Arrays...>>
 void async_eval(Arrays&&... outputs) {
   async_eval(std::vector<array>{std::forward<Arrays>(outputs)...});
