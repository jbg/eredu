+++ b/mlx/timing.cpp
@@ -0,0 +1,82 @@
+// Copyright © 2026 Apple Inc.
+
+#include <chrono>
+#include <mutex>
+#include <stdexcept>
+
+#include "mlx/backend/gpu/timing.h"
+#include "mlx/scheduler.h"
+#include "mlx/timing.h"
+
+namespace mlx::core {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+struct CpuTimerState {
+  std::mutex mutex;
+  std::optional<Clock::time_point> start;
+  std::optional<Clock::time_point> stop;
+};
+
+} // namespace
+
+DeviceTimer::DeviceTimer(Stream stream) : stream_(stream) {
+  if (stream.device == Device::cpu) {
+    state_ = std::make_shared<CpuTimerState>();
+  } else {
+    state_ = gpu::new_timer(stream);
+  }
+}
+
+void DeviceTimer::start() {
+  if (stream_.device == Device::cpu) {
+    auto state = std::static_pointer_cast<CpuTimerState>(state_);
+    scheduler::enqueue(stream_, [state = std::move(state)]() {
+      std::lock_guard lock(state->mutex);
+      state->start = Clock::now();
+    });
+  } else {
+    gpu::record_timer_start(state_, stream_);
+  }
+}
+
+void DeviceTimer::stop() {
+  if (stream_.device == Device::cpu) {
+    auto state = std::static_pointer_cast<CpuTimerState>(state_);
+    scheduler::enqueue(stream_, [state = std::move(state)]() {
+      std::lock_guard lock(state->mutex);
+      state->stop = Clock::now();
+    });
+  } else {
+    gpu::record_timer_stop(state_, stream_);
+  }
+}
+
+double DeviceTimer::elapsed_seconds() const {
+  if (stream_.device != Device::cpu) {
+    return gpu::timer_elapsed_seconds(state_);
+  }
+  auto state = std::static_pointer_cast<CpuTimerState>(state_);
+  std::lock_guard lock(state->mutex);
+  if (!state->start || !state->stop) {
+    throw std::runtime_error(
+        "[DeviceTimer::elapsed_seconds] Timestamp markers are incomplete.");
+  }
+  return std::chrono::duration<double>(*state->stop - *state->start).count();
+}
+
+std::optional<double> DeviceTimer::try_elapsed_seconds() const {
+  if (stream_.device != Device::cpu) {
+    return gpu::timer_try_elapsed_seconds(state_);
+  }
+  auto state = std::static_pointer_cast<CpuTimerState>(state_);
+  std::lock_guard lock(state->mutex);
+  if (!state->start || !state->stop) {
+    return std::nullopt;
+  }
+  return std::chrono::duration<double>(*state->stop - *state->start).count();
+}
+
+} // namespace mlx::core
