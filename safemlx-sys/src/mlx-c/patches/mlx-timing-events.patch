@@ -0,0 +1,55 @@
+// Copyright © 2026 Apple Inc.
+
+#include "mlx/backend/cuda/device.h"
+#include "mlx/backend/cuda/event.h"
+#include "mlx/backend/gpu/timing.h"
+
+namespace mlx::core::gpu {
+
+namespace {
+
+struct CudaTimerState {
+  explicit CudaTimerState(cu::Device& device)
+      : start(device, cudaEventDefault), stop(device, cudaEventDefault) {}
+
+  cu::CudaEvent start;
+  cu::CudaEvent stop;
+};
+
+} // namespace
+
+std::shared_ptr<void> new_timer(Stream stream) {
+  return std::make_shared<CudaTimerState>(cu::device(stream.device));
+}
+
+void record_timer_start(const std::shared_ptr<void>& state, Stream stream) {
+  auto timer = std::static_pointer_cast<CudaTimerState>(state);
+  auto& encoder = cu::get_command_encoder(stream);
+  // Flush any graph nodes encoded before the marker. Recording is asynchronous
+  // and remains ordered after those nodes on the same native CUDA stream.
+  encoder.commit();
+  timer->start.record(encoder.stream());
+  encoder.add_completed_handler([timer = std::move(timer)]() {});
+  encoder.commit();
+}
+
+void record_timer_stop(const std::shared_ptr<void>& state, Stream stream) {
+  auto timer = std::static_pointer_cast<CudaTimerState>(state);
+  auto& encoder = cu::get_command_encoder(stream);
+  encoder.commit();
+  timer->stop.record(encoder.stream());
+  encoder.add_completed_handler([timer = std::move(timer)]() {});
+  encoder.commit();
+}
+
+double timer_elapsed_seconds(const std::shared_ptr<void>& state) {
+  auto timer = std::static_pointer_cast<CudaTimerState>(state);
+  return timer->start.elapsed_seconds(timer->stop);
+}
+
+std::optional<double> timer_try_elapsed_seconds(
+    const std::shared_ptr<void>& state) {
+  return timer_elapsed_seconds(state);
+}
+
+} // namespace mlx::core::gpu
