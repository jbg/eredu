+TEST_CASE("test timed completion retains asynchronous CPU failures") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  scheduler::enqueue(stream, []() {
+    throw std::runtime_error("timed asynchronous producer failure");
+  });
+
+  auto output = add(array(1.0f), array(2.0f), stream);
+  auto completion = async_eval_with_timing({output}, stream);
+  CHECK_THROWS_WITH_AS(
+      completion.elapsed_seconds(),
+      "timed asynchronous producer failure",
+      std::runtime_error);
+  CHECK_THROWS_WITH_AS(
+      completion.elapsed_seconds(),
+      "timed asynchronous producer failure",
+      std::runtime_error);
+  CHECK_THROWS_WITH_AS(
+      completion.try_elapsed_seconds(),
+      "timed asynchronous producer failure",
+      std::runtime_error);
+}
