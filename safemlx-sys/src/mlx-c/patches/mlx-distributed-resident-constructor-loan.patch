+// A source-bound distributed constructor is lexical within the current resident
+// model equation. Its C caller destroys the separate bank before this guard.
+// No general suspend method is exposed and the original parent keeps all slots.
+class GraphNestedConstruction final {
+ public:
+  GraphNestedConstruction() noexcept = default;
+  GraphNestedConstruction(const GraphNestedConstruction&) = delete;
+  GraphNestedConstruction& operator=(const GraphNestedConstruction&) = delete;
+  ~GraphNestedConstruction() { if (owner_) owner_->resume_nested(); }
+ private:
+  friend class GraphConstruction;
+  GraphConstruction* owner_{nullptr};
