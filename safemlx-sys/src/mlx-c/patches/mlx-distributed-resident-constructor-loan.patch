+GraphFailure GraphConstruction::create_distributed_bound(GraphQuota& quota,uint64_t scope,
+    const distributed::Group& group,const array& input,
+    distributed::GroupWorkerOperation operation,int peer,GraphConstruction*& output,
+    GraphNestedConstruction* parent) noexcept {
+  const auto context=current_graph_construction_context();
+  if (output || !scope || context.worker || context.dispatch || context.scope != scope ||
+      current_graph_quota() != &quota) return GraphFailure::foreign_parent;
+  if (parent && parent->owner_) return GraphFailure::construction_busy;
+  distributed::GroupConstructorStorage actual;
+  if (!distributed::constructor_storage(group,input,operation,peer,actual)) return GraphFailure::invalid_layout;
+  if (parent) {
+    const GraphQuota::Loan loan(quota);
+    if (quota.preparing_) return GraphFailure::construction_busy;
+    if (auto* owner=quota.construction_) {
+      // Exact active resident producer only. Pointwise, worker and foreign
+      // banks retain the old refusal. No user callback runs during this loan.
+      if (!owner->resident_host_ || owner->dispatch_) return GraphFailure::construction_busy;
+      if (owner->scope_ != scope || owner->quota_ != &quota) return GraphFailure::foreign_parent;
+      parent->owner_=owner;
+      quota.construction_=nullptr;
+    }
+  }
+  // Every block still comes from the same finite original Graph. On failure the
+  // caller's guard restores the resident association after partial rollback.
+  return create_layout(quota,scope,nullptr,actual,output);
+}
