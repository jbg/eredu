+  if(group_->terminal_owner_)value.unresolved|=group_inherited_owner;
+  value.controls=persistent_storage_controls();
+  if(value.controls==SIZE_MAX)return false;
+  out=value;return true;
+}
+size_t Group::persistent_storage_controls() const noexcept {
+  const size_t base=sizeof(GroupPersistentStorage)+sizeof(const Group*)+sizeof(void*)*2+sizeof(size_t)+sizeof(bool)*3;
