+namespace {
+// A named owner lets cold inspection distinguish this exact allocation contract
+// from arbitrary caller-provided deleters. Its lifetime semantics match the
+// previous capturing lambda, including native view/copy_shared_buffer aliases.
+struct HostTransferArrayDeleter {
+  std::shared_ptr<HostTransferStorage> owner;
+  void operator()(allocator::Buffer) {
+    owner.reset();
+  }
+};
+} // namespace
+
+std::optional<HostTransferAllocationInfo> host_transfer_allocation_info(
+    const array& value) {
+  const auto status = value.status();
+  if (status != array::Status::available &&
+      !(status == array::Status::evaluated && !value.event().valid())) {
+    return std::nullopt;
+  }
+  const auto& data = value.data_shared_ptr();
+  if (!data) {
+    return std::nullopt;
+  }
+  const auto* retained = data->d.target<HostTransferArrayDeleter>();
+  if (!retained || !retained->owner ||
+      data->buffer.ptr() != retained->owner->buffer().ptr()) {
+    return std::nullopt;
+  }
+  return HostTransferAllocationInfo{
+      retained->owner.get(), retained->owner->capacity()};
+}
 
