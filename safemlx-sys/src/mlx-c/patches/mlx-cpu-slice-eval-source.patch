diff --git a/mlx/backend/cpu/slice_storage.cpp b/mlx/backend/cpu/slice_storage.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/slice_storage.cpp
@@ -0,0 +1,73 @@
+#include "mlx/backend/cpu/slice_storage.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <climits>
+#include <typeinfo>
+
+namespace mlx::core::cpu {
+namespace {
+bool add(size_t& total,size_t value) noexcept {
+  if(value>size_t(PTRDIFF_MAX)-total)return false;total+=value;return true;
+}
+bool product(size_t left,size_t right,size_t& output) noexcept {
+  if(right&&left>size_t(PTRDIFF_MAX)/right)return false;output=left*right;return true;
+}
+}
+bool is_slice_eval_primitive(const array& output) noexcept {
+  return output.has_primitive() && output.primitive().stream().device==Device::cpu &&
+      typeid(output.primitive())==typeid(Slice);
+}
+bool slice_eval_layout(size_t rank,bool tracer,CopyEvalStorage& out) noexcept {
+  if(rank<2||rank>4)return false;
+  CopyEvalStorage value;
+  // The common one-output cleanup/outputs bank is sufficient: prepare_slice's
+  // rank<=4 Strides is inline, and the existing output descriptor already owns
+  // rank-matched stride capacity. This neither allocates Data nor dispatches.
+  if(!copy_eval_layout(0,1,false,tracer,value))return false;
+  value.rank=rank;
+  const size_t controls=sizeof(value)+sizeof(rank)+sizeof(tracer)+sizeof(out)+
+      sizeof(std::tuple<const Shape&,const Shape&,const Shape&>)+
+      sizeof(std::tuple<int64_t,Strides>)+sizeof(std::tuple<size_t,bool,bool>)+
+      sizeof(Strides)*2+sizeof(array::Flags)+sizeof(int64_t)*8+sizeof(size_t)*12+
+      sizeof(int)*4+sizeof(bool)*4+sizeof(const array*)*3+sizeof(const Slice*)+
+      sizeof(submission::FixedEvalPrologueGuard*)+sizeof(submission::Record*)+
+      sizeof(submission::GraphQuota*)+sizeof(submission::GraphConstructionContext)+
+      sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls))return false;
+  out=value;return true;
+}
+bool slice_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_slice_eval_primitive(output)||!output.siblings().empty()||output.inputs().size()!=1)return false;
+  const auto& input=output.inputs()[0];
+  const size_t rank=input.ndim();
+  if(rank<2||rank>4||output.ndim()!=rank||input.dtype()!=output.dtype()||input.itemsize()!=output.itemsize()||!output.size())return false;
+  const auto& primitive=static_cast<const Slice&>(output.primitive());
+  const auto [starts,ends,steps]=primitive.state_refs();
+  if(starts.size()!=rank||ends.size()!=rank||steps.size()!=rank||input.strides().size()!=rank)return false;
+  size_t elements=1,offset=0,span=1;
+  for(size_t i=0;i!=rank;++i) {
+    if(input.shape(i)<=0||steps[i]!=1||starts[i]<0||ends[i]<=starts[i]||
+        ends[i]>input.shape(i)||output.shape(i)!=ends[i]-starts[i]||input.strides()[i]<0)return false;
+    size_t start=0,delta=0;
+    if(!product(size_t(output.shape(i)),elements,elements)||
+        !product(size_t(starts[i]),size_t(input.strides()[i]),start)||!add(offset,start)||
+        !product(size_t(output.shape(i)-1),size_t(input.strides()[i]),delta)||!add(span,delta))return false;
+  }
+  size_t end=offset,bytes=0;
+  if(elements!=output.size()||!add(end,span)||end>input.data_size()||
+      !product(end,size_t(input.itemsize()),bytes))return false;
+  return slice_eval_layout(rank,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_slice_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();
+  const auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||
+      context.dispatch!=&record||current_graph_quota()!=graph)return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::slice_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
