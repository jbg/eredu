@@ -0,0 +1,9 @@
+#pragma once
+#include "mlx/backend/cpu/copy_storage.h"
+namespace mlx::core::cpu {
+// Nonempty, normalized unit-step Slice over the existing fixed-rank indexing
+// path. No backing or worker task is created by this alias operation.
+MLX_API bool slice_eval_layout(size_t rank, bool tracer, CopyEvalStorage&) noexcept;
+MLX_API bool is_slice_eval_primitive(const array&) noexcept;
+MLX_API bool slice_eval_storage(const array&, CopyEvalStorage&) noexcept;
+}
