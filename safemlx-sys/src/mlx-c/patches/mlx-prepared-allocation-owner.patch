diff --git a/mlx/allocation_owners.h b/mlx/allocation_owners.h
new file mode 100644
--- /dev/null
+++ b/mlx/allocation_owners.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <memory>
+#include <utility>
+
+namespace mlx::core {
+
+// One canonical owner list for both existing shared owners and prepared opaque
+// callbacks. The embedding runtime serializes append; the physical owner keeps
+// the list alive through each append. No callback may retain this backing.
+class AllocationOwners {
+ public:
+  struct Node {
+    Node() noexcept = default;
+    explicit Node(std::shared_ptr<void> owner) noexcept
+        : shared(std::move(owner)), shared_entry(true) {}
+    ~Node() noexcept = default;
+    Node(const Node&) = delete;
+    Node& operator=(const Node&) = delete;
+
+   private:
+    friend class AllocationOwners;
+    Node* next{nullptr};
+    std::shared_ptr<void> shared;
+    void* payload{nullptr};
+    void (*release)(void*){nullptr};
+    bool shared_entry{false};
+  };
+
+  AllocationOwners() noexcept = default;
+  AllocationOwners(const AllocationOwners&) = delete;
+  AllocationOwners& operator=(const AllocationOwners&) = delete;
+  AllocationOwners(AllocationOwners&& other) noexcept
+      : first_(std::exchange(other.first_, nullptr)),
+        last_(std::exchange(other.last_, nullptr)) {}
+  // Data only needs move construction. Assignment could destroy live owners
+  // before a caller releases its backing, so it is deliberately unavailable.
+  AllocationOwners& operator=(AllocationOwners&&) = delete;
+  ~AllocationOwners() noexcept {
+    // The enclosing Data/HostTransferStorage destructor has freed backing first.
+    // Iteration avoids an unbounded recursive destructor chain.
+    while (first_) {
+      auto* node = first_;
+      first_ = node->next;
+      auto* payload = node->payload;
+      auto release = node->release;
+      // The Rust callback can publish to a queue reclaimed by another thread.
+      // Free this charged native node before making its accounting owner visible.
+      delete node;
+      if (payload) {
+        release(payload);
+      }
+    }
+  }
+
+  bool contains(const std::shared_ptr<void>& owner) const noexcept {
+    for (auto* node = first_; node; node = node->next) {
+      if (node->shared_entry && node->shared == owner) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Legacy publication still prepares its own shared_ptr payload. Allocation
+  // happens before append; failure cannot consume the caller's armed callback.
+  void push_back(std::shared_ptr<void> owner) {
+    auto node = std::make_unique<Node>(std::move(owner));
+    append(node.release());
+  }
+
+  // node is a unique, empty Node allocated before this operation. Callers have
+  // already certified the actual backing and keep it alive through this move.
+  // No allocation, comparison, destructor or callback follows arming.
+  void append_prepared(Node* node, void* payload, void (*release)(void*)) noexcept {
+    node->payload = payload;
+    node->release = release;
+    append(node);
+  }
+
+ private:
+  void append(Node* node) noexcept {
+    if (last_) {
+      last_->next = node;
+    } else {
+      first_ = node;
+    }
+    last_ = node;
+  }
+  Node* first_{nullptr};
+  Node* last_{nullptr};
+};
+
+} // namespace mlx::core
