+#pragma once
+
+#include <type_traits>
+#include <utility>
+#include "mlx/failure.h"
+#include "mlx/graph_quota.h"
+
+namespace mlx::core::scheduler {
+class MLX_API Scheduler;
+
+// One physical FIFO node. The concrete callable follows inline, before any
+// std::function conversion on original dispatch. No node owns its worker.
+struct Task {
+  Task* next{nullptr};
+  void (*invoke)(Task*);
+  void (*destroy)(Task*) noexcept;
+  submission::GraphQuotaRef graph;
+  FailureCarrierRef failure;
+  Scheduler* scheduler;
+  bool counted;
+
+  Task(void (*call)(Task*), void (*drop)(Task*) noexcept,
+       submission::GraphQuota* arena, FailureCarrierRef owner,
+       Scheduler* scheduler, bool counted) noexcept
+      : invoke(call), destroy(drop), graph(arena), failure(std::move(owner)),
+        scheduler(scheduler), counted(counted) {}
+};
+
+class TaskOwner {
+ public:
+  explicit TaskOwner(Task* task = nullptr) noexcept : task_(task) {}
+  TaskOwner(TaskOwner&& other) noexcept : task_(other.release()) {}
+  TaskOwner(const TaskOwner&) = delete;
+  TaskOwner& operator=(const TaskOwner&) = delete;
+  ~TaskOwner() { reset(); }
+  Task* get() const noexcept { return task_; }
+  Task* release() noexcept { return std::exchange(task_, nullptr); }
+  void reset() noexcept { if (auto* task = release()) task->destroy(task); }
+ private:
+  Task* task_;
+};
+
+template<class F> struct TaskNode final : Task {
+  F body;
+  template<class U> TaskNode(submission::GraphQuota* graph,
+      FailureCarrierRef failure, Scheduler* scheduler, bool counted, U&& body)
+      : Task([](Task* task) { static_cast<TaskNode*>(task)->body(); },
+             [](Task* task) noexcept {
+               auto* node = static_cast<TaskNode*>(task);
+               // The allocator protects the header through callable/base
+               // destruction and block return, even on the final task alias.
+               submission::GraphAllocator<TaskNode> allocator(node->graph.get());
+               node->~TaskNode();
+               allocator.deallocate(node, 1);
+             }, graph, std::move(failure), scheduler, counted),
+        body(std::forward<U>(body)) {}
+};
+
+template<class F> TaskOwner make_task(submission::GraphQuota* graph,
+    FailureCarrierRef failure, Scheduler* scheduler, bool counted, F&& body) {
+  using Node = TaskNode<std::decay_t<F>>;
+  submission::GraphAllocator<Node> allocator(graph);
+  auto* storage = allocator.allocate(1);
+  try {
+    return TaskOwner(::new (storage) Node(graph, std::move(failure), scheduler,
+                                         counted, std::forward<F>(body)));
+  } catch (...) {
+    allocator.deallocate(storage, 1);
+    throw;
+  }
+}
+
+template<class F> bool task_graph_extent(size_t& out) noexcept {
+  using Node = TaskNode<std::decay_t<F>>;
+  return submission::GraphQuota::allocation_extent(sizeof(Node), alignof(Node), out);
+}
