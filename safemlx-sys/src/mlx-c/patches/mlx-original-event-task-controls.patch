+  using Failure = submission::NativeControlFailure;
+  if (stream.device != Device::cpu) return Failure::foreign_domain;
+  try {
+    std::shared_lock lock(threads_mtx_, std::try_to_lock);
+    if (!lock.owns_lock()) return Failure::busy_worker;
+    if (stopping_.load(std::memory_order_acquire)) return Failure::stopped_worker;
+    auto it = threads_.find(stream.index);
+    if (it == threads_.end()) return Failure::missing_worker;
