+namespace mlx::core {
+class FailureCarrier;
+namespace submission {
+class GraphQuota;
+
+// Fixed native mechanism refusals. Throwing adapters still require the initial
+// C++ exception ABI population; these inline causes do not claim that bound.
+enum class NativeControlFailure : uint8_t {
+  none = 0,
+  missing_scope,
+  invalid_scope,
+  already_configured,
+  missing_graph,
+  missing_record,
+  missing_failure,
+  foreign_domain,
+  missing_receipt,
+  missing_worker,
+  busy_worker,
+  failed_worker,
+  stopped_worker,
+  blocked_during_submit,
+  sequence_exhausted,
+  unsupported_backend,
+  erased_callable,
+};
+
+class MLX_API NativeControlError final : public std::exception {
+ public:
+  explicit NativeControlError(NativeControlFailure failure) noexcept
+      : failure_(failure) {}
+  NativeControlFailure failure() const noexcept { return failure_; }
+  const char* what() const noexcept override;
+ private:
+  NativeControlFailure failure_;
+};
+
+// Only a lexical borrow of the current configured Scope; no owning authority
+// or quota can be reconstructed from this diagnostic population.
+struct NativeControlBinding {
+  NativeControlFailure failure{NativeControlFailure::none};
+  bool original{false};
+  GraphQuota* graph{nullptr};
+  FailureCarrier* carrier{nullptr};
+  uint64_t scope_identity{0};
+};
+MLX_API NativeControlBinding current_native_controls() noexcept;
+// Marks a construction attempt before allocation or callable construction.
+// This prevents later adoption of an ordinary Event/task into original mode.
+MLX_API void mark_native_control_construction() noexcept;
+} // namespace submission
+} // namespace mlx::core
