+  const bool original = task.get()->graph.get() != nullptr;
+  if (stopping_.load(std::memory_order_acquire))
+    throw_task_refusal(Failure::stopped_worker, original);
+  if (original) {
+    // Callable construction may throw or reenter; recheck the same lexical
+    // domain and receipt before accepting a node that already owns its block.
+    const auto binding = submission::current_native_controls();
+    if (binding.failure != Failure::none) throw_task_refusal(binding.failure, true);
+    if (!binding.original || binding.graph != task.get()->graph.get() ||
+        binding.carrier != task.get()->failure.get() || !thread->stream)
