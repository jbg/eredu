 class MLX_API Device {
+  // Used only for the duration of get_library. The cache never stores this
+  // view, the callable, or references into the callable's captures.
+  struct LibraryBuilder {
+    const void* context;
+    std::string (*invoke)(const void*);
+  };
+
+  template <class Builder>
+  using BorrowableBuilder = std::enable_if_t<
+      std::is_object_v<Builder> &&
+          !std::is_same_v<
+              std::decay_t<Builder>,
+              std::function<std::string(void)>> &&
+          std::is_invocable_r_v<std::string, const Builder&>,
+      int>;
+
  public:
   Device();
   Device(const Device&) = delete;
@@ -271,6 +289,32 @@
       const std::string& name,
       const std::function<std::string(void)>& builder) {
     return get_library(name, {}, builder);
+  }
+
+  // Explicit borrowed lambda/object calls avoid a temporary std::function
+  // allocation before a cache hit. The reference remains valid until this call
+  // returns, including exceptional exit. The unchanged get_library overloads
+  // retain the ordinary std::function adapter and its historical copy/ownership
+  // semantics.
+  template <class Builder, BorrowableBuilder<Builder> = 0>
+  MTL::Library* get_library_borrowed(
+      const std::string& name,
+      const CompileOptions& compile_options,
+      const Builder& builder) {
+    return get_library_with_builder(
+        name,
+        compile_options,
+        LibraryBuilder{
+            std::addressof(builder), [](const void* context) -> std::string {
+              return (*static_cast<const Builder*>(context))();
+            }});
+  }
+
+  template <class Builder, BorrowableBuilder<Builder> = 0>
+  MTL::Library* get_library_borrowed(
+      const std::string& name,
+      const Builder& builder) {
+    return get_library_borrowed(name, {}, builder);
   }
 
