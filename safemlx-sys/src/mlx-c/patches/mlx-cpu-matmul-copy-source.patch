+bool append_copy_temporary_layout(size_t rank,CopyEvalStorage& out) noexcept {
+  if(rank>5||Shape::inline_capacity<5||Strides::inline_capacity<5)return false;
+  CopyEvalStorage copy;
+  submission::GraphQuota::Request descriptor[5]{};size_t count=0;
+  if(!copy_eval_layout(rank,1,true,false,copy)||
+      !PreparedInputLeaf::append_array_requests(rank,descriptor,count)||count!=3)return false;
+  CopyEvalStorage value=out;value.copy=true;
+  // Reuse the actual copy's Data, weak descriptors, task and backing birth.
+  // Slots 0..2 describe its standalone Eval/cleanup and do not occur here.
+  for(size_t slot=3;slot!=9;++slot) {
+    if(!append(value,slot,copy.request_bytes[slot],copy.request_alignments[slot],
+        copy.request_counts[slot]))return false;
+  }
+  // The parent constructs one fresh destination descriptor, then copy_cpu
+  // installs the Data already included above. Both copied ranks are inline.
+  for(size_t i=0;i!=2;++i)
+    if(!append(value,4+i,descriptor[i].bytes,descriptor[i].alignment,1))return false;
+  if(!add(value.backing_births,copy.backing_births)||
+      !add(value.worker_graph_extents,copy.worker_graph_extents)||
+      !add(value.named_control_bytes,copy.named_control_bytes)||
+      !add(value.named_control_bytes,PreparedInputLeaf::descriptor_shared_control_bytes())||
+      !add(value.named_control_bytes,PreparedInputLeaf::descriptor_allocator_control_bytes()))return false;
+  const size_t controls=sizeof(rank)+sizeof(out)+sizeof(copy)+sizeof(value)+sizeof(descriptor)+sizeof(count)+
+      sizeof(size_t)*3+sizeof(array)*2+sizeof(Shape)*2+sizeof(Strides)+sizeof(ArrayVector)+
+      sizeof(std::shared_ptr<Primitive>)+sizeof(Dtype)+sizeof(CopyType)+sizeof(Stream)+sizeof(bool);
+  if(!add(value.named_control_bytes,controls)||
+      !submission::GraphConstruction::complete_layout(value))return false;
+  out=value;return true;
+}
