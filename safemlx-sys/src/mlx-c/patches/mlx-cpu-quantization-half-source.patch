 namespace cpu {
 bool arg_reduce_dispatch_storage(EvalDispatchStorage& out) noexcept {
+  return typed_arg_reduce_dispatch_storage(float32,out);
+}
+bool typed_arg_reduce_dispatch_storage(Dtype dtype,EvalDispatchStorage& out) noexcept {
+  if(dtype!=float32&&dtype!=float16&&dtype!=bfloat16)return false;
+  // Half comparisons retain their typed scalar operands and the float
+  // conversions used by the ordinary comparison operators.
+  const size_t scalars=dtype==float32?sizeof(float)*3:
+      (dtype==float16?sizeof(float16_t):sizeof(bfloat16_t))*5+sizeof(float)*2+sizeof(bool);
   DispatchLayout task;
   if(!CommandEncoder::dispatch_layout<ArgReduceTask>(task))return false;
   const size_t controls=sizeof(EvalDispatchStorage)+sizeof(task)+sizeof(out)+sizeof(ArgReduceTask)*2+
       sizeof(array)*2+sizeof(ArgReduce::ReduceType)*2+sizeof(int)*3+sizeof(Strides)+sizeof(Shape)+
-      sizeof(void*)*6+sizeof(size_t)*3+sizeof(uint32_t)*6+sizeof(float)*3+sizeof(Stream);
+      sizeof(void*)*6+sizeof(size_t)*3+sizeof(uint32_t)*6+scalars+sizeof(Stream)+
+      sizeof(dtype)+sizeof(scalars)+sizeof(EvalDispatchStorage*);
   if(task.controls>SIZE_MAX-controls)return false;
   out={task.task_bytes,task.task_alignment,0,task.controls+controls};return true;
 }
