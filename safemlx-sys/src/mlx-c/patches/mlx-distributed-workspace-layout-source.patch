diff --git a/mlx/distributed/tensor_layout.h b/mlx/distributed/tensor_layout.h
new file mode 100644
--- /dev/null
+++ b/mlx/distributed/tensor_layout.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "mlx/array.h"
+#include <climits>
+#include <limits>
+#include <optional>
+#include <span>
+
+namespace mlx::core::distributed {
+// Validated immutable equation layout, never an Array, allocation or group
+// authority. Only actual retained implementation queries consume this view.
+class GroupTensorLayout {
+ public:
+  static std::optional<GroupTensorLayout> checked(std::span<const int> shape,Dtype dtype) noexcept {
+    if(shape.size()>size_t(INT_MAX))return std::nullopt;
+    size_t item=0;
+    switch(dtype.val()) {
+      case Dtype::Val::bool_:item=sizeof(bool);break;
+      case Dtype::Val::uint8:case Dtype::Val::int8:item=1;break;
+      case Dtype::Val::uint16:case Dtype::Val::int16:case Dtype::Val::float16:case Dtype::Val::bfloat16:item=2;break;
+      case Dtype::Val::uint32:case Dtype::Val::int32:case Dtype::Val::float32:item=4;break;
+      case Dtype::Val::uint64:case Dtype::Val::int64:case Dtype::Val::float64:case Dtype::Val::complex64:item=8;break;
+      default:return std::nullopt;
+    }
+    if(dtype.size()!=item)return std::nullopt;
+    size_t elements=1;
+    for(int dimension:shape) {
+      if(dimension<0 || (dimension && elements>size_t(PTRDIFF_MAX)/size_t(dimension)))return std::nullopt;
+      elements*=size_t(dimension);
+    }
+    if(elements>size_t(PTRDIFF_MAX)/item)return std::nullopt;
+    return GroupTensorLayout(shape,dtype,elements);
+  }
+  static std::optional<GroupTensorLayout> checked(const array& input) noexcept {
+    return checked(std::span<const int>(input.shape().data(),input.ndim()),input.dtype());
+  }
+  std::span<const int> shape()const noexcept{return shape_;}
+  size_t ndim()const noexcept{return shape_.size();}
+  Dtype dtype()const noexcept{return dtype_;}
+  size_t itemsize()const noexcept{return dtype_.size();}
+  size_t size()const noexcept{return elements_;}
+  size_t nbytes()const noexcept{return elements_*itemsize();}
+ private:
+  GroupTensorLayout(std::span<const int> shape,Dtype dtype,size_t elements) noexcept
+      :shape_(shape),dtype_(dtype),elements_(elements){}
+  std::span<const int> shape_;
+  Dtype dtype_;
+  size_t elements_;
+};
+} // namespace mlx::core::distributed
