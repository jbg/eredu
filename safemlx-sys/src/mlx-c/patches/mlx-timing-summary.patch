--- /dev/null
+++ b/mlx/backend/common/timing_intervals.h
@@ -0,0 +1,32 @@
+// Completion interval diagnostics for the native timer.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <utility>
+#include <vector>
+
+namespace mlx::core {
+// Sum, union, span, valid interval count, missing timestamp count.
+using TimingSummary = std::array<double, 5>;
+inline TimingSummary summarize_timing_intervals(
+    std::vector<std::pair<double, double>> intervals,
+    double sum, size_t missing) {
+  intervals.erase(std::remove_if(intervals.begin(), intervals.end(),
+      [](const auto& interval) { return interval.first <= 0; }), intervals.end());
+  TimingSummary result{sum, 0, 0, double(intervals.size()), double(missing)};
+  if (intervals.empty()) return result;
+  std::sort(intervals.begin(), intervals.end());
+  double start = intervals.front().first, stop = intervals.front().second;
+  const double first = start;
+  for (size_t i = 1; i < intervals.size(); ++i) {
+    if (intervals[i].first > stop) {
+      result[1] += stop - start;
+      start = intervals[i].first;
+    }
+    stop = std::max(stop, intervals[i].second);
+  }
+  result[1] += stop - start;
+  result[2] = stop - first;
+  return result;
+}
+} // namespace mlx::core
