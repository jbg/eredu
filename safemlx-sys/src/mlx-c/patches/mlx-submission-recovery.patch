+struct EvalSubmissionRecord : submission::Record {
+  std::deque<array> tape;
+  std::optional<array> synchronizer;
+  std::optional<array> current;
+  std::vector<std::shared_ptr<Primitive>> primitive_owners;
+  std::unordered_map<uint32_t, Fence> fences;
+  std::unordered_map<uint32_t, Event> events;
+  bool failed_record{false};
+
+  ~EvalSubmissionRecord() override {
+    if (!failed_record) {
+      return;
+    }
+    // Every unscheduled node is still held by the tape/current array. Detach
+    // while these independent handles exist, so terminal recovery does not
+    // invoke the allocating recursive graph-destructor walk under pressure.
+    for (auto& arr : tape) {
+      arr.detach();
+    }
+    if (current) {
+      current->detach();
+    }
+    if (synchronizer) {
+      synchronizer->detach();
+    }
+  }
+
+  bool recover_event(Stream stream) noexcept override {
+    auto event = events.find(stream.index);
+    return event == events.end() || event->second.recover_terminal_failure();
+  }
+
+  bool side_effects_terminal() const noexcept override {
+    for (const auto& [_, event] : events) {
+      if (!event.side_effects_terminal()) {
+        return false;
+      }
+    }
+    for (const auto& [_, fence] : fences) {
+      if (!fence.side_effects_terminal()) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool side_effects_terminal(Stream stream) const noexcept override {
+    auto event = events.find(stream.index);
+    auto fence = fences.find(stream.index);
+    return (event == events.end() || event->second.side_effects_terminal()) &&
+        (fence == fences.end() || fence->second.side_effects_terminal());
+  }
+
+  bool side_effects_failed() const noexcept override {
+    for (const auto& [_, event] : events) {
+      if (event.side_effects_failed()) {
+        return true;
+      }
+    }
+    for (const auto& [_, fence] : fences) {
+      if (fence.side_effects_failed()) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void progress_side_effects() noexcept override {
+    for (auto& [_, event] : events) {
+      event.progress_side_effects();
+    }
+    for (auto& [_, fence] : fences) {
+      fence.progress_side_effects();
+    }
+  }
+};
