+  void record_finished(bool activity, bool failed, bool blocked) noexcept;
+  void record_failed(bool blocked) noexcept;
+  std::atomic<size_t> references_{1};
+  std::atomic<size_t> pending_{0};
+  std::atomic<bool> activity_{false};
+  std::atomic<bool> failed_{false};
+  std::atomic<bool> blocked_{false};
+  const void* owner_;
+  Scope* parent_{nullptr};
