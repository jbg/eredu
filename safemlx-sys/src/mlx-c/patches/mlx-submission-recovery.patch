diff --git a/target/mlx-recovery-edit/new/mlx/submission.cpp b/mlx/submission.cpp
new file mode 100644
index 00000000..13a2fb67
--- /dev/null
+++ b/mlx/submission.cpp
@@ -0,0 +1,523 @@
+#include "mlx/submission.h"
+
+#include <algorithm>
+#include <limits>
+#include <mutex>
+
+namespace mlx::core::submission {
+namespace {
+thread_local Scope* active_scope = nullptr;
+thread_local Record* active_capture = nullptr;
+thread_local const void* owner_identity = nullptr;
+
+const void* prepare_owner_identity() {
+  if (!owner_identity) {
+    // std::thread::id and TLS addresses may be reused after thread exit.
+    // A never-recycled tag cannot authorize another thread to touch an encoder.
+    owner_identity = new unsigned char;
+  }
+  return owner_identity;
+}
+struct Registry {
+  std::mutex mutex;
+  Record* head{nullptr};
+  Record* tail{nullptr};
+  size_t size{0};
+};
+// No static teardown: unresolved native callbacks and their owners may outlive
+// the submitting thread, all C handles, and ordinary static destruction.
+Registry& registry() {
+  static auto* value = new Registry;
+  return *value;
+}
+
+struct PinMutation {
+  array::Data& data;
+  explicit PinMutation(array::Data& value) noexcept : data(value) {
+    // Pins are created/released only by ordinary host evaluation/retirement,
+    // never scope progress/free or native worker observation. The holder does
+    // only pin-count arithmetic: no allocation, callbacks or backend work.
+    while (data.recovery_pin_lock.test_and_set(std::memory_order_acquire)) {
+      std::this_thread::yield();
+    }
+  }
+  ~PinMutation() {
+    data.recovery_pin_lock.clear(std::memory_order_release);
+  }
+  PinMutation(const PinMutation&) = delete;
+  PinMutation& operator=(const PinMutation&) = delete;
+};
+} // namespace
+
+Scope::Scope() : owner_(prepare_owner_identity()), parent_(active_scope) {
+  // Prepare global ownership before the first possible submission.
+  (void)registry();
+  if (parent_) {
+    parent_->retain();
+    parent_->record_started();
+    parent_->next_ = this;
+  }
+  previous_ = active_scope;
+  active_scope = this;
+}
+
+Scope::~Scope() {
+  if (parent_) {
+    parent_->release();
+  }
+}
+
+bool Scope::on_owner_thread() const noexcept {
+  return owner_ == owner_identity;
+}
+
+void Scope::retain() noexcept {
+  references_.fetch_add(1, std::memory_order_relaxed);
+}
+
+void Scope::release() noexcept {
+  if (references_.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+    delete this;
+  }
+}
+
+void Scope::seal() noexcept {
+  if (!active_) {
+    return;
+  }
+  // The active chain is independent of the durable ancestry. Removing an
+  // outer scope leaves its active children and their lifetime ancestry valid.
+  if (previous_) {
+    previous_->next_ = next_;
+  }
+  if (next_) {
+    next_->previous_ = previous_;
+  } else {
+    active_scope = previous_;
+  }
+  previous_ = next_ = nullptr;
+  active_ = false;
+  if (parent_) {
+    parent_->record_finished(false, false, false);
+  }
+}
+
+Status Scope::query() const noexcept {
+  const auto pending = pending_.load(std::memory_order_acquire);
+  return {
+      pending ? Activity::pending
+              : (activity_.load(std::memory_order_acquire) ? Activity::terminal
+                                                         : Activity::none),
+      failed_.load(std::memory_order_acquire),
+      blocked_.load(std::memory_order_acquire)};
+}
+
+void Scope::progress() noexcept {
+  progress_records();
+}
+
+void Scope::record_started() noexcept {
+  for (auto* scope = this; scope; scope = scope->parent_) {
+    scope->pending_.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+void Scope::record_failed(bool blocked) noexcept {
+  for (auto* scope = this; scope; scope = scope->parent_) {
+    scope->failed_.store(true, std::memory_order_release);
+    if (blocked) {
+      scope->blocked_.store(true, std::memory_order_release);
+    }
+  }
+}
+
+void Scope::record_finished(bool activity, bool failed, bool blocked) noexcept {
+  for (auto* scope = this; scope; scope = scope->parent_) {
+    if (activity) {
+      scope->activity_.store(true, std::memory_order_release);
+    }
+    if (failed) {
+      scope->failed_.store(true, std::memory_order_release);
+    }
+    if (blocked) {
+      scope->blocked_.store(true, std::memory_order_release);
+    }
+    scope->pending_.fetch_sub(1, std::memory_order_release);
+  }
+}
+
+Record::Record() : owner_(prepare_owner_identity()) {
+  captures_.reserve(8);
+  (void)registry();
+}
+
+void Record::enter() {
+  auto& owners = registry();
+  std::lock_guard<std::mutex> lock(owners.mutex);
+  scope_ = active_scope;
+  if (scope_) {
+    scope_->retain();
+    scope_->record_started();
+  }
+  if (owners.tail) {
+    owners.tail->next_ = this;
+  } else {
+    owners.head = this;
+  }
+  owners.tail = this;
+  ++owners.size;
+}
+
+Record::~Record() {
+  if (scope_) {
+    scope_->release();
+  }
+}
+
+void Record::prepare_stream(Stream stream) {
+  if (std::any_of(streams_.begin(), streams_.end(), [&](const auto& receipt) {
+        return receipt.stream == stream;
+      })) {
+    return;
+  }
+  StreamReceipt receipt{stream, {}, {}};
+  if (stream.device == Device::cpu) {
+    receipt.cpu = scheduler::prepare_cpu_stream(stream);
+    receipt.begin = scheduler::cpu_stream_progress(receipt.cpu).accepted;
+  } else {
+    receipt.gpu = gpu::prepare_submission_stream(stream);
+    receipt.begin = gpu::submission_progress(receipt.gpu).accepted;
+  }
+  receipt.end = receipt.begin;
+  streams_.push_back(std::move(receipt));
+}
+
+Record::PhysicalPin::PhysicalPin(const std::shared_ptr<array::Data>& owner)
+    : data(owner) {
+  if (data) {
+    bool exhausted;
+    {
+      PinMutation mutation(*data);
+      exhausted = data->recovery_pins.load(std::memory_order_relaxed) ==
+          std::numeric_limits<size_t>::max();
+      // The shared owner exists before its exclusion becomes visible.
+      if (!exhausted) {
+        data->recovery_pins.fetch_add(1, std::memory_order_relaxed);
+      }
+    }
+    // Exception construction may allocate, so it must run outside the guard.
+    if (exhausted) {
+      throw std::overflow_error("Native recovery pin count exhausted.");
+    }
+  }
+}
+
+Record::PhysicalPin::~PhysicalPin() {
+  if (data) {
+    PinMutation mutation(*data);
+    // Only this move-only owner changes its one count; a move transfers the
+    // shared pointer and leaves the source null without changing the count.
+    auto count = data->recovery_pins.load(std::memory_order_relaxed);
+    if (count) {
+      data->recovery_pins.fetch_sub(1, std::memory_order_relaxed);
+    }
+    // The guard releases before the shared_ptr member releases its owner.
+  }
+}
+
+void Record::reserve_outputs(size_t count) {
+  outputs_.reserve(count);
+}
+
+void Record::retain_output(const std::shared_ptr<array::Data>& data) {
+  if (data) {
+    outputs_.emplace_back(data);
+  }
+}
+
+void Record::release_success_outputs() noexcept {
+  // Called only after every primitive and all event/finalize publication
+  // succeeded. Unconsumed values remain graph-owned; consumed values are
+  // retained by the successful backend dispatch (or its donated output).
+  // Failed submission paths keep every pin until terminal retirement.
+  outputs_.clear();
+}
+
+void Record::begin_primitive() noexcept {
+  previous_capture_ = active_capture;
+  active_capture = this;
+  capture_active_ = true;
+}
+
+void Record::end_primitive() noexcept {
+  active_capture = previous_capture_;
+  previous_capture_ = nullptr;
+  capture_active_ = false;
+  captures_.clear();
+}
+
+void Record::capture(const std::shared_ptr<array::Data>& data) {
+  captures_.push_back(data);
+}
+
+void capture_data(const std::shared_ptr<array::Data>& data) {
+  if (active_capture) {
+    active_capture->capture(data);
+  }
+}
+
+void Record::mark_failure() noexcept {
+  failed_ = true;
+  for (auto& receipt : streams_) {
+    if (receipt.stream.device == Device::cpu) {
+      receipt.end = scheduler::cpu_stream_progress(receipt.cpu).accepted;
+      if (receipt.end > receipt.begin) {
+        scheduler::block_cpu_stream(receipt.cpu);
+        receipt.end = scheduler::cpu_stream_progress(receipt.cpu).accepted;
+      }
+    } else {
+      receipt.end = gpu::submission_progress(receipt.gpu).accepted;
+      if (receipt.end > receipt.begin) {
+        gpu::block_submission_stream(receipt.gpu);
+        receipt.end = gpu::submission_progress(receipt.gpu).accepted;
+      }
+    }
+    activity_ |= receipt.end > receipt.begin;
+  }
+  blocked_ |= activity_;
+  if (scope_) {
+    scope_->record_failed(blocked_);
+  }
+}
+
+void Record::finish(bool failed) noexcept {
+  if (capture_active_) {
+    active_capture = previous_capture_;
+    capture_active_ = false;
+  }
+  if (failed) {
+    mark_failure();
+  } else {
+    for (auto& receipt : streams_) {
+      receipt.end = receipt.stream.device == Device::cpu
+          ? scheduler::cpu_stream_progress(receipt.cpu).accepted
+          : gpu::submission_progress(receipt.gpu).accepted;
+      activity_ |= receipt.end > receipt.begin;
+    }
+  }
+  frozen_.store(true, std::memory_order_release);
+}
+
+bool Record::progress(bool allow_backend_progress) noexcept {
+  if (settled_) {
+    return true;
+  }
+  if (!frozen_.load(std::memory_order_acquire)) {
+    return false;
+  }
+  // Finalize every exact GPU encoder before observing any frontier. Never
+  // wait on one stream while another producer still has an open buffer.
+  for (auto& receipt : streams_) {
+    if (allow_backend_progress && owner_ == owner_identity &&
+        receipt.stream.device == Device::gpu &&
+        gpu::submission_progress(receipt.gpu).completed < receipt.end) {
+      gpu::progress_submission_stream(receipt.gpu);
+      if (failed_) {
+        receipt.end = std::max(
+            receipt.end, gpu::submission_progress(receipt.gpu).accepted);
+      }
+    }
+  }
+  if (allow_backend_progress && owner_ == owner_identity) {
+    progress_side_effects();
+  }
+  if (side_effects_failed() && !failed_) {
+    mark_failure();
+  }
+  bool terminal = side_effects_terminal();
+  for (auto& receipt : streams_) {
+    uint64_t completed;
+    bool failed;
+    if (receipt.stream.device == Device::cpu) {
+      auto state = scheduler::cpu_stream_progress(receipt.cpu);
+      completed = state.completed;
+      failed = state.failed;
+    } else {
+      auto state = gpu::submission_progress(receipt.gpu);
+      completed = state.completed;
+      failed = state.failed;
+    }
+    if (failed && !failed_) {
+      mark_failure();
+    }
+    if (completed < receipt.end) {
+      terminal = false;
+      continue;
+    }
+    if (failed_ && !receipt.event_recovered) {
+      receipt.event_recovered = side_effects_terminal(receipt.stream) &&
+          recover_event(receipt.stream);
+      terminal &= receipt.event_recovered;
+    }
+  }
+  if (terminal) {
+    settled_ = true;
+    if (scope_) {
+      scope_->record_finished(activity_, failed_, blocked_);
+    }
+  }
+  return terminal;
+}
+
+void progress_records(bool allow_backend_progress) noexcept {
+  try {
+    auto& owners = registry();
+    std::unique_lock<std::mutex> lock(owners.mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+      return;
+    }
+    // Rotate pending owners for fairness. At most 64 records are examined per
+    // call, regardless of registry size, and no native host wait is performed.
+    auto count = std::min<size_t>(owners.size, 64);
+    while (count--) {
+      auto* record = owners.head;
+      owners.head = record->next_;
+      if (!owners.head) {
+        owners.tail = nullptr;
+      }
+      record->next_ = nullptr;
+      record->progress(allow_backend_progress);
+      if (owners.tail) {
+        owners.tail->next_ = record;
+      } else {
+        owners.head = record;
+      }
+      owners.tail = record;
+    }
+  } catch (...) {
+    // Observation is best effort. Failure never destroys unresolved owners.
+  }
+}
+
+void retire_records() {
+  Record* retired = nullptr;
+  {
+    auto& owners = registry();
+    std::unique_lock<std::mutex> lock(owners.mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+      return;
+    }
+    auto count = std::min<size_t>(owners.size, 64);
+    while (count--) {
+      auto* record = owners.head;
+      owners.head = record->next_;
+      if (!owners.head) {
+        owners.tail = nullptr;
+      }
+      if (record->settled_ && record->owner_ == owner_identity) {
+        --owners.size;
+        record->next_ = retired;
+        retired = record;
+      } else {
+        record->next_ = nullptr;
+        if (owners.tail) {
+          owners.tail->next_ = record;
+        } else {
+          owners.head = record;
+        }
+        owners.tail = record;
+      }
+    }
+  }
+  while (retired) {
+    auto* record = retired;
+    retired = record->next_;
+    delete record;
+  }
+}
+
+bool stream_failed(Stream stream) noexcept {
+  if (stream.device == Device::cpu) {
+    if (auto progress = scheduler::cpu_stream_progress(stream);
+        progress && progress->failed) {
+      return true;
+    }
+  }
+  try {
+    auto& owners = registry();
+    std::unique_lock<std::mutex> lock(owners.mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+      return false;
+    }
+    for (auto* record = owners.head; record; record = record->next_) {
+      if (!record->frozen_.load(std::memory_order_acquire)) {
+        continue;
+      }
+      for (const auto& receipt : record->streams_) {
+        if (receipt.stream == stream &&
+            (record->failed_ ||
+             (stream.device == Device::gpu &&
+              gpu::submission_progress(receipt.gpu).failed))) {
+          return true;
+        }
+      }
+    }
+  } catch (...) {
+  }
+  return false;
+}
+
+bool failed_work_pending() noexcept {
+  try {
+    auto& owners = registry();
+    std::unique_lock<std::mutex> lock(owners.mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+      return false;
+    }
+    for (auto* record = owners.head; record; record = record->next_) {
+      if (record->frozen_.load(std::memory_order_acquire) &&
+          record->failed_ && !record->settled_) {
+        return true;
+      }
+    }
+  } catch (...) {
+  }
+  return false;
+}
+
+void Record::wait_for_progress() {
+  for (;;) {
+    progress_records();
+    bool failed = failed_work_pending();
+    for (const auto& receipt : streams_) {
+      failed |= receipt.stream.device == Device::cpu
+          ? scheduler::cpu_stream_progress(receipt.cpu).failed
+          : gpu::submission_progress(receipt.gpu).failed;
+    }
+    if (failed) {
+      throw std::runtime_error(
+          "Native scheduler progress is blocked by an unresolved failed submission.");
+    }
+    if (scheduler::scheduler().wait_for_one_for(std::chrono::milliseconds(1))) {
+      return;
+    }
+    // A healthy slow task has no deadline. Only known failed/owned work
+    // changes the outcome from ordinary waiting to a recoverable error.
+  }
+}
+
+void wait_for_event(const Event& event) {
+  auto fail = [&]() -> void {
+    if (event.stream().device == Device::cpu) {
+      if (auto message = scheduler::stream_error(event.stream())) {
+        throw std::runtime_error(*message);
+      }
+    }
+    throw std::runtime_error("Native submission failed while waiting for completion.");
+  };
+  for (;;) {
+    // Failure is not terminality. Return promptly and let the independent
+    // registry/scope keep accepted work and its owners until proven stopped.
+    if (stream_failed(event.stream())) {
+      fail();
+    }
+    progress_records();
+    if (stream_failed(event.stream())) {
+      fail();
+    }
+    if (event.is_signaled()) {
+      return;
+    }
+    std::this_thread::yield();
+  }
+}
+
