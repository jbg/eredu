+
+// Establish DLL linkage before the friend declarations in Record. MSVC
+// rejects adding dllexport/dllimport after an undecorated friend declaration.
+MLX_API void progress_records(bool allow_backend_progress = true) noexcept;
+// Ordinary host operations may explicitly reclaim terminal records. Arbitrary
+// primitive/resource destructors run outside the registry lock, never in
+// scope progress/free, worker observation or thread-local teardown.
+MLX_API void retire_records();
+MLX_API bool stream_failed(Stream) noexcept;
+
+// Construct and prepare before native work. Keep the current array, remaining
+// tape, primitive owners, fences and events in a derived record. finish and
+// progress never free resources; ordinary retirement reclaims only terminal
+// records on their exact original owner thread.
+class MLX_API Record {
+ public:
+  Record();
+  virtual ~Record();
+  Record(const Record&) = delete;
+  Record& operator=(const Record&) = delete;
+  void enter();
+  void prepare_stream(Stream);
+  void reserve_outputs(size_t);
+  void retain_output(const std::shared_ptr<array::Data>&);
+  void release_success_outputs() noexcept;
+  void wait_for_progress();
+  void finish(bool failed) noexcept;
+  void begin_primitive() noexcept;
+  void end_primitive() noexcept;
+  void capture(const std::shared_ptr<array::Data>&);
+
+ protected:
+  virtual bool recover_event(Stream) noexcept { return true; }
+  virtual bool side_effects_terminal() const noexcept { return true; }
+  virtual bool side_effects_failed() const noexcept { return false; }
+  virtual bool side_effects_terminal(Stream) const noexcept {
+    return side_effects_terminal();
+  }
+  virtual void progress_side_effects() noexcept {}
+
+ private:
+  friend void progress_records(bool) noexcept;
+  friend void retire_records();
+  friend bool stream_failed(Stream) noexcept;
+  friend bool failed_work_pending() noexcept;
+  struct PhysicalPin {
+    std::shared_ptr<array::Data> data;
+    explicit PhysicalPin(const std::shared_ptr<array::Data>&);
+    PhysicalPin(PhysicalPin&&) noexcept = default;
+    PhysicalPin& operator=(PhysicalPin&&) = delete;
+    PhysicalPin(const PhysicalPin&) = delete;
+    PhysicalPin& operator=(const PhysicalPin&) = delete;
+    ~PhysicalPin();
+  };
+  struct StreamReceipt {
+    Stream stream;
+    scheduler::CpuStreamToken cpu;
+    gpu::SubmissionToken gpu;
+    uint64_t begin{0};
+    uint64_t end{0};
+    bool event_recovered{false};
+  };
+  bool progress(bool) noexcept;
+  void mark_failure() noexcept;
+  Scope* scope_{nullptr};
+  Record* next_{nullptr};
+  std::atomic<bool> frozen_{false};
+  std::vector<StreamReceipt> streams_;
+  std::vector<std::shared_ptr<array::Data>> captures_;
+  std::vector<PhysicalPin> outputs_;
+  Record* previous_capture_{nullptr};
+  bool capture_active_{false};
+  bool failed_{false};
+  bool activity_{false};
+  bool blocked_{false};
+  bool settled_{false};
+  const void* owner_;
+};
+
+// Only active inside one primitive until its ordinary backend retention has
+// been published. This closes partial-primitive temporary lifetime holes while
+// restoring normal donation before the next primitive.
+MLX_API void capture_data(const std::shared_ptr<array::Data>&);
+MLX_API void wait_for_event(const Event&);
+
+} // namespace mlx::core::submission
