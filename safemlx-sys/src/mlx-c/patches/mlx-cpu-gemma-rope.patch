@@ -0,0 +1,47 @@
+#include "mlx/backend/cpu/arange_storage.h"
+#include "mlx/backend/cpu/arange.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <cmath>
+#include <climits>
+#include <typeinfo>
+namespace mlx::core::cpu {
+bool is_arange_eval_primitive(const array& value) noexcept {
+  return value.has_primitive()&&value.primitive().stream().device==Device::cpu&&
+      typeid(value.primitive())==typeid(Arange);
+}
+bool arange_float_eval_layout(size_t elements,bool tracer,CopyEvalStorage& out) noexcept {
+  if(!elements||elements>size_t(INT_MAX)||elements>size_t(PTRDIFF_MAX)/sizeof(float))return false;
+  EvalDispatchStorage task;SingleOutputEvalStorage common;
+  if(!arange_float_dispatch_storage(task)||!single_output_raw_task_layout(1,0,tracer,task,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  const size_t controls=sizeof(elements)+sizeof(tracer)+sizeof(out)+sizeof(task)+sizeof(common)+sizeof(value)+
+      sizeof(std::tuple<double,double,double>)+sizeof(double)*5+sizeof(const array*)+
+      sizeof(const Arange*)+sizeof(size_t)*2+sizeof(bool)*2+
+      sizeof(submission::FixedEvalPrologueGuard*)+sizeof(submission::Record*)+sizeof(submission::GraphQuota*)+
+      sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(controls>SIZE_MAX-value.named_control_bytes)return false;
+  value.named_control_bytes+=controls;out=value;return true;
+}
+bool arange_float_eval_storage(const array& value,CopyEvalStorage& out) noexcept {
+  if(!is_arange_eval_primitive(value)||!value.siblings().empty()||!value.inputs().empty()||value.ndim()!=1||
+      value.dtype()!=float32||value.itemsize()!=sizeof(float)||value.shape(0)<=0||
+      size_t(value.shape(0))!=value.size())return false;
+  const auto [start,stop,step]=static_cast<const Arange&>(value.primitive()).state();
+  if(!std::isfinite(start)||!std::isfinite(stop)||!std::isfinite(step)||step==0)return false;
+  const auto length=std::ceil((stop-start)/step);
+  if(!std::isfinite(length)||length!=double(value.size()))return false;
+  return arange_float_eval_layout(value.size(),value.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_arange_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::arange_float_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
