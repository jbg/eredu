+namespace mlx::core::allocator {
+MemoryPlacement memory_placement(Buffer buffer) noexcept {
+  auto* backing = static_cast<const cu::CudaBuffer*>(buffer.ptr());
+  return backing && backing->data ? backing->placement : MemoryPlacement{1, -1, 0};
+}
+bool memory_device_shares_host(int index) {
+  // CUDA exposes independent allocation domains. Integrated-device sharing is
+  // accepted only when the runtime explicitly reports an integrated GPU.
+  int integrated = 0;
+  if (cudaDeviceGetAttribute(&integrated, cudaDevAttrIntegrated, index) != cudaSuccess)
+    throw std::runtime_error("Unable to establish CUDA physical memory topology.");
+  return integrated != 0;
+}
+} // namespace mlx::core::allocator
