diff --git a/mlx/backend/metal/allocator.cpp b/mlx/backend/metal/allocator.cpp
--- a/mlx/backend/metal/allocator.cpp
+++ b/mlx/backend/metal/allocator.cpp
@@ -468,3 +468,17 @@
 namespace mlx::core::allocator {
 bool original_buffer_zero_has_backing(bool& out) noexcept { out = false; return true; }
 }
+
+namespace mlx::core::allocator {
+MemoryPlacement memory_placement(Buffer buffer) noexcept {
+  auto* backing = static_cast<MTL::Buffer*>(buffer.ptr());
+  if (!backing) return {1, -1, 0};
+  // Shared storage physically resides in host memory on discrete devices too.
+  if (backing->storageMode() == MTL::StorageModeShared) return {1, -1, 0};
+  if (backing->storageMode() == MTL::StorageModePrivate) return {2, 0, 0};
+  return {}; // Managed Metal resources need both copies attributed explicitly.
+}
+bool memory_device_shares_host(int index) {
+  return index == 0 && metal::device(mlx::core::Device::gpu).mtl_device()->hasUnifiedMemory();
+}
+} // namespace mlx::core::allocator
