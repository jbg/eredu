+namespace {
+using HostSourceQuota = submission::GraphQuota;
+using HostSourceCause = allocator::PreparedInputCause;
+struct HostSourceConstruction {
+  HostSourceQuota::Request requests[3];
+  PreparedHostTransferLayout layout{};
+  allocator::PreparedInputAllocation* backing = nullptr;
+  void* memory = nullptr;
+  uint64_t generation = 0;
+};
+struct HostSourceBlocks {
+  HostSourceQuota* quota;
+  ~HostSourceBlocks() { quota->finish_blocks(); }
+};
+struct HostSourceIncoming {
+  allocator::PreparedInputAllocation* backing;
+  ~HostSourceIncoming() { if (backing) backing->destroy(); }
+};
+size_t host_source_function_bytes() noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L && !defined(_LIBCPP_ABI_OPTIMIZED_FUNCTION)
+  using Fn = std::__function::__func<HostTransferArrayDeleter, void(allocator::Buffer)>;
+  if (sizeof(Fn) > 3 * sizeof(void*) ||
+      !std::is_nothrow_copy_constructible_v<HostTransferArrayDeleter>) return 0;
+  return sizeof(Fn);
+#else
+  return 0;
+#endif
+}
+bool host_source_requests(HostSourceQuota::Request* out) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L && !defined(_LIBCPP_ABI_OPTIMIZED_FUNCTION)
+  if (!host_source_function_bytes()) return false;
+  using Control = std::__shared_ptr_emplace<HostTransferStorage,
+      submission::GraphAllocator<HostTransferStorage>>;
+  out[0] = {sizeof(allocator::PreparedInputAllocation), alignof(allocator::PreparedInputAllocation)};
+  out[1] = {sizeof(Control), alignof(Control)};
+  out[2] = {sizeof(PreparedHostTransferSource), alignof(PreparedHostTransferSource)};
+  return true;
+#else
+  return false;
+#endif
+}
