+bool flat_scatter_dispatch_storage(EvalDispatchStorage& out) noexcept {
+  if (Shape::inline_capacity < 2 || Strides::inline_capacity < 2) return false;
+  DispatchLayout task;
+  WeakCopyStorage weak_one, weak_two;
+  ContiguousIteratorLayout index_it, update_it, output_it;
+  if (!CommandEncoder::dispatch_layout<ScatterTask>(task) ||
+      !PreparedInputLeaf::weak_copy_storage(1, weak_one) ||
+      !PreparedInputLeaf::weak_copy_storage(2, weak_two) ||
+      !contiguous_iterator_layout(1, index_it) ||
+      !contiguous_iterator_layout(2, update_it) ||
+      !contiguous_iterator_layout(1, output_it)) return false;
+  EvalDispatchStorage value{task.task_bytes, task.task_alignment, 0, 0};
+  for (size_t extent : {index_it.graph_extent_sum, update_it.graph_extent_sum, output_it.graph_extent_sum}) {
+    if (extent > SIZE_MAX - value.worker_graph_extents) return false;
+    value.worker_graph_extents += extent;
+  }
+  const size_t controls[] = {task.controls, weak_one.controls, weak_one.controls, weak_two.controls,
+      index_it.controls, update_it.controls, output_it.controls,
+      sizeof(out), sizeof(task), sizeof(weak_one), sizeof(weak_two),
