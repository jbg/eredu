+      sizeof(int64_t) * 4, sizeof(const void*) * 3, sizeof(Stream), sizeof(CommandEncoder*), sizeof(Dtype) * 2};
+  value.controls = sizeof(controls);
+  for (size_t control : controls) {
+    if (control > SIZE_MAX - value.controls) return false;
+    value.controls += control;
+  }
+  out = value; return true;
