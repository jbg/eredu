--- /dev/null
+++ b/mlx/backend/cuda/jit_include_paths.h
@@ -0,0 +1,60 @@
+// Copyright © 2026 Eredu contributors.
+#pragma once
+
+#include <filesystem>
+#include <vector>
+
+namespace mlx::core::cu::detail {
+
+inline std::filesystem::path find_header_directory(
+    const std::vector<std::filesystem::path>& candidates,
+    const std::filesystem::path& header) {
+  for (const auto& candidate : candidates) {
+    std::error_code error;
+    if (!candidate.empty() &&
+        std::filesystem::is_regular_file(candidate / header, error)) {
+      return candidate;
+    }
+  }
+  return {};
+}
+
+// Resolve symlinks before deriving the sibling include directory: loader paths
+// may name a library symlink outside the toolkit (for example under /usr/lib).
+inline std::filesystem::path cuda_include_from_library(
+    const std::filesystem::path& library) {
+  std::error_code error;
+  auto resolved = std::filesystem::canonical(library, error);
+  if (error) {
+    return {};
+  }
+  return find_header_directory(
+      {resolved.parent_path().parent_path() / "include"}, "cuda_runtime.h");
+}
+
+inline std::filesystem::path find_cuda_toolkit(
+    const std::vector<std::filesystem::path>& roots) {
+  std::vector<std::filesystem::path> candidates;
+  for (const auto& root : roots) {
+    candidates.push_back(root / "include");
+  }
+  auto include = find_header_directory(candidates, "cuda_runtime.h");
+  return include.empty() ? std::filesystem::path{} : include.parent_path();
+}
+
+inline std::filesystem::path find_cccl_include_path(
+    const std::filesystem::path& bundled,
+    const std::filesystem::path& compiled,
+    const std::filesystem::path& runtime_include,
+    const std::vector<std::filesystem::path>& system_candidates) {
+  std::vector<std::filesystem::path> candidates{bundled, compiled};
+  if (!runtime_include.empty()) {
+    candidates.push_back(runtime_include / "cccl");
+    candidates.push_back(runtime_include);
+  }
+  candidates.insert(
+      candidates.end(), system_candidates.begin(), system_candidates.end());
+  return find_header_directory(candidates, "cuda/std/tuple");
+}
+
+} // namespace mlx::core::cu::detail
