+void add_include_path(
+    std::vector<std::string>& args,
+    const std::filesystem::path& path) {
+  auto argument = fmt::format("--include-path={}", path.string());
+  if (std::find(args.begin(), args.end(), argument) == args.end()) {
+    args.push_back(argument);
+  }
