+
+void add_configured_include_paths(std::vector<std::string>& args) {
+  const char* configured = std::getenv("MLX_CUDA_JIT_INCLUDE_DIRS");
+  if (!configured || !*configured) {
+    return;
+  }
+#if defined(_WIN32)
+  constexpr char separator = ';';
+#else
+  constexpr char separator = ':';
+#endif
+  std::string paths(configured);
+  for (size_t begin = 0; begin <= paths.size();) {
+    auto end = paths.find(separator, begin);
+    auto path = std::filesystem::path(paths.substr(begin, end - begin));
+    if (!path.empty()) {
+      if (!std::filesystem::is_directory(path)) {
+        throw std::runtime_error(fmt::format(
+            "MLX_CUDA_JIT_INCLUDE_DIRS contains a missing directory: {}",
+            path.string()));
+      }
+      add_include_path(args, path);
+    }
+    if (end == std::string::npos) {
+      break;
+    }
+    begin = end + 1;
+  }
+}
