+
+bool retain_host_transfer_allocation_owner(
+    const array& value, std::shared_ptr<void> owner) {
+  if (!host_transfer_allocation_info(value)) {
+    return false;
+  }
+  const auto* retained =
+      value.data_shared_ptr()->d.target<HostTransferArrayDeleter>();
+  retained->owner->retain_allocation_owner(std::move(owner));
+  return true;
 }
 
