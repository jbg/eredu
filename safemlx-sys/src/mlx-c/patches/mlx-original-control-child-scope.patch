+size_t Scope::original_child_control_bytes() noexcept {
+  // Factory arguments plus the explicit constructor parent and selection
+  // locals; no new allocated object or mutable domain slot is introduced.
+  return sizeof(Scope*) * 2 + sizeof(void*) + sizeof(void (*)(void*)) +
+      sizeof(RecordQuota*) * 2 + sizeof(GraphQuota*) * 2 + sizeof(bool);
+}
+
+Scope* Scope::original_child(Scope& parent, void* owner, void (*retire)(void*),
+    RecordQuota* quota, GraphQuota* graph) {
+  return new Scope(owner, retire, quota, graph, &parent);
+}
