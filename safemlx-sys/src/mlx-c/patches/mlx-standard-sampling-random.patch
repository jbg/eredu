@@ -10,6 +11,31 @@
 #include "mlx/utils.h"
 
 namespace mlx::core::random {
+
+size_t standard_sampling_control_bytes() noexcept {
+  const size_t gpu = metal::random_bits_control_bytes();
+  if (!gpu) return 0;
+  // Key: the real initializer-list seed and final source descriptor.
+  const size_t seed = sizeof(uint64_t) + 2 * sizeof(uint32_t) +
+      sizeof(std::initializer_list<uint32_t>) + sizeof(Shape) + sizeof(array);
+  // bits/split: explicit key copy, width/dtype lambda, shape and stream loans.
+  // The default KeySequence branch is unreachable with the supplied key.
+  const size_t bits = 2 * sizeof(array) + sizeof(std::optional<array>) +
+      sizeof(Shape) + 2 * sizeof(int) + sizeof(Dtype) + sizeof(StreamOrDevice) +
+      4 * sizeof(void*);
+  // uniform: lo/hi/range/upper/maxval/out, low/high source arguments and the
+  // minimum/cast plus multiply/add expression temporaries. Shapes are inline
+  // for this rank<=3 route; every owned array body is already in Graph/P.
+  const size_t uniform = 11 * sizeof(array) + sizeof(Shape) +
+      sizeof(Dtype) + sizeof(Stream) + sizeof(StreamOrDevice) +
+      sizeof(std::optional<array>) + 5 * sizeof(void*);
+  // Four nested Gumbel unary expressions plus uniform's result; outer
+  // categorical shape, gumbel_shape, g and add/argmax result temporaries.
+  const size_t categorical = 8 * sizeof(array) + 2 * sizeof(Shape) +
+      3 * sizeof(int) + sizeof(size_t) + 2 * sizeof(StreamOrDevice) +
+      2 * sizeof(std::optional<array>) + 6 * sizeof(void*);
+  return gpu + seed + bits + uniform + categorical + 5 * sizeof(size_t);
+}
 
 KeySequence::KeySequence(uint64_t seed) : key_(key(seed)) {}
 
