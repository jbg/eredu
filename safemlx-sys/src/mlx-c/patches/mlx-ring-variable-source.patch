+array all_to_all_v_prepared(const array& input, std::span<const size_t> matrix,
+    bool transposed, const Group& group, StreamOrDevice stream) {
+  group.ensure_submission_available();
+  GroupStorageInventory inventory;
+  if (!group.storage_inventory(inventory) ||
+      (inventory.kind != GroupStorageKind::ring && inventory.kind != GroupStorageKind::empty) ||
+      input.is_tracer())
+    throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+  const auto layout = GroupTensorLayout::checked(input);
+  const auto source = layout ? VariableAllToAllGeometry::checked(*layout, group.size(),
+      group.rank(), matrix, transposed) : std::nullopt;
+  if (!source) throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+  if (source->members() == 1) return input;
+  auto shape = input.shape();
+  shape[0] = int(source->output_rows());
+  return array(std::move(shape), input.dtype(),
+      submission::make_graph_primitive<AllToAllV>(
+          detail::communication_stream(group, stream), group, *source), {input});
+}
 } // namespace mlx::core::distributed
