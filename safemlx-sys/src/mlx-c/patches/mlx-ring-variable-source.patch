@@ -0,0 +1,117 @@
+#pragma once
+
+#include "mlx/distributed/tensor_layout.h"
+#include "mlx/graph_quota.h"
+
+namespace mlx::core::distributed {
+class VariableAllToAllPlan;
+
+// Borrowed complete semantic count matrix. No native ownership, caller bytes,
+// capacities or communication permission are encoded by this checked geometry.
+class VariableAllToAllGeometry {
+ public:
+  static std::optional<VariableAllToAllGeometry> checked(
+      const GroupTensorLayout& input, int members, int rank,
+      std::span<const size_t> matrix, bool transposed) noexcept {
+    if (members <= 0 || rank < 0 || rank >= members || !input.ndim()) return std::nullopt;
+    const size_t world = size_t(members);
+    if (world > size_t(PTRDIFF_MAX) / sizeof(size_t) / world ||
+        matrix.size() != world * world) return std::nullopt;
+    size_t row_bytes = input.itemsize();
+    for (size_t d = 1; d < input.ndim(); ++d) {
+      const size_t dimension = size_t(input.shape()[d]);
+      if (dimension && row_bytes > size_t(PTRDIFF_MAX) / dimension) return std::nullopt;
+      row_bytes *= dimension;
+    }
+    VariableAllToAllGeometry value(matrix, transposed, world, size_t(rank), row_bytes);
+    // Every forwarded packet and every source/destination extent is checked,
+    // including rows owned by peers that this rank only routes through.
+    for (size_t source = 0; source < world; ++source) {
+      size_t sent = 0, received = 0;
+      for (size_t destination = 0; destination < world; ++destination) {
+        const size_t a = value.count(source, destination);
+        const size_t b = value.count(destination, source);
+        if (a > size_t(INT_MAX) - sent || b > size_t(INT_MAX) - received) return std::nullopt;
+        sent += a; received += b;
+      }
+      if (row_bytes && (sent > size_t(PTRDIFF_MAX) / row_bytes ||
+                        received > size_t(PTRDIFF_MAX) / row_bytes)) return std::nullopt;
+      if (source == size_t(rank)) {
+        if (sent != size_t(input.shape()[0])) return std::nullopt;
+        value.input_rows_ = sent; value.output_rows_ = received;
+      }
+    }
+    return value;
+  }
+  std::span<const size_t> matrix() const noexcept { return matrix_; }
+  bool transposed() const noexcept { return transposed_; }
+  size_t members() const noexcept { return members_; }
+  size_t rank() const noexcept { return rank_; }
+  size_t row_bytes() const noexcept { return row_bytes_; }
+  size_t input_rows() const noexcept { return input_rows_; }
+  size_t output_rows() const noexcept { return output_rows_; }
+  size_t output_bytes() const noexcept { return output_rows_ * row_bytes_; }
+  size_t count(size_t source, size_t destination) const noexcept {
+    return matrix_[transposed_ ? destination * members_ + source : source * members_ + destination];
+  }
+  size_t bytes(size_t source, size_t destination) const noexcept {
+    return count(source, destination) * row_bytes_;
+  }
+  size_t send_offset(size_t destination) const noexcept {
+    size_t offset = 0;
+    for (size_t peer = 0; peer < destination; ++peer) offset += bytes(rank_, peer);
+    return offset;
+  }
+  size_t receive_offset(size_t source) const noexcept {
+    size_t offset = 0;
+    for (size_t peer = 0; peer < source; ++peer) offset += bytes(peer, rank_);
+    return offset;
+  }
+  size_t hop_source(size_t hop) const noexcept { return (rank_ + members_ - hop) % members_; }
+  size_t hop_destination(size_t distance, size_t hop) const noexcept {
+    return (hop_source(hop) + distance) % members_;
+  }
+  size_t hop_bytes(size_t distance, size_t hop) const noexcept {
+    return bytes(hop_source(hop), hop_destination(distance, hop));
+  }
+  static constexpr size_t inspection_controls() noexcept {
+    return sizeof(VariableAllToAllGeometry) * 2 + sizeof(std::optional<VariableAllToAllGeometry>) +
+        sizeof(GroupTensorLayout) + sizeof(std::span<const size_t>) + sizeof(size_t) * 12 +
+        sizeof(int) * 2 + sizeof(bool) * 2;
+  }
+ private:
+  friend class VariableAllToAllPlan;
+  VariableAllToAllGeometry(std::span<const size_t> matrix, bool transposed,
+      size_t members, size_t rank, size_t row_bytes) noexcept
+      : matrix_(matrix), transposed_(transposed), members_(members), rank_(rank), row_bytes_(row_bytes) {}
+  std::span<const size_t> matrix_;
+  bool transposed_;
+  size_t members_, rank_, row_bytes_, input_rows_{0}, output_rows_{0};
+};
+
+// Each asynchronous owner copies the checked matrix into its own counted
+// destination. A task never borrows a primitive's potentially retired storage.
+class VariableAllToAllPlan {
+ public:
+  VariableAllToAllPlan() = default;
+  explicit VariableAllToAllPlan(const VariableAllToAllGeometry& source)
+      : matrix_(source.matrix().begin(), source.matrix().end()),
+        transposed_(source.transposed()), members_(source.members()), rank_(source.rank()),
+        row_bytes_(source.row_bytes()), input_rows_(source.input_rows()), output_rows_(source.output_rows()) {}
+  VariableAllToAllPlan(VariableAllToAllPlan&&) = default;
+  VariableAllToAllPlan& operator=(VariableAllToAllPlan&&) = default;
+  VariableAllToAllPlan(const VariableAllToAllPlan&) = delete;
+  VariableAllToAllPlan& operator=(const VariableAllToAllPlan&) = delete;
+  bool prepared() const noexcept { return members_ != 0; }
+  VariableAllToAllGeometry geometry() const noexcept {
+    VariableAllToAllGeometry result(std::span<const size_t>(matrix_.data(), matrix_.size()),
+        transposed_, members_, rank_, row_bytes_);
+    result.input_rows_ = input_rows_; result.output_rows_ = output_rows_;
+    return result;
+  }
+ private:
+  submission::GraphVector<size_t> matrix_;
+  bool transposed_{false};
+  size_t members_{0}, rank_{0}, row_bytes_{0}, input_rows_{0}, output_rows_{0};
+};
