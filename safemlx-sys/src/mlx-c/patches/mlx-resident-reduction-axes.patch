new file mode 100644
--- /dev/null
+++ b/mlx/axis_view.h
@@ -0,0 +1,36 @@
+#pragma once
+#include "mlx/array.h"
+
+namespace mlx::core {
+// A synchronous read-only axis loan. Owners remain Shape/ordinary vector;
+// no view is stored in a primitive, callback or returned ReductionPlan.
+class AxisView {
+ public:
+  AxisView(const Shape& axes) noexcept
+      : data_(axes.data()), size_(axes.size()) {}
+  AxisView(const std::vector<int>& axes) noexcept
+      : data_(axes.data()), size_(axes.size()) {}
+  const int* begin() const noexcept {
+    return data_;
+  }
+  const int* end() const noexcept {
+    return size_ ? data_ + size_ : data_;
+  }
+  size_t size() const noexcept {
+    return size_;
+  }
+  bool empty() const noexcept {
+    return !size_;
+  }
+  int operator[](size_t i) const noexcept {
+    return data_[i];
+  }
+  int back() const noexcept {
+    return data_[size_ - 1];
+  }
+
+ private:
+  const int* data_;
+  size_t size_;
+};
+} // namespace mlx::core
