+// Synchronous template argument loan from either ordinary owned names or a
+// fixed caller's borrowed names. No view is retained by generated primitives.
+using NamedTemplateView = std::pair<std::string_view, TemplateArg>;
+class TemplateArgsView {
+ public:
+  TemplateArgsView(const std::vector<std::pair<std::string, TemplateArg>>& args)
+      : owned_(args.data()), count_(args.size()) {}
+  TemplateArgsView(std::span<const NamedTemplateView> args)
+      : borrowed_(args.data()), count_(args.size()) {}
+  size_t size() const noexcept { return count_; }
+  bool empty() const noexcept { return count_ == 0; }
+  NamedTemplateView operator[](size_t i) const {
+    return owned_ ? NamedTemplateView{owned_[i].first, owned_[i].second} : borrowed_[i];
+  }
+  struct Iterator {
+    const TemplateArgsView* owner;
+    size_t index;
+    NamedTemplateView operator*() const { return (*owner)[index]; }
+    Iterator& operator++() { ++index; return *this; }
+    bool operator!=(const Iterator& other) const { return index != other.index; }
+  };
+  Iterator begin() const { return {this, 0}; }
+  Iterator end() const { return {this, count_}; }
+ private:
+  const std::pair<std::string, TemplateArg>* owned_{nullptr};
+  const NamedTemplateView* borrowed_{nullptr};
+  size_t count_;
+};
