@@ -0,0 +1,18 @@
+#pragma once
+#include "mlx/array.h"
+#include "mlx/graph_construction.h"
+
+namespace mlx::core::cpu {
+// Existing Contiguous copy branch or the private completion no-op. These are
+// host/worker request populations only; backing, events and source custody are
+// separate. Physical bank installation requires the actual accepted primitive.
+struct CopyEvalStorage : submission::GraphConstructionLayout {
+  size_t rank{0}, inputs{0}, backing_births{0};
+  size_t worker_graph_extents{0};
+  bool copy{false}, tracer{false};
+};
+MLX_API bool copy_eval_layout(size_t rank, size_t inputs, bool copy, bool tracer,
+    CopyEvalStorage&) noexcept;
+MLX_API bool is_copy_eval_primitive(const array&) noexcept;
+MLX_API bool copy_eval_storage(const array&, CopyEvalStorage&) noexcept;
+} // namespace mlx::core::cpu
