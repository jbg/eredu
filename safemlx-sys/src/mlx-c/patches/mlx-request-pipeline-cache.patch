+#include "mlx/backend/common/pipeline_cache.h"
+#include "mlx/graph_quota.h"
+#include <algorithm>
+#include <cassert>
+#include <limits>
+#include <new>
+
+namespace mlx::core::fast {
+namespace {
+constexpr size_t alignment = std::max(alignof(PreparedPipelineCache), alignof(PreparedPipeline));
+constexpr size_t row_offset = (sizeof(PreparedPipelineCache) + alignment - 1) & ~(alignment - 1);
+struct Retirement { void* memory; void* owner; void (*retire)(void*); size_t rows; };
+}
+PipelineCacheStatus PreparedPipelineCache::layout(size_t attempts, PipelineCacheLayout& out) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return PipelineCacheStatus::unknown_layout;
+#else
+  static_assert(std::atomic<size_t>::is_always_lock_free);
+  static_assert(std::atomic<const submission::GraphQuota*>::is_always_lock_free);
+  size_t platform;
+  if (!pipeline_cache_platform_controls(attempts, platform)) return PipelineCacheStatus::unknown_layout;
+  constexpr auto limit = size_t(std::numeric_limits<ptrdiff_t>::max());
+  if (attempts > (limit - row_offset) / sizeof(PreparedPipeline)) return PipelineCacheStatus::overflow;
+  const size_t controls = sizeof(PipelineCacheLayout) * 2 + sizeof(Retirement) +
+      sizeof(PreparedPipelineCache*) * 3 + sizeof(PreparedPipeline*) +
+      sizeof(PipelineCacheRef) * 2 + sizeof(size_t) * 8 + sizeof(PipelineCacheStatus) * 2 + sizeof(PipelineCacheError) +
+      submission::GraphQuota::pipeline_cache_control_bytes();
+  if (platform > limit - controls) return PipelineCacheStatus::overflow;
+  out = {row_offset + attempts * sizeof(PreparedPipeline), alignment, controls + platform};
+  return PipelineCacheStatus::success;
+#endif
+}
+PreparedPipelineCache::PreparedPipelineCache(size_t capacity, void* owner, void (*retire)(void*)) noexcept
+    : capacity_(capacity), owner_(owner), retire_(retire) {}
+PreparedPipeline* PreparedPipelineCache::rows() noexcept {
+  return reinterpret_cast<PreparedPipeline*>(reinterpret_cast<char*>(this) + row_offset);
+}
+PipelineCacheStatus PreparedPipelineCache::create(size_t attempts, void* owner,
+    void (*retire)(void*), PreparedPipelineCache*& output) noexcept {
+  if (!owner || !retire || output) return PipelineCacheStatus::invalid;
+  PipelineCacheLayout facts;
+  const auto cause = layout(attempts, facts);
+  if (cause != PipelineCacheStatus::success) return cause;
+  auto* memory = ::operator new(facts.allocation_bytes, std::align_val_t(alignment), std::nothrow);
+  if (!memory) return PipelineCacheStatus::allocation_failed;
+  // Qualified libc++ mutex construction is noexcept. No callback or throwing
+  // operation follows allocation before the complete owner is handed off.
+  static_assert(std::is_nothrow_default_constructible_v<PreparedPipeline>);
+  auto* value = ::new (memory) PreparedPipelineCache(attempts, owner, retire);
+  for (size_t i = 0; i < attempts; ++i) ::new (value->rows() + i) PreparedPipeline{};
+  output = value;
+  return PipelineCacheStatus::success;
+}
+void PreparedPipelineCache::retain() noexcept {
+  if (references_.fetch_add(1, std::memory_order_relaxed) == std::numeric_limits<size_t>::max()) std::terminate();
+}
+void PreparedPipelineCache::release() noexcept {
+  if (references_.fetch_sub(1, std::memory_order_acq_rel) != 1) return;
+  const Retirement retired{this, owner_, retire_, capacity_};
+  for (size_t i = retired.rows; i; --i) rows()[i - 1].~PreparedPipeline();
+  this->~PreparedPipelineCache();
+  ::operator delete(retired.memory, std::align_val_t(alignment));
+  retired.retire(retired.owner); // no Graph/Scope/Record ownership in this source
+}
+bool PreparedPipelineCache::bind(const submission::GraphQuota* graph) noexcept {
+  if (!graph || used_.load(std::memory_order_acquire)) return false;
+  const submission::GraphQuota* absent = nullptr;
+  return bound_.compare_exchange_strong(absent, graph, std::memory_order_release, std::memory_order_relaxed);
+}
+PreparedPipeline& PreparedPipelineCache::next() {
+  auto used = used_.load(std::memory_order_relaxed);
+  do {
+    if (used >= capacity_) throw PipelineCacheError(PipelineCacheStatus::exhausted);
+  } while (!used_.compare_exchange_weak(used, used + 1, std::memory_order_acq_rel, std::memory_order_relaxed));
+  return rows()[used];
+}
+} // namespace mlx::core::fast
