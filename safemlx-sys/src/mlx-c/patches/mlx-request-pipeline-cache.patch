new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/kernels/indexing/gather_front.metal
@@ -0,0 +1,35 @@
+// Copyright © 2025 Apple Inc.
+// Exact existing gather_front worker: all native data/index types, both offset
+// widths, and the two actual work-per-thread choices. No alternate equation.
+#include "mlx/backend/metal/kernels/utils.h"
+#include "mlx/backend/metal/kernels/indexing/gather_front.h"
+
+#define GATHER_FRONT_WIDTH(tname, type, iname, index, n) \
+  instantiate_kernel("gather_front" #tname "_" #iname "_int_" #n, gather_front, type, index, int, n) \
+  instantiate_kernel("gather_front" #tname "_" #iname "_int64_t_" #n, gather_front, type, index, int64_t, n)
+#define GATHER_FRONT_INDICES(tname, type, n) \
+  GATHER_FRONT_WIDTH(tname, type, bool_, bool, n) \
+  GATHER_FRONT_WIDTH(tname, type, uint8, uint8_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, uint16, uint16_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, uint32, uint32_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, uint64, uint64_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, int8, int8_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, int16, int16_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, int32, int32_t, n) \
+  GATHER_FRONT_WIDTH(tname, type, int64, int64_t, n)
+#define GATHER_FRONT_SMALL(tname, type) \
+  GATHER_FRONT_INDICES(tname, type, 1) \
+  GATHER_FRONT_INDICES(tname, type, 2)
+GATHER_FRONT_SMALL(bool_, bool)
+GATHER_FRONT_SMALL(uint8, uint8_t)
+GATHER_FRONT_SMALL(uint16, uint16_t)
+GATHER_FRONT_SMALL(int8, int8_t)
+GATHER_FRONT_SMALL(int16, int16_t)
+GATHER_FRONT_SMALL(float16, half)
+GATHER_FRONT_SMALL(bfloat16, bfloat16_t)
+GATHER_FRONT_INDICES(uint32, uint32_t, 1)
+GATHER_FRONT_INDICES(uint64, uint64_t, 1)
+GATHER_FRONT_INDICES(int32, int32_t, 1)
+GATHER_FRONT_INDICES(int64, int64_t, 1)
+GATHER_FRONT_INDICES(float32, float, 1)
+GATHER_FRONT_INDICES(complex64, complex64_t, 1)
