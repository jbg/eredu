+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <exception>
+#include <type_traits>
+#include <utility>
+#include "mlx/api.h"
+#include "mlx/backend/common/prepared_kernel.h"
+
+namespace mlx::core::submission { class GraphQuota; }
+namespace mlx::core::fast {
+enum class PipelineCacheStatus : unsigned {
+  success = 0, unknown_layout, invalid, overflow, allocation_failed,
+  already_bound, exhausted,
+};
+class PipelineCacheError final : public std::exception {
+ public:
+  explicit PipelineCacheError(PipelineCacheStatus cause) noexcept : cause_(cause) {}
+  PipelineCacheStatus cause() const noexcept { return cause_; }
+  const char* what() const noexcept override { return "prepared Metal pipeline destinations exhausted"; }
+ private:
+  PipelineCacheStatus cause_;
+};
+struct PipelineCacheLayout {
+  size_t allocation_bytes, alignment, control_bytes;
+};
+// Platform compiler/driver storage is excluded. This query names the actual
+// managed handles and call frames used by the precompiled selector worker.
+MLX_API bool pipeline_cache_platform_controls(size_t attempts, size_t& output) noexcept;
+class MLX_API PreparedPipelineCache final {
+ public:
+  static PipelineCacheStatus layout(size_t attempts, PipelineCacheLayout&) noexcept;
+  static PipelineCacheStatus create(size_t attempts, void* owner,
+      void (*retire)(void*), PreparedPipelineCache*& output) noexcept;
+  void retain() noexcept;
+  void release() noexcept;
+  // Each actual selector attempt consumes one destination before platform work.
+  // The resulting handles stay here through the same request's final aliases.
+  PreparedPipeline& next();
+  size_t capacity() const noexcept { return capacity_; }
+ private:
+  friend class submission::GraphQuota;
+  bool bind(const submission::GraphQuota*) noexcept;
+  PreparedPipelineCache(size_t, void*, void (*)(void*)) noexcept;
+  ~PreparedPipelineCache() = default;
+  PreparedPipeline* rows() noexcept;
+  std::atomic<size_t> references_{1};
+  std::atomic<size_t> used_{0};
+  std::atomic<const submission::GraphQuota*> bound_{nullptr}; // identity only
+  size_t capacity_;
+  void* owner_;
+  void (*retire_)(void*);
+};
+class PipelineCacheRef {
+ public:
+  explicit PipelineCacheRef(PreparedPipelineCache* value = nullptr) noexcept : value_(value) {
+    if (value_) value_->retain();
+  }
+  PipelineCacheRef(const PipelineCacheRef& value) noexcept : PipelineCacheRef(value.value_) {}
+  PipelineCacheRef(PipelineCacheRef&& value) noexcept : value_(std::exchange(value.value_, nullptr)) {}
+  PipelineCacheRef& operator=(const PipelineCacheRef&) = delete;
+  ~PipelineCacheRef() { if (value_) value_->release(); }
+ private:
+  PreparedPipelineCache* value_;
+};
+} // namespace mlx::core::fast
