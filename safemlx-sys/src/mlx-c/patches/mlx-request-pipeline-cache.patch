+bool Device::original_precompiled_kernel_required() const {
+  const auto controls = submission::current_native_controls();
+  if (controls.failure != submission::NativeControlFailure::none)
+    throw submission::NativeControlError(controls.failure);
+  if (!controls.original) return false;
+  if (!controls.graph || !controls.graph->pipeline_cache())
+    throw submission::NativeControlError(submission::NativeControlFailure::missing_graph);
+  return true;
+}
