+  // No key/hash identity reuse, ordinary cache hit, or generated source escapes.
+  auto function = get_function_(base_name, specialized_name, constants, library, &request);
+  auto links = get_linked_functions_(linked);
+  auto pipeline = get_kernel_(specialized_name, function.get(), links.get(), &request);
+  slot.pipeline = pipeline->retain();
+  return pipeline.get();
