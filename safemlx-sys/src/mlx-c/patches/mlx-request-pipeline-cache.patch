+      sizeof(submission::NativeControlBinding) * 2 + sizeof(const std::string*) * 4 +
+      sizeof(std::tuple<const void*, MTL::DataType, NS::UInteger>) +
+      sizeof(void*) * 8 + sizeof(size_t) * 4;
+  if (selector > size_t(PTRDIFF_MAX) - fixed) return false;
+  out = selector + fixed;
+  return true;
+#else
+  return false;
+#endif
