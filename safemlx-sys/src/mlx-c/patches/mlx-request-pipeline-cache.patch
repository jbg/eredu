@@ -0,0 +1,17 @@
+#pragma once
+#include <cstddef>
+#include "mlx/api.h"
+
+namespace mlx::core::metal {
+// Transient caller-owned storage of the closed dense resident selectors.
+// Persistent pipelines and platform-private compiler objects are separate.
+struct ResidentSelectorLayout {
+  size_t allocation_bytes_per_lookup;
+  size_t control_bytes_per_lookup;
+  size_t maximum_name_bytes;
+  size_t maximum_function_constants;
+  size_t linked_functions;
+};
+MLX_API bool resident_selector_layout(ResidentSelectorLayout&) noexcept;
+MLX_API bool resident_selector_control_bytes(size_t attempts, size_t& output) noexcept;
+} // namespace mlx::core::metal
