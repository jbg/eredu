diff --git a/mlx/backend/metal/selector_controls.cpp b/mlx/backend/metal/selector_controls.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/selector_controls.cpp
@@ -0,0 +1,115 @@
+#include "mlx/backend/metal/selector_controls.h"
+#include "mlx/backend/metal/device.h"
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <string>
+#include <utility>
+#include <fmt/format.h>
+
+namespace mlx::core::metal {
+namespace {
+template <size_t N> constexpr size_t text(const char (&)[N]) { return N - 1; }
+// type_to_name and get_type_string_view are closed Dtype switches. All type
+// and individual integer conversions fit the qualified string's inline room.
+constexpr size_t dtype_tag = text("complex64");
+constexpr size_t source_type = text("complex64_t");
+constexpr size_t integer = std::numeric_limits<int>::digits10 + 2;
+constexpr size_t size_integer = std::numeric_limits<size_t>::digits10 + 1;
+constexpr size_t gemm_base = text("steel_gemm_splitk_nax_") + 2 +
+    2 * (1 + dtype_tag) + text("_bm_bn_bk_wm_wn") + 5 * integer;
+constexpr size_t gemm_specialized = gemm_base +
+    text("_has_batch__use_out_source__do_axpby__align_M__align_N__align_K_") + 6;
+constexpr size_t gemm_split = gemm_base + text("_MN_aligned_K_aligned") + 2;
+constexpr size_t gemv = text("gemv_t_") + dtype_tag +
+    text("_bm_bn_sm_sn_tm_tn_nc_axpby") + 6 * integer + 2;
+constexpr size_t attention_base = text("steel_attention_") + 2 * dtype_tag +
+    text("_bq_bk_bd_wm_wn_mask") + 5 * integer;
+constexpr size_t attention = attention_base +
+    text("_align_Q__align_K__has_mask__do_causal__has_sinks_") + 5;
+constexpr size_t vector_attention = text("sdpa_vector_2pass_1_") + source_type +
+    2 * (1 + integer) + text("_floatmask_qnt_nc_nosinks_") + integer;
+constexpr size_t reduce = text("col_reduce_longcolumn_large___reduce_") +
+    3 * integer + text("prod") + dtype_tag;
+constexpr size_t indexing = text("gather_front___") + 2 * dtype_tag +
+    text("int64_t") + integer;
+constexpr size_t pointwise = text("ggnlarge_") + size_integer +
+    text("BitwiseRightShift") + 2 * dtype_tag;
+constexpr size_t rope = text("rope_single_freqs_large__vjp_traditional_transpose") + dtype_tag;
+constexpr size_t normalization = text("layer_norm_looped") + dtype_tag;
+constexpr size_t maximum_name = std::max({gemm_specialized, gemm_split, gemv,
+    attention, vector_attention, reduce, indexing, pointwise, rope, normalization});
+
+// The widest formatting call is split-K: two transpose chars, two dtype tags,
+// five integer tile values and two alignment chars. Other formatting calls use
+// no more storage; append-based selectors use the same finite name bound.
+using FormatArguments = decltype(fmt::make_format_args(
+    std::declval<char&>(), std::declval<char&>(),
+    std::declval<std::string&>(), std::declval<std::string&>(),
+    std::declval<int&>(), std::declval<int&>(), std::declval<int&>(),
+    std::declval<int&>(), std::declval<int&>(),
+    std::declval<char&>(), std::declval<char&>()));
+
+// libc++ 210106 __recommend rounds (requested+1) to eight. Each append
+// growth requests max(new_size,2*old_capacity), then recommendation; C++20's
+// default allocator returns that exact count. Summing every requested buffer
+// in a monotone name's geometric sequence (including a failed final request)
+// is below twice its final requested count. That count is at most
+// round_up(2*maximum_name+1,8). Explicit reserve(64) in SDPA is below this
+// source bound. Copies and fmt results each request at most one such buffer.
+constexpr size_t name_request = ((2 * maximum_name + 1 + 7) / 8) * 8;
+constexpr size_t name_sequence = 2 * name_request;
+// Largest simultaneously entered name population: SDPA base, specialized name
+// and concatenate's by-value base loan. The two-pass reduction keeps its first
+// and second names plus function-name owner. Dense GEMM has two fmt results;
+// gather_front has kernel/lib copies. No JIT builder body runs in this profile.
+constexpr size_t name_owners = 3;
+// SDPA's first two-pass kernel has six boolean constants plus blocks (integer).
+// Dense GEMM has six; RoPE three. All are direct vector initializer lists,
+// never growing inserts, with the exact actual tuple element representation.
+constexpr size_t constants = 7;
+}
+
+bool resident_selector_layout(ResidentSelectorLayout& out) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || \
+    __cplusplus != 202002L || FMT_VERSION != 120100
+  return false;
+#else
+  static_assert(sizeof(std::string) == 3 * sizeof(void*));
+  static_assert(size_integer < 23 && integer < 23 && source_type < 23);
+  static_assert(maximum_name < fmt::inline_buffer_size);
+  // All selected calls use the default empty linked-function vector. This is
+  // a derived zero for these source call sites, not general Device coverage.
+  constexpr size_t linked = 0;
+  constexpr size_t allocation = name_owners * name_sequence +
+      constants * sizeof(MTLFCList::value_type);
+  // The longest concatenate call has 14 arguments (attention base); each
+  // recursive frame retains its by-value suffix: 14+13+...+1 parameters.
+  // Every parameter is string, pointer, char or int, no larger than string.
+  // Only base_name can exceed inline storage and it is the first argument
+  // of its separate hash call, so this recursion adds no hidden long copies.
+  constexpr size_t concatenate_arguments = 14;
+  constexpr size_t concatenate_parameters =
+      concatenate_arguments * (concatenate_arguments + 1) / 2;
+  constexpr size_t controls = sizeof(ResidentSelectorLayout) * 2 +
+      sizeof(fmt::memory_buffer) + sizeof(FormatArguments) + sizeof(fmt::format_args) +
+      sizeof(std::string) * (name_owners + concatenate_parameters) +
+      sizeof(MTLFCList) + sizeof(MTLFCList::value_type) * constants +
+      sizeof(std::vector<MTL::Function*>) +
+      sizeof(std::string*) * concatenate_arguments;
+  out = {allocation, controls, maximum_name, constants, linked};
+  return true;
+#endif
+}
+bool resident_selector_control_bytes(size_t attempts, size_t& output) noexcept {
+  ResidentSelectorLayout layout;
+  if (!resident_selector_layout(layout)) return false;
+  constexpr auto limit = size_t(std::numeric_limits<ptrdiff_t>::max());
+  if (layout.control_bytes_per_lookup > limit - layout.allocation_bytes_per_lookup)
+    return false;
+  const size_t per_lookup = layout.allocation_bytes_per_lookup + layout.control_bytes_per_lookup;
+  if (attempts > limit / per_lookup) return false;
+  output = attempts * per_lookup;
+  return true;
+}
+} // namespace mlx::core::metal
