+// Full broadcasts one actual stored value per row. The copy source is the
+// completed broadcast alias, and the ordinary General/Vector copy writes out.
+static bool row_full_source(const array& input,size_t elements) noexcept {
+  if(input.dtype()!=float32||input.itemsize()!=sizeof(float)||!input.ndim())return false;
+  const size_t rank=input.ndim(),width=size_t(input.shape(rank-1)),rows=elements/width;
+  if(input.data_size()!=rows)return false;
+  if(input.strides()[rank-1]<0||(width>1&&input.strides()[rank-1]!=0))return false;
+  size_t stride=1;
+  for(size_t axis=rank-1;axis--;) {
+    if(input.strides()[axis]<0||
+        (input.shape(axis)>1&&size_t(input.strides()[axis])!=stride)||
+        !product(stride,size_t(input.shape(axis)),stride))return false;
+  }
+  return stride==rows;
+}
