+bool PreparedInputArray::layout(size_t& bytes, size_t& controls) noexcept {
+  if (!submission::GraphQuota::allocation_extent(
+          sizeof(PreparedInputArray), alignof(PreparedInputArray), bytes)) return false;
+  // Actual make_array locals, output pointer and fixed status, including the
+  // pointer retained across object destruction/deallocation.
+  controls = sizeof(void*) + sizeof(PreparedInputArray*) +
+      sizeof(submission::GraphQuota*) + sizeof(allocator::PreparedInputCause);
+  return true;
+}
+allocator::PreparedInputCause PreparedInputLeaf::make_array(
+    PreparedInputArray*& out) const noexcept {
+  static_assert(std::is_nothrow_copy_constructible_v<array>);
+  static_assert(std::is_nothrow_destructible_v<array>);
+  if (out) return allocator::PreparedInputCause::invalid;
+  void* memory = quota_->try_allocate(sizeof(PreparedInputArray), alignof(PreparedInputArray));
+  if (!memory) return allocator::PreparedInputCause::capacity;
+  out = ::new (memory) PreparedInputArray(value_, quota_);
+  return allocator::PreparedInputCause::success;
+}
+void PreparedInputArray::destroy() noexcept {
+  auto* quota = quota_;
+  this->~PreparedInputArray();
+  quota->deallocate(this, sizeof(PreparedInputArray), alignof(PreparedInputArray));
+}
 void PreparedInputLeaf::destroy() noexcept {
   auto* quota = quota_;
   this->~PreparedInputLeaf();
