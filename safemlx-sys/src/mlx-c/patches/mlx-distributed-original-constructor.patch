+#pragma once
+#include "mlx/distributed/distributed.h"
+#include "mlx/graph_construction.h"
+namespace mlx::core::distributed {
+// Exact host-only lazy constructor. No Data/backing, Eval, task, completion or
+// persistent communicator allowance. The original source remains borrowed.
+struct GroupConstructorStorage : submission::GraphConstructionLayout {
+  size_t output_rank{0}, output_elements{0}, primitives{0}, input_edges{0};
+};
+MLX_API bool constructor_storage(const Group&, const array&, GroupWorkerOperation,
+    int peer, GroupConstructorStorage&) noexcept;
+MLX_API size_t constructor_storage_inspection_controls() noexcept;
+} // namespace mlx::core::distributed
