+bool cpu_mxfp4_quantize_construction_layout(Dtype dtype,size_t rank,
+    size_t rows,size_t columns,CpuMxFp4QuantizeConstructionLayout& output) noexcept {
+  if((dtype!=float16&&dtype!=bfloat16&&dtype!=float32)||rank<2||rank>size_t(INT_MAX)||
+      rank>Shape::max_size()||rank>Strides::max_size()||!rows||!columns||columns%32||
+      columns>size_t(INT_MAX)||rows>size_t(INT_MAX)/16/columns)return false;
+  // Each binary frontend may construct two casts, two broadcasts and its
+  // primitive; where may construct three casts/broadcasts and Select. Count
+  // potential identity nodes too, so shape-dependent elision cannot grow this
+  // bound. The seven views include both reduction squeezes and four reshapes.
+  constexpr size_t binary_candidates=8*5;
+  constexpr size_t select_candidates=7;
+  // Cast candidates include log2's input dtype normalization.
+  constexpr size_t unary_candidates=4,cast_candidates=4,view_candidates=7;
+  constexpr size_t reductions=3,ranges=1;
+  constexpr size_t candidates=binary_candidates+select_candidates+unary_candidates+
+      cast_candidates+view_candidates+reductions+ranges;
+  CpuMxFp4QuantizeConstructionLayout value;
+  if(!resident_graph_layout(candidates,6,std::max(rank,size_t(3)),value.graph))return false;
+  // maxval, zero, power base, exponent offset, F32 lookup table, packing base.
+  const size_t requests[]={dtype.size(),dtype.size(),dtype.size(),sizeof(int32_t),
+      16*sizeof(float),sizeof(uint32_t)};
+  std::copy(std::begin(requests),std::end(requests),std::begin(value.seed_request_bytes));
+  // Named quantizer/query frames and a conservative sum of the potential
+  // frontend call transports; descriptor and callable storage is in Graph.
+  const size_t frontend_controls=sizeof(StreamOrDevice)+sizeof(Stream)+sizeof(Dtype)*3+
+      sizeof(array)*3+sizeof(ArrayVector)*3+sizeof(Shape)*4+sizeof(AxisView)*2+
+      sizeof(std::optional<bool>)+sizeof(int)*4+sizeof(size_t)*4;
+  const size_t controls[]={sizeof(value),sizeof(output),sizeof(dtype),sizeof(rank),
+      sizeof(rows),sizeof(columns),sizeof(requests),sizeof(frontend_controls),
+      sizeof(FpQuantizeFallback),sizeof(array)*9,sizeof(ArrayVector)*3,sizeof(Shape)*3,
+      sizeof(StreamOrDevice),sizeof(Stream),sizeof(std::optional<int>)*2,
+      sizeof(std::optional<array>),sizeof(std::string),sizeof(QuantizationMode),
+      sizeof(float),sizeof(int)*4,sizeof(size_t)*3};
+  size_t frames=0;
+  if(!resident_multiply(candidates,frontend_controls,frames))return false;
+  value.named_control_bytes=sizeof(controls)+sizeof(size_t);
+  if(!add(value.named_control_bytes,frames,value.named_control_bytes))return false;
+  for(size_t bytes:controls)if(!add(value.named_control_bytes,bytes,value.named_control_bytes))return false;
+  output=value;return true;
+}
