--- a/mlx/physical_backing.cpp	1970-01-01 01:00:00
+++ b/mlx/physical_backing.cpp	2026-09-21 16:11:25
@@ -0,0 +1,88 @@
+// Copyright © 2026 Eredu contributors.
+#include "mlx/host_transfer.h"
+#include "mlx/allocator.h"
+#include "mlx/array.h"
+#include <mutex>
+#include <memory>
+
+namespace mlx::core::allocator {
+namespace {
+std::mutex roots_mutex;
+PhysicalBacking* roots = nullptr;
+PhysicalBackingObserver observer = nullptr;
+void* observer_context = nullptr;
+}
+PhysicalBacking::PhysicalBacking(uint64_t id, size_t bytes, size_t controls, MemoryPlacement where) noexcept
+    : generation(id), capacity(bytes), host_controls(controls), placement(where) {}
+PhysicalBacking::~PhysicalBacking() {
+  {
+    std::lock_guard lock(roots_mutex);
+    if (registry_previous) registry_previous->registry_next = registry_next;
+    else if (roots == this) roots = registry_next;
+    if (registry_next) registry_next->registry_previous = registry_previous;
+  }
+}
+void destroy_physical_backing(PhysicalBacking* root) noexcept {
+  if (!root) return;
+  auto* observation = root->observation;
+  const auto release = root->release_observation;
+  // Another host thread may drain the deferred Rust queue immediately. Keep
+  // its accounting owner private until operator delete has freed this block.
+  delete root;
+  if (release) release(observation);
+}
+size_t physical_backing_control_bytes() noexcept { return sizeof(PhysicalBacking); }
+size_t physical_backing_static_bytes() noexcept { return sizeof(roots_mutex) + sizeof(roots) + sizeof(observer) + sizeof(observer_context) + host_transfer_static_bytes(); }
+PhysicalBacking* prepare_physical_backing(size_t capacity, MemoryPlacement placement, size_t extra) {
+  if (extra > std::numeric_limits<size_t>::max() - sizeof(PhysicalBacking))
+    throw std::overflow_error("Physical backing control size overflow.");
+  const auto controls = sizeof(PhysicalBacking) + extra;
+  const auto identity = next_allocation_generation();
+  if (!identity) throw std::overflow_error("Physical backing identity exhausted.");
+  std::lock_guard lock(roots_mutex);
+  void* payload = nullptr;
+  void (*release)(void*) = nullptr;
+  PhysicalBackingPublish publish = nullptr;
+  if (observer && !observer(observer_context, identity, capacity, controls, placement, &payload, &release, &publish))
+    throw PhysicalBackingAdmissionError(payload, release);
+  PhysicalBacking* root = nullptr;
+  try { root = new PhysicalBacking(identity, capacity, controls, placement); }
+  catch (...) { if (release) release(payload); throw; }
+  root->observation = payload;
+  root->release_observation = release;
+  root->publish_observation = publish;
+  root->registry_next = roots;
+  if (roots) roots->registry_previous = root;
+  roots = root;
+  return root;
+}
+void publish_physical_backing(PhysicalBacking* root) {
+  if (!root || !root->publish_observation) return;
+  void* failure = nullptr;
+  void (*release)(void*) = nullptr;
+  if (!root->publish_observation(root->observation, &failure, &release))
+    throw PhysicalBackingAdmissionError(failure, release);
+  root->publish_observation = nullptr;
+}
+bool observe_physical_backings(void* context, PhysicalBackingObserver callback) {
+  std::lock_guard lock(roots_mutex);
+  if (observer) return observer == callback && observer_context == context;
+  // Installing observers precedes ledger admission. Refusal keeps already paid
+  // roots attached and leaves the observer uninstalled for an explicit retry.
+  for (auto* root = roots; root; root = root->registry_next) {
+    if (root->release_observation) continue;
+    void* payload = nullptr;
+    void (*release)(void*) = nullptr;
+    PhysicalBackingPublish publish = nullptr;
+    if (!callback(context, root->generation, root->capacity, root->host_controls,
+                  root->placement, &payload, &release, &publish)) throw PhysicalBackingAdmissionError(payload, release);
+    root->observation = payload;
+    root->release_observation = release;
+    root->publish_observation = publish;
+    publish_physical_backing(root);
+  }
+  observer = callback;
+  observer_context = context;
+  return true;
+}
+} // namespace mlx::core::allocator
