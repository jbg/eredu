+
+std::shared_ptr<array::ArrayDesc> array::make_descriptor(Shape shape, Dtype dtype) {
+  // shared_ptr invokes the same deleter if control-block allocation fails.
+  // Do not catch and delete the raw descriptor a second time.
+  return std::shared_ptr<ArrayDesc>(
+      new ArrayDesc(std::move(shape), dtype), RetireDescriptor{});
+}
+
+std::shared_ptr<array::ArrayDesc> array::make_descriptor(
+    Shape shape,
+    Dtype dtype,
+    std::shared_ptr<Primitive> primitive,
+    std::vector<array> inputs) {
+  return std::shared_ptr<ArrayDesc>(
+      new ArrayDesc(
+          std::move(shape), dtype, std::move(primitive), std::move(inputs)),
+      RetireDescriptor{});
+}
+
+// Expand removed known edges before this point. Primitive/Event/custom Data
