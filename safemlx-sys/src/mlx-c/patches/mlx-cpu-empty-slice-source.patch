+// Shared allocate_data(0) branch: one Data owner, no physical backing or task.
+bool append_empty_data_layout(CopyEvalStorage& value) noexcept {
+  if(value.request_counts[3] || value.backing_births || value.copy)return false;
+  WeakCopyStorage descriptor;
+  size_t allocation_controls=0;
+  if(!PreparedInputLeaf::weak_copy_storage(0,descriptor)||descriptor.count!=3||
+      !allocator::original_buffer_allocation_control_bytes(allocation_controls))return false;
+  value.request_counts[3]=1;
+  value.request_bytes[3]=descriptor.requests[2].bytes;
+  value.request_alignments[3]=descriptor.requests[2].alignment;
+  const auto adoption=array::buffer_adoption_layout();
+  const size_t empty_controls[]={sizeof(descriptor),sizeof(allocation_controls),sizeof(adoption),
+      sizeof(allocator::Buffer),sizeof(Deleter),sizeof(std::shared_ptr<array::Data>),
+      sizeof(submission::GraphAllocator<array::Data>),sizeof(submission::CaptureSlot),adoption.incoming_bytes,
+      adoption.scratch_owner_bytes,adoption.deleter_bytes,adoption.allocator_callable_bytes,
+      adoption.prepared_strides_bytes,allocation_controls};
+  if(sizeof(empty_controls)>SIZE_MAX-value.named_control_bytes)return false;
+  value.named_control_bytes+=sizeof(empty_controls);
+  for(size_t bytes:empty_controls) {
+    if(bytes>SIZE_MAX-value.named_control_bytes)return false;
+    value.named_control_bytes+=bytes;
+  }
+  if(sizeof(size_t)>SIZE_MAX-value.named_control_bytes)return false;
+  value.named_control_bytes+=sizeof(size_t);
+  if(!submission::GraphConstruction::complete_layout(value))return false;
+  if(!add(value.named_control_bytes,sizeof(CopyEvalStorage&)))return false;
+  return true;
+}
