+bool unary_eval_storage(const array& output, UnaryEvalStorage& out) noexcept {
+  UnaryEvalKind selected;
+  if (!is_unary_eval_primitive(output) || !kind(output.primitive(), selected) ||
+      !output.siblings().empty() || output.inputs().size() != 1) return false;
+  const auto& input = output.inputs()[0];
+  if (input.dtype() != output.dtype() || input.shape() != output.shape()) return false;
+  size_t size = 1;
+  for (auto dimension : input.shape()) {
+    if (dimension < 0 || (dimension && size > size_t(PTRDIFF_MAX) / size_t(dimension))) return false;
+    size *= size_t(dimension);
+  }
+  if (size != input.size() || size != output.size() ||
+      size > size_t(PTRDIFF_MAX) / output.itemsize() ||
+      input.data_size() > size_t(PTRDIFF_MAX) / output.itemsize()) return false;
+  return unary_eval_layout(selected, output.dtype(), output.ndim(), output.is_tracer(), out);
+}
+} // namespace mlx::core::cpu
+
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_unary_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record = guard.record();
+  auto* graph = record.graph_quota();
+  const auto context = current_graph_construction_context();
+  if (out || !graph || !guard.cpu() || !context.scope || context.worker ||
+      context.dispatch != &record || current_graph_quota() != graph) return GraphFailure::foreign_parent;
+  cpu::UnaryEvalStorage actual;
+  if (!cpu::unary_eval_storage(guard.current(), actual)) return GraphFailure::invalid_layout;
+  return create_layout(*graph, context.scope, &record, actual, out, true);
+}
+} // namespace mlx::core::submission
