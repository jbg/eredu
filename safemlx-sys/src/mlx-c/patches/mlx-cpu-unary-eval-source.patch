+        sizeof(simd::Simd<int16_t, simd::max_size<int16_t>>),
+        sizeof(simd::Simd<int32_t, simd::max_size<int32_t>>),
+        sizeof(simd::Simd<int64_t, simd::max_size<int64_t>>),
+        sizeof(simd::Simd<uint8_t, simd::max_size<uint8_t>>),
+        sizeof(simd::Simd<uint16_t, simd::max_size<uint16_t>>),
+        sizeof(simd::Simd<uint32_t, simd::max_size<uint32_t>>),
+        sizeof(simd::Simd<uint64_t, simd::max_size<uint64_t>>),
+        sizeof(simd::Simd<float16_t, simd::max_size<float16_t>>),
