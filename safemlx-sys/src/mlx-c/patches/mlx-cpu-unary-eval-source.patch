+namespace mlx::core::cpu {
+namespace {
+bool add(size_t& value, size_t more) noexcept {
+  if (more > SIZE_MAX - value) return false;
+  value += more; return true;
+}
+bool kind(const Primitive& primitive, UnaryEvalKind& out) noexcept {
+#define SIMPLE(Type, Kind) if (typeid(primitive) == typeid(Type)) { out = UnaryEvalKind::Kind; return true; }
+  SIMPLE(Exp, exponential)
+  SIMPLE(Expm1, expm1)
+  SIMPLE(Log1p, log1p)
+  SIMPLE(Sigmoid, sigmoid)
+  SIMPLE(Tanh, tanh)
+  SIMPLE(Sin, sine)
+  SIMPLE(Cos, cosine)
+  SIMPLE(Square, square)
+  SIMPLE(Negative, negative)
+  SIMPLE(Erf, erf)
+#undef SIMPLE
+  if (typeid(primitive) == typeid(Sqrt)) {
+    out = static_cast<const Sqrt&>(primitive).state() ? UnaryEvalKind::rsqrt : UnaryEvalKind::sqrt;
+    return true;
+  }
+  if (typeid(primitive) == typeid(Log)) {
+    switch (static_cast<const Log&>(primitive).state()) {
+      case Log::Base::e: out = UnaryEvalKind::log; return true;
+      case Log::Base::two: out = UnaryEvalKind::log2; return true;
+      case Log::Base::ten: out = UnaryEvalKind::log10; return true;
+    }
+  }
+  return false;
+}
+} // namespace
+bool is_unary_eval_primitive(const array& output) noexcept {
+  UnaryEvalKind selected;
+  return output.has_primitive() && output.primitive().stream().device == Device::cpu &&
+      kind(output.primitive(), selected);
+}
+bool unary_eval_layout(UnaryEvalKind selected, Dtype dtype, size_t rank, bool tracer,
+    UnaryEvalStorage& out) noexcept {
+  EvalDispatchStorage dispatch;
+  SingleOutputEvalStorage common;
