+namespace mlx::core::cpu {
+// Empty fixed destinations for one output, its ordinary cleanup and optional
+// two-weak-array task. The caller supplies an exact task query; only a private
+// actual-primitive constructor can install this bank in an Eval prologue.
+struct EvalDispatchStorage {
+  size_t task_bytes{0}, task_alignment{0};
+  size_t worker_graph_extents{0}, controls{0};
+};
+struct SingleOutputEvalStorage : submission::GraphConstructionLayout {
+  size_t rank{0}, inputs{0}, backing_births{0};
+  size_t worker_graph_extents{0};
+  bool tracer{false};
+};
+bool single_output_eval_layout(size_t rank, size_t inputs, bool tracer,
+    const EvalDispatchStorage*, SingleOutputEvalStorage&) noexcept;
