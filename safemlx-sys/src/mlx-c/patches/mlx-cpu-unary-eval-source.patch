+      !single_output_eval_layout(rank, 1, tracer, &dispatch, common)) return false;
+  UnaryEvalStorage value;
+  static_cast<SingleOutputEvalStorage&>(value) = common;
+  value.kind = selected; value.dtype = dtype;
+  const size_t controls = sizeof(UnaryEvalStorage) * 2 + sizeof(EvalDispatchStorage) +
+      sizeof(SingleOutputEvalStorage) + sizeof(UnaryEvalKind) * 3 + sizeof(Dtype) * 3 +
+      sizeof(size_t) * 5 + sizeof(bool) * 3 + sizeof(const array*) * 3 +
+      sizeof(const Primitive*) + sizeof(submission::FixedEvalPrologueGuard*) +
+      sizeof(submission::GraphConstruction*) + sizeof(submission::GraphConstructionContext) +
+      sizeof(submission::GraphFailure) + sizeof(submission::Record*) + sizeof(submission::GraphQuota*);
+  if (!add(value.named_control_bytes, controls)) return false;
+  out = value; return true;
