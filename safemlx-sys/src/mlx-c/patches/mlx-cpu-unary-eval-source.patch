+bool floating_dtype(Dtype dtype, bool real) noexcept {
+  return dtype == float16 || dtype == bfloat16 || dtype == float32 || dtype == float64 ||
+      (!real && dtype == complex64);
+}
+bool all_dtype(Dtype dtype) noexcept {
+  return floating_dtype(dtype, false) || dtype == bool_ || dtype == int8 || dtype == int16 ||
+      dtype == int32 || dtype == int64 || dtype == uint8 || dtype == uint16 ||
+      dtype == uint32 || dtype == uint64;
+}
+} // namespace
+bool unary_dispatch_storage(UnaryEvalKind selected, Dtype dtype, size_t rank,
+    EvalDispatchStorage& out) noexcept {
+  switch (selected) {
+#define FLOATING(Kind, Op) case UnaryEvalKind::Kind: return floating_dtype(dtype, false) && unary_task_storage<UnaryFloatingTask<::mlx::core::detail::Op>>(rank, out);
+    FLOATING(exponential, Exp)
+    FLOATING(expm1, Expm1)
+    FLOATING(log, Log)
+    FLOATING(log2, Log2)
+    FLOATING(log10, Log10)
+    FLOATING(log1p, Log1p)
+    FLOATING(sigmoid, Sigmoid)
+    FLOATING(tanh, Tanh)
+    FLOATING(sine, Sin)
+    FLOATING(cosine, Cos)
+    FLOATING(sqrt, Sqrt)
+    FLOATING(rsqrt, Rsqrt)
+#undef FLOATING
+    case UnaryEvalKind::square:
+      return all_dtype(dtype) && unary_task_storage<UnaryTask<::mlx::core::detail::Square>>(rank, out);
+    case UnaryEvalKind::negative:
+      return all_dtype(dtype) && unary_task_storage<UnaryTask<::mlx::core::detail::Negative>>(rank, out);
+    case UnaryEvalKind::erf:
+      return floating_dtype(dtype, true) && unary_task_storage<UnaryRealTask<::mlx::core::detail::Erf>>(rank, out);
+  }
+  return false;
+}
+} // namespace mlx::core::cpu
