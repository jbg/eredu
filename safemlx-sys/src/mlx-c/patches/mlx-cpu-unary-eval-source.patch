+template<class Vector>
+bool unary_small_extent(size_t rank, size_t& out) noexcept {
+  if (rank <= Vector::inline_capacity) { out = 0; return true; }
+  const size_t capacity = std::max(rank, 2 * Vector::inline_capacity);
+  if (capacity > size_t(PTRDIFF_MAX) / sizeof(typename Vector::value_type)) return false;
+  return submission::GraphQuota::allocation_extent(capacity * sizeof(typename Vector::value_type),
+      alignof(typename Vector::value_type), out);
+}
