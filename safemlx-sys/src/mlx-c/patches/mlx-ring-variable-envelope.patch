 #include "mlx/distributed/tensor_layout.h"
 #include "mlx/graph_quota.h"
+#include <algorithm>
 
 namespace mlx::core::distributed {
 class VariableAllToAllPlan;
+
+// Descriptive global row ceilings for storage inspection only. It has no count
+// matrix and cannot be passed to the prepared variable constructor or worker.
+class VariableAllToAllEnvelope {
+ public:
+  static std::optional<VariableAllToAllEnvelope> checked(
+      const GroupTensorLayout& input, int members, int rank,
+      size_t maximum_receive_rows) noexcept {
+    if (members <= 1 || rank < 0 || rank >= members || !input.ndim() ||
+        maximum_receive_rows > size_t(INT_MAX)) return std::nullopt;
+    const size_t world = size_t(members);
+    if (world > size_t(PTRDIFF_MAX) / sizeof(size_t) / world) return std::nullopt;
+    size_t row_bytes = input.itemsize();
+    for (size_t axis = 1; axis < input.ndim(); ++axis) {
+      const size_t dimension = size_t(input.shape()[axis]);
+      if (dimension && row_bytes > size_t(PTRDIFF_MAX) / dimension) return std::nullopt;
+      row_bytes *= dimension;
+    }
+    const size_t sent = size_t(input.shape()[0]);
+    if (row_bytes && (sent > size_t(PTRDIFF_MAX) / row_bytes ||
+        maximum_receive_rows > size_t(PTRDIFF_MAX) / row_bytes)) return std::nullopt;
+    return VariableAllToAllEnvelope(world, maximum_receive_rows,
+        maximum_receive_rows * row_bytes, std::min(sent, maximum_receive_rows) * row_bytes);
+  }
+  size_t members() const noexcept { return members_; }
+  size_t output_rows() const noexcept { return output_rows_; }
+  size_t output_bytes() const noexcept { return output_bytes_; }
+  size_t matrix_entries() const noexcept { return members_ * members_; }
+  size_t hop_bytes(size_t, size_t) const noexcept { return packet_bytes_; }
+  static constexpr size_t inspection_controls() noexcept {
+    return sizeof(VariableAllToAllEnvelope) * 2 + sizeof(std::optional<VariableAllToAllEnvelope>) +
+        sizeof(GroupTensorLayout) + sizeof(size_t) * 8 + sizeof(int) * 2 + sizeof(bool) * 3;
+  }
+ private:
+  VariableAllToAllEnvelope(size_t members, size_t rows, size_t bytes, size_t packet) noexcept
+      : members_(members), output_rows_(rows), output_bytes_(bytes), packet_bytes_(packet) {}
+  size_t members_, output_rows_, output_bytes_, packet_bytes_;
+};
 
