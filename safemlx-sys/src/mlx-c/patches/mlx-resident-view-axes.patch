+namespace {
+// Sorted/deduplicated view axes need no tree nodes or recursive sort storage.
+// The caller owns one inline/Graph Shape. Duplicate and range error ordering
+// stays in the ordinary squeeze/expand entry points below.
+bool sort_unique_view_axes(Shape& axes) {
+  for (size_t i = 1; i < axes.size(); ++i) {
+    const auto value = axes[i];
+    size_t j = i;
+    while (j && axes[j - 1] > value) {
+      axes[j] = axes[j - 1];
+      --j;
+    }
+    axes[j] = value;
+  }
+  return std::adjacent_find(axes.begin(), axes.end()) == axes.end();
+}
