+namespace mlx::core {
+// Exact eager U32/I32[1,N] source under an already admitted original Scope.
+// Graph storage and physical mutable backing are separate contributions.
+struct OriginalPromptInputLayout {
+  size_t metadata_bytes{0};
+  size_t backing_bytes{0};
+  size_t controls{0};
+  size_t ordinary_handle_bytes{0};
+};
+MLX_API bool original_prompt_input_layout(const allocator::PreparedInputFacts&,
+    size_t elements, OriginalPromptInputLayout&) noexcept;
+MLX_API PreparedHostCopyCause construct_original_prompt_input(
+    const uint32_t*, size_t elements, PreparedInputArray*&) noexcept;
+MLX_API PreparedHostCopyCause construct_original_prediction_input(
+    const int32_t*, size_t elements, PreparedInputArray*&) noexcept;
