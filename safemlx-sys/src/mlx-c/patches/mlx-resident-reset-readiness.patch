@@ -330,6 +330,34 @@
   } catch (...) { return {WorkerCause::busy}; }
 }
 
+CpuWorkerStartupResult observe_initialized_cpu_worker_idle(uint64_t scheduler_identity,
+    Stream stream, const void* stream_birth, const void* worker_birth) noexcept {
+  if (!worker_birth || stream.device != Device::cpu) return {WorkerCause::identity_mismatch};
+  const auto prerequisite = worker_prerequisites(scheduler_identity, stream, stream_birth);
+  if (prerequisite.cause != WorkerCause::success) return prerequisite;
+  auto* owner = prepared_scheduler();
+  try {
+    std::shared_lock lock(owner->threads_mtx_, std::try_to_lock);
+    if (!lock.owns_lock()) return {WorkerCause::busy};
+    const auto* entry = owner->threads_.find(stream.index);
+    if (!entry || !entry->worker || entry->original_birth.value != worker_birth ||
+        !entry->worker->stream || *entry->worker->stream != stream)
+      return {WorkerCause::identity_mismatch};
+    const auto& worker = *entry->worker;
+    // Completed is published after actual Task/capture retirement. Read it
+    // first so concurrent acceptance cannot be hidden by a newer completion.
+    const auto completed = worker.completed.load(std::memory_order_acquire);
+    const auto admission = worker.admission.load(std::memory_order_acquire);
+    if (owner->stopping_.load(std::memory_order_acquire) ||
+        worker.failed.load(std::memory_order_acquire) ||
+        (admission & StreamThread::blocked_bit) ||
+        (admission & StreamThread::sequence_mask) == StreamThread::sequence_mask)
+      return {WorkerCause::execution_failed};
+    return {(admission & StreamThread::sequence_mask) == completed
+        ? WorkerCause::success : WorkerCause::busy};
+  } catch (...) { return {WorkerCause::busy}; }
+}
+
 Scheduler::Scheduler() {
   is_main_thread();
   gpu::init();
