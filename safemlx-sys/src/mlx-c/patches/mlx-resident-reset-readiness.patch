+      return Cause::execution_failed;
+    const auto progress = submission_state_->query();
+    if (!submission_idle() || progress.accepted != progress.completed || encoder_ ||
+        buffer_ops_ || buffer_sizes_ || timer_ || resources_.first() != nullptr ||
+        temporaries_.size() != 0 || waiting_fences_.first() != nullptr ||
+        (receipt_ && (receipt_->active || !receipt_->handlers.empty() ||
+                     !receipt_->waits.empty() || !receipt_->signals.empty())))
+      return Cause::busy;
+    return Cause::success;
+  }
 
