+DeviceTransfer copy_to_host_into(
+    const array& source,
+    const HostTransferBuffer& destination,
+    StreamOrDevice stream) {
+  const auto controls = submission::current_native_controls();
+  size_t original_controls = 0;
+  if (controls.original) {
+    const Stream selected = to_stream(stream);
+    if (controls.failure != submission::NativeControlFailure::none)
+      throw submission::NativeControlError(controls.failure);
+    if (!controls.graph || !submission::current_scope())
+      throw ScopedEvaluationError(ScopedEvaluation::domain);
+    if (!destination || source.shape() != destination.shape() ||
+        source.dtype() != destination.dtype() ||
+        source.status() != array::Status::available ||
+        destination.policy() != HostTransferPolicy::transfer ||
+        destination.storage_kind() != HostTransferStorageKind::metal_shared ||
+        selected.device.type != Device::gpu ||
+        !original_host_store_control_bytes(source.ndim(), source.dtype(), original_controls))
+      throw ScopedEvaluationError(ScopedEvaluation::unobservable);
+    const auto ready = preflight_original_submission_stream(*submission::current_scope(), selected);
+    if (ready != ScopedEvaluation::complete) throw ScopedEvaluationError(ready);
+    const auto bank = submission::GraphConstruction::validate_nested(
+        *controls.graph, controls.scope_identity, 1);
+    if (bank != submission::GraphFailure{}) throw submission::GraphQuotaError(bank);
+  } else if (!destination || source.shape() != destination.shape() ||
+             source.dtype() != destination.dtype()) {
+    throw std::invalid_argument("[copy_to_host_into] Destination differs from source.");
+  }
+  // The ordinary and prepared paths construct the same contiguous/copy pair.
+  // Prepared ownership supplies the final host allocation before submission.
   auto output = array(
-      source.shape(),
-      source.dtype(),
-      submission::make_graph_primitive<CopyToHostTransfer>(to_stream(stream), buffer),
+      source.shape(), source.dtype(),
+      submission::make_graph_primitive<CopyToHostTransfer>(to_stream(stream), destination),
       {contiguous(source, false, stream)});
+  if (controls.original) {
+    submission::GraphNestedEvaluation suspended;
+    const auto bank = submission::GraphConstruction::suspend_nested(
+        *controls.graph, controls.scope_identity, 1, suspended);
+    if (bank != submission::GraphFailure{}) throw submission::GraphQuotaError(bank);
+    if (suspended.limits().streams != 1)
+      throw ScopedEvaluationError(ScopedEvaluation::domain);
+    // Completed source + optional compaction + CopyToHostTransfer. The output
+    // Data aliases the paid host buffer; only compaction can allocate Device.
+    CompletionEvalRecordLayout record;
+    if (!completion_eval_record_layout(3, 1, 3, record))
+      throw ScopedEvaluationError(ScopedEvaluation::unobservable);
+    const CompletionEvalTraversalLimits limits{1, 4, 3, 3, 3, 1, record.capture_slots};
+    Completion completion;
+    const auto result = async_eval_with_completion_scoped_on_stream_prepared(
+        {output}, *submission::current_scope(), completion, output.primitive().stream(), limits);
+    if (result != submission::ScopedProgress::observed)
+      throw ScopedEvaluationError(evaluation_progress(result));
+    return {std::move(output), std::move(completion)};
+  }
   auto completion = async_eval_with_completion({output});
-  return {std::move(buffer), std::move(completion)};
+  return {std::move(output), std::move(completion)};
+}
+
+bool original_host_store_control_bytes(size_t rank, Dtype dtype, size_t& out) noexcept {
+  size_t copy = 0;
+  if (!original_host_copy_control_bytes(rank, dtype, copy)) return false;
+  const size_t extra = sizeof(HostTransferBuffer) + sizeof(CopyToHostTransfer) +
+      sizeof(array) + sizeof(Shape) + sizeof(HostTransfer) + sizeof(bool);
+  if (copy > SIZE_MAX - extra) return false;
+  out = copy + extra;
+  return true;
 }
 
