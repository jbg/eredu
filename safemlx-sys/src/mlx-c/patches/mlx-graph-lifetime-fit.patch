+}
+
+bool GraphQuota::allocation_population_extent(
+    size_t bytes, size_t attempts, size_t& out) noexcept {
+  if (!attempts) {
+    if (bytes) return false;
+    out = 0;
+    return true;
+  }
+  // Every nonempty request costs its bytes plus the block/offset, at most
+  // alignment-1 leading bytes, and at most alignment-1 terminal rounding.
+  // This also covers GraphConstruction's max-alignment reserved payloads.
+  const size_t overhead = sizeof(Block) + sizeof(size_t) + 2 * (alignment - 1);
+  if (bytes < attempts || attempts > absent / overhead) return false;
+  size_t extent;
+  if (!add(bytes, attempts * overhead, extent) ||
+      !align_up(extent, alignment, extent) ||
+      extent > std::numeric_limits<ptrdiff_t>::max()) return false;
+  out = extent;
+  return true;
+}
+
+size_t GraphQuota::minimum_split_bytes() noexcept {
+  return sizeof(Block) + sizeof(size_t) + alignment;
+}
+
+bool GraphQuota::fresh_capacity_for_extents(size_t extents, size_t& out) noexcept {
+  size_t capacity;
+  if (extents % alignment || !add(extents, minimum_split_bytes(), capacity)) return false;
+  GraphQuotaLayout checked;
+  if (!layout(capacity, checked)) return false;
+  out = capacity;
+  return true;
 }
 
