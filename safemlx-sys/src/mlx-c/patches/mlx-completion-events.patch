+std::shared_ptr<std::string> Scheduler::stream_error(
+    const Stream& stream) const {
+  std::lock_guard lk(mtx);
+  auto it = stream_errors_.find(stream.index);
+  return it == stream_errors_.end() ? nullptr : it->second;
+}
