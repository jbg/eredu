+Completion async_eval_with_completion(std::vector<array> outputs) {
+  if (outputs.empty()) {
+    return Completion{};
+  }
+
+  bool needs_evaluation = false;
+  for (auto& output : outputs) {
+    if (output.status() == array::Status::unscheduled ||
+        !output.is_available()) {
+      needs_evaluation = true;
+    }
+  }
+  if (!needs_evaluation) {
+    return Completion{};
+  }
+
+  auto synchronizer = eval_impl(std::move(outputs), true);
+  return Completion{synchronizer.event()};
+}
+
+void Completion::wait() const {
+  if (event_) {
+    event_->wait();
+  }
+}
+
+void Completion::wait(Stream stream) const {
+  if (!event_) {
+    return;
+  }
+  if (stream.device != *device_) {
+    std::ostringstream message;
+    message << "[Completion::wait] Incompatible producer and consumer "
+               "devices: completion is for "
+            << *device_ << ", but the consumer stream is on " << stream.device
+            << ".";
+    throw std::invalid_argument(message.str());
+  }
+  event_->wait(stream);
+}
+
+bool Completion::is_complete() const {
+  return !event_ || event_->is_signaled();
+}
+
+CompletionBackend Completion::backend() const {
+  if (!device_) {
+    return CompletionBackend::none;
+  }
+  if (*device_ == Device::cpu) {
+    return CompletionBackend::cpu;
+  }
+#if defined(MLX_USE_CUDA)
+  return CompletionBackend::cuda;
+#else
+  return CompletionBackend::metal;
+#endif
+}
