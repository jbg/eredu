new file mode 100644
index 00000000..ef7f688e
--- /dev/null
+++ b/tests/completion_tests.cpp
@@ -0,0 +1,84 @@
+// Copyright © 2026 Apple Inc.
+
+#include "doctest/doctest.h"
+
+#include "mlx/event.h"
+#include "mlx/mlx.h"
+#include "mlx/scheduler.h"
+
+using namespace mlx::core;
+
+TEST_CASE("test completion empty and already available") {
+  auto empty = async_eval_with_completion({});
+  CHECK(empty.is_complete());
+  CHECK_FALSE(empty.device().has_value());
+  empty.wait();
+  empty.wait();
+
+  auto available = array(1.0f);
+  auto ready = async_eval_with_completion({available});
+  CHECK(ready.is_complete());
+  CHECK_FALSE(ready.device().has_value());
+}
+
+TEST_CASE("test CPU completion host and stream waits") {
+  auto producer = new_thread_unsafe_stream(Device::cpu);
+  auto first_consumer = new_thread_unsafe_stream(Device::cpu);
+  auto second_consumer = new_thread_unsafe_stream(Device::cpu);
+
+  auto output = add(array(1.0f), array(2.0f), producer);
+  auto completion = async_eval_with_completion({output});
+  CHECK(completion.device() == Device(Device::cpu, 0));
+  CHECK(completion.backend() == CompletionBackend::cpu);
+
+  completion.wait(first_consumer);
+  completion.wait(second_consumer);
+  synchronize(first_consumer);
+  synchronize(second_consumer);
+  completion.wait();
+  completion.wait();
+  CHECK(completion.is_complete());
+  CHECK(completion.is_complete());
+}
+
+TEST_CASE("test CPU completion retains asynchronous failures") {
+  auto producer = new_thread_unsafe_stream(Device::cpu);
+  Event event(producer);
+  event.set_value(1);
+
+  scheduler::enqueue(producer, []() {
+    throw std::runtime_error("deterministic async producer failure");
+  });
+  event.signal(producer);
+
+  CHECK_THROWS_WITH_AS(
+      event.wait(),
+      "deterministic async producer failure",
+      std::runtime_error);
+  CHECK_THROWS_WITH_AS(
+      event.wait(),
+      "deterministic async producer failure",
+      std::runtime_error);
+  CHECK_THROWS_WITH_AS(
+      event.is_signaled(),
+      "deterministic async producer failure",
+      std::runtime_error);
+}
+
+TEST_CASE("test failed CPU event poisons consumer stream") {
+  auto producer = new_thread_unsafe_stream(Device::cpu);
+  auto consumer = new_thread_unsafe_stream(Device::cpu);
+  Event event(producer);
+  event.set_value(1);
+
+  scheduler::enqueue(producer, []() {
+    throw std::runtime_error("producer poisoned completion");
+  });
+  event.signal(producer);
+  event.wait(consumer);
+
+  CHECK_THROWS_WITH_AS(
+      synchronize(consumer),
+      "producer poisoned completion",
+      std::runtime_error);
+}
