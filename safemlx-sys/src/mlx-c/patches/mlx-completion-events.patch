new file mode 100644
index 00000000..1b002a68
--- /dev/null
+++ b/mlx/completion.h
@@ -0,0 +1,76 @@
+// Copyright © 2026 Apple Inc.
+#pragma once
+
+#include <optional>
+#include <vector>
+
+#include "mlx/api.h"
+#include "mlx/array.h"
+#include "mlx/device.h"
+#include "mlx/event.h"
+#include "mlx/stream.h"
+
+namespace mlx::core {
+
+/** The execution backend which owns a completion token. */
+enum class CompletionBackend {
+  none,
+  cpu,
+  metal,
+  cuda,
+};
+
+/**
+ * A single-shot completion token for an asynchronous evaluation.
+ *
+ * A completion is reusable for observation: it may be queried or host-waited
+ * repeatedly and may order any number of compatible consumer streams. It is
+ * not a timeline and cannot be re-recorded. Copies of its internal event are
+ * retained by queued stream waits, so destroying this public object does not
+ * invalidate outstanding work.
+ */
+class MLX_API Completion {
+ public:
+  /** Construct an already-complete token with no device identity. */
+  Completion() = default;
+
+  Completion(const Completion&) = delete;
+  Completion& operator=(const Completion&) = delete;
+  Completion(Completion&&) noexcept = default;
+  Completion& operator=(Completion&&) noexcept = default;
+  ~Completion() = default;
+
+  /** Block the host until evaluation completes, rethrowing async errors. */
+  void wait() const;
+
+  /**
+   * Order later work on `stream` after this completion.
+   *
+   * The consumer must be on the same logical device as the producer. The
+   * dependency is enqueued in the backend; this call does not synchronize the
+   * host. An identity-free, already-complete token accepts every stream.
+   */
+  void wait(Stream stream) const;
+
+  /** Return true when complete, or rethrow a retained asynchronous error. */
+  bool is_complete() const;
+
+  /** The producer device, absent for an identity-free completed token. */
+  const std::optional<Device>& device() const {
+    return device_;
+  }
+
+  /** The producer execution backend. */
+  CompletionBackend backend() const;
+
+ private:
+  explicit Completion(Event event)
+      : event_(std::move(event)), device_(event_->stream().device) {}
+
+  std::optional<Event> event_;
+  std::optional<Device> device_;
+
+  friend Completion async_eval_with_completion(std::vector<array> outputs);
+};
+
+} // namespace mlx::core
