+std::shared_ptr<std::string> Scheduler::take_stream_error(
+    const Stream& stream) {
+  std::lock_guard lk(mtx);
+  auto node = stream_errors_.extract(stream.index);
+  return node.empty() ? nullptr : std::move(node.mapped());
 }
 
