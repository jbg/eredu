diff --git a/mlx/backend/cpu/matmul_storage.cpp b/mlx/backend/cpu/matmul_storage.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/matmul_storage.cpp
@@ -0,0 +1,96 @@
+#include "mlx/backend/cpu/matmul_storage.h"
+#include "mlx/backend/cpu/encoder.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <climits>
+#include <tuple>
+#include <typeinfo>
+namespace mlx::core::cpu {
+namespace {
+bool product(size_t a,size_t b,size_t& out) noexcept {
+  if(b&&a>size_t(PTRDIFF_MAX)/b)return false;out=a*b;return true;
+}
+bool add(size_t& out,size_t more) noexcept {
+  if(more>size_t(PTRDIFF_MAX)-out)return false;out+=more;return true;
+}
+bool matrix_source(const array& value,size_t rank) noexcept {
+  if(value.ndim()!=rank||value.strides().size()!=rank||value.dtype()!=bfloat16||
+      value.itemsize()!=sizeof(bfloat16_t))return false;
+  const auto row=value.strides()[rank-2],column=value.strides()[rank-1];
+  // Exactly the no-copy branches of ordinary matmul_general::check_transpose.
+  if(!((row==value.shape(-1)&&column==1)||(row==1&&column==value.shape(-2))))return false;
+  size_t span=1,extent=0,elements=1,bytes=0;
+  for(size_t i=0;i!=rank;++i) {
+    if(value.shape(i)<=0||value.strides()[i]<0||
+        !product(elements,size_t(value.shape(i)),elements)||
+        !product(size_t(value.shape(i)-1),size_t(value.strides()[i]),extent)||!add(span,extent))return false;
+  }
+  return elements==value.size()&&elements<=size_t(INT_MAX)&&span<=value.data_size()&&
+      product(span,sizeof(bfloat16_t),bytes);
+}
+}
+bool is_bf16_matmul_eval_primitive(const array& out) noexcept {
+  return out.has_primitive()&&out.primitive().stream().device==Device::cpu&&
+      typeid(out.primitive())==typeid(Matmul)&&out.dtype()==bfloat16;
+}
+bool bf16_matmul_eval_layout(size_t rank,size_t m,size_t n,size_t k,
+    size_t batches,bool tracer,CopyEvalStorage& out) noexcept {
+  if(rank<2||rank>4||!m||!n||!k||!batches||(rank==2&&batches!=1))return false;
+  size_t left=0,right=0,result=0,bytes=0;
+  // elem_to_loc takes int, and ordinary batch_size uses a signed shape product.
+  // Include all matrix/intermediate products before any cast or allocation.
+  if(!product(m,k,left)||!product(k,n,right)||!product(m,n,result)||
+      !product(left,batches,left)||!product(right,batches,right)||
+      !product(result,batches,result)||left>size_t(INT_MAX)||right>size_t(INT_MAX)||
+      result>size_t(INT_MAX)||!product(result,sizeof(bfloat16_t),bytes))return false;
+  EvalDispatchStorage task;SingleOutputEvalStorage common;RetentionLayout retention;
+  if(!bf16_matmul_dispatch_storage(task)||!single_output_raw_task_layout(rank,2,tracer,task,common)||
+      !CommandEncoder::retention_layout(2,0,retention))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  // matmul_general unconditionally publishes its actual (possibly empty)
+  // temporary batch. The same cleanup owns it through CPU callback return.
+  value.request_bytes[9]=retention.temporary_batch.bytes;
+  value.request_alignments[9]=retention.temporary_batch.alignment;
+  value.request_counts[9]=1;
+  const size_t controls=sizeof(value)+sizeof(common)+sizeof(task)+sizeof(retention)+
+      sizeof(rank)+sizeof(m)+sizeof(n)+sizeof(k)+sizeof(batches)+sizeof(tracer)+sizeof(out)+
+      sizeof(size_t)*20+sizeof(bool)*5+sizeof(int64_t)*2+sizeof(const array*)*8+
+      sizeof(array)*2+sizeof(ArrayVector)+sizeof(std::tuple<bool,int64_t,array>)*2+
+      sizeof(Stream)*2+sizeof(float)*2+sizeof(detail::TemporaryOwner)*2+
+      sizeof(detail::TemporaryStorage)+sizeof(detail::TemporaryBatch*)*3+
+      sizeof(submission::GraphAllocator<detail::TemporaryBatch>)*2+
+      sizeof(std::optional<ArrayVector>)+sizeof(submission::GraphAllocator<array>)+
+      sizeof(submission::NativeControlFailure)+sizeof(submission::NativeControlError)+
+      sizeof(submission::FixedEvalPrologueGuard*)+sizeof(submission::Record*)+
+      sizeof(submission::GraphQuota*)+sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls)||!submission::GraphConstruction::complete_layout(value))return false;
+  out=value;return true;
+}
+bool bf16_matmul_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_bf16_matmul_eval_primitive(output)||!output.siblings().empty()||output.inputs().size()!=2||
+      output.itemsize()!=sizeof(bfloat16_t))return false;
+  const size_t rank=output.ndim();if(rank<2||rank>4)return false;
+  const auto& a=output.inputs()[0];const auto& b=output.inputs()[1];
+  if(!matrix_source(a,rank)||!matrix_source(b,rank)||a.shape(-1)!=b.shape(-2)||
+      output.shape(-2)!=a.shape(-2)||output.shape(-1)!=b.shape(-1))return false;
+  size_t batches=1,result=0;
+  for(size_t i=0;i+2<rank;++i) {
+    if(output.shape(i)<=0||a.shape(i)!=output.shape(i)||b.shape(i)!=output.shape(i)||
+        !product(batches,size_t(output.shape(i)),batches))return false;
+  }
+  if(!product(batches,size_t(output.shape(-2)),result)||
+      !product(result,size_t(output.shape(-1)),result)||result!=output.size())return false;
+  return bf16_matmul_eval_layout(rank,a.shape(-2),b.shape(-1),a.shape(-1),batches,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_bf16_matmul_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::bf16_matmul_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
