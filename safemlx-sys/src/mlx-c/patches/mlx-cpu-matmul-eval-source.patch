+              a_ptr + elem_to_loc(m * k * batch, a_shape, a_strides),
+              b_ptr + elem_to_loc(k * n * batch, b_shape, b_strides),
+              out_ptr + m * n * batch, m, n, k, a_transposed ? 1 : lda, a_transposed ? lda : 1, b_transposed ? ldb : 1, b_transposed ? 1 : ldb);
+        }
+        return;
+      }
+    }
+    matmul<T>(
+        a_ptr,
+        b_ptr,
+        out_ptr,
+        a_transposed,
+        b_transposed,
+        lda,
+        ldb,
+        ldc,
+        alpha,
+        beta,
+        batch_size,
+        a_shape,
+        a_strides,
+        b_shape,
+        b_strides);
+  }
+};
+
+namespace cpu {
+bool bf16_matmul_dispatch_storage(EvalDispatchStorage& out) noexcept {
+  DispatchLayout task;
+  if(!CommandEncoder::dispatch_layout<MatmulTask<bfloat16_t>>(task))return false;
+  // Existing row worker has fixed FP32 partial/tail arrays and no heap scratch.
+  // These controls include the dispatch/call copies and all simultaneous local
+  // pointer/index/reduction transports, not an opaque BLAS workspace allowance.
+  const size_t controls=sizeof(EvalDispatchStorage)+sizeof(task)+sizeof(out)+
+      sizeof(MatmulTask<bfloat16_t>)*2+sizeof(float[32])+sizeof(float[4])*2+
+      sizeof(float)*2+sizeof(size_t)*28+sizeof(int)*3+sizeof(long)*2+
+      sizeof(ldiv_t)+sizeof(bfloat16_t*)*6+sizeof(bool)*4+sizeof(Stream)+
+      sizeof(Shape)*2+sizeof(Strides)*2;
+  if(task.controls>SIZE_MAX-controls)return false;
+  out={task.task_bytes,task.task_alignment,0,task.controls+controls};return true;
+}
 }
 
