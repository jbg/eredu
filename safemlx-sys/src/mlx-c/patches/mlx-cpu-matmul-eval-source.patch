+template <typename T>
+struct MatmulTask {
+  const T* a_ptr;
+  const T* b_ptr;
+  T* out_ptr;
+  bool a_transposed, b_transposed;
+  size_t lda, ldb, ldc;
+  float alpha, beta;
+  size_t batch_size;
+  Shape a_shape;
+  Strides a_strides;
+  Shape b_shape;
+  Strides b_strides;
+  void operator()() {
+    if constexpr (std::is_same_v<T, bfloat16_t>) {
+      if (alpha == 1.0f && beta == 0.0f) {
