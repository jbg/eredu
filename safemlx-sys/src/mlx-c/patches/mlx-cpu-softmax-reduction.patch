+
+#pragma once
+#include <cmath>
+
+namespace mlx::core {
+// Stable one-ULP exponential for maximum-subtracted scores and activation functions.
+// Explicit rounding keeps rare BF16 halfway cases independent of libm/SIMD ABI.
+inline float exp_f32(float d) {
+  if (!std::isfinite(d)) return std::exp(d);
+  if (d > 100.0f) return HUGE_VALF;
+  if (d < -104.0f) return 0.0f;
+  int q = static_cast<int>(std::nearbyint(d * 1.44269504088896340736f));
+  float s = std::fma(float(q), -0.693145751953125f, d);
+  s = std::fma(float(q), -1.428606765330187045e-06f, s);
+  float u = 0.000198527617612853646278381f;
+  u = std::fma(u, s, 0.00139304355252534151077271f);
+  u = std::fma(u, s, 0.00833336077630519866943359f);
+  u = std::fma(u, s, 0.0416664853692054748535156f);
+  u = std::fma(u, s, 0.166666671633720397949219f);
+  u = std::fma(u, s, 0.5f);
+  u = 1.0f + std::fma(s * s, u, s);
+  return std::ldexp(std::ldexp(u, q >> 1), q - (q >> 1));
+}
+} // namespace mlx::core
