     T* current_out_ptr;
 
     for (int i = 0; i < L; i++, in_ptr += M, out_ptr += M) {
+      if constexpr (std::is_same_v<T, float> && std::is_same_v<AccT, float>) {
+        if (M >= 4) {
+          // Fix the reduction width independently of the native vector ABI.
+          // Merge the partial final vector before the balanced four-lane sum.
+          float maximum = -numeric_limits<float>::infinity();
+          for (int j = 0; j < M; ++j) {
+            maximum = std::isnan(in_ptr[j]) ? in_ptr[j] : std::max(maximum, in_ptr[j]);
+          }
+          float sums[4] = {};
+          for (int j = 0; j < M; ++j) {
+            out_ptr[j] = exp_f32(in_ptr[j] - maximum);
+            sums[j % 4] += out_ptr[j];
+          }
+          float inverse = 1.0f / ((sums[0] + sums[2]) + (sums[1] + sums[3]));
+          for (int j = 0; j < M; ++j) {
+            out_ptr[j] *= inverse;
+          }
+          continue;
+        }
+      }
       // Find the maximum
       current_in_ptr = in_ptr;
       Simd<AccT, N> vmaximum(-numeric_limits<AccT>::infinity());
