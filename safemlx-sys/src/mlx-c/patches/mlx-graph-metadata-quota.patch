+// The concrete native array-vector API keeps the same Python list interface.
+// Its allocator captures the entered original graph domain before reserve.
+template <typename Type>
+struct type_caster<::mlx::core::submission::GraphVector<Type>> {
+  using List = ::mlx::core::submission::GraphVector<Type>;
+  using Caster = make_caster<Type>;
+  NB_TYPE_CASTER(List, const_name("list[") + Caster::Name + const_name("]"))
+
+  bool from_python(handle src, uint8_t flags, cleanup_list* cleanup) {
+    size_t size;
+    PyObject* temp;
+    PyObject** items = seq_get(src.ptr(), &size, &temp);
+    // Graph refusal may throw at reserve/push; retain Python's temporary then.
+    object temporary = steal(temp);
+    if (!items) return false;
+    value.clear();
+    value.reserve(size);
+    flags = flags_for_local_caster<Type>(flags);
+    for (size_t i = 0; i < size; ++i) {
+      Caster caster;
+      if (!caster.from_python(items[i], flags, cleanup) ||
+          !caster.template can_cast<Type>()) return false;
+      value.push_back(caster.operator cast_t<Type>());
+    }
+    return true;
+  }
+
+  template <typename T>
+  static handle from_cpp(T&& src, rv_policy policy, cleanup_list* cleanup) {
+    object result = steal(PyList_New(src.size()));
+    if (!result.is_valid()) return result.release();
+    Py_ssize_t index = 0;
+    for (auto&& value : src) {
+      handle item = Caster::from_cpp(forward_like_<T>(value), policy, cleanup);
+      if (!item.is_valid()) return handle();
+      PyList_SET_ITEM(result.ptr(), index++, item.ptr());
+    }
+    return result.release();
+  }
+};
