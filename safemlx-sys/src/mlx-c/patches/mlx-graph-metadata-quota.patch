+
+// A distinct original component: no upstream, refill, graph-fit estimate or
+// substitution of the Record arena. Each physical block and each allocator
+// has its own native reference, including allocators of empty containers.
+class MLX_API GraphQuota final {
+ public:
+  static bool layout(size_t capacity, GraphQuotaLayout& out) noexcept;
+  static GraphQuota* create(size_t capacity, void* owner, void (*retire)(void*));
+  void retain() noexcept;
+  void release() noexcept;
+  size_t capacity() const noexcept { return capacity_; }
+  size_t occupied_bytes() const noexcept;
+  void* allocate(size_t, size_t);
+  void deallocate(void*, size_t, size_t) noexcept;
+ private:
+  struct Block;
+  struct Loan;
+  struct Scratch {
+    void* result = nullptr;
+    Block* entry = nullptr;
+    Block* adjacent = nullptr;
+    size_t offset = 0, start = 0, pointer = 0, used = 0;
+    size_t address = 0, remainder = 0, next = 0;
+  } scratch_;
+  GraphQuota(size_t, void*, void (*)(void*)) noexcept;
+  ~GraphQuota() = default;
+  std::byte* bytes() noexcept;
+  Block* block(size_t) noexcept;
+  std::atomic<size_t> references_{1};
+  mutable std::atomic_flag loan_ = ATOMIC_FLAG_INIT;
+  size_t capacity_;
+  size_t occupied_{0};
+  void* owner_;
+  void (*retire_)(void*);
+};
+
+// Read only the existing entered native Scope/Record association. This does
+// not invent worker inheritance or attach ownership after a graph is created.
+MLX_API GraphQuota* current_graph_quota() noexcept;
+
+class GraphQuotaRef {
+ public:
+  explicit GraphQuotaRef(GraphQuota* value = nullptr) noexcept : value_(value) {
+    if (value_) value_->retain();
+  }
+  GraphQuotaRef(const GraphQuotaRef& other) noexcept : GraphQuotaRef(other.value_) {}
+  GraphQuotaRef& operator=(const GraphQuotaRef&) = delete;
+  ~GraphQuotaRef() { if (value_) value_->release(); }
+  GraphQuota* get() const noexcept { return value_; }
+ private:
+  GraphQuota* value_;
+};
+
+template<class T> class GraphAllocator {
+ public:
+  using value_type = T;
+  using propagate_on_container_copy_assignment = std::false_type;
+  using propagate_on_container_move_assignment = std::false_type;
+  using propagate_on_container_swap = std::false_type;
+  using is_always_equal = std::false_type;
+
+  GraphAllocator() noexcept : GraphAllocator(current_graph_quota()) {}
+  explicit GraphAllocator(GraphQuota* value) noexcept : quota_(value) {
+    if (quota_) quota_->retain();
+  }
+  GraphAllocator(const GraphAllocator& other) noexcept : GraphAllocator(other.quota_) {}
+  // A move deliberately retains the source allocator's association. Containers
+  // remain valid after moving and may allocate again, even when initially empty.
+  GraphAllocator(GraphAllocator&& other) noexcept : GraphAllocator(other.quota_) {}
+  template<class U> GraphAllocator(const GraphAllocator<U>& other) noexcept
+      : GraphAllocator(other.resource()) {}
+  GraphAllocator& operator=(const GraphAllocator& other) noexcept {
+    auto* old = quota_;
+    quota_ = other.quota_;
+    if (quota_) quota_->retain();
+    if (old) old->release();
+    return *this;
+  }
+  GraphAllocator& operator=(GraphAllocator&& other) noexcept { return *this = other; }
+  ~GraphAllocator() { if (quota_) quota_->release(); }
+  GraphAllocator select_on_container_copy_construction() const noexcept {
+    return GraphAllocator(); // new construction selects the active domain
+  }
+  GraphQuota* resource() const noexcept { return quota_; }
+  T* allocate(size_t count) {
+    if (count > std::numeric_limits<size_t>::max() / sizeof(T))
+      throw GraphQuotaError(GraphFailure::invalid_layout);
+    if (quota_) return static_cast<T*>(quota_->allocate(count * sizeof(T), alignof(T)));
+    return std::allocator<T>{}.allocate(count);
+  }
+  void deallocate(T* p, size_t count) noexcept {
+    if (quota_) quota_->deallocate(p, count * sizeof(T), alignof(T));
+    else std::allocator<T>{}.deallocate(p, count);
+  }
+  template<class U> bool operator==(const GraphAllocator<U>& other) const noexcept {
+    return quota_ == other.resource();
+  }
+  template<class U> bool operator!=(const GraphAllocator<U>& other) const noexcept {
+    return !(*this == other);
+  }
+ private:
+  GraphQuota* quota_;
+};
+
+// This concrete native container makes constructor and fixed-destination swap
+// semantics explicit; std::vector's unequal-allocator swap is not a safe API.
+template<class T> class GraphVector : public std::vector<T, GraphAllocator<T>> {
+  using Base = std::vector<T, GraphAllocator<T>>;
+ public:
+  using allocator_type = GraphAllocator<T>;
+  using Base::Base;
+  using Base::operator=;
+  GraphVector() : Base(allocator_type{}) {}
+  GraphVector(const GraphVector& other)
+      : Base(other.begin(), other.end(), allocator_type{}) {}
+  GraphVector(const GraphVector& other, const allocator_type& allocator)
+      : Base(other.begin(), other.end(), allocator) {}
+  GraphVector(GraphVector&& other)
+      : GraphVector(std::move(other), allocator_type{}) {}
+  GraphVector(GraphVector&& other, const allocator_type& allocator) : Base(allocator) {
+    if (this->get_allocator() == other.get_allocator()) {
+      Base::operator=(std::move(static_cast<Base&>(other)));
+    } else {
+      // Copy before mutation: allocation refusal leaves every source root alive.
+      this->assign(other.begin(), other.end());
+      other.clear();
+    }
+  }
+  GraphVector& operator=(const GraphVector& other) {
+    if (this == &other) return *this;
+    GraphVector incoming(other, this->get_allocator());
+    Base::swap(incoming);
+    return *this;
+  }
+  GraphVector& operator=(GraphVector&& other) {
+    if (this == &other) return *this;
+    GraphVector incoming(std::move(other), this->get_allocator());
+    Base::swap(incoming);
+    return *this;
+  }
+  void swap(GraphVector& other) {
+    if (this == &other) return;
+    if (this->get_allocator() == other.get_allocator()) {
+      Base::swap(other);
+      return;
+    }
+    GraphVector incoming(other, this->get_allocator());
+    GraphVector outgoing(*this, other.get_allocator());
+    Base::swap(incoming);
+    other.Base::swap(outgoing);
+  }
+  friend void swap(GraphVector& a, GraphVector& b) { a.swap(b); }
+};
+
+template<class T, class... Args>
+std::shared_ptr<T> make_graph_primitive(Args&&... args) {
+  return std::allocate_shared<T>(GraphAllocator<T>{}, std::forward<Args>(args)...);
+}
