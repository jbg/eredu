 class GroupImpl {
+  friend struct ::mlx::core::distributed::Group;
+  static_assert(std::atomic<bool>::is_always_lock_free);
+  std::atomic<bool> terminal_{false};
+  // Bound once, before a freshly split implementation becomes externally
+  // visible. Direct root ownership prevents chains and retains native identity.
+  std::shared_ptr<GroupImpl> terminal_owner_;
+
+  void inherit_terminal_owner(const std::shared_ptr<GroupImpl>& parent) noexcept {
