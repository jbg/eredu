diff --git a/cmake/blas_headers.cmake b/cmake/blas_headers.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/blas_headers.cmake
@@ -0,0 +1,18 @@
+# Header discovery is separate from FindBLAS/FindLAPACK library selection.
+# Distribution packages can place C headers outside the default include path.
+find_package(PkgConfig QUIET)
+if(PkgConfig_FOUND)
+  pkg_search_module(MLX_CBLAS_HEADERS QUIET cblas openblas blas)
+  pkg_search_module(MLX_LAPACKE_HEADERS QUIET lapacke openblas lapack)
+endif()
+
+find_path(BLAS_INCLUDE_DIRS
+          NAMES cblas.h
+          HINTS $ENV{BLAS_HOME}/include ${MLX_CBLAS_HEADERS_INCLUDE_DIRS}
+          PATHS /usr/include /usr/local/include
+          PATH_SUFFIXES openblas)
+find_path(LAPACK_INCLUDE_DIRS
+          NAMES lapacke.h
+          HINTS ${MLX_LAPACKE_HEADERS_INCLUDE_DIRS}
+          PATHS /usr/include /usr/local/include /usr/local/opt/openblas/include
+          PATH_SUFFIXES openblas)
