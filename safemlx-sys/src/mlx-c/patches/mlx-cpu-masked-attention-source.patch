 /** Computes: O = softmax(Q @ K.T) @ V **/
 namespace {
+// The same ordinary mask worker, named so its actual borrowed arguments,
+// local arrays and returned result can be included in a selected CPU source.
+struct SdpaMask {
+  int n_kv_heads,n_repeats;
+  bool do_causal;
+  StreamOrDevice s;
+  array fetch(const ArrayVector& inputs,const array& q,const array& k) const {
+    if(do_causal) {
+      int kL=k.shape(-2),qL=q.shape(-2),offset=kL-qL;
+      auto q_idx=arange(offset,qL+offset,s);
+      auto k_idx=arange(0,kL,s);
+      q_idx=expand_dims(q_idx,1,s);k_idx=expand_dims(k_idx,0,s);
+      return greater_equal(q_idx,k_idx,s);
+    }
+    return inputs[3];
+  }
+  array apply(const ArrayVector& inputs,const array& q,const array& k,const array& scores) const {
+    auto mask=fetch(inputs,q,k);
+    if(n_repeats>1&&mask.ndim()>=3) {
+      if(mask.shape(-3)==1)mask=expand_dims(mask,-3,s);
+      else mask=unflatten(mask,-3,{n_kv_heads,n_repeats},s);
+    }
+    if(mask.dtype()==bool_)
+      return where(mask,scores,array(finfo(scores.dtype()).min,scores.dtype()),s);
+    return add(scores,mask,s);
+  }
+};
 struct SdpaFallback {
