new file mode 100644
--- /dev/null
+++ b/mlx/submission_identity.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <exception>
+#include <limits>
+
+namespace mlx::core::submission::detail {
+// The caller owns the cache; production keeps its sequence and cache private.
+// Zero is unassigned and UINT64_MAX is permanently exhausted. Neither is issued.
+class OwnerIdentityExhausted final : public std::exception {
+ public:
+  const char* what() const noexcept override {
+    return "submission owner identity supply exhausted";
+  }
+};
+inline uint64_t claim_owner_identity(
+    std::atomic<uint64_t>& sequence, uint64_t& cached) {
+  if (cached) return cached;
+  auto next = sequence.load(std::memory_order_relaxed);
+  while (next && next != std::numeric_limits<uint64_t>::max()) {
+    if (sequence.compare_exchange_weak(next, next + 1,
+            std::memory_order_relaxed, std::memory_order_relaxed)) {
+      cached = next;
+      return cached;
+    }
+  }
+  throw OwnerIdentityExhausted();
+}
+} // namespace mlx::core::submission::detail
