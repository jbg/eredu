+// Private loaded-constructor qualification; no runtime creation or loader calls.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <shared_mutex>
+
+#if defined(__APPLE__) && defined(__aarch64__) && !defined(__arm64e__) && \
+    defined(__clang__) && defined(_LIBCPP_VERSION) && \
+    _LIBCPP_VERSION == 210106 && _LIBCPP_ABI_VERSION == 1 && __cplusplus == 202002L
+# if __has_attribute(no_destroy)
+#  define MLX_SCHEDULER_CONSTANT_STORAGE 1
+# endif
+#endif
+#ifndef MLX_SCHEDULER_CONSTANT_STORAGE
+#define MLX_SCHEDULER_CONSTANT_STORAGE 0
+#endif
+
+namespace mlx::core::scheduler::detail {
+#if MLX_SCHEDULER_CONSTANT_STORAGE
+// Darwin asm labels name the final Mach-O symbols, including its extra leading
+// underscore. These are the same C1/C2 symbols imported by shared_mutex's actual
+// member constructor. Taking an address does not invoke the constructor or use
+// dlopen/dlsym. Later compiled-input validation checks the actual import binding.
+extern "C" void shared_mutex_c1(void*)
+    __asm__("__ZNSt3__119__shared_mutex_baseC1Ev");
+extern "C" void shared_mutex_c2(void*)
+    __asm__("__ZNSt3__119__shared_mutex_baseC2Ev");
+
+// Audited loaded libc++ body: sixteen fixed stores/setup instructions, then ret;
+// no call, branch, stack owner or allocation. One named module object, shared by
+// both comparisons. It is data in our managed static inventory, not a guessed
+// dynamic safety reserve. C1/C2 audit SHA256: 41d3417a...c1b9a8bdb.
+inline constexpr unsigned char shared_mutex_constructor[] = {
+    0xe8, 0x74, 0x95, 0x52, 0x48, 0x55, 0xa6, 0x72, 0x08, 0x00, 0x00, 0xf9,
+    0x00, 0xe4, 0x00, 0x6f, 0x00, 0x80, 0x80, 0x3c, 0x00, 0x80, 0x81, 0x3c,
+    0x00, 0x80, 0x82, 0x3c, 0x68, 0x37, 0x96, 0x52, 0x08, 0x96, 0xa7, 0x72,
+    0x1f, 0xa0, 0x03, 0xa9, 0x00, 0x80, 0x84, 0x3c, 0x00, 0x80, 0x85, 0x3c,
+    0x1f, 0xa0, 0x06, 0xa9, 0x00, 0x80, 0x87, 0x3c, 0x00, 0x80, 0x88, 0x3c,
+    0x00, 0x40, 0x89, 0x3c, 0xc0, 0x03, 0x5f, 0xd6};
+static_assert(sizeof(shared_mutex_constructor) == 68);
+static_assert(sizeof(std::shared_mutex) == 168 && alignof(std::shared_mutex) == 8);
+
+inline bool matches_shared_mutex_constructor(
+    const volatile unsigned char* bytes, size_t available) noexcept {
+  if (!bytes || available < sizeof(shared_mutex_constructor)) return false;
+  for (size_t i = 0; i < sizeof(shared_mutex_constructor); ++i)
+    if (bytes[i] != shared_mutex_constructor[i]) return false;
+  return true;
+}
+inline bool loaded_shared_mutex_constructor_matches(void (*symbol)(void*)) noexcept {
+  // Apple arm64 represents a non-PAC function pointer as its readable code
+  // address. Standard linked libc++ text is permanent and not execute-only.
+  // Read only within one 4-KiB subpage of the existing mapping (Darwin arm64's
+  // page granularity is at least this). A near-boundary address or thunk is
+  // unknown; we never chase a trampoline, strip PAC or ask the loader for data.
+  const auto address = reinterpret_cast<uintptr_t>(symbol);
+  if (!address || address % 4) return false;
+  const size_t available = 4096 - (address % 4096);
+  if (available < sizeof(shared_mutex_constructor)) return false;
+  return matches_shared_mutex_constructor(
+      reinterpret_cast<const volatile unsigned char*>(address), available);
+}
+#endif
+inline bool scheduler_constructor_qualified() noexcept {
+#if MLX_SCHEDULER_CONSTANT_STORAGE && !defined(MLX_USE_CUDA)
+  // The actual CPU/Metal gpu::init bodies are empty. CUDA initializes caches and
+  // is not described by this producer, even with the same standard library.
+  return loaded_shared_mutex_constructor_matches(&shared_mutex_c1) &&
+      loaded_shared_mutex_constructor_matches(&shared_mutex_c2);
+#else
+  return false;
+#endif
+}
+inline constexpr size_t scheduler_qualification_static_bytes() noexcept {
+#if MLX_SCHEDULER_CONSTANT_STORAGE
+  return sizeof(shared_mutex_constructor);
+#else
+  return 0;
+#endif
+}
+inline constexpr size_t scheduler_qualification_controls() noexcept {
+  // Two actual calls plus the bounded byte matcher; no copied code buffer.
+  return sizeof(void (*)(void*)) * 2 + sizeof(uintptr_t) * 2 +
+      sizeof(const volatile unsigned char*) * 2 + sizeof(size_t) * 6 +
+      sizeof(bool) * 4;
+}
+} // namespace mlx::core::scheduler::detail
