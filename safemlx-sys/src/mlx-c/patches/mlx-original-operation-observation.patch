+      sizeof(requests) + sizeof(EvalGraphLayout*) + sizeof(size_t) +
+      sizeof(GraphConstruction*) + sizeof(GraphConstructionContext) +
+      sizeof(GraphQuota*) + sizeof(const Record*) + sizeof(uint64_t) +
+      sizeof(Event) + sizeof(Shape) + sizeof(Stream) + sizeof(ArrayVector) +
+      sizeof(std::shared_ptr<Primitive>) + sizeof(GraphAllocator<Synchronizer>) +
+      sizeof(GraphQuota::Request*) + PreparedInputLeaf::descriptor_shared_control_bytes() +
+      PreparedInputLeaf::descriptor_allocator_control_bytes() + event.construction_controls;
