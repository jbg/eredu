+MLX_API StreamRegistrationCause borrow_stream_registration(
+    Stream, const void* expected_owner) noexcept;
+namespace cpu {
+// Process registrations never move/remove an encoder during runtime. Local
+// thread encoders remain in their existing separate ordinary directory.
+MLX_API CommandEncoder* registered_global_encoder(Stream) noexcept;
+}
