+bool CommandEncoder::persistent_control_layout(PersistentControlLayout& out) noexcept {
+  PersistentControlLayout facts;
+  if (!allocation_shape<detail::ResourceEntry>(facts.resource_entry) ||
+      !allocation_shape<detail::FenceEntry>(facts.fence_entry) ||
+      !allocation_shape<detail::TemporaryBatch>(facts.temporary_batch) ||
+      !shared_allocation_shape<detail::EncoderFence>(facts.encoder_fence)) return false;
+  facts.encoder_bytes = sizeof(CommandEncoder);
+  facts.resource_index_bytes = sizeof(resources_);
+  facts.fence_index_bytes = sizeof(prev_ce_outputs_);
+  facts.candidate_chain_bytes = sizeof(detail::EntryChain<detail::FenceEntry>);
+  facts.temporary_storage_bytes = sizeof(temporaries_);
+  out = facts;
+  return true;
+}
