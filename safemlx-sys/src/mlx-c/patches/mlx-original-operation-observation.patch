+struct CommandEncoder::EncodingCleanup {
+  CommandEncoder* owner;
+  detail::FenceOwner fence;
+  ArrayVector temporaries;
+  submission::GraphVector<const void*> outputs;
+  submission::GraphVector<detail::FenceOwner> waiting;
+  detail::EntryChain<detail::FenceEntry> detached;
+  EncodingCleanup(CommandEncoder* owner, submission::GraphQuota* graph)
+      : owner(owner), fence(owner->fence_),
+        temporaries(ArrayVector::allocator_type(graph)),
+        outputs(decltype(outputs)::allocator_type(graph)),
+        waiting(decltype(waiting)::allocator_type(graph)) {}
+  EncodingCleanup(EncodingCleanup&& other)
+      : owner(other.owner), fence(std::move(other.fence)),
+        temporaries(std::move(other.temporaries), other.temporaries.get_allocator()),
+        outputs(std::move(other.outputs), other.outputs.get_allocator()),
+        waiting(std::move(other.waiting), other.waiting.get_allocator()),
+        detached(std::move(other.detached)) {}
+  void operator()(MTL::CommandBuffer*) {
+    {
+      std::lock_guard lock(owner->outputs_mtx_);
+      for (auto* output : outputs) {
+        auto* entry = owner->prev_ce_outputs_.find(output);
+        if (entry && entry->fence.get() == fence.get() &&
+            !entry->fence.owner_before(fence) && !fence.owner_before(entry->fence))
+          detached.append(owner->prev_ce_outputs_.detach(entry));
+      }
+    }
+    // Returning an old request's Graph block or final native fence may invoke
+    // its source retirement. Both occur outside outputs_mtx_, before finish.
+    detached.clear();
+  }
+};
