+bool PreparedHostCopySlot::layout(const allocator::PreparedInputFacts& facts,
+    const int* shape, size_t rank, Dtype dtype, PreparedHostCopyLayout& out) noexcept {
+  if ((rank && !shape) || rank > static_cast<size_t>(INT_MAX) || dtype == bool_ ||
+      !facts.page_size || (facts.page_size & (facts.page_size - 1)) ||
+      (facts.kind != allocator::HostTransferStorageKind::cpu &&
+       facts.kind != allocator::HostTransferStorageKind::metal_shared)) return false;
+  size_t elements = 1;
+  for (size_t i = 0; i < rank; ++i) {
+    if (shape[i] < 0 || !multiply(elements, static_cast<size_t>(shape[i]), elements)) return false;
+  }
+  size_t bytes;
+  if (!multiply(elements, dtype.size(), bytes) || bytes > static_cast<size_t>(PTRDIFF_MAX)) return false;
+  size_t backing = 0;
+  if (bytes) {
+    backing = bytes;
+    if (facts.kind == allocator::HostTransferStorageKind::cpu &&
+        !add(backing, sizeof(size_t), backing)) return false;
+    if (!add(backing, facts.page_size - 1, backing)) return false;
+    backing &= ~(facts.page_size - 1);
+    if (backing > facts.maximum) return false;
+  }
+  HostConstruction c;
+  if (!requests(rank, c.requests, c.count)) return false;
+  size_t metadata = 0;
+  for (size_t i = 0; i < c.count; ++i) {
+    size_t extent;
+    if (!submission::GraphQuota::allocation_extent(c.requests[i].bytes,
+            c.requests[i].alignment, extent) || !add(metadata, extent, metadata)) return false;
+  }
+  out = {metadata, backing, bytes, sizeof(PreparedInputArray), alignof(PreparedInputArray),
+      sizeof(HostConstruction) + sizeof(FinishBlocks) + sizeof(Incoming) +
+      sizeof(Shape) + sizeof(std::shared_ptr<array::ArrayDesc>) +
+      sizeof(std::shared_ptr<array::Data>) + sizeof(array) +
+      sizeof(submission::GraphAllocator<array::ArrayDesc>) +
+      sizeof(submission::NativeControlBinding) + sizeof(HostCause) +
+      sizeof(submission::GraphQuota::Request) * 6 +
+      sizeof(allocator::PreparedInputFacts) + sizeof(PreparedHostCopyLayout) +
+      sizeof(PreparedInputArray*) + sizeof(submission::GraphQuota*) +
+      sizeof(const void*) + sizeof(size_t) * 8 + facts.controls};
+  return true;
+}
