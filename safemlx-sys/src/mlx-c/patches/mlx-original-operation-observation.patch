+bool submission::fixed_eval_record(const submission::Record& record,
+    const array* current) noexcept {
+  if (typeid(record) != typeid(PreparedEvalSubmissionRecord)) return false;
+  const auto& actual = static_cast<const PreparedEvalSubmissionRecord&>(record);
+  return !current || (actual.current && std::addressof(*actual.current) == current);
+}
+
+bool submission::fixed_gpu_eval_record(const submission::Record& record,
+    const array* current) noexcept { return fixed_eval_record(record, current); }
