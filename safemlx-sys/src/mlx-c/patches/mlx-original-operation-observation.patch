+  const auto cleanup = direct_target(sc2, 188);
+  if (!matches(cleanup, code_cleanup_thunk) || direct_target(make_error, 240) != cleanup) return false;
+  const auto cleanup_string = direct_target(cleanup, 12);
+  if (!matches(cleanup_string, code_cleanup_string) ||
+      !bound_leaf(cleanup_string, 28, reinterpret_cast<uintptr_t>(&leaf_sized_delete))) return false;
+  // These calls consume the finite request/counts checked above. Bind their
+  // actual leaf endpoints to the same standard API contracts used by this TU.
+  // Destructor double-fault/stack-corruption/length-overflow terminate branches
+  // are not returned startup failures; the finite inputs cannot reach length overflow.
+  if (!bound_leaf(tc1, 40, reinterpret_cast<uintptr_t>(&leaf_tagged_new)) ||
+      !bound_leaf(tc2, 40, reinterpret_cast<uintptr_t>(&leaf_tagged_new)) ||
+      !bound_leaf(key, 36, reinterpret_cast<uintptr_t>(&leaf_key_create)) ||
+      !bound_leaf(tls, 60, reinterpret_cast<uintptr_t>(&leaf_guard_acquire)) ||
+      !bound_leaf(tls, 92, reinterpret_cast<uintptr_t>(&leaf_guard_release)) ||
+      !bound_leaf(tls, 112, reinterpret_cast<uintptr_t>(&leaf_guard_abort)) ||
+      !bound_leaf(tls, 120, reinterpret_cast<uintptr_t>(&leaf_resume)) ||
+      !bound_leaf(throw_code, 36, reinterpret_cast<uintptr_t>(&leaf_exception_alloc)) ||
+      !bound_leaf(throw_code, 88, reinterpret_cast<uintptr_t>(&leaf_exception_throw)) ||
+      !bound_leaf(throw_code, 100, reinterpret_cast<uintptr_t>(&leaf_exception_free)) ||
+      !bound_leaf(throw_code, 108, reinterpret_cast<uintptr_t>(&leaf_resume)) ||
+      !bound_leaf(sc2, 88, reinterpret_cast<uintptr_t>(&leaf_sized_delete)) ||
+      !bound_leaf(sc2, 112, reinterpret_cast<uintptr_t>(&leaf_sized_delete)) ||
+      !bound_leaf(sc2, 220, reinterpret_cast<uintptr_t>(&leaf_sized_delete)) ||
+      !bound_leaf(sc2, 228, reinterpret_cast<uintptr_t>(&leaf_resume)) ||
+      !bound_leaf(make_error, 176, reinterpret_cast<uintptr_t>(&leaf_sized_delete)) ||
+      !bound_leaf(make_error, 248, reinterpret_cast<uintptr_t>(&leaf_resume)) ||
+      !bound_leaf(errno_message, 52, reinterpret_cast<uintptr_t>(&leaf_errno_address)) ||
+      !bound_leaf(errno_message, 76, reinterpret_cast<uintptr_t>(&leaf_error_text)) ||
+      !bound_leaf(errno_message, 92, reinterpret_cast<uintptr_t>(&leaf_errno_address)) ||
+      !bound_leaf(errno_message, 148, reinterpret_cast<uintptr_t>(&leaf_format_text)) ||
+      !bound_leaf(errno_message, 152, reinterpret_cast<uintptr_t>(&leaf_errno_address)) ||
+      !bound_leaf(construct_string, 36, reinterpret_cast<uintptr_t>(&leaf_string_length)) ||
+      !bound_leaf(construct_string, 120, reinterpret_cast<uintptr_t>(&leaf_tagged_new)) ||
+      !bound_leaf(construct_string, 152, reinterpret_cast<uintptr_t>(&leaf_move_bytes)) ||
+      !bound_leaf(append, 140, reinterpret_cast<uintptr_t>(&leaf_move_bytes)) ||
+      !bound_leaf(grow, 176, reinterpret_cast<uintptr_t>(&leaf_tagged_new)) ||
+      !bound_leaf(grow, 200, reinterpret_cast<uintptr_t>(&leaf_move_bytes)) ||
+      !bound_leaf(grow, 220, reinterpret_cast<uintptr_t>(&leaf_copy_bytes)) ||
+      !bound_leaf(grow, 256, reinterpret_cast<uintptr_t>(&leaf_move_bytes)) ||
+      !bound_leaf(grow, 276, reinterpret_cast<uintptr_t>(&leaf_sized_delete)) ||
+      !bound_leaf(runtime, 72, reinterpret_cast<uintptr_t>(&leaf_string_length)) ||
+      !bound_leaf(runtime, 84, reinterpret_cast<uintptr_t>(&leaf_plain_new)) ||
+      !bound_leaf(runtime, 112, reinterpret_cast<uintptr_t>(&leaf_copy_bytes)) ||
