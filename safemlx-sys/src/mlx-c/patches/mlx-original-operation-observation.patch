+PreparedHostCopyCause PreparedHostCopySlot::create(allocator::Allocator& allocator,
+    const allocator::PreparedInputFacts& facts, submission::GraphQuota* quota,
+    const int* source_shape, size_t rank, Dtype dtype, PreparedHostCopySlot*& output) noexcept {
+  HostConstruction c;
+  if (output || !quota || !layout(facts, source_shape, rank, dtype, c.layout) ||
+      !requests(rank, c.requests, c.count)) return HostCause::invalid;
+  if (!quota->prepare_blocks(c.requests, c.count)) return HostCause::capacity;
+  FinishBlocks finish{quota};
+  c.generation = c.layout.copy_bytes ? next_allocation_generation() : 0;
+  if (c.layout.copy_bytes && !c.generation) return HostCause::identity_exhausted;
+  auto* memory = quota->allocate(sizeof(allocator::PreparedInputAllocation), alignof(allocator::PreparedInputAllocation));
+  c.backing = ::new (memory) allocator::PreparedInputAllocation{};
+  c.backing->quota = quota;
+  Incoming incoming{c.backing};
+  Shape shape(rank, Shape::allocator_type{quota});
+  for (size_t i = 0; i < rank; ++i) {
+    shape[i] = source_shape[i];
+    c.elements *= static_cast<size_t>(source_shape[i]);
+    c.maximum = std::max(c.maximum, static_cast<size_t>(source_shape[i]));
+  }
+  submission::GraphAllocator<array::ArrayDesc> descriptor_allocator(quota);
+  auto* descriptor = ::new (descriptor_allocator.allocate(1)) array::ArrayDesc(std::move(shape), dtype, quota);
+  descriptor->allocation_quota = quota;
+  std::shared_ptr<array::ArrayDesc> owned(descriptor, array::RetireDescriptor{}, descriptor_allocator);
+  owned->data = std::allocate_shared<array::Data>(
+      submission::GraphAllocator<array::Data>{quota}, c.backing, c.generation);
+  incoming.backing = nullptr;
+  owned->data_size = c.elements;
+  owned->flags = {true, true, c.elements <= 1 || c.elements == c.maximum};
+  c.handle = quota->allocate(sizeof(PreparedInputArray), alignof(PreparedInputArray));
+  auto* slot = quota->allocate(sizeof(PreparedHostCopySlot), alignof(PreparedHostCopySlot));
+  output = ::new (slot) PreparedHostCopySlot(array(std::move(owned)), allocator,
+      quota, std::exchange(c.handle, nullptr), c.layout);
+  return HostCause::success;
+}
