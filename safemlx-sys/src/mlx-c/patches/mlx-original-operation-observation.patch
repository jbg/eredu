+// Counted callback and exception paths share this exact one-shot token.
+struct MLX_API CountedCompletion {
+  scheduler::Scheduler* owner;
+  std::atomic<bool> counted{false};
+  explicit CountedCompletion(scheduler::Scheduler* owner) : owner(owner) {}
+  void complete() noexcept;
+};
+
+// Immutable allocation custody, independent of the physical command buffer's
+// other producers. No node retains its encoder, Record or Scope.
+struct Handler {
+  Handler* next{nullptr};
+  void (*invoke)(Handler*, MTL::CommandBuffer*);
+  void (*destroy)(Handler*) noexcept;
+  submission::GraphQuotaRef graph;
+  FailureCarrierRef failure;
+
+  Handler(void (*call)(Handler*, MTL::CommandBuffer*),
+      void (*drop)(Handler*) noexcept, submission::GraphQuota* arena,
+      FailureCarrierRef owner) noexcept
+      : invoke(call), destroy(drop), graph(arena), failure(std::move(owner)) {}
+};
+
+struct HandlerDeleter {
+  void operator()(Handler* value) const noexcept { value->destroy(value); }
+};
+using HandlerOwner = std::unique_ptr<Handler, HandlerDeleter>;
+
+template<class F> struct HandlerNode final : Handler {
+  F body;
+  template<class U> HandlerNode(submission::GraphQuota* graph,
+      FailureCarrierRef failure, U&& body)
+      : Handler([](Handler* node, MTL::CommandBuffer* buffer) {
+          static_cast<HandlerNode*>(node)->body(buffer);
+        }, [](Handler* base) noexcept {
+          auto* node = static_cast<HandlerNode*>(base);
+          submission::GraphAllocator<HandlerNode> allocator(node->graph.get());
+          node->~HandlerNode();
+          allocator.deallocate(node, 1);
+        }, graph, std::move(failure)), body(std::forward<U>(body)) {}
+};
+
+template<class F>
+using PreparedHandler = std::unique_ptr<HandlerNode<F>, HandlerDeleter>;
+
+template<class F> PreparedHandler<std::decay_t<F>> make_handler(
+    submission::GraphQuota* graph, FailureCarrierRef failure, F&& body) {
+  using Node = HandlerNode<std::decay_t<F>>;
+  submission::GraphAllocator<Node> allocator(graph);
+  auto* storage = allocator.allocate(1);
+  try {
+    return PreparedHandler<std::decay_t<F>>(::new (storage)
+        Node(graph, std::move(failure), std::forward<F>(body)));
+  } catch (...) {
+    allocator.deallocate(storage, 1);
+    throw;
+  }
+}
+
+struct AllocationShape {
+  size_t bytes{0}, alignment{0}, graph_extent{0};
+};
+template<class T> bool allocation_shape(AllocationShape& out) noexcept {
+  size_t extent;
+  if (!submission::GraphQuota::allocation_extent(sizeof(T), alignof(T), extent)) return false;
+  out = {sizeof(T), alignof(T), extent};
+  return true;
+}
+template<class T> bool shared_allocation_shape(AllocationShape& out) noexcept {
+#ifdef _LIBCPP_VERSION
+  using Control = std::__shared_ptr_emplace<T, submission::GraphAllocator<T>>;
+  return allocation_shape<Control>(out);
+#else
+  return false;
+#endif
+}
+
+template<class F> bool handler_graph_extent(size_t& out) noexcept {
+  using Node = HandlerNode<F>;
+  return submission::GraphQuota::allocation_extent(sizeof(Node), alignof(Node), out);
+}
+
+// Intrusive FIFO, including destruction: no recursive unique_ptr chain, ordinary
+// vector growth, callable erasure or allocator propagation from an earlier role.
+class HandlerList {
+ public:
+  HandlerList() noexcept = default;
+  HandlerList(const HandlerList&) = delete;
+  HandlerList& operator=(const HandlerList&) = delete;
+  ~HandlerList() { clear(); }
+  Handler* begin() const noexcept { return first_; }
+  bool empty() const noexcept { return first_ == nullptr; }
+  void append(HandlerOwner owner) noexcept {
+    auto* node = owner.release();
+    if (last_) last_->next = node;
+    else first_ = node;
+    last_ = node;
+  }
+  HandlerOwner pop() noexcept {
+    auto* node = first_;
+    if (node) {
+      first_ = std::exchange(node->next, nullptr);
+      if (!first_) last_ = nullptr;
+    }
+    return HandlerOwner(node);
+  }
+  void clear() noexcept { while (auto node = pop()) {} }
+ private:
+  Handler* first_{nullptr};
+  Handler* last_{nullptr};
+};
+
