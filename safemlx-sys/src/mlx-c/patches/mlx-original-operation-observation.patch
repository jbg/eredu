diff --git a/mlx/original_buffer.cpp b/mlx/original_buffer.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/original_buffer.cpp
@@ -0,0 +1,204 @@
+#include "mlx/original_buffer.h"
+#include "mlx/array.h"
+#include "mlx/submission.h"
+#include <limits>
+#include <new>
+
+namespace mlx::core::allocator {
+namespace {
+using Cause = OriginalBufferCause;
+[[noreturn]] void fail(Cause cause) { throw OriginalBufferError(cause); }
+}
+const char* OriginalBufferError::what() const noexcept {
+  switch (cause_) {
+    case Cause::missing_binding: return "Original buffer allowance is missing.";
+    case Cause::foreign_domain: return "Original buffer allocation domain differs.";
+    case Cause::invalid_scope: return "Original buffer role is not current and accepted.";
+    case Cause::already_bound: return "Original buffer role was already bound.";
+    case Cause::invalid_layout: return "Original buffer physical layout is invalid.";
+    case Cause::capacity: return "Original buffer allowance is exhausted.";
+    case Cause::busy: return "Original buffer allocation loan is busy.";
+    case Cause::allocation_failed: return "Original buffer native allocation failed.";
+    case Cause::unsupported: return "Original buffer allocator is unsupported.";
+    case Cause::identity_exhausted: return "Original buffer identity is exhausted.";
+  }
+  return "Original buffer allocation refused.";
+}
+OriginalBufferBudget::OriginalBufferBudget(Allocator& allocator, PreparedInputFacts facts,
+    size_t capacity, void* owner, void (*retire)(void*)) noexcept
+    : allocator_(&allocator), facts_(facts), capacity_(capacity), owner_(owner), retire_(retire) {}
+
+OriginalBufferBudget* OriginalBufferBudget::create(Allocator& allocator, size_t capacity,
+    void* owner, void (*retire)(void*)) {
+  // Cold preparation invokes the actual allocator, not caller-supplied facts.
+  // Failure leaves owner with the caller, including allocation of this object.
+  PreparedInputFacts facts;
+  if (!allocator.prepare_input_runtime(facts) || !facts.page_size ||
+      (facts.page_size & (facts.page_size - 1)) ||
+      (facts.kind != HostTransferStorageKind::cpu &&
+       facts.kind != HostTransferStorageKind::metal_shared)) fail(Cause::unsupported);
+  return new OriginalBufferBudget(allocator, facts, capacity, owner, retire);
+}
+void OriginalBufferBudget::retain() noexcept {
+  references_.fetch_add(1, std::memory_order_relaxed);
+}
+void OriginalBufferBudget::release() noexcept {
+  if (references_.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+    if (occupied_.load(std::memory_order_acquire)) std::terminate();
+    auto* owner = owner_;
+    auto retire = retire_;
+    delete this;
+    // Same nonthrowing unlocked-queue contract as Graph/Record retirement.
+    if (retire) retire(owner);
+  }
+}
+bool original_buffer_physical_capacity(const PreparedInputFacts& facts,
+    size_t bytes, size_t& capacity) noexcept {
+  if (!facts.page_size || (facts.page_size & (facts.page_size - 1)) ||
+      (facts.kind != HostTransferStorageKind::cpu &&
+       facts.kind != HostTransferStorageKind::metal_shared)) return false;
+  if (!bytes && facts.kind == HostTransferStorageKind::metal_shared) {
+    capacity = 0; return true;
+  }
+  const auto header = facts.kind == HostTransferStorageKind::cpu ? sizeof(size_t) : 0;
+  if (bytes > std::numeric_limits<size_t>::max() - header - (facts.page_size - 1)) return false;
+  capacity = (bytes + header + facts.page_size - 1) & ~(facts.page_size - 1);
+  return capacity <= facts.maximum;
+}
+bool OriginalBufferBudget::physical_capacity(size_t bytes, size_t& capacity) const noexcept {
+  return original_buffer_physical_capacity(facts_, bytes, capacity);
+}
+void OriginalBufferBudget::debit(size_t bytes) {
+  auto current = occupied_.load(std::memory_order_acquire);
+  if (bytes > capacity_ - current) fail(Cause::capacity);
+  // One bounded attempt. Contention does not retry native work or spend credit.
+  if (!occupied_.compare_exchange_strong(current, current + bytes,
+          std::memory_order_acq_rel, std::memory_order_acquire)) fail(Cause::busy);
+}
+void OriginalBufferBudget::refund(size_t bytes) noexcept {
+  if (occupied_.fetch_sub(bytes, std::memory_order_acq_rel) < bytes) std::terminate();
+}
+
+OriginalBufferBinding OriginalBufferBinding::capture(OriginalBufferBudget& expected) {
+  const auto domain = submission::current_original_buffer_domain();
+  if (!domain.budget) fail(Cause::missing_binding);
+  if (domain.budget != &expected) fail(Cause::foreign_domain);
+  return OriginalBufferBinding(domain.graph, domain.budget, domain.identity);
+}
+void OriginalBufferBinding::validate() const {
+  if (!budget_.get() || !graph_.get() || !identity_) fail(Cause::missing_binding);
+  const auto domain = submission::current_original_buffer_domain();
+  if (!domain.budget) fail(Cause::missing_binding);
+  if (domain.budget != budget_.get() || domain.graph != graph_.get() ||
+      domain.identity != identity_) fail(Cause::foreign_domain);
+}
+
+// The physical direct worker remains shared with immutable prepared inputs.
+// This distinct mutable birth never sets Data::original_input.
+struct OriginalBufferAllocation final : PreparedInputAllocation {
+  OriginalBufferBudgetRef budget;
+  submission::GraphQuotaRef graph;
+  uint64_t generation;
+  size_t charged;
+  OriginalBufferAllocation(OriginalBufferBudget* owner, submission::GraphQuota* arena,
+      uint64_t id, size_t bytes) noexcept : budget(owner), graph(arena), generation(id), charged(bytes) {}
+  void destroy() noexcept {
+    // Both local owners survive field destruction and the final Graph return.
+    OriginalBufferBudgetRef allowance(budget);
+    submission::GraphAllocator<OriginalBufferAllocation> source(graph.get());
+    const auto bytes = charged;
+    if (allocator) allocator->free_prepared_input(*this);
+    this->~OriginalBufferAllocation();
+    source.deallocate(this, 1);
+    allowance.get()->refund(bytes);
+  }
+};
+
+namespace {
+struct OriginalBufferIncoming {
+  OriginalBufferAllocation* value;
+  ~OriginalBufferIncoming() { if (value) value->destroy(); }
+};
+}
+bool original_buffer_allocation_control_bytes(size_t& out) noexcept {
+  // Actual default route, debit/rollback and birth retirement representations.
+  // The birth block and physical backing are separately charged by the caller.
+  const size_t values[] = {sizeof(OriginalBufferBinding), sizeof(OriginalBufferDomain),
+      sizeof(OriginalBufferBudget*), sizeof(submission::GraphAllocator<OriginalBufferAllocation>),
+      sizeof(OriginalBufferAllocation*), sizeof(OriginalBufferIncoming),
+      sizeof(OriginalBufferBudgetRef), sizeof(Buffer), sizeof(Buffer),
+      sizeof(size_t) * 5, sizeof(uint64_t), sizeof(PreparedInputCause), sizeof(OriginalBufferError)};
+  size_t total = sizeof(values);
+  for (size_t value : values) {
+    if (total > std::numeric_limits<size_t>::max() - value) return false;
+    total += value;
+  }
+  out = total;
+  return true;
+}
+
+Buffer malloc(size_t bytes) {
+  const auto binding = submission::current_default_buffer_binding();
+  if (binding) return allocate_original(bytes, binding);
+  return allocator().malloc(bytes);
+}
+void refuse_original_buffer_bypass() {
+  if (submission::current_default_buffer_binding()) fail(Cause::unsupported);
+}
+
+Buffer allocate_original(size_t bytes, const OriginalBufferBinding& binding) {
+  binding.validate();
+  submission::mark_native_control_construction();
+  auto* budget = binding.budget();
+  size_t capacity;
+  if (!budget->physical_capacity(bytes, capacity)) fail(Cause::invalid_layout);
+  // Metal's zero-length path has no physical owner. Validation still precedes it.
+  if (!capacity) return Buffer{nullptr};
+  const auto generation = next_allocation_generation();
+  if (!generation) fail(Cause::identity_exhausted);
+  submission::GraphAllocator<OriginalBufferAllocation> source(binding.graph());
+  auto* storage = source.allocate(1);
+  try { budget->debit(capacity); }
+  catch (...) { source.deallocate(storage, 1); throw; }
+  auto* allocation = ::new (storage) OriginalBufferAllocation(budget, binding.graph(), generation, capacity);
+  OriginalBufferIncoming incoming{allocation};
+  const auto outcome = budget->allocator_->allocate_prepared_buffer(bytes, *allocation);
+  if (outcome != PreparedInputCause::success) {
+    switch (outcome) {
+      case PreparedInputCause::busy: fail(Cause::busy);
+      case PreparedInputCause::allocation_failed: fail(Cause::allocation_failed);
+      case PreparedInputCause::capacity: fail(Cause::capacity);
+      case PreparedInputCause::unsupported: fail(Cause::unsupported);
+      case PreparedInputCause::identity_exhausted: fail(Cause::identity_exhausted);
+      default: fail(Cause::invalid_layout);
+    }
+  }
+  if (allocation->capacity != capacity) fail(Cause::capacity);
+  Buffer result(allocation->buffer.ptr(), allocation);
+  incoming.value = nullptr;
+  return result;
+}
+void free_original(Buffer buffer) noexcept {
+  if (auto* birth = buffer.original_) birth->destroy();
+}
+uint64_t Buffer::original_allocation_generation() const noexcept {
+  return original_ ? original_->generation : 0;
+}
+size_t Buffer::original_allocation_capacity() const noexcept {
+  return original_ ? original_->charged : 0;
+}
+OriginalBufferBudget* Buffer::original_buffer_budget() const noexcept {
+  return original_ ? original_->budget.get() : nullptr;
+}
+} // namespace mlx::core::allocator
+
+namespace mlx::core::submission {
+bool original_buffer_routing_layout(OriginalBufferRoutingLayout& out) noexcept {
