+      // Named factory/wait/query transports, not a compiler stack-frame bound.
+      sizeof(std::unique_ptr<WaitRecord, submission::Record::Deleter>) +
+      sizeof(WaitRecord*) + sizeof(submission::RecordDispatchGuard) +
+      sizeof(submission::Record::Allocation) + sizeof(void*) +
+      sizeof(submission::RecordQuota*) + sizeof(submission::RecordFixedStorageLayout) +
