+      !scope.active_on_owner_thread() || scope.graph_quota() != graph ||
+      !controls.original || controls.failure != submission::NativeControlFailure::none ||
+      controls.scope_identity != scope.identity() || scope.original_buffer_budget() != &budget ||
+      !budget.uses_allocator(allocator) || actual.page_size != facts.page_size ||
+      actual.maximum != facts.maximum || actual.kind != facts.kind || actual.controls != facts.controls)
+    return Status::domain;
