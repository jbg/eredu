diff --git a/mlx/input_allocator.h b/mlx/input_allocator.h
new file mode 100644
--- /dev/null
+++ b/mlx/input_allocator.h
@@ -0,0 +1,208 @@
+// One actual allocator birth shared by ordinary and admitted input callers.
+#pragma once
+
+#include <cstddef>
+#include <atomic>
+#include <limits>
+#include <cstdint>
+#include <mutex>
+#include <new>
+#include <utility>
+#include "mlx/allocator.h"
+
+namespace mlx::core::allocator {
+
+enum class InputAllocatorCause : unsigned {
+  success = 0,
+  unsupported = 1,
+  invalid = 2,
+  busy = 3,
+  allocation_failed = 4,
+  missing_device = 5,
+  ordinary_predecessor = 6,
+  already_initialized = 7,
+  identity_mismatch = 8,
+  identity_exhausted = 9,
+};
+struct InputAllocatorLayout {
+  size_t static_bytes{0};
+  size_t object_bytes{0};
+  size_t controls{0};
+  bool qualified{false};
+  bool requires_device{false};
+};
+struct InitializedInputAllocator {
+  Allocator* allocator{nullptr};
+  PreparedInputFacts facts{};
+  // This identifies this singleton's successful admitted birth, never a buffer.
+  uint64_t identity{0};
+};
+struct InputAllocatorOwner {
+  void* value{nullptr};
+  void (*retire)(void*){nullptr};
+};
+
+// Ordinary constructors still work on unqualified implementations. The admitted
+// recipe relies on the pinned constant mutex and nonallocating function-pointer /
+// reference_wrapper std::function forms. No observational allocation probe is a
+// replacement for this owning producer qualification.
+#if defined(__APPLE__) && defined(__aarch64__) && defined(__clang__) && \
+    defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L
+inline constexpr bool input_allocator_layout_qualified = true;
+#define MLX_INPUT_ALLOCATOR_CONSTINIT constinit
+#define MLX_INPUT_ALLOCATOR_CONSTEXPR constexpr
+#else
+inline constexpr bool input_allocator_layout_qualified = false;
+#define MLX_INPUT_ALLOCATOR_CONSTINIT
+#define MLX_INPUT_ALLOCATOR_CONSTEXPR
+#endif
+
+
+#if defined(__clang__)
+# if __has_attribute(no_destroy)
+#  define MLX_INPUT_ALLOCATOR_NO_DESTROY [[clang::no_destroy]]
+# endif
+#endif
+#ifndef MLX_INPUT_ALLOCATOR_NO_DESTROY
+#define MLX_INPUT_ALLOCATOR_NO_DESTROY
+#endif
+
+// Owning module storage, priced once beside the actual singleton slot. Checked
+// exhaustion never wraps or substitutes an address for a completed generation.
+inline MLX_INPUT_ALLOCATOR_CONSTINIT std::atomic<uint64_t> next_input_allocator_identity{1};
+inline uint64_t claim_input_allocator_identity() noexcept {
+  auto next = next_input_allocator_identity.load(std::memory_order_relaxed);
+  while (next != 0) {
+    auto after = next == std::numeric_limits<uint64_t>::max() ? 0 : next + 1;
+    if (next_input_allocator_identity.compare_exchange_weak(next, after, std::memory_order_relaxed))
+      return next;
+  }
+  return 0;
+}
+
+// Metal's existing allocator is intentionally permanent; CPU retains its actual
+// static object and exit cleanup. A local in-place instance uses this same worker
+// for lifetime/failure tests without resetting any process-global singleton.
+template <class T, bool PermanentHeap>
+class InputAllocatorSlot {
+ public:
+  MLX_INPUT_ALLOCATOR_CONSTEXPR InputAllocatorSlot() noexcept = default;
+  InputAllocatorSlot(const InputAllocatorSlot&) = delete;
+  ~InputAllocatorSlot() {
+    if constexpr (!PermanentHeap) {
+      if (value_) {
+        value_->~T();
+      }
+      // All allocator/cache destruction precedes the actual accounting owner.
+      if (owner_.value) {
+        owner_.retire(owner_.value);
+      }
+    }
+  }
+
+  template <class Factory>
+  T& ordinary(Factory&& factory) {
+    std::lock_guard guard(mutex_);
+    if (!value_) {
+      value_ = factory(storage());
+    }
+    return *value_;
+  }
+
+  template <class Factory>
+  InputAllocatorCause initialize(
+      Factory&& factory,
+      InputAllocatorOwner owner,
+      InitializedInputAllocator& output) noexcept {
+    if (!owner.value || !owner.retire || output.allocator || output.identity) {
+      return InputAllocatorCause::invalid;
+    }
+    if (!mutex_.try_lock()) {
+      return InputAllocatorCause::busy;
+    }
+    std::unique_lock guard(mutex_, std::adopt_lock);
+    if (value_) {
+      return owner_.value ? InputAllocatorCause::already_initialized
+                          : InputAllocatorCause::ordinary_predecessor;
+    }
+    T* candidate = nullptr;
+    PreparedInputFacts facts{};
+    try {
+      candidate = factory(storage());
+      if (!candidate) {
+        return InputAllocatorCause::allocation_failed;
+      }
+      if (!candidate->prepare_input_runtime(facts)) {
+        destroy_candidate(candidate);
+        return InputAllocatorCause::unsupported;
+      }
+    } catch (...) {
+      destroy_candidate(candidate);
+      return InputAllocatorCause::allocation_failed;
+    }
+    const auto identity = claim_input_allocator_identity();
+    if (!identity) {
+      destroy_candidate(candidate);
+      return InputAllocatorCause::identity_exhausted;
+    }
+    value_ = candidate;
+    owner_ = owner;
+    facts_ = facts;
+    identity_ = identity;
+    output = {value_, facts_, identity_};
+    return InputAllocatorCause::success;
+  }
+
+  InputAllocatorCause borrow(
+      uint64_t identity, InitializedInputAllocator& output) noexcept {
+    if (!identity || output.allocator || output.identity) {
+      return InputAllocatorCause::invalid;
+    }
+    if (!mutex_.try_lock()) {
+      return InputAllocatorCause::busy;
+    }
+    std::lock_guard guard(mutex_, std::adopt_lock);
+    if (!value_ || !owner_.value || identity != identity_) {
+      return InputAllocatorCause::identity_mismatch;
+    }
+    output = {value_, facts_, identity_};
+    return InputAllocatorCause::success;
+  }
+
+  static constexpr size_t construction_controls() noexcept {
+    return sizeof(std::unique_lock<std::mutex>) + sizeof(T*) +
+        sizeof(PreparedInputFacts) + sizeof(InputAllocatorOwner) +
+        sizeof(InitializedInputAllocator) + sizeof(InputAllocatorCause) + sizeof(uint64_t) * 3;
+  }
+
+ private:
+  void* storage() noexcept {
+    if constexpr (PermanentHeap) {
+      return nullptr;
+    } else {
+      return storage_;
+    }
+  }
+  static void destroy_candidate(T* value) noexcept {
+    if (!value) return;
+    if constexpr (PermanentHeap) {
+      delete value;
+    } else {
+      value->~T();
+    }
+  }
+  std::mutex mutex_{};
+  T* value_{nullptr};
+  InputAllocatorOwner owner_{};
+  PreparedInputFacts facts_{};
+  uint64_t identity_{0};
+  alignas(T) std::byte storage_[PermanentHeap ? 1 : sizeof(T)]{};
+};
+
+MLX_API InputAllocatorLayout input_allocator_layout() noexcept;
+MLX_API InputAllocatorCause initialize_input_allocator(
+    InputAllocatorOwner, InitializedInputAllocator&) noexcept;
+MLX_API InputAllocatorCause borrow_input_allocator(
+    uint64_t, InitializedInputAllocator&) noexcept;
+
+} // namespace mlx::core::allocator
diff --git a/mlx/intrusive_index.h b/mlx/intrusive_index.h
new file mode 100644
--- /dev/null
+++ b/mlx/intrusive_index.h
@@ -0,0 +1,178 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <functional>
+#include <utility>
+
+namespace mlx::core::detail {
+
+// Intrusive ordering only: the caller owns every allocation and its immutable
+// birth allocator. Rotations/removal never move payloads or destroy owners.
+template <class Node, class Key = const void *> struct IndexLinks {
+  Key key{};
+  Node *left{nullptr};
+  Node *right{nullptr};
+  Node *parent{nullptr};
+  Node *next{nullptr}; // detached/FIFO custody, never tree ownership
+  int height{1};
+  explicit IndexLinks(Key key = {}) noexcept : key(key) {}
+};
+
+template <class Node, class Key = const void *> class IntrusiveIndex {
+public:
+  IntrusiveIndex() = default;
+  IntrusiveIndex(const IntrusiveIndex &) = delete;
+  IntrusiveIndex &operator=(const IntrusiveIndex &) = delete;
+  bool empty() const noexcept { return !root_; }
+  size_t size() const noexcept { return size_; }
+  Node *root() const noexcept { return root_; }
+  Node *first() const noexcept { return minimum(root_); }
+  static Node *next(Node *node) noexcept {
+    if (node->right)
+      return minimum(node->right);
+    auto *parent = node->parent;
+    while (parent && node == parent->right) {
+      node = parent;
+      parent = parent->parent;
+    }
+    return parent;
+  }
+  Node *find(Key key) const noexcept {
+    auto *node = root_;
+    const std::less<Key> less;
+    while (node) {
+      if (less(key, node->key))
+        node = node->left;
+      else if (less(node->key, key))
+        node = node->right;
+      else
+        return node;
+    }
+    return nullptr;
+  }
+  // Returns an existing node on duplicate without adopting the candidate.
+  // Candidates are detached and already owned before this no-throw mutation.
+  Node *insert(Node *candidate) noexcept {
+    Node *parent = nullptr;
+    auto **link = &root_;
+    const std::less<Key> less;
+    while (*link) {
+      parent = *link;
+      if (less(candidate->key, parent->key))
+        link = &parent->left;
+      else if (less(parent->key, candidate->key))
+        link = &parent->right;
+      else
+        return parent;
+    }
+    candidate->parent = parent;
+    candidate->left = candidate->right = nullptr;
+    candidate->height = 1;
+    *link = candidate;
+    ++size_;
+    rebalance(parent);
+    return nullptr;
+  }
+  Node *detach(Node *node) noexcept {
+    Node *repair;
+    if (!node->left || !node->right) {
+      repair = node->parent;
+      replace(node, node->left ? node->left : node->right);
+    } else {
+      auto *successor = minimum(node->right);
+      if (successor->parent == node) {
+        repair = successor;
+      } else {
+        repair = successor->parent;
+        replace(successor, successor->right);
+        successor->right = node->right;
+        successor->right->parent = successor;
+      }
+      replace(node, successor);
+      successor->left = node->left;
+      successor->left->parent = successor;
+      successor->height = node->height;
+    }
+    --size_;
+    node->left = node->right = node->parent = nullptr;
+    node->height = 1;
+    rebalance(repair);
+    return node;
+  }
+  Node *pop_first() noexcept {
+    auto *node = first();
+    return node ? detach(node) : nullptr;
+  }
+
+private:
+  static Node *minimum(Node *node) noexcept {
+    if (node)
+      while (node->left)
+        node = node->left;
+    return node;
+  }
+  static int height(Node *node) noexcept { return node ? node->height : 0; }
+  static void update(Node *node) noexcept {
+    node->height = 1 + std::max(height(node->left), height(node->right));
+  }
+  static int balance(Node *node) noexcept {
+    return height(node->left) - height(node->right);
+  }
+  void replace(Node *old, Node *incoming) noexcept {
+    auto *parent = old->parent;
+    if (!parent)
+      root_ = incoming;
+    else if (parent->left == old)
+      parent->left = incoming;
+    else
+      parent->right = incoming;
+    if (incoming)
+      incoming->parent = parent;
+  }
+  Node *rotate_left(Node *node) noexcept {
+    auto *incoming = node->right;
+    auto *middle = incoming->left;
+    replace(node, incoming);
+    incoming->left = node;
+    node->parent = incoming;
+    node->right = middle;
+    if (middle)
+      middle->parent = node;
+    update(node);
+    update(incoming);
+    return incoming;
+  }
+  Node *rotate_right(Node *node) noexcept {
+    auto *incoming = node->left;
+    auto *middle = incoming->right;
+    replace(node, incoming);
+    incoming->right = node;
+    node->parent = incoming;
+    node->left = middle;
+    if (middle)
+      middle->parent = node;
+    update(node);
+    update(incoming);
+    return incoming;
+  }
+  void rebalance(Node *node) noexcept {
+    while (node) {
+      update(node);
+      if (balance(node) > 1) {
+        if (balance(node->left) < 0)
+          rotate_left(node->left);
+        node = rotate_right(node);
+      } else if (balance(node) < -1) {
+        if (balance(node->right) > 0)
+          rotate_right(node->right);
+        node = rotate_left(node);
+      }
+      node = node->parent;
+    }
+  }
+  Node *root_{nullptr};
+  size_t size_{0};
+};
+
+} // namespace mlx::core::detail
