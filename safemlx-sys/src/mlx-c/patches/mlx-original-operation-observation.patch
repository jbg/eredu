+  if (!failure) return Status::domain;
+  if (failure->borrow() || scope.query().failed) return Status::failed;
+  if (failure->pending_publication()) return Status::busy;
+  // Dedicated fresh storage only. No sharing of the global prepared-block table
+  // with another producer, and no interpretation of current free space as fit.
+  if (graph->capacity() != c.layout.metadata_bytes || graph->occupied_bytes() != 0)
+    return Status::capacity;
+  if (!graph->prepare_blocks(c.requests, c.count)) return Status::capacity;
+  FinishBlocks finish{graph};
+  try {
+    MutablePairHandle handle{graph,
+        graph->allocate(sizeof(PreparedInputArray), alignof(PreparedInputArray))};
+    // Same ordinary eager scalar decoder, now under the exact original domain.
+    // Rank-one shape/strides and the fixed default function-pointer deleter are inline.
+    array value(input, Shape{2}, uint32);
+    const auto& data = value.data_shared_ptr();
