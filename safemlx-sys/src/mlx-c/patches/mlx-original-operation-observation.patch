diff --git a/mlx/eval_storage.h b/mlx/eval_storage.h
new file mode 100644
--- /dev/null
+++ b/mlx/eval_storage.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include <cstdint>
+#include <utility>
+
+#include "mlx/intrusive_index.h"
+#include "mlx/record_quota.h"
+
+namespace mlx::core::detail {
+
+// The fixed route owns one actual Record allocation and never grows after
+// construction. Its caller qualifies fresh reserve(n) before construction.
+template <class T> class EvalFixedVector {
+  submission::RecordVector<T> values_;
+  size_t limit_;
+
+  void room() const {
+    if (values_.size() == limit_)
+      throw submission::RecordQuotaError(submission::QuotaFailure::exhausted);
+  }
+
+ public:
+  using value_type = T;
+  using reference = T&;
+  using const_reference = const T&;
+  using size_type = size_t;
+  using iterator = typename submission::RecordVector<T>::iterator;
+  using const_iterator = typename submission::RecordVector<T>::const_iterator;
+
+  EvalFixedVector(submission::RecordQuota* resource, size_t limit)
+      : values_(resource), limit_(limit) {
+    values_.reserve(limit);
+    if (values_.capacity() != limit)
+      throw submission::RecordQuotaError(submission::QuotaFailure::invalid_layout);
+  }
+  bool empty() const noexcept { return values_.empty(); }
+  size_t size() const noexcept { return values_.size(); }
+  reference operator[](size_t i) noexcept { return values_[i]; }
+  const_reference operator[](size_t i) const noexcept { return values_[i]; }
+  reference back() noexcept { return values_.back(); }
+  const_reference back() const noexcept { return values_.back(); }
+  void pop_back() noexcept { values_.pop_back(); }
+  reference top() noexcept { return values_.back(); }
+  void pop() noexcept { values_.pop_back(); }
+  template<class... Args> reference emplace(Args&&... args) {
+    return emplace_back(std::forward<Args>(args)...);
+  }
+  iterator begin() noexcept { return values_.begin(); }
+  const_iterator begin() const noexcept { return values_.begin(); }
+  iterator end() noexcept { return values_.end(); }
+  const_iterator end() const noexcept { return values_.end(); }
+  auto rbegin() noexcept { return values_.rbegin(); }
+  auto rbegin() const noexcept { return values_.rbegin(); }
+  auto rend() noexcept { return values_.rend(); }
+  auto rend() const noexcept { return values_.rend(); }
+  void push_back(const T& value) { room(); values_.push_back(value); }
+  void push_back(T&& value) { room(); values_.push_back(std::move(value)); }
+  template<class... Args> reference emplace_back(Args&&... args) {
+    room();
+    return values_.emplace_back(std::forward<Args>(args)...);
+  }
+  iterator insert(const_iterator position, const T& value) {
+    room();
+    return values_.insert(position, value);
+  }
+};
+
+// Storage adapters retain the ordinary hash-map operations and their original
+// allocation/error positions. The prepared alternative has no hash buckets,
+// no per-insertion allocation, and no ownership in the intrusive ordering.
+template <class V> class EvalOrdinaryMap {
+  submission::RecordMap<uintptr_t, V> values_;
+ public:
+  explicit EvalOrdinaryMap(submission::RecordQuota* resource) : values_(resource) {}
+  bool empty() const noexcept { return values_.empty(); }
+  V* find(uintptr_t key) {
+    auto found = values_.find(key);
+    return found == values_.end() ? nullptr : &found->second;
+  }
+  std::pair<V*, bool> emplace(uintptr_t key, const V& value) {
+    auto [where, inserted] = values_.emplace(key, value);
+    return {&where->second, inserted};
+  }
+  void insert(uintptr_t key, const V& value) { values_.insert({key, value}); }
+  V& operator[](uintptr_t key) { return values_[key]; }
+  void erase(uintptr_t key) { values_.erase(key); }
+};
+
+template <class V> struct EvalMapNode : IndexLinks<EvalMapNode<V>> {
+  V value;
+  EvalMapNode(uintptr_t key, const V& value)
+      : IndexLinks<EvalMapNode<V>>(reinterpret_cast<const void*>(key)), value(value) {}
+};
+
+template <class V> class EvalFixedMap {
+  using Node = EvalMapNode<V>;
+  EvalFixedVector<Node> nodes_;
+  IntrusiveIndex<Node> index_;
+ public:
+  EvalFixedMap(submission::RecordQuota* resource, size_t limit) : nodes_(resource, limit) {}
+  bool empty() const noexcept { return index_.empty(); }
+  V* find(uintptr_t key) noexcept {
+    auto* node = index_.find(reinterpret_cast<const void*>(key));
+    return node ? &node->value : nullptr;
+  }
+  std::pair<V*, bool> emplace(uintptr_t key, const V& value) {
+    if (auto* existing = find(key)) return {existing, false};
+    auto& node = nodes_.emplace_back(key, value);
+    index_.insert(&node);
+    return {&node.value, true};
+  }
+  void insert(uintptr_t key, const V& value) { (void)emplace(key, value); }
+  V& operator[](uintptr_t key) { return *emplace(key, V{}).first; }
+  void erase(uintptr_t key) noexcept {
+    if (auto* node = index_.find(reinterpret_cast<const void*>(key))) index_.detach(node);
+    // DFS inserts precede BFS erasure. Slots remain owned through retirement;
+    // erasure needs neither compaction nor a second free-list allocation.
+  }
+};
+
+} // namespace mlx::core::detail
