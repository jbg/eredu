+namespace mlx::core::submission {
+bool cpu_eval_cleanup_layout(size_t inputs, size_t siblings,
+    CpuEvalCleanupLayout& output) noexcept {
+  cpu::RetentionLayout retention;
+  if (!cpu::CommandEncoder::retention_layout(inputs, siblings, retention)) return false;
+  CpuEvalCleanupLayout value;
+  value.inputs = inputs; value.siblings = siblings;
+  value.data_slot_bytes = sizeof(cpu::detail::DataRetention::Value);
+  value.data_slot_alignment = alignof(cpu::detail::DataRetention::Value);
+  value.request_bytes[0] = retention.cleanup_task.bytes;
+  value.request_alignments[0] = retention.cleanup_task.alignment;
+  value.request_counts[0] = 1;
+  value.request_bytes[1] = retention.data_slots.bytes;
+  value.request_alignments[1] = retention.data_slots.alignment;
+  value.request_counts[1] = retention.maximum_data_slots != 0;
+  // The encoder shell and temporary batches already have separate owners.
+  // No standard container/shared-control layout is inferred by this query.
+  value.named_control_bytes = sizeof(value) + sizeof(retention) +
+      sizeof(size_t) * 2 + sizeof(CpuEvalCleanupLayout*) +
+      sizeof(std::optional<FixedEvalPrologueGuard>) + sizeof(GraphConstruction*) +
+      sizeof(GraphFailure) + sizeof(NativeControlBinding) + sizeof(NativeControlError) +
+      sizeof(cpu::detail::PreparedCleanup) + sizeof(scheduler::TaskContext) +
+      sizeof(scheduler::TaskOwner) + sizeof(cpu::detail::Cleanup) +
+      sizeof(GraphAllocator<cpu::detail::DataRetention::Value>) +
+      sizeof(GraphAllocator<scheduler::TaskNode<cpu::detail::Cleanup>>) +
+      sizeof(cpu::CommandEncoder*) + sizeof(array*) + sizeof(Stream);
+  if (!GraphConstruction::complete_layout(value)) return false;
+  output = value;
+  return true;
+}
