+PreparedHostCopyCause construct_original_mutable_pair(allocator::Allocator& allocator,
+    const allocator::PreparedInputFacts& facts, submission::GraphQuota* graph,
+    submission::Scope& scope, allocator::OriginalBufferBudget& budget,
+    const uint32_t* input, PreparedInputArray*& output) noexcept {
+  using Status = PreparedHostCopyCause;
+  MutablePairConstruction c;
+  if (output || !input || reinterpret_cast<uintptr_t>(input) % alignof(uint32_t) || !graph ||
+      !original_mutable_pair_layout(facts, c.layout) ||
+      !mutable_pair_requests(c.requests, c.count)) return Status::invalid;
+  const auto controls = submission::current_native_controls();
+  const auto& actual = budget.facts();
