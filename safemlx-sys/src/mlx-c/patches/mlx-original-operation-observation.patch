diff --git a/mlx/backend/metal/persistent_storage.h b/mlx/backend/metal/persistent_storage.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/persistent_storage.h
@@ -0,0 +1,169 @@
+#pragma once
+
+#include <Metal/Metal.hpp>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "mlx/array.h"
+#include "mlx/backend/metal/intrusive_index.h"
+#include "mlx/graph_quota.h"
+
+namespace mlx::core::metal::detail {
+
+// Only the existing Graph allocator chooses ordinary versus prepaid storage.
+// Keep it alive across payload destruction AND the physical block return.
+template <class Node> struct EntryDeleter {
+  void operator()(Node *node) const noexcept {
+    submission::GraphAllocator<Node> allocator(node->birth.get());
+    node->~Node();
+    allocator.deallocate(node, 1);
+  }
+};
+template <class Node>
+using EntryOwner = std::unique_ptr<Node, EntryDeleter<Node>>;
+template <class Node, class... Args>
+EntryOwner<Node> prepare_entry(submission::GraphQuota *graph, Args &&...args) {
+  submission::GraphAllocator<Node> allocator(graph);
+  auto *storage = allocator.allocate(1);
+  try {
+    return EntryOwner<Node>(::new (storage)
+                                Node(graph, std::forward<Args>(args)...));
+  } catch (...) {
+    allocator.deallocate(storage, 1);
+    throw;
+  }
+}
+
+// A fixed header for already allocated nodes. Used for candidates and callback
+// detach lists: no allocation, recursion or owner destruction under the map
+// lock.
+template <class Node> class EntryChain {
+public:
+  EntryChain() = default;
+  EntryChain(const EntryChain &) = delete;
+  EntryChain &operator=(const EntryChain &) = delete;
+  EntryChain(EntryChain &&other) noexcept
+      : head_(std::exchange(other.head_, nullptr)),
+        tail_(std::exchange(other.tail_, nullptr)),
+        size_(std::exchange(other.size_, 0)) {}
+  ~EntryChain() { clear(); }
+  Node *first() const noexcept { return head_; }
+  size_t size() const noexcept { return size_; }
+  void append(Node *node) noexcept {
+    node->next = nullptr;
+    if (tail_)
+      tail_->next = node;
+    else
+      head_ = node;
+    tail_ = node;
+    ++size_;
+  }
+  void append(EntryOwner<Node> node) noexcept { append(node.release()); }
+  Node *pop() noexcept {
+    auto *node = head_;
+    if (node) {
+      head_ = node->next;
+      node->next = nullptr;
+      if (!head_)
+        tail_ = nullptr;
+      --size_;
+    }
+    return node;
+  }
+  void clear() noexcept {
+    while (auto *node = pop())
+      EntryDeleter<Node>{}(node);
+  }
+
+private:
+  Node *head_{nullptr};
+  Node *tail_{nullptr};
+  size_t size_{0};
+};
+
+template <class Node> class OwnedIndex : public IntrusiveIndex<Node> {
+public:
+  ~OwnedIndex() { clear(); }
+  void clear() noexcept {
+    while (auto *node = this->pop_first())
+      EntryDeleter<Node>{}(node);
+  }
+};
+
+// No Array/Data references: membership cannot affect primitive donation.
+struct ResourceEntry : IndexLinks<ResourceEntry> {
+  submission::GraphQuotaRef birth;
+  enum Bit : uint8_t {
+    all_input = 1,
+    all_output = 2,
+    previous_input = 4,
+    previous_output = 8,
+    next_input = 16,
+    next_output = 32,
+    concurrent_output = 64
+  };
+  uint8_t bits{0};
+  ResourceEntry(submission::GraphQuota *graph, const void *key)
+      : IndexLinks(key), birth(graph) {}
+  bool has(Bit bit) const noexcept { return (bits & bit) != 0; }
+  void add(Bit bit) noexcept { bits |= bit; }
+  void remove(Bit bit) noexcept { bits &= static_cast<uint8_t>(~bit); }
+};
+
+// One actual compute-encoder fence. Original shared controls use
+// GraphAllocator; this payload has no encoder, Scope, Record, or mutable
+// allocator backedge.
+struct EncoderFence {
+  NS::SharedPtr<MTL::Fence> native;
+  MTL::Fence *get() const noexcept { return native.get(); }
+};
+using FenceOwner = std::shared_ptr<EncoderFence>;
+struct FenceEntry : IndexLinks<FenceEntry> {
+  submission::GraphQuotaRef birth;
+  FenceOwner fence;
+  FenceEntry(submission::GraphQuota *graph, const void *key = nullptr)
+      : IndexLinks(key), birth(graph) {}
+};
+
+// Registration owns either one inline array or the EXACT incoming vector
+// allocation. Each vector preserves its own allocator independently of the
+// batch node's birth owner. Duplicates and FIFO row order are intentional.
+struct TemporaryBatch {
+  submission::GraphQuotaRef birth;
+  TemporaryBatch *next{nullptr};
+  std::optional<array> single;
+  std::optional<ArrayVector> multiple;
+  explicit TemporaryBatch(submission::GraphQuota *graph) : birth(graph) {}
+  size_t size() const noexcept {
+    return single ? 1 : multiple ? multiple->size() : 0;
+  }
+};
+class TemporaryStorage {
+public:
+  size_t size() const noexcept { return rows_; }
+  void append(EntryOwner<TemporaryBatch> batch) noexcept {
+    rows_ += batch->size();
+    batches_.append(std::move(batch));
+  }
+  template <class F> void each(F &&f) const {
+    for (auto *batch = batches_.first(); batch; batch = batch->next) {
+      if (batch->single)
+        f(*batch->single);
+      if (batch->multiple)
+        for (const auto &value : *batch->multiple)
+          f(value);
+    }
+  }
+  void clear() noexcept {
+    batches_.clear();
+    rows_ = 0;
+  }
+
+private:
+  EntryChain<TemporaryBatch> batches_;
+  size_t rows_{0};
+};
+
+} // namespace mlx::core::metal::detail
