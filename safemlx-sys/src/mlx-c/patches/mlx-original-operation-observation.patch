+// An owning scratch/adoption destination. Buffer itself remains a borrowed,
+// trivially copied physical handle; only this owner frees its current value.
+class BufferOwner final {
+ public:
+  explicit BufferOwner(Buffer buffer = Buffer{nullptr}) noexcept : buffer_(buffer) {}
+  BufferOwner(BufferOwner&& other) noexcept : buffer_(other.release()) {}
+  BufferOwner& operator=(BufferOwner&& other) noexcept {
+    if (this != &other) { reset(); buffer_ = other.release(); }
+    return *this;
+  }
+  BufferOwner(const BufferOwner&) = delete;
+  BufferOwner& operator=(const BufferOwner&) = delete;
+  ~BufferOwner() { reset(); }
+  Buffer get() const noexcept { return buffer_; }
+  Buffer release() noexcept { auto result = buffer_; buffer_ = Buffer{nullptr}; return result; }
+  void reset() noexcept { auto value = release(); if (value.ptr()) free(value); }
+ private:
+  Buffer buffer_;
+};
