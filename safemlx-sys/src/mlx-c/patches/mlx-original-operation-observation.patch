+detail::ResourceEntry& CommandEncoder::prepare_resource(
+    const void* key, size_t input_bytes) {
+  const auto owner = allocation_owner();
+  auto* existing = resources_.find(key);
+  if ((!existing || !existing->has(detail::ResourceEntry::all_input)) &&
+      input_bytes > std::numeric_limits<size_t>::max() - buffer_sizes_)
+    throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+  if (existing) return *existing;
+  auto candidate = detail::prepare_entry<detail::ResourceEntry>(owner.graph, key);
+  resources_.insert(candidate.get());
+  return *candidate.release();
+}
+
+size_t CommandEncoder::resource_count(detail::ResourceEntry::Bit bit) const noexcept {
+  size_t count = 0;
+  for (auto* node = resources_.first(); node; node = resources_.next(node))
+    count += node->has(bit);
+  return count;
+}
+
+void CommandEncoder::remove_resource_bits(const void* key, uint8_t bits) noexcept {
+  if (auto* node = resources_.find(key)) {
