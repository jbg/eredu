+
+bool completion_eval_record_layout(
+    size_t tape_entries, size_t streams, size_t output_slots,
+    CompletionEvalRecordLayout& out) noexcept {
+  // Every selected frontier contains its Synchronizer. An unselected
+  // eventless fast return is a zero-Eval population, not a zero-shaped Eval.
+  if (!tape_entries || !streams || streams > tape_entries || output_slots < tape_entries)
+    return false;
+  submission::RecordFrontierStorageLayout base;
+  if (!submission::Record::frontier_storage_layout(streams, output_slots, base))
+    return false;
+  using States = decltype(EvalSubmissionRecord::streams);
+  using Owners = decltype(EvalSubmissionRecord::primitive_owners);
+  constexpr size_t state_size = sizeof(States::value_type);
+  constexpr size_t owner_size = sizeof(Owners::value_type);
+  const auto maximum = std::numeric_limits<size_t>::max();
+  if (streams > maximum / state_size ||
+      streams > static_cast<size_t>(std::numeric_limits<States::difference_type>::max()) ||
+      tape_entries > maximum / owner_size ||
+      tape_entries > static_cast<size_t>(std::numeric_limits<Owners::difference_type>::max()))
+    return false;
+  const size_t requests[] = {sizeof(EvalSubmissionRecord), base.fixed.capture_bytes,
+      streams * state_size, base.fixed.stream_bytes,
+      tape_entries * owner_size, base.output_bytes};
+  size_t total = 0;
+  for (auto bytes : requests) {
+    if (bytes > maximum - total) return false;
+    total += bytes;
+  }
+  submission::EvalGraphLayout host_graph;
+  if (!submission::eval_graph_layout(host_graph)) return false;
+  const CompletionEvalRecordLayout value{tape_entries, streams, output_slots,
+      sizeof(EvalSubmissionRecord), alignof(EvalSubmissionRecord),
+      base.fixed.capture_slots, base.fixed.capture_bytes, base.fixed.capture_alignment,
+      streams * state_size, alignof(States::value_type),
+      base.fixed.stream_bytes, base.fixed.stream_alignment,
+      tape_entries * owner_size, alignof(Owners::value_type),
+      base.output_bytes, base.output_alignment, 6, total,
+      // Named query/factory transports. The existing Eval object contains the
+      // vector/deque/optional shells; do not charge them again here.
+      sizeof(CompletionEvalRecordLayout) + sizeof(submission::RecordFrontierStorageLayout) +
+      sizeof(requests) + sizeof(size_t) * 6 + sizeof(CompletionEvalRecordLayout*) +
+      sizeof(std::unique_ptr<EvalSubmissionRecord, submission::Record::Deleter>) +
+      sizeof(EvalSubmissionRecord*) + sizeof(submission::RecordDispatchGuard) +
+      sizeof(submission::Record::Allocation) + sizeof(void*) +
+      sizeof(submission::RecordQuota*) + host_graph.named_control_bytes,
+      host_graph};
+  out = value;
+  return true;
+}
+
+namespace {
+template<class T> bool eval_traversal_request(
+    CompletionEvalTraversalLayout& value, size_t index, size_t count) noexcept {
+  if (count > std::numeric_limits<size_t>::max() / sizeof(T) ||
+      count > static_cast<size_t>(std::numeric_limits<ptrdiff_t>::max())) return false;
+  value.request_bytes[index] = count * sizeof(T);
+  value.request_alignments[index] = alignof(T);
+  return true;
+}
