@@ -0,0 +1,90 @@
+#pragma once
+#include "mlx/graph_quota.h"
+
+namespace mlx::core::submission {
+// Internal closed-producer recipe. Classes reserve maximum byte extents at
+// max_align_t. Only owning producer entry points may install a recipe.
+struct GraphConstructionLayout {
+  static constexpr size_t classes = 10;
+  size_t request_bytes[classes]{};
+  size_t request_alignments[classes]{};
+  size_t request_counts[classes]{};
+  size_t blocks{0};
+  size_t header_bytes{0}, header_alignment{0};
+  size_t slots_bytes{0}, slots_alignment{0};
+  size_t reserved_alignment{0};
+  size_t requested_bytes{0};
+  // Sum of allocator worst-alignment extents; not a promise about fragmented
+  // free space or tail absorption. Actual successful preflight is the proof.
+  size_t allocation_extents{0};
+  size_t named_control_bytes{0};
+};
+// Actual generic Add/Multiply host constructors, including temporary overlap.
+struct PointwiseGraphLayout : GraphConstructionLayout {
+  size_t operations{0}, maximum_rank{0};
+};
+MLX_API bool pointwise_graph_layout(size_t operations, size_t maximum_rank,
+    PointwiseGraphLayout&) noexcept;
+
+// Four fixed-Eval host requests; no Data, worker or stream-frontier owners.
+struct EvalGraphLayout : GraphConstructionLayout {
+  size_t event_construction_controls{0};
+  size_t platform_events{0};
+};
+MLX_API bool eval_graph_layout(EvalGraphLayout&) noexcept;
+class Record;
+class FixedEvalPrologueGuard;
+using GpuEvalPrologueGuard = FixedEvalPrologueGuard;
+// CPU Eval reserves only the existing cleanup task and empty Data slots.
+// Invocation vectors, primitive tasks and worker scratch remain separate.
+struct CpuEvalCleanupLayout : GraphConstructionLayout {
+  size_t inputs{0}, siblings{0};
+  size_t data_slot_bytes{0}, data_slot_alignment{0};
+};
+MLX_API bool cpu_eval_cleanup_layout(size_t inputs, size_t siblings,
+    CpuEvalCleanupLayout&) noexcept;
+// GPU host prologue: retention controls and empty Data/invocation vectors.
+struct GpuEvalPrologueLayout : GraphConstructionLayout {
+  size_t inputs{0}, siblings{0}, tracer_inputs{0};
+  size_t data_slot_bytes{0}, data_slot_alignment{0};
+  size_t array_slot_bytes{0}, array_slot_alignment{0};
+};
+// Compiled GPU adapter supplies an honest unknown when this producer is absent.
+MLX_API bool gpu_eval_prologue_layout(size_t inputs, size_t siblings, bool tracer,
+    GpuEvalPrologueLayout&) noexcept;
+inline bool gpu_eval_prologue_layout(size_t inputs, size_t siblings,
+    GpuEvalPrologueLayout& output) noexcept {
+  return gpu_eval_prologue_layout(inputs, siblings, false, output);
+}
+
+// The header, slots and reserved blocks are ordinary blocks of the existing
+// GraphQuota. No inner arena, fallback, refill or recycled construction credit.
+class MLX_API GraphConstruction final {
+ public:
+  static bool complete_layout(GraphConstructionLayout&) noexcept;
+  static GraphFailure create(GraphQuota&, uint64_t scope,
+      const PointwiseGraphLayout&, GraphConstruction*&) noexcept;
+  static GraphFailure create_eval(GraphQuota&, uint64_t scope,
+      const Record& dispatch, GraphConstruction*&) noexcept;
+  static GraphFailure create_gpu_prologue(const GpuEvalPrologueGuard&, GraphConstruction*&) noexcept;
+  static GraphFailure create_cpu_cleanup(const FixedEvalPrologueGuard&, GraphConstruction*&) noexcept;
+  void destroy() noexcept;
+  size_t remaining() const noexcept;
+ private:
+  friend class GraphQuota;
+  struct Slot { void* pointer; size_t bytes; };
+  static GraphFailure create_layout(GraphQuota&, uint64_t scope,
+      const Record* dispatch, const GraphConstructionLayout&, GraphConstruction*&, bool exclusive_host = false) noexcept;
+  GraphConstruction(GraphQuota& quota, uint64_t scope, const Record* dispatch,
+      size_t count, bool exclusive_host) noexcept
+      : quota_(&quota), scope_(scope), dispatch_(dispatch), count_(count), exclusive_host_(exclusive_host) {}
+  ~GraphConstruction() = default;
+  void* take(size_t bytes, size_t alignment); // caller holds GraphQuota::Loan
+  GraphQuota* quota_;
+  uint64_t scope_;
+  const Record* dispatch_;
+  Slot* slots_{nullptr};
+  size_t count_;
+  bool exclusive_host_;
+};
+} // namespace mlx::core::submission
