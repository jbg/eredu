+}
+inline constexpr size_t qualification_controls() noexcept {
+  // Actual local address/scalar inventories, matching loops and caller results.
+  return sizeof(uintptr_t) * 27 + sizeof(size_t) * 9 + sizeof(uint32_t) * 5 +
+      sizeof(int64_t) * 4 + sizeof(const volatile unsigned char*) * 2 +
+      sizeof(const volatile uint32_t*) + sizeof(bool) * 18 +
+      sizeof(uintptr_t) * 7 + sizeof(size_t) + sizeof(const volatile uint32_t*);
+}
