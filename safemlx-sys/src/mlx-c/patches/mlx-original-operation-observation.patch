+        bytes > absent / n || extent > absent / n ||
+        !add(count, n, count) || !add(requested, n * bytes, requested) ||
+        !add(extents, n * extent, extents)) return false;
+  }
+  if (count > size_t(PTRDIFF_MAX) / sizeof(Slot)) return false;
+  value.blocks = count;
+  value.header_bytes = sizeof(GraphConstruction);
+  value.header_alignment = alignof(GraphConstruction);
+  value.slots_bytes = count * sizeof(Slot);
+  value.slots_alignment = alignof(Slot);
+  value.reserved_alignment = alignment;
+  size_t header_extent, slots_extent = 0;
