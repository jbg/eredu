+void PreparedHostCopySlot::destroy() noexcept {
+  auto* quota = quota_;
+  if (handle_) quota->deallocate(handle_, sizeof(PreparedInputArray), alignof(PreparedInputArray));
+  this->~PreparedHostCopySlot();
+  quota->deallocate(this, sizeof(PreparedHostCopySlot), alignof(PreparedHostCopySlot));
+  quota->release();
+}
