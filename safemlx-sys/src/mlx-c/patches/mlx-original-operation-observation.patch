+}
+GraphFailure GraphConstruction::create(GraphQuota& quota, uint64_t scope,
+    const PointwiseGraphLayout& layout, GraphConstruction*& output) noexcept {
+  const auto context = current_graph_construction_context();
+  if (output || !scope || context.worker || context.dispatch || context.scope != scope ||
+      current_graph_quota() != &quota) return GraphFailure::foreign_parent;
+  // Recompute owning geometry from the two scalar inputs. No caller-supplied
+  // byte/count field can change the destination recipe.
+  PointwiseGraphLayout actual;
+  if (!pointwise_graph_layout(layout.operations, layout.maximum_rank, actual))
+    return GraphFailure::invalid_layout;
+  return create_layout(quota, scope, nullptr, actual, output);
+}
+GraphFailure GraphConstruction::create_eval(GraphQuota& quota, uint64_t scope,
+    const Record& dispatch, GraphConstruction*& output) noexcept {
+  const auto context = current_graph_construction_context();
+  if (output || !scope || context.worker || context.scope != scope ||
+      context.dispatch != &dispatch || current_graph_quota() != &quota)
+    return GraphFailure::foreign_parent;
+  EvalGraphLayout actual;
+  if (!eval_graph_layout(actual)) return GraphFailure::invalid_layout;
+  return create_layout(quota, scope, &dispatch, actual, output);
+}
+GraphFailure GraphConstruction::create_gpu_prologue(const GpuEvalPrologueGuard& guard,
+    GraphConstruction*& output) noexcept {
+  auto& dispatch = guard.record();
+  auto* quota = dispatch.graph_quota();
+  const auto context = current_graph_construction_context();
+  if (output || !quota || !context.scope || context.worker ||
+      context.dispatch != &dispatch || current_graph_quota() != quota)
+    return GraphFailure::foreign_parent;
+  if (guard.cpu()) return GraphFailure::foreign_parent;
+  GpuEvalPrologueLayout actual;
+  if (!gpu_eval_prologue_layout(guard.inputs(), guard.siblings(), guard.tracer(), actual)) return GraphFailure::invalid_layout;
+  return create_layout(*quota, context.scope, &dispatch, actual, output, true);
+}
+GraphFailure GraphConstruction::create_cpu_cleanup(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& output) noexcept {
+  auto& dispatch = guard.record();
+  auto* quota = dispatch.graph_quota();
+  const auto context = current_graph_construction_context();
+  if (output || !quota || !context.scope || context.worker || !guard.cpu() ||
+      context.dispatch != &dispatch || current_graph_quota() != quota)
+    return GraphFailure::foreign_parent;
+  CpuEvalCleanupLayout actual;
+  if (!cpu_eval_cleanup_layout(guard.inputs(), guard.siblings(), actual))
+    return GraphFailure::invalid_layout;
+  return create_layout(*quota, context.scope, &dispatch, actual, output, true);
+}
+GraphFailure GraphConstruction::create_layout(GraphQuota& quota, uint64_t scope,
+    const Record* dispatch, const GraphConstructionLayout& actual,
+    GraphConstruction*& output, bool exclusive_host) noexcept {
+  {
+    const GraphQuota::Loan loan(quota);
+    if (quota.preparing_ || quota.construction_) return GraphFailure::construction_busy;
+  }
+  // These objects contain no payload, native resource or source callback. Every
+  // physical allocation already retains quota independently, through rollback.
+  auto* memory = quota.try_allocate(actual.header_bytes, actual.header_alignment);
+  if (!memory) return GraphFailure::exhausted;
+  auto* value = ::new (memory) GraphConstruction(quota, scope, dispatch, actual.blocks, exclusive_host);
+  if (actual.blocks) {
+    value->slots_ = static_cast<Slot*>(quota.try_allocate(actual.slots_bytes, actual.slots_alignment));
+    if (!value->slots_) { value->count_ = 0; value->destroy(); return GraphFailure::exhausted; }
+    for (size_t i = 0; i < actual.blocks; ++i) ::new (value->slots_ + i) Slot{};
+  }
+  size_t cursor = 0;
+  for (size_t i = 0; i < GraphConstructionLayout::classes; ++i) {
+    for (size_t n = 0; n < actual.request_counts[i]; ++n) {
+      auto* block = quota.try_allocate(actual.request_bytes[i], actual.reserved_alignment);
+      if (!block) { value->destroy(); return GraphFailure::exhausted; }
+      value->slots_[cursor++] = {block, actual.request_bytes[i]};
+    }
+  }
+  {
+    const GraphQuota::Loan loan(quota);
+    // Only the authenticated host can install this association. Native workers
+    // never install/clear it and there is no intervening user code above.
+    quota.construction_ = value;
+  }
+  output = value;
+  return static_cast<GraphFailure>(0);
+}
+void* GraphConstruction::take(size_t bytes, size_t align) {
+  if (!align || (align & (align - 1)) || align > alignment)
+    throw GraphQuotaError(GraphFailure::construction_mismatch);
+  Slot* best = nullptr;
+  for (size_t i = 0; i < count_; ++i) {
+    auto& slot = slots_[i];
+    if (slot.pointer && slot.bytes >= bytes && (!best || slot.bytes < best->bytes)) best = &slot;
+  }
+  if (!best) throw GraphQuotaError(GraphFailure::construction_mismatch);
+  auto* value = best->pointer;
+  best->pointer = nullptr;
+  // Allocation already has its immutable physical reference. Deallocation
+  // uses its in-block offset, not the consumer's smaller byte request.
+  return value;
+}
+size_t GraphConstruction::remaining() const noexcept {
+  const GraphQuota::Loan loan(*quota_);
+  size_t result = 0;
+  for (size_t i = 0; i < count_; ++i) if (slots_[i].pointer) ++result;
+  return result;
+}
+void GraphConstruction::destroy() noexcept {
+  GraphQuota* quota = quota_;
+  GraphQuotaRef retention(quota); // outlives header destructor AND physical free
+  {
+    const GraphQuota::Loan loan(*quota);
+    if (quota->construction_ == this) quota->construction_ = nullptr;
+  }
+  // Retire unused prefix outside the allocator loan. Consumed blocks remain
+  // with their real allocator/control owners; destruction never refunds them.
+  for (size_t i = 0; i < count_; ++i)
+    if (slots_[i].pointer) quota->deallocate(slots_[i].pointer, slots_[i].bytes, alignment);
+  if (slots_) quota->deallocate(slots_, count_ * sizeof(Slot), alignof(Slot));
+  this->~GraphConstruction();
+  quota->deallocate(this, sizeof(GraphConstruction), alignof(GraphConstruction));
+}
+
 } // namespace mlx::core::submission
