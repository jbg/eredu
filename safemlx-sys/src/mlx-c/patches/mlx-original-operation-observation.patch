+PreparedHostCopyCause PreparedHostCopySlot::fill(submission::Scope& scope,
+    const void* data, size_t bytes, PreparedInputArray*& output) noexcept {
+  const size_t alignment = value_.dtype() == complex64 ? alignof(std::complex<float>) :
+      std::min(value_.itemsize(), size_t{8});
+  if (output || (bytes && !data) || bytes != layout_.copy_bytes ||
+      (data && reinterpret_cast<uintptr_t>(data) % alignment))
+    return HostCause::invalid;
+  if (attempted_ || !handle_) return HostCause::spent;
+  const auto controls = submission::current_native_controls();
+  if (submission::current_scope() != &scope || !scope.valid_original_observer() ||
+      !scope.active_on_owner_thread() || !controls.original ||
+      controls.failure != submission::NativeControlFailure::none ||
+      controls.scope_identity != scope.identity()) return HostCause::domain;
+  if (scope.failure_owner().get()->borrow() || scope.query().failed) return HostCause::failed;
+  if (scope.failure_owner().get()->pending_publication()) return HostCause::busy;
+  // Runtime/owner/input refusal above leaves Ready. This is the sole physical
+  // allocation attempt: allocator Busy/refusal below is spent, not a retry grant.
+  attempted_ = true;
+  submission::mark_native_control_construction();
+  if (bytes) {
+    auto* backing = value_.data_shared_ptr()->original_input;
+    const auto result = allocator_->allocate_prepared_input(bytes, *backing);
+    if (result != allocator::PreparedInputCause::success) return host_cause(result);
+    if (backing->capacity != layout_.backing_bytes) return HostCause::capacity;
+    value_.data_shared_ptr()->buffer = backing->buffer;
+    std::memcpy(backing->buffer.raw_ptr(), data, bytes);
+  }
+  static_assert(std::is_nothrow_copy_constructible_v<array>);
+  output = PreparedInputArray::publish_storage(std::exchange(handle_, nullptr), value_, quota_);
+  return HostCause::success;
+}
