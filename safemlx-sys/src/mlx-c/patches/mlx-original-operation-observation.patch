+bool GraphConstruction::complete_layout(GraphConstructionLayout& value) noexcept {
+  size_t count = 0, requested = 0, extents = 0;
+  for (size_t i = 0; i < GraphConstructionLayout::classes; ++i) {
+    const auto bytes = value.request_bytes[i], n = value.request_counts[i];
+    if (!n) continue;
