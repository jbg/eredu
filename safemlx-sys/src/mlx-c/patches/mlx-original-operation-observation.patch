+      direct_target(make_error, 76) != append || direct_target(make_error, 152) != append ||
+      direct_target(append, 104) != grow) return false;
+  if (!literal_matches(data_target(key, 60), "__thread_specific_ptr construction failed")) return false;
+  // The matched throw body names one immutable generic-category object. Its
+  // actual vtable and method must agree with this precise shared-cache layout.
+  // Reject signed/rebound/unknown pointers; never strip PAC or follow a loader thunk.
+  const auto category = data_target(throws, 20);
+  if (!page_contains(category, sizeof(uintptr_t))) return false;
+  const auto vtable = *reinterpret_cast<const volatile uintptr_t*>(category);
+  if (vtable != offset(throws, int64_t(0x1fb77a138ULL - 0x18d5e9028ULL)) ||
+      !page_contains(vtable, 56)) return false;
