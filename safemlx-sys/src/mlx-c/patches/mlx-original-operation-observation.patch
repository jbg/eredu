+      !add(requested, value.header_bytes, requested) ||
+      !add(requested, value.slots_bytes, value.requested_bytes) ||
+      !add(extents, header_extent, extents) ||
+      !add(extents, slots_extent, value.allocation_extents)) return false;
+  value.named_control_bytes += sizeof(GraphConstruction*) + sizeof(GraphQuotaRef) +
+      sizeof(GraphConstructionContext) + sizeof(GraphQuota::Loan) +
+      sizeof(size_t) * 8 + sizeof(GraphFailure);
