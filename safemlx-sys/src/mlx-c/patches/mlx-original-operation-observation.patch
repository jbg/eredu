+bool completion_eval_traversal_layout(
+    CompletionEvalTraversalLimits limits, CompletionEvalTraversalLayout& out) noexcept {
+  // Every selected frontier has one Synchronizer. Descriptor, tape and edge
+  // populations also bound the evaluator's existing signed loop/degree cells.
+  const size_t signed_max = static_cast<size_t>(std::numeric_limits<int>::max());
+  if (!limits.array_nodes || !limits.tape_entries || !limits.stream_count ||
+      limits.tape_entries > limits.array_nodes ||
+      limits.stream_count > limits.tape_entries ||
+      limits.output_slots < limits.tape_entries ||
+      limits.root_count > limits.input_edges ||
+      limits.array_nodes > signed_max || limits.tape_entries > signed_max ||
+      limits.input_edges > signed_max)
+    return false;
+  submission::RecordFrontierStorageLayout base;
+  if (!submission::Record::bounded_storage_layout(
+          {limits.capture_slots, limits.stream_count, limits.output_slots}, base)) return false;
+  CompletionEvalTraversalLayout value{};
+  value.limits = limits;
+  if (!eval_traversal_request<PreparedEvalSubmissionRecord>(value, 0, 1) ||
+      !eval_traversal_request<array>(value, 2, limits.tape_entries) ||
+      !eval_traversal_request<detail::EvalMapNode<int>>(value, 3, limits.array_nodes) ||
+      !eval_traversal_request<detail::EvalMapNode<EvalFenceValue>>(value, 4, limits.array_nodes) ||
+      !eval_traversal_request<EvalDfsEntry>(value, 5, limits.array_nodes) ||
+      !eval_traversal_request<Stream>(value, 6, limits.stream_count) ||
+      !eval_traversal_request<EvaluationStream>(value, 7, limits.stream_count) ||
+      !eval_traversal_request<std::shared_ptr<Primitive>>(value, 9, limits.tape_entries)) return false;
+  value.request_bytes[1] = base.fixed.capture_bytes;
+  value.request_alignments[1] = base.fixed.capture_alignment;
+  value.request_bytes[8] = base.fixed.stream_bytes;
+  value.request_alignments[8] = base.fixed.stream_alignment;
+  value.request_bytes[10] = base.output_bytes;
+  value.request_alignments[10] = base.output_alignment;
+  for (size_t bytes : value.request_bytes) {
+    if (bytes > std::numeric_limits<size_t>::max() - value.record_requested_bytes) return false;
+    value.record_requested_bytes += bytes;
+    value.record_allocations += bytes != 0;
+  }
+  // Scalar query/factory transports, separate from the actual Record object.
+  value.named_control_bytes = sizeof(CompletionEvalTraversalLimits) + // query input
+      sizeof(CompletionEvalTraversalLayout) + sizeof(base) + // query locals
+      sizeof(CompletionEvalTraversalLayout*) + 2 * sizeof(size_t) + // out/maximum/loop
+      sizeof(std::unique_ptr<PreparedEvalSubmissionRecord, submission::Record::Deleter>) +
+      sizeof(submission::RecordDispatchGuard) + sizeof(submission::Record::Allocation);
+  out = value;
+  return true;
+}
 
