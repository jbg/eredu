new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/retention.h
@@ -0,0 +1,270 @@
+#pragma once
+
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "mlx/array.h"
+#include "mlx/scheduler.h"
+
+namespace mlx::core::cpu {
+
+struct RetentionAllocation {
+  size_t bytes{0}, alignment{0}, graph_extent{0};
+};
+struct RetentionLayout {
+  RetentionAllocation cleanup_task, data_slots, temporary_batch;
+  size_t maximum_data_slots{0};
+  size_t prepared_cleanup_bytes{0}, prepared_cleanup_alignment{0};
+  size_t cleanup_body_bytes{0}, data_retention_bytes{0};
+  size_t temporary_storage_bytes{0}, temporary_owner_bytes{0};
+  size_t encoder_bytes{0}, encoder_alignment{0};
+};
+
+namespace detail {
+
+// Exactly one allocation request, with no growth or container capacity policy.
+// Before the primitive these slots contain no Data references: donation sees
+// the same owners as before. The inline allocator outlives every slot and its
+// physical storage; TaskNode separately protects the outer callable/header.
+class DataRetention {
+ public:
+  using Value = std::shared_ptr<array::Data>;
+  DataRetention(submission::GraphQuota* graph, size_t capacity)
+      : allocator_(graph), capacity_(capacity) {
+    if (capacity_)
+      values_ = allocator_.allocate(capacity_);
+  }
+  DataRetention(const DataRetention&) = delete;
+  DataRetention& operator=(const DataRetention&) = delete;
+  DataRetention(DataRetention&& other) noexcept
+      : allocator_(other.allocator_),
+        values_(std::exchange(other.values_, nullptr)),
+        capacity_(std::exchange(other.capacity_, 0)),
+        size_(std::exchange(other.size_, 0)) {}
+  ~DataRetention() {
+    truncate(0);
+    if (values_)
+      allocator_.deallocate(values_, capacity_);
+  }
+  size_t size() const noexcept {
+    return size_;
+  }
+  size_t capacity() const noexcept {
+    return capacity_;
+  }
+  const Value* data() const noexcept {
+    return values_;
+  }
+  void fill(
+      const ArrayVector& inputs,
+      const ArrayVector& siblings,
+      const array::Data* output) {
+    if (size_ || inputs.size() > capacity_ ||
+        siblings.size() > capacity_ - inputs.size())
+      throw submission::GraphQuotaError(
+          submission::GraphFailure::invalid_layout);
+    for (const auto& input : inputs)
+      append(input.data_shared_ptr());
+    for (const auto& sibling : siblings)
+      append(sibling.data_shared_ptr());
+    if (!size_)
+      return;
+    std::sort(values_, values_ + size_, [](const Value& a, const Value& b) {
+      return std::less<const array::Data*>{}(a.get(), b.get());
+    });
+    auto* unique_end = std::unique(values_, values_ + size_);
+    auto* end =
+        std::remove_if(values_, unique_end, [output](const Value& value) {
+          return value.get() == output;
+        });
+    truncate(static_cast<size_t>(end - values_));
+  }
+
+ private:
+  void append(const Value& value) noexcept {
+    ::new (static_cast<void*>(values_ + size_)) Value(value);
+    ++size_;
+  }
+  void truncate(size_t size) noexcept {
+    while (size_ > size)
+      values_[--size_].~Value();
+  }
+  submission::GraphAllocator<Value> allocator_;
+  Value* values_{nullptr};
+  size_t capacity_{0}, size_{0};
+};
+
+// CPU-owned counterpart of the Metal temporary batch. Neither the header nor
+// the exact incoming vector can inherit a later request's allocation owner.
+struct TemporaryBatch {
+  submission::GraphQuotaRef birth;
+  TemporaryBatch* next{nullptr};
+  std::optional<array> single;
+  std::optional<ArrayVector> multiple;
+  explicit TemporaryBatch(submission::GraphQuota* graph) noexcept
+      : birth(graph) {}
+  size_t size() const noexcept {
+    return single ? 1 : multiple ? multiple->size() : 0;
+  }
+};
+struct TemporaryDeleter {
+  void operator()(TemporaryBatch* batch) const noexcept {
+    submission::GraphAllocator<TemporaryBatch> allocator(batch->birth.get());
+    batch->~TemporaryBatch();
+    allocator.deallocate(batch, 1);
+  }
+};
+using TemporaryOwner = std::unique_ptr<TemporaryBatch, TemporaryDeleter>;
+inline TemporaryOwner prepare_temporary() {
+  const auto failure = submission::current_graph_allocation_failure();
+  if (failure != submission::NativeControlFailure::none)
+    throw submission::NativeControlError(failure);
+  submission::mark_native_control_construction();
+  auto* graph = submission::current_graph_quota();
+  submission::GraphAllocator<TemporaryBatch> allocator(graph);
+  auto* storage = allocator.allocate(1);
+  // The fixed header's constructor only retains its immutable Graph owner.
+  return TemporaryOwner(::new (storage) TemporaryBatch(graph));
+}
+
+class TemporaryStorage {
+ public:
+  TemporaryStorage() = default;
+  TemporaryStorage(const TemporaryStorage&) = delete;
+  TemporaryStorage& operator=(const TemporaryStorage&) = delete;
+  TemporaryStorage(TemporaryStorage&& other) noexcept {
+    take(other);
+  }
+  TemporaryStorage& operator=(TemporaryStorage&& other) noexcept {
+    if (this != &other) {
+      clear();
+      take(other);
+    }
+    return *this;
+  }
+  ~TemporaryStorage() {
+    clear();
+  }
+  size_t size() const noexcept {
+    return size_;
+  }
+  const TemporaryBatch* first() const noexcept {
+    return head_;
+  }
+  void append(TemporaryOwner batch) noexcept {
+    auto* node = batch.release();
+    size_ += node->size();
+    if (tail_)
+      tail_->next = node;
+    else
+      head_ = node;
+    tail_ = node;
+  }
+  void clear() noexcept {
+    while (head_) {
+      auto* node = head_;
+      head_ = node->next;
+      TemporaryDeleter{}(node);
+    }
+    tail_ = nullptr;
+    size_ = 0;
+  }
+
+ private:
+  void take(TemporaryStorage& other) noexcept {
+    head_ = std::exchange(other.head_, nullptr);
+    tail_ = std::exchange(other.tail_, nullptr);
+    size_ = std::exchange(other.size_, 0);
+  }
+  TemporaryBatch* head_{nullptr};
+  TemporaryBatch* tail_{nullptr};
+  size_t size_{0};
+};
+
+struct Cleanup {
+  DataRetention data;
+  TemporaryStorage temporaries;
+  Cleanup(submission::GraphQuota* graph, size_t capacity)
+      : data(graph, capacity) {}
+  Cleanup(Cleanup&&) noexcept = default;
+  void operator()() const noexcept {}
+};
+
+class PreparedCleanup {
+ public:
+  PreparedCleanup(scheduler::TaskContext context, size_t capacity)
+      : context_(std::move(context)),
+        task_(
+            scheduler::make_task(
+                context_.graph,
+                std::move(context_.failure),
+                context_.scheduler,
+                false,
+                Cleanup(context_.graph, capacity),
+                context_.buffers)) {}
+  PreparedCleanup(PreparedCleanup&&) = default;
+  PreparedCleanup(const PreparedCleanup&) = delete;
+  Cleanup& body() noexcept {
+    return static_cast<scheduler::TaskNode<Cleanup>*>(task_.get())->body;
+  }
+  void submit(bool counted) {
+    task_.get()->counted = counted;
+    context_.scheduler->submit_task_owned(context_.thread, task_, counted);
+  }
