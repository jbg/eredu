+      !allocation_shape<HandlerNode<EventEntry>>(facts.event_node) ||
+      !allocation_shape<HandlerNode<EncodingCleanup>>(facts.cleanup_node)) return false;
+  facts.fixed_block_capture_bytes = sizeof(CommandEncoder*) + sizeof(Receipt*);
+  out = facts;
+  return true;
+}
