+inline bool page_contains(uintptr_t address, size_t bytes) noexcept {
+  // Apple arm64 text is readable. Require the actual runtime page geometry,
+  // since the qualified grow body crosses a 4-KiB subpage. No VM/loader query.
+  return vm_page_size == 16384 && address && bytes <= 16384 - address % 16384;
+}
+template<size_t N> bool matches(uintptr_t address, const unsigned char (&expected)[N]) noexcept {
+  if (address % 4 || !page_contains(address, N)) return false;
+  auto* actual = reinterpret_cast<const volatile unsigned char*>(address);
+  for (size_t i = 0; i < N; ++i) if (actual[i] != expected[i]) return false;
+  return true;
+}
+inline uintptr_t offset(uintptr_t address, int64_t delta) noexcept {
+  if (delta >= 0) return uintptr_t(delta) <= UINTPTR_MAX - address ? address + uintptr_t(delta) : 0;
+  return uint64_t(-delta) <= address ? address - uint64_t(-delta) : 0;
+}
+inline uintptr_t direct_target(uintptr_t address, size_t instruction) noexcept {
+  if (!page_contains(address, instruction + 4) || instruction % 4) return 0;
+  const auto word = *reinterpret_cast<const volatile uint32_t*>(address + instruction);
+  if ((word & 0x7c000000) != 0x14000000) return 0;
+  int64_t displacement = word & 0x03ffffff;
+  if (displacement & 0x02000000) displacement -= 0x04000000;
+  return offset(address + instruction, displacement * 4);
+}
+inline uintptr_t data_target(uintptr_t address, size_t adrp_offset) noexcept {
+  if (!page_contains(address, adrp_offset + 8) || adrp_offset % 4) return 0;
+  auto* code = reinterpret_cast<const volatile uint32_t*>(address + adrp_offset);
+  const auto adrp = code[0], add = code[1];
+  if ((adrp & 0x9f000000) != 0x90000000 || (add & 0xffc00000) != 0x91000000)
+    return 0;
+  int64_t page_delta = ((adrp >> 5) & 0x7ffff) * 4 + ((adrp >> 29) & 3);
+  if (page_delta & 0x100000) page_delta -= 0x200000;
+  return offset((address + adrp_offset) & ~uintptr_t(4095),
+                page_delta * 4096 + ((add >> 10) & 4095));
+}
+// Real shared-cache import stub: ADRP x17; ADD x17; LDR x16; BRAA x16,x17.
+// The non-arm64e process exposes unsigned resolved pointers. Compare exactly;
+// signed pointers, another stub form, lazy trampolines or rebindings are unknown.
+inline bool bound_leaf(uintptr_t caller, size_t instruction, uintptr_t expected) noexcept {
+  const auto stub = direct_target(caller, instruction);
+  if (stub == expected) return true;
+  if (!page_contains(stub, 16) || stub % 4) return false;
+  auto* words = reinterpret_cast<const volatile uint32_t*>(stub);
+  if ((words[0] & 0x9f00001f) != 0x90000011 ||
+      (words[1] & 0xffc003ff) != 0x91000231 ||
+      words[2] != 0xf9400230 || words[3] != 0xd71f0a11) return false;
+  const auto slot = data_target(stub, 0);
+  if (slot % alignof(uintptr_t) || !page_contains(slot, sizeof(uintptr_t))) return false;
+  return *reinterpret_cast<const volatile uintptr_t*>(slot) == expected;
+}
+template<size_t N> bool literal_matches(uintptr_t address, const char (&expected)[N]) noexcept {
+  if (!page_contains(address, N)) return false;
+  auto* actual = reinterpret_cast<const volatile unsigned char*>(address);
+  for (size_t i = 0; i < N; ++i) if (actual[i] != static_cast<unsigned char>(expected[i])) return false;
+  return true;
+}
+inline bool loaded_startup_matches() noexcept {
+  const auto tc1 = reinterpret_cast<uintptr_t>(&thread_c1);
+  const auto tc2 = reinterpret_cast<uintptr_t>(&thread_c2);
+  const auto tls = reinterpret_cast<uintptr_t>(&tls_data);
+  const auto throws = reinterpret_cast<uintptr_t>(&throw_int);
+  const auto sc1 = reinterpret_cast<uintptr_t>(&system_c1);
+  const auto sc2 = reinterpret_cast<uintptr_t>(&system_c2);
+  const auto runtime = reinterpret_cast<uintptr_t>(&runtime_c2);
