+inline bool retention_allocation(
+    size_t bytes,
+    size_t alignment,
+    RetentionAllocation& out) noexcept {
+  RetentionAllocation value{bytes, alignment, 0};
+  if (bytes &&
+      !submission::GraphQuota::allocation_extent(
+          bytes, alignment, value.graph_extent))
+    return false;
+  out = value;
+  return true;
+}
+inline bool retention_layout(
+    size_t inputs,
+    size_t siblings,
+    RetentionLayout& out) noexcept {
+  if (inputs > SIZE_MAX - siblings)
+    return false;
+  const size_t count = inputs + siblings;
+  if (count > SIZE_MAX / sizeof(DataRetention::Value))
+    return false;
+  RetentionLayout value;
+  if (!retention_allocation(
+          sizeof(scheduler::TaskNode<Cleanup>),
+          alignof(scheduler::TaskNode<Cleanup>),
+          value.cleanup_task) ||
+      !retention_allocation(
+          count * sizeof(DataRetention::Value),
+          alignof(DataRetention::Value),
+          value.data_slots) ||
+      !retention_allocation(
+          sizeof(TemporaryBatch),
+          alignof(TemporaryBatch),
+          value.temporary_batch))
+    return false;
+  value.maximum_data_slots = count;
+  value.prepared_cleanup_bytes = sizeof(PreparedCleanup);
+  value.prepared_cleanup_alignment = alignof(PreparedCleanup);
+  value.cleanup_body_bytes = sizeof(Cleanup);
+  value.data_retention_bytes = sizeof(DataRetention);
+  value.temporary_storage_bytes = sizeof(TemporaryStorage);
+  value.temporary_owner_bytes = sizeof(TemporaryOwner);
+  out = value;
+  return true;
+}
