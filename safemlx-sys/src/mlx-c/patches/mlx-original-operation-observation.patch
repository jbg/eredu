+// Pure type/loaded-implementation query, with no lazy registry initialization.
+MLX_API StreamRegistrationCause stream_registration_layout(
+    StreamRegistrationLayout&) noexcept;
+// The caller protects the exact owning request before calling. Failure leaves
+// output and owner untouched. Success transfers owner to this actual process
+// registration, including its inline CPU encoder, until physical destruction.
+MLX_API StreamRegistrationCause register_prepared_cpu_stream(
+    const StreamRegistrationLayout&, StreamRegistrationOwner, Stream&) noexcept;
+// Read-only exact constructor-token lookup. A scalar index or non-null-owner
