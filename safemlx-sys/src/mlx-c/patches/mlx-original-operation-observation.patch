+  const auto grow = reinterpret_cast<uintptr_t>(&string_grow);
+  const auto sets = reinterpret_cast<uintptr_t>(&set_specific);
+  if (!matches(tc1, code_thread_c1) || !matches(tc2, code_thread_c2) ||
+      !matches(tls, code_tls_data) || !matches(throws, code_throw_int) ||
+      !matches(sc1, code_system_c1) || !matches(sc2, code_system_c2) ||
+      !matches(runtime, code_runtime_c2) || !matches(append, code_string_append) ||
+      !matches(grow, code_string_grow) || !matches(sets, code_set_specific)) return false;
