+bool completion_wait_record_layout(CompletionWaitRecordLayout& out) noexcept {
+  submission::RecordFixedStorageLayout storage;
+  if (!submission::Record::fixed_storage_layout(1, storage)) return false;
+  const auto maximum = std::numeric_limits<size_t>::max();
+  if (storage.capture_bytes > maximum - sizeof(WaitRecord) ||
+      storage.stream_bytes > maximum - sizeof(WaitRecord) - storage.capture_bytes)
+    return false;
