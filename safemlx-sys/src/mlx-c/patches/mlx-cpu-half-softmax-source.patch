+namespace {
+template<typename T>
+bool precise_half_softmax_dispatch(EvalDispatchStorage& out) noexcept {
+  static_assert(sizeof(T)==2);
+  DispatchLayout task;
+  if(!CommandEncoder::dispatch_layout<SoftmaxTask<T,float>>(task))return false;
+  constexpr int N=std::min(simd::max_size<float>,simd::max_size<T>);
+  // Exact existing precise worker: half loads/stores, F32 reductions and the
+  // shared SIMD exp polynomial, including its integer exponent/mask controls.
+  // No task for the nonprecise half accumulator is selected by this source.
+  using Mask=decltype(simd::Simd<float,N>(0.0f)<-88.0f);
+  const size_t controls=sizeof(EvalDispatchStorage)+sizeof(task)+sizeof(out)+
+      sizeof(SoftmaxTask<T,float>)*2+sizeof(const T*)*2+sizeof(T*)*2+
+      sizeof(int)*7+sizeof(size_t)*3+sizeof(float)*20+sizeof(bool)*2+
+      sizeof(simd::Simd<float,N>)*12+sizeof(simd::Simd<T,N>)*4+
+      sizeof(simd::Simd<int,N>)*2+sizeof(Mask)*3+sizeof(Dtype);
+  if(task.controls>SIZE_MAX-controls)return false;
+  out={task.task_bytes,task.task_alignment,0,task.controls+controls};return true;
+}
+}
+bool precise_half_softmax_dispatch_storage(Dtype dtype,EvalDispatchStorage& out) noexcept {
+  if(dtype==float16&&dtype.size()==2)return precise_half_softmax_dispatch<float16_t>(out);
+  if(dtype==bfloat16&&dtype.size()==2)return precise_half_softmax_dispatch<bfloat16_t>(out);
+  return false;
+}
