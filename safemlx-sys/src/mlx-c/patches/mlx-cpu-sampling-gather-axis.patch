+      index.dtype()!=uint32||index.itemsize()!=sizeof(uint32_t)||
+      input.shape()!=output.shape()||index.shape()!=input.shape()||
+      input.strides().size()!=rank||index.strides().size()!=rank||
+      !input.flags().row_contiguous||!index.flags().row_contiguous||input.shape(-1)<=0||
+      input.strides().back()!=1||index.strides().back()!=1||
+      static_cast<const GatherAxis&>(output.primitive()).state()!=int(rank)-1)return false;
+  for(size_t axis=0;axis+1<rank;++axis)if(input.shape(axis)!=1)return false;
+  if(input.size()!=size_t(input.shape(-1))||index.size()!=input.size()||
