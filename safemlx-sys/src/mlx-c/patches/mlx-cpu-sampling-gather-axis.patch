+      !contiguous_iterator_layout(rank-1,iterator)||!PreparedInputLeaf::weak_copy_storage(rank,weak)||
+      iterator.graph_extent_sum>SIZE_MAX/2)return false;
+  const size_t frames[]={task.controls,iterator.controls,iterator.controls,
+      weak.controls,weak.controls,weak.controls,
+      sizeof(rank),sizeof(elements),sizeof(tracer),sizeof(out),sizeof(task),sizeof(iterator),sizeof(weak),
+      sizeof(GatherAxisTask)*2,sizeof(array)*4,sizeof(Shape)*3,sizeof(Strides)*4,
+      sizeof(ContiguousIterator)*2,sizeof(const float*)*2,sizeof(float*)*2,sizeof(const uint32_t*)*2,
+      sizeof(size_t)*12,sizeof(int)*5,sizeof(int64_t)*3,sizeof(uint32_t)*2,
+      sizeof(Stream),sizeof(CommandEncoder*),sizeof(Dtype)*2,
+      sizeof(const array*)*4,sizeof(const GatherAxis*),sizeof(bool)*4};
+  size_t controls=sizeof(frames);
+  for(size_t frame:frames){if(frame>SIZE_MAX-controls)return false;controls+=frame;}
+  EvalDispatchStorage dispatch{task.task_bytes,task.task_alignment,iterator.graph_extent_sum*2,controls};
+  SingleOutputEvalStorage common;
+  if(!single_output_eval_layout(rank,2,tracer,&dispatch,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  const size_t final=sizeof(dispatch)+sizeof(common)+sizeof(value)+sizeof(controls);
+  if(value.named_control_bytes>SIZE_MAX-final)return false;
+  value.named_control_bytes+=final;out=value;return true;
+}
+bool gather_axis_row_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
