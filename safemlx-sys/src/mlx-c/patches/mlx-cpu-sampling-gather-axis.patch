+bool gather_axis_row_eval_layout(size_t rank,size_t elements,bool tracer,CopyEvalStorage& out) noexcept {
+  if(rank<1||rank>3||!elements||elements>size_t(INT_MAX)||
+      Shape::inline_capacity<3||Strides::inline_capacity<3)return false;
