+struct NoGpuEventCpuSignal {
+  Event event;
+  Stream stream;
+  void operator()() {
+    auto* ec = static_cast<EventCounter*>(event.event_.get());
+    {
+      std::lock_guard<std::mutex> lock(ec->mtx);
+      if (!event.scope_identity_) ec->error = scheduler::stream_error(stream);
+      ec->value = event.value();
+    }
+    ec->cv.notify_all();
+  }
+};
