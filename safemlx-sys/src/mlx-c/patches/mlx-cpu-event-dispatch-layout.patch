+bool event_dispatch_control_layout(EventDispatchControlLayout& out) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus < 202002L
+  return false;
+#else
+  using Wait = scheduler::TaskNode<NoGpuEventCpuWait>;
+  using Signal = scheduler::TaskNode<NoGpuEventCpuSignal>;
+  size_t wait_extent=0, signal_extent=0;
+  if(!scheduler::task_graph_extent<NoGpuEventCpuWait>(wait_extent)||
+      !scheduler::task_graph_extent<NoGpuEventCpuSignal>(signal_extent))return false;
+  const size_t controls=sizeof(EventDispatchControlLayout)+sizeof(size_t)*2+
+      sizeof(NoGpuEventCpuWait)+sizeof(NoGpuEventCpuSignal)+sizeof(Stream)+
+      sizeof(EventCounter*)*2+sizeof(bool)+sizeof(std::unique_lock<std::mutex>)+
+      sizeof(std::lock_guard<std::mutex>)+sizeof(std::chrono::milliseconds)+
+      sizeof(scheduler::TaskOwner)+sizeof(scheduler::TaskContext)+
+      sizeof(submission::GraphAllocator<Wait>)+sizeof(submission::GraphAllocator<Signal>);
+  out={sizeof(Wait),alignof(Wait),wait_extent,
+       sizeof(Signal),alignof(Signal),signal_extent,0,1,0,controls};
+  return true;
+#endif
+}
