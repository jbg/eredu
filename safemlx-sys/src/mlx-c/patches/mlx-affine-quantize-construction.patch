+bool affine_quantize_construction_layout(size_t rank,
+    AffineQuantizeConstructionLayout& output) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return false;
+#else
+  if(rank<2 || rank>size_t(INT_MAX) || rank>Shape::max_size() || rank>Strides::max_size())return false;
+  GraphQuota::Request leaf[5]{};size_t count=0;
+  if(!PreparedInputLeaf::append_array_requests(0,leaf,count)||count!=3)return false;
+  const size_t fallback=graph_function_control_bytes<ArrayVector(ArrayVector),AffineQuantizeFallback>();
+  if(!fallback)return false;
+  AffineQuantizeConstructionLayout value;value.rank=rank;
+  value.request_bytes[0]=leaf[0].bytes;value.request_alignments[0]=leaf[0].alignment;value.request_counts[0]=3;
+  value.request_bytes[1]=leaf[1].bytes;value.request_alignments[1]=leaf[1].alignment;value.request_counts[1]=3;
+  value.request_bytes[2]=std::max(fallback,resident_primitive_control<fast::Quantize>());
+  value.request_alignments[2]=alignof(std::max_align_t);value.request_counts[2]=2;
+  // One input vector, three descriptor input copies, one reserved output
+  // vector and three sibling copies. No geometric vector growth is required.
+  value.request_bytes[3]=3*sizeof(array);value.request_alignments[3]=alignof(array);value.request_counts[3]=8;
+  if(rank>Shape::inline_capacity) {
+    if(!resident_multiply(rank,sizeof(Shape::value_type),value.request_bytes[4]))return false;
+    value.request_alignments[4]=alignof(Shape::value_type);value.request_counts[4]=7;
+  }
+  if(rank>Strides::inline_capacity) {
+    if(!resident_multiply(std::max(rank,2*Strides::inline_capacity),sizeof(Strides::value_type),value.request_bytes[5]))return false;
+    value.request_alignments[5]=alignof(Strides::value_type);value.request_counts[5]=3;
+  }
+  value.request_bytes[6]=sizeof(PreparedInputArray);value.request_alignments[6]=alignof(PreparedInputArray);value.request_counts[6]=3;
+  for(size_t i=0;i<GraphConstructionLayout::classes;++i)if(!value.request_alignments[i])value.request_alignments[i]=1;
+  const size_t controls[]={sizeof(value),sizeof(output),sizeof(rank),sizeof(leaf),sizeof(count),sizeof(fallback),
+      sizeof(size_t)*12,sizeof(bool)*4,sizeof(int)*6,sizeof(Dtype)*5,sizeof(Stream)*4,sizeof(StreamOrDevice)*2,
+      sizeof(std::optional<int>)*2,sizeof(std::optional<array>),sizeof(std::string),sizeof(array)*3,
+      sizeof(std::array<Shape,3>),sizeof(std::array<Dtype,3>),sizeof(Shape)*7,sizeof(Strides)*3,
+      sizeof(std::span<const Shape>),sizeof(std::span<const Dtype>),sizeof(ArrayVector)*7,
+      sizeof(GraphAllocator<array>)*7,sizeof(GraphAllocator<fast::Quantize>)*2,
+      sizeof(GraphAllocator<AffineQuantizeFallback>)*2,sizeof(AffineQuantizeFallback)*2,
+      sizeof(std::shared_ptr<AffineQuantizeFallback>)*3,sizeof(std::shared_ptr<Primitive>)*4,
+      sizeof(std::function<ArrayVector(ArrayVector)>)*3,sizeof(const array*)*4,
+      sizeof(GraphConstructionContext),sizeof(GraphConstruction*),sizeof(GraphFailure),sizeof(GraphQuota*)};
+  value.named_control_bytes=sizeof(controls)+sizeof(size_t);
+  for(size_t bytes:controls)if(!add(value.named_control_bytes,bytes,value.named_control_bytes))return false;
+  if(!GraphConstruction::complete_layout(value))return false;
+  output=value;return true;
+#endif
+}
+GraphFailure GraphConstruction::create_affine_quantize_graph(GraphQuota& quota,
+    uint64_t scope,size_t rank,GraphConstruction*& output) noexcept {
+  const auto context=current_graph_construction_context();
+  if(output||!scope||context.worker||context.dispatch||context.scope!=scope||
+      current_graph_quota()!=&quota)return GraphFailure::foreign_parent;
+  AffineQuantizeConstructionLayout actual;
+  if(!affine_quantize_construction_layout(rank,actual))return GraphFailure::invalid_layout;
+  return create_layout(quota,scope,nullptr,actual,output,false,true);
 }
