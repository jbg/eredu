diff --git a/mlx/quantize_construction.h b/mlx/quantize_construction.h
new file mode 100644
--- /dev/null
+++ b/mlx/quantize_construction.h
@@ -0,0 +1,20 @@
+#pragma once
+#include "mlx/array.h"
+#include "mlx/graph_construction.h"
+
+namespace mlx::core {
+struct AffineQuantizeFallback {
+  int group_size, bits;
+  Stream s;
+  ArrayVector operator()(const ArrayVector& inputs);
+};
+namespace submission {
+struct AffineQuantizeConstructionLayout : GraphConstructionLayout {
+  size_t rank{0};
+};
+// One primitive, one retained fallback, three sibling descriptors and the
+// three C result handles. Eval, physical backing and source custody are separate.
+MLX_API bool affine_quantize_construction_layout(size_t rank,
+    AffineQuantizeConstructionLayout&) noexcept;
+} // namespace submission
+} // namespace mlx::core
