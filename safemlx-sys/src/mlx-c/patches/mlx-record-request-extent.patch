+namespace {
+bool block_extent(size_t address, size_t header, size_t requested, size_t align,
+    size_t& start, size_t& pointer, size_t& used) noexcept {
+  return add(address, header, start) && align_up(start, align, pointer) &&
+      add(pointer - address, std::max(requested, size_t{1}), used) &&
+      align_up(used, alignment, used);
+}
+} // namespace
+
+bool RecordQuota::allocation_extent(size_t requested, size_t align, size_t& out) noexcept {
+  // Every block begins at an arena-aligned address. For these request
+  // alignments zero has the identical residue as every actual block address.
+  if (!align || (align & (align - 1)) || align > alignment) return false;
+  size_t start, pointer, used;
+  if (!block_extent(0, sizeof(Block) + sizeof(size_t), requested, align,
+          start, pointer, used) || used > std::numeric_limits<ptrdiff_t>::max())
+    return false;
+  out = used;
+  return true;
+}
