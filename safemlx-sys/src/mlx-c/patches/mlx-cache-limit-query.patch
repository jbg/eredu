  * */
 MLX_API size_t set_cache_limit(size_t limit);
 
+/* Get the current cache limit without changing cache retention. */
+MLX_API size_t get_cache_limit();
+
+// Provenance is retained by the allocator, including direct native setters.
+enum class CacheLimitSource { NativeDefault, ManagedDefault, Explicit, Preserved };
+struct CacheLimitPolicy {
+  size_t bytes;
+  CacheLimitSource source;
+};
+MLX_API CacheLimitPolicy get_cache_policy();
+// Atomically configure only an untouched native default. Never raise its limit.
+// preserve=true freezes the existing policy without changing cache retention.
+MLX_API CacheLimitPolicy configure_default_cache_policy(size_t ceiling, bool preserve);
+
 /* Clear the memory cache. */
 MLX_API void clear_cache();
 
