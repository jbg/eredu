+CacheLimitPolicy CommonAllocator::get_cache_policy() {
+  std::lock_guard lk(mutex_);
+  return {cache_limit_, cache_limit_source_};
+}
+
+CacheLimitPolicy CommonAllocator::configure_default_cache_policy(size_t ceiling, bool preserve) {
+  std::lock_guard lk(mutex_);
+  if (cache_limit_source_ == CacheLimitSource::NativeDefault) {
+    if (!preserve) {
+      cache_limit_ = std::min(cache_limit_, ceiling);
+    }
+    cache_limit_source_ = preserve ? CacheLimitSource::Preserved : CacheLimitSource::ManagedDefault;
+  }
+  return {cache_limit_, cache_limit_source_};
+}
+
 size_t CommonAllocator::set_cache_limit(size_t limit) {
   synchronize_cpu_streams();
   std::unique_lock lk(mutex_);
+  cache_limit_source_ = CacheLimitSource::Explicit;
   std::swap(cache_limit_, limit);
   if (buffer_cache_.cache_size() > cache_limit_) {
     buffer_cache_.release_cached_buffers(
@@ -203,6 +227,17 @@
