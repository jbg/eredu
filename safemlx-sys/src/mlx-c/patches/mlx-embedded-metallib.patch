+  // Prefer the metallib embedded by a static-library consumer over paths from
+  // the build machine or a separately copied application resource.
+  if (get_embedded_metallib().compressed_data != nullptr) {
+    auto [lib, error] = load_embedded_library(device);
+    if (!lib) {
+      auto detail = error == nullptr
+          ? "Metal returned no diagnostic"
+          : error->localizedDescription()->utf8String();
+      throw std::runtime_error(
+          fmt::format("Failed to load the embedded metallib: {}.", detail));
+    }
+    return lib;
+  }
+
