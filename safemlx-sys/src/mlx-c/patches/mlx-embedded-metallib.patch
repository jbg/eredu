   return std::make_pair(lib, error);
 }
 
+std::pair<MTL::Library*, NS::Error*> load_embedded_library(
+    MTL::Device* device) {
+  const auto& embedded = get_embedded_metallib();
+  if (embedded.compressed_data == nullptr) {
+    return {nullptr, nullptr};
+  }
+
+  std::vector<uint8_t> decoded(embedded.uncompressed_size);
+  size_t decoded_size = compression_decode_buffer(
+      decoded.data(),
+      decoded.size(),
+      embedded.compressed_data,
+      embedded.compressed_size,
+      nullptr,
+      COMPRESSION_LZFSE);
+  if (decoded_size != decoded.size()) {
+    throw std::runtime_error(fmt::format(
+        "Failed to decompress the embedded metallib: expected {} bytes but decoded {}.",
+        decoded.size(),
+        decoded_size));
+  }
+
+  dispatch_data_t data = dispatch_data_create(
+      decoded.data(), decoded.size(), nullptr, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  if (data == nullptr) {
+    throw std::runtime_error(
+        "Failed to create dispatch data for the embedded metallib.");
+  }
+  NS::Error* error = nullptr;
+  auto lib = device->newLibrary(data, &error);
+  dispatch_release(data);
+  return {lib, error};
+}
+
