+#include "mlx/backend/cpu/binary_storage.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <climits>
+#include <typeinfo>
+namespace mlx::core::cpu {
+namespace {
+bool kind(const Primitive& primitive, BinaryEvalKind& out) noexcept {
+#define SIMPLE(Type, Kind) if (typeid(primitive) == typeid(Type)) { out = BinaryEvalKind::Kind; return true; }
+  SIMPLE(Add, add)
+  SIMPLE(Subtract, subtract)
+  SIMPLE(Multiply, multiply)
+  SIMPLE(Divide, divide)
+  SIMPLE(Maximum, maximum)
+  SIMPLE(Minimum, minimum)
+  SIMPLE(Power, power)
+  SIMPLE(LogicalAnd, logical_and)
+  SIMPLE(LogicalOr, logical_or)
+  SIMPLE(NotEqual, not_equal)
+  SIMPLE(Greater, greater)
+  SIMPLE(GreaterEqual, greater_equal)
+  SIMPLE(Less, less)
+  SIMPLE(LessEqual, less_equal)
+#undef SIMPLE
+  if (typeid(primitive) == typeid(Equal) && !static_cast<const Equal&>(primitive).state()) {
+    out = BinaryEvalKind::equal; return true;
+  }
+  return false;
+}
+bool comparison(BinaryEvalKind value) noexcept {
+  return value == BinaryEvalKind::equal || value == BinaryEvalKind::not_equal ||
+      value == BinaryEvalKind::greater || value == BinaryEvalKind::greater_equal ||
+      value == BinaryEvalKind::less || value == BinaryEvalKind::less_equal;
+}
+} // namespace
+bool is_binary_eval_primitive(const array& output) noexcept {
+  BinaryEvalKind selected;
+  return output.has_primitive() && output.primitive().stream().device == Device::cpu &&
+      kind(output.primitive(), selected);
+}
+bool binary_eval_layout(BinaryEvalKind selected, Dtype dtype, size_t rank,
+    size_t elements, bool tracer, BinaryEvalStorage& out) noexcept {
+  EvalDispatchStorage dispatch;
+  SingleOutputEvalStorage common;
+  if (!binary_dispatch_storage(selected, dtype, rank, elements, dispatch) ||
+      !single_output_eval_layout(rank, 2, tracer, &dispatch, common)) return false;
+  BinaryEvalStorage value;
+  static_cast<SingleOutputEvalStorage&>(value) = common;
+  value.kind = selected; value.dtype = dtype; value.elements = elements;
+  const size_t controls = sizeof(BinaryEvalStorage) * 2 + sizeof(EvalDispatchStorage) +
+      sizeof(SingleOutputEvalStorage) + sizeof(BinaryEvalKind) * 3 + sizeof(Dtype) * 3 +
+      sizeof(size_t) * 6 + sizeof(bool) * 3 + sizeof(const array*) * 4 +
+      sizeof(const Primitive*) + sizeof(submission::FixedEvalPrologueGuard*) +
+      sizeof(submission::GraphConstruction*) + sizeof(submission::GraphConstructionContext) +
+      sizeof(submission::GraphFailure) + sizeof(submission::Record*) + sizeof(submission::GraphQuota*);
+  if (controls > SIZE_MAX - value.named_control_bytes) return false;
+  value.named_control_bytes += controls;
+  out = value; return true;
+}
+bool binary_eval_storage(const array& output, BinaryEvalStorage& out) noexcept {
+  BinaryEvalKind selected;
+  if (!is_binary_eval_primitive(output) || !kind(output.primitive(), selected) ||
+      !output.siblings().empty() || output.inputs().size() != 2) return false;
+  const auto& left = output.inputs()[0];
+  const auto& right = output.inputs()[1];
+  if (left.dtype() != right.dtype() || left.shape() != output.shape() || right.shape() != output.shape() ||
+      output.dtype() != (comparison(selected) ? bool_ : left.dtype())) return false;
+  size_t size = 1;
+  for (auto dimension : output.shape()) {
+    if (dimension < 0 || (dimension && size > size_t(INT_MAX) / size_t(dimension))) return false;
+    size *= size_t(dimension);
+  }
+  // The unchanged vector/recursive worker takes int sizes. Do not truncate an
+  // accepted source while proving its host iterator population.
+  if (size != left.size() || size != right.size() || size != output.size() ||
+      left.data_size() > size_t(INT_MAX) || right.data_size() > size_t(INT_MAX)) return false;
+  return binary_eval_layout(selected, left.dtype(), output.ndim(), size, output.is_tracer(), out);
+}
+} // namespace mlx::core::cpu
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_binary_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record = guard.record();
+  auto* graph = record.graph_quota();
+  const auto context = current_graph_construction_context();
+  if (out || !graph || !guard.cpu() || !context.scope || context.worker ||
+      context.dispatch != &record || current_graph_quota() != graph) return GraphFailure::foreign_parent;
+  cpu::BinaryEvalStorage actual;
+  if (!cpu::binary_eval_storage(guard.current(), actual)) return GraphFailure::invalid_layout;
+  return create_layout(*graph, context.scope, &record, actual, out, true);
+}
+} // namespace mlx::core::submission
