+bool cpu::argpartition_task_layout(ArgPartitionTaskLayout& output) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return false;
+#else
+  using Bound = decltype(std::bind(std::declval<ArgPartitionTask>()));
+  using Node = scheduler::TaskNode<Bound>;
+  ArgPartitionTaskLayout value;
+  value.bytes = sizeof(Node); value.alignment = alignof(Node);
+  if (!scheduler::task_graph_extent<Bound>(value.extent)) return false;
+  // Rank-two inputs leave rank-one iteration geometry. Shape, Strides and both
+  // ContiguousIterators stay inline; nth_element/sort use no owning container.
+  value.controls = sizeof(value) + sizeof(ArgPartitionTask) + sizeof(Bound) +
+      sizeof(scheduler::TaskContext) + sizeof(scheduler::TaskOwner) +
+      sizeof(submission::GraphAllocator<Node>) + 2 * sizeof(Shape) +
+      2 * sizeof(Strides) + 2 * sizeof(ContiguousIterator) +
+      5 * sizeof(StridedIterator<uint32_t>) + 6 * sizeof(size_t) +
+      4 * sizeof(int) + 4 * sizeof(void*);
+  output = value;
+  return true;
+#endif
+}
+
 } // namespace mlx::core
