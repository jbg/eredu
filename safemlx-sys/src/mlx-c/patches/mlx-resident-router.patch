+      !allocator::original_buffer_allocation_control_bytes(allocation_controls) ||
+      !PreparedInputLeaf::append_array_requests(2, array_requests, count) || count != 3)
+    return false;
+  CpuArgPartitionLayout value;
+  value.tracer = tracer;
+  for (size_t i = 0; i < 2; ++i) {
+    value.request_bytes[i] = cleanup.request_bytes[i];
+    value.request_alignments[i] = cleanup.request_alignments[i];
+    value.request_counts[i] = cleanup.request_counts[i];
+  }
+  // outputs() contains the sole output; the optional tracer copy holds the sole
+  // input at exactly its previous construction point. Both vectors start empty.
+  value.request_bytes[2] = sizeof(array);
+  value.request_alignments[2] = alignof(array);
+  value.request_counts[2] = 1 + size_t(tracer);
