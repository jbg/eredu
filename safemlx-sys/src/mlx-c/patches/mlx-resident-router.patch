+  value.request_alignments[3] = array_requests[2].alignment;
+  value.request_counts[3] = 3; // output Data plus both task weak-view Data controls
+  value.request_bytes[4] = task.bytes;
+  value.request_alignments[4] = task.alignment;
+  value.request_counts[4] = 1;
+  value.request_bytes[5] = routing.birth_bytes;
+  value.request_alignments[5] = routing.birth_alignment;
+  value.request_counts[5] = 1;
