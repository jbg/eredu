+      sizeof(std::optional<FixedEvalPrologueGuard>) + sizeof(GraphConstruction*) +
+      sizeof(bool) + 2 * (sizeof(array) + sizeof(Shape) + sizeof(ArrayVector) +
+          sizeof(std::shared_ptr<Primitive>) + sizeof(Strides) + sizeof(array::Flags) +
