diff --git a/tests/scheduler_recovery_tests.cpp b/tests/scheduler_recovery_tests.cpp
new file mode 100644
index 00000000..21fdaeaf
--- /dev/null
+++ b/tests/scheduler_recovery_tests.cpp
@@ -0,0 +1,193 @@
+#include "doctest/doctest.h"
+#include "mlx/backend/cpu/encoder.h"
+#include "mlx/scheduler.h"
+
+#include <chrono>
+#include <future>
+#include <new>
+#include <thread>
+
+using namespace mlx::core;
+
+namespace {
+
+bool reached(
+    scheduler::CpuStreamToken token,
+    uint64_t frontier,
+    std::chrono::seconds timeout = std::chrono::seconds(5)) {
+  auto deadline = std::chrono::steady_clock::now() + timeout;
+  do {
+    if (scheduler::cpu_stream_progress(token).completed >= frontier) {
+      return true;
+    }
+    std::this_thread::yield();
+  } while (std::chrono::steady_clock::now() < deadline);
+  return false;
+}
+
+struct Gate {
+  std::promise<void> release;
+  std::shared_future<void> ready{release.get_future().share()};
+  bool released{false};
+
+  void open() {
+    if (!released) {
+      release.set_value();
+      released = true;
+    }
+  }
+
+  ~Gate() {
+    open();
+  }
+};
+
+struct FailsMovingIntoTask {
+  FailsMovingIntoTask() = default;
+  FailsMovingIntoTask(const FailsMovingIntoTask&) = default;
+  FailsMovingIntoTask(FailsMovingIntoTask&&) {
+    throw std::bad_alloc();
+  }
+  void operator()() const {}
+};
+
+} // namespace
+
+TEST_CASE("test CPU recovery progress counts pending and throwing tasks") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto token = scheduler::prepare_cpu_stream(stream);
+  auto initial = scheduler::cpu_stream_progress(token);
+  CHECK(initial.accepted == 0);
+  CHECK(initial.completed == 0);
+  CHECK_FALSE(initial.failed);
+
+  Gate gate;
+  scheduler::enqueue(stream, [ready = gate.ready]() { ready.wait(); });
+  scheduler::enqueue(stream, []() { throw std::runtime_error("queued failure"); });
+  scheduler::enqueue(stream, []() {});
+  auto pending = scheduler::cpu_stream_progress(token);
+  CHECK(pending.accepted == 3);
+  CHECK(pending.completed == 0);
+  CHECK_FALSE(pending.failed);
+  gate.open();
+  REQUIRE(reached(token, 3));
+
+  auto terminal = scheduler::cpu_stream_progress(token);
+  CHECK(terminal.accepted == 3);
+  CHECK(terminal.completed == 3);
+  CHECK(terminal.failed);
+  CHECK_THROWS_AS(scheduler::prepare_cpu_stream(stream), std::runtime_error);
+  auto error = scheduler::stream_error(stream);
+  REQUIRE(error);
+  CHECK(*error == "queued failure");
+  CHECK(scheduler::take_stream_error(stream) == error);
+  CHECK_FALSE(scheduler::stream_error(stream));
+  // Error consumption does not erase the terminal recovery failure witness.
+  CHECK(scheduler::cpu_stream_progress(token).failed);
+  CHECK_THROWS_AS(scheduler::prepare_cpu_stream(stream), std::runtime_error);
+}
+
+TEST_CASE("test CPU recovery accounts bad alloc and unknown task exceptions") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto token = scheduler::prepare_cpu_stream(stream);
+  scheduler::enqueue(stream, []() { throw std::bad_alloc(); });
+  scheduler::enqueue(stream, []() { throw 7; });
+  REQUIRE(reached(token, 2));
+  CHECK(scheduler::cpu_stream_progress(token).failed);
+  CHECK(scheduler::cpu_stream_progress(token).completed == 2);
+  CHECK(scheduler::take_stream_error(stream) != nullptr);
+
+  scheduler::enqueue(stream, []() { throw 9; });
+  REQUIRE(reached(token, 3));
+  auto unknown = scheduler::take_stream_error(stream);
+  REQUIRE(unknown);
+  CHECK(*unknown ==
+        "Asynchronous CPU stream work failed; diagnostic unavailable.");
+}
+
+TEST_CASE("test CPU recovery blocks acceptance without phantom tasks") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto token = scheduler::prepare_cpu_stream(stream);
+  auto baseline = scheduler::n_active_tasks();
+  scheduler::block_cpu_stream(token);
+  CHECK_THROWS_AS(scheduler::prepare_cpu_stream(stream), std::runtime_error);
+  CHECK_THROWS_AS(scheduler::enqueue(stream, []() {}), std::runtime_error);
+  CHECK_THROWS_AS(
+      scheduler::enqueue_counted(stream, []() {}), std::runtime_error);
+  auto progress = scheduler::cpu_stream_progress(token);
+  CHECK(progress.accepted == 0);
+  CHECK(progress.completed == 0);
+  CHECK(scheduler::n_active_tasks() == baseline);
+  auto lookup = scheduler::cpu_stream_progress(stream);
+  REQUIRE(lookup.has_value());
+  CHECK(lookup->accepted == progress.accepted);
+  CHECK(lookup->completed == progress.completed);
+}
+
+TEST_CASE("test CPU recovery counted dispatch is exception safe") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto token = scheduler::prepare_cpu_stream(stream);
+  auto& encoder = cpu::get_command_encoder(stream);
+  auto baseline = scheduler::n_active_tasks();
+  for (int i = 0; i < cpu::DISPATCHES_PER_TASK - 1; ++i) {
+    encoder.dispatch([]() {});
+  }
+  REQUIRE(reached(token, cpu::DISPATCHES_PER_TASK - 1));
+  FailsMovingIntoTask failure;
+  CHECK_THROWS_AS(encoder.dispatch(failure), std::bad_alloc);
+  CHECK(scheduler::cpu_stream_progress(token).accepted ==
+        cpu::DISPATCHES_PER_TASK - 1);
+  CHECK(scheduler::n_active_tasks() == baseline);
+
+  Gate gate;
+  encoder.dispatch([ready = gate.ready]() {
+    ready.wait();
+    throw std::runtime_error("counted task failed");
+  });
+  CHECK(scheduler::n_active_tasks() == baseline + 1);
+  CHECK(scheduler::cpu_stream_progress(token).accepted == cpu::DISPATCHES_PER_TASK);
+  gate.open();
+  REQUIRE(reached(token, cpu::DISPATCHES_PER_TASK));
+  CHECK(scheduler::n_active_tasks() == baseline);
+  CHECK(scheduler::cpu_stream_progress(token).failed);
+}
+
+TEST_CASE("test CPU recovery block linearizes with concurrent acceptance") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto token = scheduler::prepare_cpu_stream(stream);
+  Gate start;
+  std::thread producer([stream, ready = start.ready]() {
+    ready.wait();
+    for (int i = 0; i < 1000; ++i) {
+      try {
+        scheduler::enqueue(stream, []() {});
+      } catch (const std::runtime_error&) {
+        break;
+      }
+    }
+  });
+  start.open();
+  scheduler::block_cpu_stream(token);
+  auto frontier = scheduler::cpu_stream_progress(token).accepted;
+  producer.join();
+  CHECK(scheduler::cpu_stream_progress(token).accepted == frontier);
+  CHECK_THROWS_AS(scheduler::enqueue(stream, []() {}), std::runtime_error);
+  REQUIRE(reached(token, frontier));
+  CHECK(scheduler::cpu_stream_progress(token).completed == frontier);
+}
+
+TEST_CASE("test CPU recovery sequence exhaustion rejects before acceptance") {
+  auto stream = new_thread_unsafe_stream(Device::cpu);
+  auto token = scheduler::prepare_cpu_stream(stream);
+  auto* state = const_cast<scheduler::StreamThread*>(
+      static_cast<const scheduler::StreamThread*>(token.state));
+  auto baseline = scheduler::n_active_tasks();
+  state->admission.store(scheduler::StreamThread::sequence_mask);
+  CHECK_THROWS_AS(
+      scheduler::enqueue_counted(stream, []() {}), std::overflow_error);
+  CHECK(scheduler::cpu_stream_progress(token).accepted ==
+        scheduler::StreamThread::sequence_mask);
+  CHECK(scheduler::cpu_stream_progress(token).completed == 0);
+  CHECK(scheduler::n_active_tasks() == baseline);
+  scheduler::block_cpu_stream(token);
+}
