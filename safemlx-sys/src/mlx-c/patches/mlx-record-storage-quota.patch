diff --git a/mlx/record_quota.cpp b/mlx/record_quota.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/record_quota.cpp
@@ -0,0 +1,179 @@
+#include "mlx/record_quota.h"
+
+#include <algorithm>
+#include <cassert>
+#include <cstring>
+#include <limits>
+#include <new>
+#include <thread>
+
+namespace mlx::core::submission {
+namespace {
+constexpr size_t alignment = alignof(std::max_align_t);
+constexpr size_t absent = std::numeric_limits<size_t>::max();
+
+bool add(size_t a, size_t b, size_t& out) noexcept {
+  if (a > absent - b) return false;
+  out = a + b;
+  return true;
+}
+bool align_up(size_t value, size_t align, size_t& out) noexcept {
+  if (!align || (align & (align - 1))) return false;
+  if (!add(value, align - 1, out)) return false;
+  out &= ~(align - 1);
+  return true;
+}
+size_t header_bytes() noexcept {
+  return (sizeof(RecordQuota) + alignment - 1) & ~(alignment - 1);
+}
+struct ArenaConstruction {
+  RecordQuotaLayout facts;
+  void* memory;
+};
+struct ArenaRetirement {
+  void* allocation;
+  void* owner;
+  void (*retire)(void*);
+};
+} // namespace
+
+struct alignas(std::max_align_t) RecordQuota::Block {
+  size_t bytes;
+  size_t previous;
+  size_t next;
+  bool free;
+};
+struct RecordQuota::Loan {
+  const RecordQuota& quota;
+  explicit Loan(const RecordQuota& value) noexcept : quota(value) {
+    // Arithmetic/link updates only; never constructors/destructors/callbacks.
+    while (quota.loan_.test_and_set(std::memory_order_acquire))
+      std::this_thread::yield();
+  }
+  ~Loan() { quota.loan_.clear(std::memory_order_release); }
+};
+
+const char* RecordQuotaError::what() const noexcept {
+  switch (cause_) {
+    case QuotaFailure::exhausted: return "submission tracking capacity exhausted";
+    case QuotaFailure::invalid_layout: return "invalid submission tracking layout";
+    case QuotaFailure::foreign_parent: return "submission tracking parent mismatch";
+    case QuotaFailure::unbound_record: return "record requires its bounded factory";
+  }
+  return "submission tracking failure";
+}
+
+bool RecordQuota::layout(size_t capacity, RecordQuotaLayout& out) noexcept {
+  size_t total;
+  // This is the minimum physical allocator block, not a graph-fit assertion.
+  size_t minimum;
+  if (!add(sizeof(Block) + sizeof(size_t) + alignment - 1, minimum_record_object_bytes(), minimum) ||
+      capacity < minimum ||
+      capacity > std::numeric_limits<ptrdiff_t>::max() ||
+      !add(header_bytes(), capacity, total)) {
+    return false;
+  }
+  out = {capacity, total, alignment,
+      sizeof(ArenaRetirement) + sizeof(ArenaConstruction) + sizeof(Loan)};
+  return true;
+}
+
+RecordQuota::RecordQuota(size_t capacity, void* owner, void (*retire)(void*)) noexcept
+    : capacity_(capacity), owner_(owner), retire_(retire) {
+  ::new (bytes()) Block{capacity, absent, absent, true};
+}
+
+RecordQuota* RecordQuota::create(size_t capacity, void* owner, void (*retire)(void*)) {
+  ArenaConstruction construction{};
+  if (!layout(capacity, construction.facts))
+    throw RecordQuotaError(QuotaFailure::invalid_layout);
+  construction.memory = ::operator new(construction.facts.allocation_bytes, std::align_val_t(alignment));
+  // No failure or owner callback follows allocation before handoff.
+  return ::new (construction.memory) RecordQuota(capacity, owner, retire);
+}
+
+void RecordQuota::retain() noexcept {
+  const auto prior = references_.fetch_add(1, std::memory_order_relaxed);
+  if (prior == std::numeric_limits<size_t>::max()) std::terminate();
+}
+void RecordQuota::release() noexcept {
+  if (references_.fetch_sub(1, std::memory_order_acq_rel) != 1) return;
+  // Every record/scope/resource borrower has a native strong owner. Block
+  // return happens before that owner releases; no live allocation remains.
+  assert(occupied_ == 0);
+  const ArenaRetirement retirement{this, owner_, retire_};
+  this->~RecordQuota();
+  ::operator delete(retirement.allocation, std::align_val_t(alignment));
+  if (retirement.retire) retirement.retire(retirement.owner);
+}
+size_t RecordQuota::occupied_bytes() const noexcept {
+  const Loan loan(*this);
+  return occupied_;
+}
+std::byte* RecordQuota::bytes() noexcept {
+  return reinterpret_cast<std::byte*>(this) + header_bytes();
+}
+RecordQuota::Block* RecordQuota::block(size_t offset) noexcept {
+  return reinterpret_cast<Block*>(bytes() + offset);
+}
+
+void* RecordQuota::allocate(size_t requested, size_t align) {
+  void* result = nullptr;
+  {
+    const Loan loan(*this);
+    auto& c = scratch_;
+    c.result = nullptr;
+    for (c.offset = 0; c.offset != absent; c.offset = block(c.offset)->next) {
+      c.entry = block(c.offset);
+      if (!c.entry->free) continue;
+      c.address = reinterpret_cast<uintptr_t>(bytes() + c.offset);
+      if (!add(c.address, sizeof(Block) + sizeof(size_t), c.start) ||
+          !align_up(c.start, align, c.pointer) ||
+          !add(c.pointer - c.address, std::max(requested, size_t{1}), c.used) ||
+          !align_up(c.used, alignment, c.used) || c.used > c.entry->bytes)
+        continue;
+      c.remainder = c.entry->bytes - c.used;
+      if (c.remainder >= sizeof(Block) + sizeof(size_t) + alignment) {
+        c.next = c.offset + c.used;
+        ::new (bytes() + c.next) Block{c.remainder, c.offset, c.entry->next, true};
+        if (c.entry->next != absent) block(c.entry->next)->previous = c.next;
+        c.entry->next = c.next;
+        c.entry->bytes = c.used;
+      }
+      c.entry->free = false;
+      occupied_ += c.entry->bytes; // disjoint physical blocks, total <= capacity
+      c.result = reinterpret_cast<void*>(c.pointer);
+      // memcpy avoids imposing an alignment requirement on the back-offset.
+      std::memcpy(reinterpret_cast<std::byte*>(c.result) - sizeof(size_t), &c.offset, sizeof(c.offset));
+      break;
+    }
+    result = c.result;
+    // No scratch pointer is an owning reference or consulted outside this loan.
+  }
+  if (!result) throw RecordQuotaError(QuotaFailure::exhausted);
+  return result;
+}
+
+void RecordQuota::deallocate(void* pointer, size_t, size_t) noexcept {
+  const Loan loan(*this);
+  auto& c = scratch_;
+  std::memcpy(&c.offset, reinterpret_cast<std::byte*>(pointer) - sizeof(size_t), sizeof(c.offset));
+  c.entry = block(c.offset);
+  assert(!c.entry->free);
+  occupied_ -= c.entry->bytes;
+  c.entry->free = true;
+  if (c.entry->next != absent && block(c.entry->next)->free) {
+    c.adjacent = block(c.entry->next);
+    c.entry->bytes += c.adjacent->bytes;
+    c.entry->next = c.adjacent->next;
+    if (c.entry->next != absent) block(c.entry->next)->previous = c.offset;
+  }
+  if (c.entry->previous != absent && block(c.entry->previous)->free) {
+    c.adjacent = block(c.entry->previous);
+    c.adjacent->bytes += c.entry->bytes;
+    c.adjacent->next = c.entry->next;
+    if (c.entry->next != absent) block(c.entry->next)->previous = c.entry->previous;
+  }
+}
+
+} // namespace mlx::core::submission
