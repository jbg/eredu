@@ -0,0 +1,130 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <deque>
+#include <map>
+#include <memory>
+#include <set>
+#include <unordered_map>
+#include <vector>
+#include <limits>
+
+#include "mlx/api.h"
+
+namespace mlx::core::submission {
+
+// A component ceiling, never a prediction that an evaluation graph will fit.
+enum class QuotaFailure : uint8_t {
+  exhausted = 1,
+  invalid_layout = 2,
+  foreign_parent = 3,
+  unbound_record = 4,
+};
+
+class MLX_API RecordQuotaError final : public std::exception {
+ public:
+  explicit RecordQuotaError(QuotaFailure cause) noexcept : cause_(cause) {}
+  const char* what() const noexcept override;
+  QuotaFailure cause() const noexcept { return cause_; }
+ private:
+  QuotaFailure cause_;
+};
+
+// Minimum concrete Record object block, supplied by the actual Eval class.
+// Its containers and future graph may still exhaust a larger admitted ceiling.
+MLX_API size_t minimum_record_object_bytes() noexcept;
+
+struct RecordQuotaLayout {
+  size_t capacity;
+  size_t allocation_bytes;
+  size_t alignment;
+  size_t retirement_controls;
+};
+
+// One allocation: this resource followed by its physical arena. All block
+// headers live inside capacity. No grow/reset/upstream/fallback operation exists.
+// The constructor owner is consumed only on success. Its callback is invoked
+// after the complete allocation is freed, and must only enqueue owned retirement.
+class MLX_API RecordQuota final {
+ public:
+  static bool layout(size_t capacity, RecordQuotaLayout& out) noexcept;
+  static RecordQuota* create(
+      size_t capacity, void* owner, void (*retire)(void*));
+  void retain() noexcept;
+  void release() noexcept;
+  size_t capacity() const noexcept { return capacity_; }
+  // Diagnostic only. Allocation/deallocation, not status/progress, changes it.
+  size_t occupied_bytes() const noexcept;
+  void* allocate(size_t, size_t);
+  void deallocate(void*, size_t, size_t) noexcept;
+
+ private:
+  struct Block;
+  struct Loan;
+  // One serialized allocator scratch representation is part of this exact
+  // header allocation, rather than an unpriced population of heap controls.
+  struct Scratch {
+    void* result = nullptr;
+    Block* entry = nullptr;
+    Block* adjacent = nullptr;
+    size_t offset = 0, start = 0, pointer = 0, used = 0;
+    size_t address = 0, remainder = 0, next = 0;
+  } scratch_;
+  RecordQuota(size_t, void*, void (*)(void*)) noexcept;
+  ~RecordQuota() = default;
+  std::byte* bytes() noexcept;
+  Block* block(size_t) noexcept;
+  std::atomic<size_t> references_{1};
+  mutable std::atomic_flag loan_ = ATOMIC_FLAG_INIT;
+  size_t capacity_;
+  size_t occupied_{0};
+  void* owner_;
+  void (*retire_)(void*);
+};
+
+// Allocator state is one borrowed pointer. The containing Record owns the
+// arena through object deallocation, including construction failure. Scratch
+// containers are lexically nested inside that same entered Record lifetime.
+// No global/default resource or upstream fallback exists for a non-null quota.
+template<class T> class RecordAllocator {
+ public:
+  using value_type = T;
+  RecordAllocator(RecordQuota* value = nullptr) noexcept : quota(value) {}
+  template<class U> RecordAllocator(const RecordAllocator<U>& other) noexcept : quota(other.quota) {}
+  T* allocate(size_t count) {
+    if (count > std::numeric_limits<size_t>::max() / sizeof(T))
+      throw RecordQuotaError(QuotaFailure::invalid_layout);
+    if (quota) return static_cast<T*>(quota->allocate(count * sizeof(T), alignof(T)));
+    return std::allocator<T>{}.allocate(count);
+  }
+  void deallocate(T* pointer, size_t count) noexcept {
+    if (quota) quota->deallocate(pointer, count * sizeof(T), alignof(T));
+    else std::allocator<T>{}.deallocate(pointer, count);
+  }
+  template<class U> bool operator==(const RecordAllocator<U>& other) const noexcept { return quota == other.quota; }
+  template<class U> bool operator!=(const RecordAllocator<U>& other) const noexcept { return quota != other.quota; }
+  RecordQuota* quota;
+};
+template<class T> using RecordVector = std::vector<T, RecordAllocator<T>>;
+template<class T> using RecordDeque = std::deque<T, RecordAllocator<T>>;
+template<class K, class V> using RecordMap = std::unordered_map<K, V, std::hash<K>, std::equal_to<K>, RecordAllocator<std::pair<const K, V>>>;
+template<class T> using RecordSet = std::set<T, std::less<T>, RecordAllocator<T>>;
+
+// Native-only reference. No callback runs while the arena allocator loan lives.
+class RecordQuotaRef {
+ public:
+  explicit RecordQuotaRef(RecordQuota* value = nullptr) noexcept : value_(value) {
+    if (value_) value_->retain();
+  }
+  RecordQuotaRef(const RecordQuotaRef& other) noexcept : RecordQuotaRef(other.value_) {}
+  RecordQuotaRef& operator=(const RecordQuotaRef&) = delete;
+  ~RecordQuotaRef() { if (value_) value_->release(); }
+  RecordQuota* get() const noexcept { return value_; }
+ private:
+  RecordQuota* value_;
+};
+
+} // namespace mlx::core::submission
