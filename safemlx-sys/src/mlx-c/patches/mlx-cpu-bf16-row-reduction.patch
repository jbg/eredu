+// Complete FP32 reductions for reduced-precision matrix products.
+// Keep reduction trees independent of GEMM tiles and prompt length. Products
+// of BF16 inputs are exactly representable in FP32; only accumulation rounds.
+// No expanded or widened copy of the weight matrix is required.
+static void bf16_row_matmul(
+    const bfloat16_t* a, const bfloat16_t* b, bfloat16_t* out,
+    size_t m, size_t n, size_t k, size_t ar, size_t ak, size_t bc, size_t bk) {
+  for (size_t row = 0; row < m; ++row) {
+    for (size_t col = 0; col < n; ++col) {
+      // Strided right-hand columns use four independent FP32 accumulators.
+      // Contiguous row dots below use the wider vector reduction tree.
+      if (bk != 1) {
+        float partial[4] = {};
+        size_t index = 0;
+        for (; index + 4 <= k; index += 4) {
+          for (size_t lane = 0; lane < 4; ++lane) {
+            partial[lane] += static_cast<float>(a[row * ar + (index + lane) * ak]) *
+                static_cast<float>(b[col * bc + (index + lane) * bk]);
+          }
+        }
+        for (; index < k; ++index) {
+          partial[0] += static_cast<float>(a[row * ar + index * ak]) *
+              static_cast<float>(b[col * bc + index * bk]);
+        }
+        for (size_t lane = 1; lane < 4; ++lane) {
+          partial[0] += partial[lane];
+        }
+        out[row * n + col] = partial[0];
+        continue;
+      }
+      float lanes[32] = {};
+      size_t index = 0;
+      for (; index + 32 <= k; index += 32) {
+        for (size_t lane = 0; lane < 32; ++lane) {
+          lanes[lane] += static_cast<float>(a[row * ar + (index + lane) * ak]) *
+              static_cast<float>(b[col * bc + (index + lane) * bk]);
+        }
+      }
+      for (size_t width = 16; width >= 4; width /= 2) {
+        for (size_t lane = 0; lane < width; ++lane) {
+          lanes[lane] += lanes[lane + width];
+        }
+      }
+      float sum = (lanes[0] + lanes[1]) + (lanes[2] + lanes[3]);
+      // The same four-lane tree handles complete tail vectors.
+      float tail[4] = {};
+      for (; index + 8 <= k; index += 8) {
+        for (size_t lane = 0; lane < 4; ++lane) {
+          tail[lane] += static_cast<float>(a[row * ar + (index + lane) * ak]) *
+              static_cast<float>(b[col * bc + (index + lane) * bk]);
+          tail[lane] += static_cast<float>(a[row * ar + (index + lane + 4) * ak]) *
+              static_cast<float>(b[col * bc + (index + lane + 4) * bk]);
+        }
+      }
+      sum += (tail[0] + tail[1]) + (tail[2] + tail[3]);
+      for (; index < k; ++index) {
+        sum += static_cast<float>(a[row * ar + index * ak]) *
+            static_cast<float>(b[col * bc + index * bk]);
+      }
+      out[row * n + col] = sum;
+    }
+  }
+}
 
