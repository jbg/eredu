+  value.request_bytes[7]=backing?routing.birth_bytes:0;
+  value.request_alignments[7]=backing?routing.birth_alignment:1;
+  const size_t controls=sizeof(backing)+sizeof(routing)+sizeof(value)+sizeof(size_t);
+  if(!add(value.named_control_bytes,controls))return false;
+  return submission::GraphConstruction::complete_layout(value);
