+bool GraphQuota::minimum_allocation_extent(size_t requested, size_t align, size_t& out) noexcept {
+  size_t start, used;
+  if (!align || (align & (align - 1)) || align > alignment) return false;
+  // Arena base and every split Block offset are max_align_t-aligned. This is
+  // the exact relative pointer calculation in try_allocate before tail choice.
+  return align_up(sizeof(Block) + sizeof(size_t), align, start) &&
+      add(start, std::max(requested, size_t{1}), used) &&
+      align_up(used, alignment, out);
 }
 
