+  // Reshape stores the requested shape, while ops::reshape resolves its one
+  // optional -1 in the output array. Exact positive dimensions and the checked
+  // total product below prove the same unique inferred extent without creating
+  // a second Shape or entering the ordinary throwing shape constructor.
+  bool inferred=false;
+  for(size_t i=0;i!=output_rank;++i) {
+    if(output.shape(i)<=0)return false;
+    if(shape[i]==-1) {
+      if(inferred)return false;
+      inferred=true;
+    } else if(shape[i]<=0||shape[i]!=output.shape(i))return false;
+    if(!product(output_elements,size_t(output.shape(i)),output_elements))return false;
+  }
