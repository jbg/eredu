+size_t NativeFailure::copy_utf16(bool domain, size_t offset, uint16_t* output,
+    size_t capacity, size_t& remaining) const noexcept {
+  const auto* string = static_cast<NS::String*>(domain ? domain_ : description_);
+  const auto length = string ? string->length() : 0;
+  remaining = offset < length ? length - offset : 0;
+  const auto count = std::min(capacity, remaining);
+  // Copy raw UTF-16 into caller storage. No UTF8String/cString conversion or
+  // autoreleased byte pointer escapes; both actual NSString objects are retained.
+  for (size_t i = 0; i < count; ++i) output[i] = string->character(offset + i);
+  remaining -= count;
+  return count;
