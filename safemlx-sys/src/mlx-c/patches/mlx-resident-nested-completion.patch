+GraphFailure GraphConstruction::configure_nested(
+    const NestedGraphEvaluationLimits& limits, size_t attempts) noexcept {
+  const auto context = current_graph_construction_context();
+  const GraphQuota::Loan loan(*quota_);
+  if (!context.scope || context.scope != scope_ || context.worker || context.dispatch ||
+      !resident_host_ || dispatch_ || quota_->construction_ != this)
+    return GraphFailure::foreign_parent;
+  if (!attempts || !limits.roots || nested_configured_ || quota_->preparing_)
+    return GraphFailure::construction_mismatch;
+  for (size_t i = 0; i < count_; ++i)
+    if (!slots_[i].pointer) return GraphFailure::construction_mismatch;
+  nested_configured_ = true;
+  nested_limits_ = limits;
+  nested_remaining_ = attempts;
+  return static_cast<GraphFailure>(0);
+}
+GraphFailure GraphConstruction::validate_nested(
+    GraphQuota& quota, uint64_t scope, size_t roots) noexcept {
+  const auto context = current_graph_construction_context();
+  const GraphQuota::Loan loan(quota);
+  const auto* owner = quota.construction_;
+  if (!owner || !scope || context.scope != scope || owner->scope_ != scope ||
+      context.worker || context.dispatch || !owner->resident_host_ || owner->dispatch_)
+    return GraphFailure::foreign_parent;
+  if (quota.preparing_ || !roots || !owner->nested_remaining_ || roots > owner->nested_limits_.roots)
+    return GraphFailure::construction_mismatch;
+  return static_cast<GraphFailure>(0);
+}
+GraphFailure GraphConstruction::suspend_nested(
+    GraphQuota& quota, uint64_t scope, size_t roots, GraphNestedEvaluation& suspended) noexcept {
+  if (suspended.owner_) return GraphFailure::construction_busy;
+  if (const auto failure = validate_nested(quota, scope, roots); static_cast<unsigned>(failure))
+    return failure;
+  const GraphQuota::Loan loan(quota);
+  auto* owner = quota.construction_;
+  // Same owner-thread synchronous entry; no hook runs between the two loans.
+  if (!owner || owner->scope_ != scope || !owner->nested_remaining_)
+    return GraphFailure::foreign_parent;
+  suspended.limits_ = owner->nested_limits_;
+  suspended.limits_.roots = roots;
+  suspended.owner_ = owner;
+  --owner->nested_remaining_;
+  quota.construction_ = nullptr;
+  return static_cast<GraphFailure>(0);
+}
+void GraphConstruction::resume_nested() noexcept {
+  const GraphQuota::Loan loan(*quota_);
+  // All nested banks are lexical owners inside the synchronous caller. A live
+  // replacement here is an internal lifetime violation, never a heap fallback.
+  if (quota_->construction_ || quota_->preparing_) std::terminate();
+  quota_->construction_ = this;
+}
