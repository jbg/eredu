+++ b/mlx/backend/cpu/alias_storage.h
@@ -0,0 +1,12 @@
+#pragma once
+#include "mlx/backend/cpu/copy_storage.h"
+namespace mlx::core::cpu {
+enum class AliasOperation : unsigned { Transpose = 0, Broadcast = 1 };
+// Common alias workers inspect only fixed inline shape/stride state. These
+// queries grant neither source storage nor permission to evaluate a primitive.
+MLX_API bool alias_input_geometry(const array&, size_t& elements) noexcept;
+MLX_API bool is_alias_eval_primitive(const array&) noexcept;
+MLX_API bool alias_eval_layout(AliasOperation, size_t rank, size_t output_rank,
+    bool tracer, CopyEvalStorage&) noexcept;
+MLX_API bool alias_eval_storage(const array&, CopyEvalStorage&) noexcept;
+}
