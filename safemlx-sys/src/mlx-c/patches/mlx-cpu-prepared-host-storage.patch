+namespace {
+// CPU workers can address CPU pages and shared Metal storage. GPU workers
+// retain the shared-Metal contract; ordinary CPU pages are not GPU buffers.
+bool original_host_storage_matches(const HostTransferBuffer& buffer, Stream selected) {
+  const auto kind = buffer.storage_kind();
+  return (kind == HostTransferStorageKind::metal_shared &&
+          (selected.device.type == Device::gpu || selected.device.type == Device::cpu)) ||
+      (kind == HostTransferStorageKind::cpu && selected.device.type == Device::cpu);
+}
