diff --git a/mlx/backend/cpu/random_storage.cpp b/mlx/backend/cpu/random_storage.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/random_storage.cpp
@@ -0,0 +1,55 @@
+#include "mlx/backend/cpu/random_storage.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <typeinfo>
+namespace mlx::core::cpu {
+namespace {
+bool product(size_t a,size_t b,size_t& out) noexcept {
+  if(b&&a>size_t(PTRDIFF_MAX)/b)return false;out=a*b;return true;
+}
+}
+bool is_random_bits_eval_primitive(const array& out) noexcept {
+  return out.has_primitive()&&out.primitive().stream().device==Device::cpu&&
+      typeid(out.primitive())==typeid(RandomBits);
+}
+bool random_bits_eval_layout(size_t rank,size_t elements,bool tracer,CopyEvalStorage& out) noexcept {
+  size_t bytes=0;
+  if(rank<1||rank>4||!elements||elements>UINT32_MAX||!product(elements,sizeof(uint32_t),bytes))return false;
+  EvalDispatchStorage task;SingleOutputEvalStorage common;
+  if(!random_bits_dispatch_storage(task)||!single_output_raw_task_layout(rank,tracer,task,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  const size_t controls=sizeof(value)+sizeof(task)+sizeof(common)+sizeof(rank)+sizeof(elements)+sizeof(tracer)+sizeof(out)+
+      sizeof(bytes)+sizeof(std::pair<const Shape&,int>)+sizeof(const array*)*3+sizeof(const RandomBits*)+
+      sizeof(size_t)*9+sizeof(int)*2+sizeof(bool)*2+sizeof(Shape)+sizeof(Strides)+
+      sizeof(submission::FixedEvalPrologueGuard*)+sizeof(submission::Record*)+sizeof(submission::GraphQuota*)+
+      sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(controls>SIZE_MAX-value.named_control_bytes)return false;
+  value.named_control_bytes+=controls;out=value;return true;
+}
+bool random_bits_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_random_bits_eval_primitive(output)||!output.siblings().empty()||output.inputs().size()!=1)return false;
+  const auto& keys=output.inputs()[0];const auto [shape,width]=static_cast<const RandomBits&>(output.primitive()).state_refs();
+  const size_t rank=output.ndim();
+  if(rank<1||rank>4||shape.size()!=rank||width!=4||output.dtype()!=uint32||output.itemsize()!=sizeof(uint32_t)||
+      keys.ndim()!=1||keys.shape(0)!=2||keys.size()!=2||keys.strides().size()!=1||keys.strides()[0]<0||
+      keys.dtype()!=uint32||keys.itemsize()!=sizeof(uint32_t))return false;
+  size_t elements=1,span=0,bytes=0;
+  for(size_t i=0;i!=rank;++i)
+    if(shape[i]<=0||shape[i]!=output.shape(i)||!product(elements,size_t(shape[i]),elements))return false;
+  if(!product(size_t(keys.strides()[0]),1,span)||span==size_t(PTRDIFF_MAX))return false;
+  ++span;
+  if(span>keys.data_size()||!product(span,sizeof(uint32_t),bytes)||elements!=output.size())return false;
+  return random_bits_eval_layout(rank,elements,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_random_bits_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::random_bits_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
