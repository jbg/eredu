+bool random_bits_dispatch_storage(EvalDispatchStorage& out) noexcept {
+  DispatchLayout task;
+  if(!CommandEncoder::dispatch_layout<RandomBitsTask>(task))return false;
+  const size_t controls=sizeof(EvalDispatchStorage)+sizeof(task)+sizeof(out)+sizeof(RandomBitsTask)*2+
+      sizeof(const uint32_t*)+sizeof(char*)+sizeof(size_t)*11+sizeof(int)*3+sizeof(bool)*2+
+      sizeof(Shape)+sizeof(Strides)+sizeof(std::pair<uint32_t,uint32_t>)*4+
+      sizeof(std::pair<uintptr_t,uintptr_t>)+sizeof(uint32_t[3])+sizeof(uint32_t)*3+sizeof(void*)*5;
+  if(controls>SIZE_MAX-task.controls)return false;
+  out={task.task_bytes,task.task_alignment,0,task.controls+controls};return true;
