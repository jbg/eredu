+uint64_t detail::allocate_group_storage_identity() noexcept {
+  static std::atomic<uint64_t> next{1};
+  auto value=next.load(std::memory_order_relaxed);
+  while(value!=UINT64_MAX) {
+    if(next.compare_exchange_weak(value,value+1,std::memory_order_relaxed))return value;
+  }
+  return 0; // Exhaustion is unqualified, never an address-reused identity.
+}
+
 bool Group::persistent_storage(GroupPersistentStorage& out) const noexcept {
   if(!group_)return false;
   GroupPersistentStorage value;
   if(!group_->persistent_storage(value))return false;
+  if(!group_->storage_identity_)return false;
+  value.storage_identity=group_->storage_identity_;
   if(group_->terminal_owner_)value.unresolved|=group_inherited_owner;
   value.controls=persistent_storage_controls();
   if(value.controls==SIZE_MAX)return false;
