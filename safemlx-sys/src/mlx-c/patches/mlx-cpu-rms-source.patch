+bool cpu_rms_fallback_control_bytes(
+    Dtype dtype, size_t rank, size_t width, size_t rows, size_t& out) noexcept {
+  if ((dtype != float32 && dtype != bfloat16) || rank == 0 || rank > 4 ||
+      width == 0 || rows == 0 || width > size_t(INT_MAX) ||
+      rows > size_t(INT_MAX) / width) return false;
+  // ArrayVector destinations use the existing resident Graph constructor bank;
+  // these are the actual caller/fallback/mean argument and result frames only.
+  const size_t parts[] = {
+      sizeof(RmsFallback), sizeof(std::optional<array>),
+      sizeof(std::tuple<const array&, const std::optional<array>&, float, StreamOrDevice>),
+      sizeof(const ArrayVector&), sizeof(ArrayVector) * 2,
+      sizeof(array) * 2, sizeof(Stream), sizeof(StreamOrDevice), sizeof(Dtype),
+      sizeof(bool), sizeof(float),
+      sizeof(std::tuple<const array&, int, bool, StreamOrDevice>),
+      sizeof(std::tuple<const array&, AxisView, bool, StreamOrDevice>),
+      sizeof(std::tuple<const array&, Shape, bool, Dtype, StreamOrDevice>),
+      sizeof(Shape) * 2, sizeof(AxisView), sizeof(double), sizeof(int) * 3,
+      sizeof(std::tuple<Dtype, size_t, size_t, size_t, size_t&>),
+      sizeof(size_t) * 2};
+  size_t total = sizeof(parts);
+  for (auto bytes : parts) {
+    if (bytes > SIZE_MAX - total) return false;
+    total += bytes;
+  }
+  out = total;
+  return true;
+}
