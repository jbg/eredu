diff --git a/mlx/promise_storage.h b/mlx/promise_storage.h
new file mode 100644
--- /dev/null
+++ b/mlx/promise_storage.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <future>
+#include <type_traits>
+#include "mlx/graph_quota.h"
+
+namespace mlx::core::submission {
+// The ordinary promise and the source-allocated promise share the standard
+// ready/exception protocol. Only the actual shared-state allocator differs.
+template<class R>
+bool promise_storage_layout(size_t& bytes, size_t& alignment) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L
+  using Allocator = GraphAllocator<std::byte>;
+  if constexpr (std::is_void_v<R>) {
+    using State = std::__assoc_sub_state_alloc<Allocator>;
+    bytes = sizeof(State); alignment = alignof(State);
+  } else {
+    using State = std::__assoc_state_alloc<R, Allocator>;
+    bytes = sizeof(State); alignment = alignof(State);
+  }
+  return true;
+#else
+  return false;
+#endif
+}
+template<class R>
+std::promise<R> make_graph_promise(GraphQuota* graph) {
+  if (!graph) return std::promise<R>();
+  size_t bytes, alignment;
+  if (!promise_storage_layout<R>(bytes, alignment))
+    throw GraphQuotaError(GraphFailure::invalid_layout);
+  return std::promise<R>(std::allocator_arg, GraphAllocator<std::byte>(graph));
+}
+} // namespace mlx::core::submission
