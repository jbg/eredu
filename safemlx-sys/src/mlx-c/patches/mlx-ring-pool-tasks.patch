diff --git a/mlx/threadpool_task.h b/mlx/threadpool_task.h
new file mode 100644
--- /dev/null
+++ b/mlx/threadpool_task.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <functional>
+#include <future>
+#include <mutex>
+#include <type_traits>
+#include <utility>
+#include "mlx/scheduler_task.h"
+#include "mlx/promise_storage.h"
+
+namespace mlx::core::threadpool_detail {
+// Concrete owner requests only. This does not qualify arbitrary callable
+// constructors, captures, invocation work or a total operation population.
+struct TaskLayout {
+  size_t node_bytes, node_alignment, node_extent;
+  size_t promise_bytes, promise_alignment, promise_extent;
+  size_t controls;
+};
+
+template<class F, class R> struct Operation {
+  F callable;
+  // An unaccepted construction destroys future before promise. Throwing
+  // callable construction/move happens before either future owner transfers.
+  std::promise<R> promise;
+  std::future<R> future;
+  template<class U>
+  Operation(submission::GraphQuota* graph, U&& body)
+      : callable(std::forward<U>(body)), promise(submission::make_graph_promise<R>(graph)),
+        future(promise.get_future()) {}
+  Operation(Operation&&) = default;
+  void operator()() noexcept {
+    // Same packaged-task result/exception semantics, using the concrete
+    // callable inline in the existing native TaskNode instead of type erasure.
+    try {
+      if constexpr (std::is_void_v<R>) { callable(); promise.set_value(); }
+      else promise.set_value(callable());
+    } catch (...) { promise.set_exception(std::current_exception()); }
+  }
+};
+template<class F, class R>
+bool task_layout(TaskLayout& out) noexcept {
+  using Body = Operation<F, R>;
+  using Node = scheduler::TaskNode<Body>;
+  TaskLayout value{};
+  value.node_bytes = sizeof(Node); value.node_alignment = alignof(Node);
+  if (!submission::promise_storage_layout<R>(value.promise_bytes, value.promise_alignment) ||
+      !submission::GraphQuota::allocation_extent(value.node_bytes, value.node_alignment, value.node_extent) ||
+      !submission::GraphQuota::allocation_extent(value.promise_bytes, value.promise_alignment, value.promise_extent)) return false;
+  value.controls = sizeof(TaskLayout) * 2 + sizeof(Body) + sizeof(F) +
+      sizeof(scheduler::TaskOwner) * 2 + sizeof(std::future<R>) * 2 +
+      sizeof(submission::GraphAllocator<Node>) + sizeof(submission::GraphAllocator<std::byte>) * 3 +
+      sizeof(std::unique_lock<std::mutex>) + sizeof(std::exception_ptr) +
+      sizeof(void*) * 6 + sizeof(size_t) * 4 + sizeof(bool) * 2;
+  out = value;
+  return true;
+}
+} // namespace mlx::core::threadpool_detail
