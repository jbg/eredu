new file mode 100644
--- /dev/null
+++ b/mlx/distributed/ring/socket_tasks.h
@@ -0,0 +1,192 @@
+#pragma once
+
+#include <future>
+#include <limits>
+#include <utility>
+#include "mlx/scheduler_task.h"
+
+namespace mlx::core::distributed::ring {
+
+// These are the actual shared owner layouts, not an inferred operation count.
+struct SocketTaskLayout {
+  size_t node_bytes, node_alignment, node_extent;
+  size_t promise_bytes, promise_alignment, promise_extent;
+  size_t controls;
+};
+
+class SocketTaskQueue;
+class SocketFuture {
+ public:
+  SocketFuture() = default;
+  SocketFuture(SocketFuture&&) noexcept = default;
+  SocketFuture& operator=(SocketFuture&& other) noexcept {
+    wait_if_valid();
+    value_ = std::move(other.value_);
+    return *this;
+  }
+  SocketFuture(const SocketFuture&) = delete;
+  ~SocketFuture() { wait_if_valid(); }
+  void wait() { value_.wait(); }
+  void get() { value_.get(); }
+ private:
+  friend class SocketTaskQueue;
+  explicit SocketFuture(std::future<void>&& value) noexcept : value_(std::move(value)) {}
+  void wait_if_valid() noexcept {
+    // A receipt is formed only after queue acceptance (or immediate success).
+    // Its raw buffer borrower cannot retire before that exact socket finishes.
+    // A valid standard future wait has no no-state branch; a platform failure
+    // cannot be treated as safe native completion during destructor unwinding.
+    if (value_.valid()) value_.wait();
+  }
+  std::future<void> value_;
+};
+
+namespace socket_detail {
+inline bool promise_layout(size_t& bytes, size_t& alignment) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L
+  using State = std::__assoc_sub_state_alloc<submission::GraphAllocator<std::byte>>;
+  bytes = sizeof(State);
+  alignment = alignof(State);
+  return true;
+#else
+  return false;
+#endif
+}
+inline std::promise<void> make_promise(submission::GraphQuota* graph) {
+  if (!graph) return std::promise<void>();
+  size_t bytes, alignment;
+  if (!promise_layout(bytes, alignment))
+    throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+  // The allocator state is retained in the actual promise/future shared state,
+  // including after a socket worker drops its completed task node.
+  return std::promise<void>(std::allocator_arg,
+                           submission::GraphAllocator<std::byte>(graph));
+}
+struct Operation {
+  void* buffer;
+  size_t size;
+  // On an unaccepted prefix, future dies before promise. No broken-promise
+  // exception allocation is needed while another constructor is unwinding.
+  std::promise<void> promise;
+  std::future<void> future;
+  Operation(void* buffer, size_t size, submission::GraphQuota* graph)
+      : buffer(buffer), size(size), promise(make_promise(graph)),
+        future(promise.get_future()) {}
+  Operation(Operation&&) noexcept = default;
+  void operator()() { promise.set_value(); }
+};
+using Node = scheduler::TaskNode<Operation>;
+inline Operation& operation(scheduler::Task* task) noexcept {
+  return static_cast<Node*>(task)->body;
+}
+} // namespace socket_detail
+
+// No list/deque allocation: reuse the exact native scheduler TaskNode and
+// TaskOwner destruction machinery. The existing SocketThread mutex and worker
+// own acceptance/progress; this class neither starts a worker nor creates Scope.
+class SocketTaskQueue {
+ public:
+  class Ready {
+   public:
+    Ready(Ready&&) noexcept = default;
+    Ready(const Ready&) = delete;
+   private:
+    friend class SocketTaskQueue;
+    explicit Ready(scheduler::TaskOwner&& value) noexcept : value_(std::move(value)) {}
+    scheduler::TaskOwner value_;
+  };
+  SocketTaskQueue() = default;
+  SocketTaskQueue(const SocketTaskQueue&) = delete;
+  ~SocketTaskQueue() { while (head_) { auto retired = pop(); } }
+  static Ready prepare(void* buffer, size_t size, submission::GraphQuota* graph) {
+    return Ready(scheduler::make_task(graph, {}, nullptr, false,
+                                     socket_detail::Operation(buffer, size, graph)));
+  }
+  static SocketFuture complete_empty(Ready& ready) {
+    auto* task = ready.value_.get();
+    if (!task || socket_detail::operation(task).size)
+      throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+    task->invoke(task);
+    SocketFuture result(std::move(socket_detail::operation(task).future));
+    ready.value_.reset();
+    return result;
+  }
+  SocketFuture push(Ready& ready) {
+    auto* task = ready.value_.get();
+    if (!task || !socket_detail::operation(task).future.valid())
+      throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+    SocketFuture result(std::move(socket_detail::operation(task).future));
+    if (tail_) tail_->next = task;
+    else head_ = task;
+    tail_ = ready.value_.release();
+    return result;
+  }
+  bool empty() const noexcept { return head_ == nullptr; }
+  socket_detail::Operation* front() noexcept {
+    return head_ ? &socket_detail::operation(head_) : nullptr;
+  }
+  void complete_front() {
+    auto* task = head_;
+    if (!task) throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+    task->invoke(task);
+    auto retired = pop();
+  }
+ private:
+  scheduler::TaskOwner pop() noexcept {
+    auto* task = head_;
+    head_ = task->next;
+    if (!head_) tail_ = nullptr;
+    task->next = nullptr;
+    return scheduler::TaskOwner(task);
+  }
+  scheduler::Task* head_{nullptr};
+  scheduler::Task* tail_{nullptr};
+};
+
+inline bool socket_task_layout(SocketTaskLayout& out) noexcept {
+  SocketTaskLayout value{};
+  value.node_bytes = sizeof(socket_detail::Node);
+  value.node_alignment = alignof(socket_detail::Node);
+  if (!socket_detail::promise_layout(value.promise_bytes, value.promise_alignment) ||
+      !submission::GraphQuota::allocation_extent(value.node_bytes, value.node_alignment, value.node_extent) ||
+      !submission::GraphQuota::allocation_extent(value.promise_bytes, value.promise_alignment, value.promise_extent))
+    return false;
+  value.controls = sizeof(SocketTaskLayout) * 2 + sizeof(SocketTaskQueue) +
+      sizeof(SocketTaskQueue::Ready) + sizeof(SocketFuture) * 2 +
+      sizeof(socket_detail::Operation) + sizeof(scheduler::TaskOwner) * 2 +
+      sizeof(submission::GraphAllocator<socket_detail::Node>) +
+      sizeof(submission::GraphAllocator<std::byte>) * 3 +
+      sizeof(void*) * 5 + sizeof(size_t) * 4 + sizeof(bool) * 2;
+  out = value;
+  return true;
+}
+
+// Every accepted pool sibling must finish before any exception escapes the
+// enclosing CPU task. std::future::wait alone used to discard packaged errors.
+// This joins the same pool jobs; it is not a new executor or completion event.
+class PoolFutures {
+ public:
+  PoolFutures(size_t count, submission::GraphQuota* graph)
+      : values_(submission::GraphAllocator<std::future<void>>(graph)) {
+    values_.reserve(count);
+  }
+  ~PoolFutures() { for (auto& value : values_) if (value.valid()) value.wait(); }
+  void append(std::future<void>&& value) {
+    if (values_.size() == values_.capacity()) {
+      if (value.valid()) value.wait();
+      throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+    }
+    values_.push_back(std::move(value));
+  }
+  void join() {
+    std::exception_ptr first;
+    for (auto& value : values_) {
+      try { value.get(); }
+      catch (...) { if (!first) first = std::current_exception(); }
+    }
+    if (first) std::rethrow_exception(first);
+  }
+ private:
+  submission::GraphVector<std::future<void>> values_;
+};
+} // namespace mlx::core::distributed::ring
