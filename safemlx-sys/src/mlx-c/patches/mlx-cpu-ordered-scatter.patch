+#include <typeinfo>
+namespace mlx::core::cpu {
+namespace {
+bool add(size_t& total,size_t value) noexcept {if(value>SIZE_MAX-total)return false;total+=value;return true;}
+bool append(CopyEvalStorage& out,size_t slot,const submission::GraphQuota::Request& request,size_t count) noexcept {
+  if(!request.bytes||!request.alignment||!add(out.request_counts[slot],count))return false;
+  out.request_bytes[slot]=std::max(out.request_bytes[slot],request.bytes);
+  out.request_alignments[slot]=std::max(out.request_alignments[slot],request.alignment);return true;
+}
+}
+bool scatter_axis_eval_layout(Dtype index,size_t rank,size_t output_elements,
+    size_t update_elements,bool tracer,CopyEvalStorage& out) noexcept {
+  if(!((index==int32&&index.size()==4)||(index==uint32&&index.size()==4))||rank<1||rank>4||
+      !output_elements||output_elements>size_t(INT_MAX)||output_elements>size_t(PTRDIFF_MAX)/sizeof(float)||
+      !update_elements||update_elements>size_t(INT_MAX)||update_elements>size_t(PTRDIFF_MAX)/sizeof(float))return false;
+  CopyEvalStorage value;
+  // Exactly one Eval cleanup retains all three inputs through both queued jobs.
+  if(!copy_eval_layout(0,3,false,tracer,value))return false;
+  CpuCopyDispatchStorage copy;EvalDispatchStorage scatter;WeakCopyStorage weak;
+  submission::OriginalBufferRoutingLayout routing;size_t allocation_controls=0;
+  if(!contiguous_copy_dispatch_storage(rank,copy)||!scatter_axis_dispatch_storage(rank,scatter)||
+      !PreparedInputLeaf::weak_copy_storage(rank,weak)||weak.count!=3||
+      !submission::original_buffer_routing_layout(routing)||
+      !allocator::original_buffer_allocation_control_bytes(allocation_controls))return false;
+  // First job: source/output weak aliases. Second job: indices/updates/output.
+  // Donation can elide the copy; the admitted destination never assumes it.
+  if(!append(value,3,weak.requests[2],6)||!append(value,4,weak.requests[0],5)||
+      !append(value,5,weak.requests[1],5))return false;
+  const submission::GraphQuota::Request first{copy.task_bytes,copy.task_alignment},
+      second{scatter.task_bytes,scatter.task_alignment},birth{routing.birth_bytes,routing.birth_alignment};
+  if(!append(value,6,first,1)||!append(value,6,second,1)||!append(value,7,birth,1))return false;
+  value.rank=rank;value.copy=true;value.backing_births=1;
+  value.worker_graph_extents=copy.worker_graph_extent_bound;
+  if(!add(value.worker_graph_extents,scatter.worker_graph_extents))return false;
+  const auto adoption=array::buffer_adoption_layout();
+  const size_t controls[]={sizeof(value)*2,sizeof(out),sizeof(index),sizeof(rank),sizeof(output_elements),
+      sizeof(update_elements),sizeof(tracer),sizeof(copy),sizeof(scatter),sizeof(weak),sizeof(routing),
+      sizeof(allocation_controls),sizeof(adoption),sizeof(first),sizeof(second),sizeof(birth),
+      copy.controls,scatter.controls,weak.controls,weak.controls,weak.controls,weak.controls,weak.controls,
+      sizeof(std::function<allocator::Buffer(size_t)>)*2,sizeof(allocator::Buffer)*2,
+      sizeof(std::shared_ptr<array::Data>),sizeof(submission::GraphAllocator<array::Data>),
+      sizeof(Shape),sizeof(Strides),sizeof(array::Flags),sizeof(CopyType),sizeof(Stream),sizeof(bool),
+      adoption.incoming_bytes,adoption.scratch_owner_bytes,adoption.deleter_bytes,
+      adoption.allocator_callable_bytes,adoption.prepared_strides_bytes,allocation_controls,
+      sizeof(const array*)*5,sizeof(const ScatterAxis*),sizeof(size_t)*9,sizeof(int)*3,
+      sizeof(std::pair<ScatterAxis::ReduceType,int>),sizeof(submission::FixedEvalPrologueGuard*),
+      sizeof(submission::Record*),sizeof(submission::GraphQuota*),
+      sizeof(submission::GraphConstructionContext),sizeof(submission::GraphFailure)};
+  if(!add(value.named_control_bytes,sizeof(controls)))return false;
+  for(size_t bytes:controls)if(!add(value.named_control_bytes,bytes))return false;
+  if(!submission::GraphConstruction::complete_layout(value))return false;
+  out=value;return true;
+}
+bool is_scatter_axis_eval_primitive(const array& output) noexcept {
+  return output.has_primitive()&&output.primitive().stream().device==Device::cpu&&
+      typeid(output.primitive())==typeid(ScatterAxis);
+}
+bool scatter_axis_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_scatter_axis_eval_primitive(output)||!output.siblings().empty()||output.inputs().size()!=3)return false;
+  const auto& source=output.inputs()[0];const auto& index=output.inputs()[1];const auto& updates=output.inputs()[2];
+  const size_t rank=source.ndim();const auto state=static_cast<const ScatterAxis&>(output.primitive()).state();
+  size_t source_elements=0,index_elements=0,update_elements=0;
+  if(rank<1||rank>4||output.ndim()!=rank||index.ndim()!=rank||updates.ndim()!=rank||
+      state.first!=ScatterAxis::None||state.second!=int(rank)-1||
+      source.dtype()!=float32||source.itemsize()!=sizeof(float)||
+      updates.dtype()!=float32||updates.itemsize()!=sizeof(float)||
+      output.dtype()!=float32||output.itemsize()!=sizeof(float)||
+      source.shape()!=output.shape()||updates.shape()!=index.shape()||
+      !alias_input_geometry(source,source_elements)||!alias_input_geometry(index,index_elements)||
+      !alias_input_geometry(updates,update_elements)||source_elements!=output.size()||index_elements!=update_elements)return false;
+  for(size_t axis=0;axis!=rank;++axis) {
+    if(source.shape(axis)<=0||index.shape(axis)<=0||
+        (axis+1!=rank&&source.shape(axis)!=index.shape(axis)))return false;
+  }
+  return scatter_axis_eval_layout(index.dtype(),rank,source_elements,update_elements,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_scatter_axis_eval(const FixedEvalPrologueGuard& guard,GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;if(!cpu::scatter_axis_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
