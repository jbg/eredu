+      iterator.controls,iterator.controls,sizeof(out),sizeof(rank),sizeof(task),sizeof(weak),sizeof(iterator),
+      sizeof(value),sizeof(ScatterAxisTask)*2,sizeof(array)*4,sizeof(Shape)*3,sizeof(Strides)*2,
