+bool MetalAllocator::prepare_input_runtime(allocator::PreparedInputFacts& facts) {
+  std::lock_guard<std::mutex> guard(mutex_);
+  facts = {vm_page_size, device_->maxBufferLength(),
+      allocator::HostTransferStorageKind::metal_shared,
+      sizeof(std::lock_guard<std::mutex>) + sizeof(MTL::Buffer*) + sizeof(size_t) * 3};
+  return true;
+}
+allocator::PreparedInputCause MetalAllocator::allocate_prepared_input(
+    size_t bytes, allocator::PreparedInputAllocation& output) noexcept {
+  using Cause = allocator::PreparedInputCause;
+  if (!bytes || bytes > std::numeric_limits<size_t>::max() - (vm_page_size - 1))
+    return Cause::invalid;
+  const auto capacity = vm_page_size * ((bytes + vm_page_size - 1) / vm_page_size);
+  if (capacity > device_->maxBufferLength()) return Cause::capacity;
+  if (!mutex_.try_lock()) return Cause::busy;
+  std::lock_guard<std::mutex> guard(mutex_, std::adopt_lock);
+  if (num_resources_ >= resource_limit_ ||
+      active_memory_ > std::numeric_limits<size_t>::max() - capacity)
+    return Cause::capacity;
+  // No cache trim, reuse, heap allocation or ordinary residency hash insertion.
+  auto* buffer = device_->newBuffer(capacity, resource_options);
+  if (!buffer) return Cause::allocation_failed;
+  if (buffer->length() != capacity) { buffer->release(); return Cause::capacity; }
+  output.allocator = this;
+  output.buffer = Buffer{static_cast<void*>(buffer)};
+  output.capacity = capacity;
+  residency_set_.insert_prepared(buffer, output.residency);
+  ++num_resources_;
+  active_memory_ += capacity;
+  peak_memory_ = std::max(peak_memory_, active_memory_);
+  return Cause::success;
+}
+void MetalAllocator::free_prepared_input(allocator::PreparedInputAllocation& input) noexcept {
+  auto* buffer = static_cast<MTL::Buffer*>(input.buffer.ptr());
+  if (!buffer) return;
+  {
+    std::lock_guard<std::mutex> guard(mutex_);
+    active_memory_ -= input.capacity;
+    --num_resources_;
+    residency_set_.erase_prepared(input.residency);
+  }
+  // Direct retained-object release; no library-owned autorelease-pool allocation.
+  buffer->release();
+  input.buffer = Buffer{nullptr};
+}
