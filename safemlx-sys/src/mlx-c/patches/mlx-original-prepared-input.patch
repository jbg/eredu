+void ResidencySet::insert_prepared(
+    MTL::Allocation* value, allocator::PreparedInputResidency& node) noexcept {
+  node.allocation = value;
+  node.previous = nullptr;
+  node.next = prepared_;
+  if (prepared_) prepared_->previous = &node;
+  prepared_ = &node;
+  node.installed = true;
+  if (wired_set_ && wired_set_->allocatedSize() <= capacity_ &&
+      value->allocatedSize() <= capacity_ - wired_set_->allocatedSize()) {
+    wired_set_->addAllocation(value);
+    wired_set_->commit();
+    node.wired = true;
+  }
+}
+void ResidencySet::erase_prepared(allocator::PreparedInputResidency& node) noexcept {
+  if (!node.installed) return;
+  if (node.wired) {
+    wired_set_->removeAllocation(static_cast<MTL::Allocation*>(node.allocation));
+    wired_set_->commit();
+  }
+  if (node.previous) node.previous->next = node.next;
+  else prepared_ = node.next;
+  if (node.next) node.next->previous = node.previous;
+  node = {};
+}
