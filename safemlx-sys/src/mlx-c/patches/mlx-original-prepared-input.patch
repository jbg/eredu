+namespace mlx::core {
+namespace {
+using Cause = allocator::PreparedInputCause;
+using Quota = submission::GraphQuota;
+bool add(size_t a, size_t b, size_t& out) noexcept {
+  if (a > std::numeric_limits<size_t>::max() - b) return false;
+  out = a + b; return true;
+}
+bool multiply(size_t a, size_t b, size_t& out) noexcept {
+  if (b && a > std::numeric_limits<size_t>::max() / b) return false;
+  out = a * b; return true;
+}
+struct Construction {
+  Quota::Request requests[8];
+  size_t count{0};
+  PreparedInputSlotLayout layout;
+  uint64_t generation{0};
+  void* memory{nullptr};
+  allocator::PreparedInputAllocation* backing{nullptr};
+  size_t maximum{0};
+  Cause cause{Cause::invalid};
+};
+struct FinishBlocks {
+  Quota* quota;
+  ~FinishBlocks() { quota->finish_blocks(); }
+};
+struct Incoming {
+  allocator::PreparedInputAllocation* backing;
+  ~Incoming() { if (backing) backing->destroy(); }
+};
+}
+
+void allocator::PreparedInputAllocation::destroy() noexcept {
+  auto* original_quota = quota;
+  if (allocator) allocator->free_prepared_input(*this);
+  this->~PreparedInputAllocation();
+  original_quota->deallocate(this, sizeof(PreparedInputAllocation), alignof(PreparedInputAllocation));
+}
+
+bool PreparedInputLeaf::requests(size_t rank, Quota::Request* out, size_t& count) noexcept {
+#ifndef _LIBCPP_VERSION
+  // No guessed standard-library control layout for another native ABI.
+  return false;
+#else
+  using DescAllocator = submission::GraphAllocator<array::ArrayDesc>;
+  using DescControl = std::__shared_ptr_pointer<array::ArrayDesc*, array::RetireDescriptor, DescAllocator>;
+  using DataAllocator = submission::GraphAllocator<array::Data>;
+  using DataControl = std::__shared_ptr_emplace<array::Data, DataAllocator>;
+  const Quota::Request fixed[] = {
+    {sizeof(PreparedInputLeaf), alignof(PreparedInputLeaf)},
+    {sizeof(allocator::PreparedInputAllocation), alignof(allocator::PreparedInputAllocation)},
+    {sizeof(array::ArrayDesc), alignof(array::ArrayDesc)},
+    {sizeof(DescControl), alignof(DescControl)},
+    {sizeof(DataControl), alignof(DataControl)},
+  };
+  count = 0;
+  for (const auto& request : fixed) out[count++] = request;
+  if (rank > 10) {
+    // Exact first-growth rule of Shape/Strides SmallVector<...,10>.
+    const auto capacity = std::max(rank, size_t{20});
+    size_t shape_bytes, stride_bytes;
+    if (!multiply(capacity, sizeof(Shape::value_type), shape_bytes) ||
+        !multiply(capacity, sizeof(Strides::value_type), stride_bytes)) return false;
+    out[count++] = {shape_bytes, alignof(Shape::value_type)};
+    out[count++] = {stride_bytes, alignof(Strides::value_type)};
+  }
+  return true;
+#endif
+}
+
+bool PreparedInputLeaf::layout(const allocator::PreparedInputFacts& facts,
+    const PreparedInputSource& source, PreparedInputSlotLayout& out) noexcept {
+  if (!source.shape || !source.rank || source.rank > static_cast<size_t>(INT_MAX) ||
+      source.kind > 2 || !facts.page_size || (facts.page_size & (facts.page_size - 1))) return false;
+  size_t elements = 1;
+  for (size_t i = 0; i < source.rank; ++i) {
+    if (!source.shape[i] || source.shape[i] > static_cast<size_t>(INT_MAX) ||
+        !multiply(elements, source.shape[i], elements)) return false;
+  }
+  if (elements != source.elements) return false;
+  size_t bytes, rounded;
+  if (!multiply(elements, size_t{4}, bytes) || bytes > static_cast<size_t>(PTRDIFF_MAX)) return false;
+  if (facts.kind == allocator::HostTransferStorageKind::cpu) {
+    if (!add(bytes, sizeof(size_t), bytes)) return false;
+  } else if (facts.kind != allocator::HostTransferStorageKind::metal_shared) return false;
+  if (!add(bytes, facts.page_size - 1, rounded)) return false;
+  rounded &= ~(facts.page_size - 1);
+  if (rounded > facts.maximum) return false;
+  Construction c;
+  if (!requests(source.rank, c.requests, c.count)) return false;
+  size_t metadata = 0;
+  for (size_t i = 0; i < c.count; ++i) {
+    size_t extent;
+    if (!Quota::allocation_extent(c.requests[i].bytes, c.requests[i].alignment, extent) ||
+        !add(metadata, extent, metadata)) return false;
+  }
+  out = {metadata, rounded,
+      sizeof(Construction) + sizeof(FinishBlocks) + sizeof(Incoming) + sizeof(Shape) +
+      sizeof(submission::GraphAllocator<array::ArrayDesc>) + sizeof(std::shared_ptr<array::ArrayDesc>) +
+      sizeof(std::shared_ptr<array::Data>) + sizeof(array) + sizeof(PreparedInputSource) +
+      sizeof(allocator::PreparedInputFacts) + sizeof(size_t) * 5 + facts.controls};
+  return true;
+}
+
+Cause PreparedInputLeaf::create(allocator::Allocator& allocator,
+    const allocator::PreparedInputFacts& facts, Quota* quota,
+    const PreparedInputSource& source, PreparedInputLeaf*& output) noexcept {
+  Construction c;
+  if (output || !quota || !source.data || !layout(facts, source, c.layout) ||
+      !requests(source.rank, c.requests, c.count)) return Cause::invalid;
+  if (!quota->prepare_blocks(c.requests, c.count)) return Cause::capacity;
+  FinishBlocks finish{quota};
+  c.generation = next_allocation_generation();
+  if (!c.generation) return Cause::identity_exhausted;
+  c.memory = quota->allocate(sizeof(allocator::PreparedInputAllocation), alignof(allocator::PreparedInputAllocation));
+  c.backing = ::new (c.memory) allocator::PreparedInputAllocation{};
+  c.backing->quota = quota;
+  Incoming incoming{c.backing};
+  c.cause = allocator.allocate_prepared_input(source.elements * size_t{4}, *c.backing);
+  if (c.cause != Cause::success) return c.cause;
+  if (c.backing->capacity != c.layout.backing_bytes) std::terminate();
+  Shape shape(source.rank, Shape::allocator_type{quota});
+  for (size_t i = 0; i < source.rank; ++i) {
+    shape[i] = static_cast<int>(source.shape[i]);
+    c.maximum = std::max(c.maximum, source.shape[i]);
+  }
+  const Dtype dtype = source.kind == 0 ? uint32 : source.kind == 1 ? int32 : float32;
+  submission::GraphAllocator<array::ArrayDesc> descriptor_allocator(quota);
+  auto* memory = descriptor_allocator.allocate(1);
+  auto* descriptor = ::new (memory) array::ArrayDesc(std::move(shape), dtype, quota);
+  descriptor->allocation_quota = quota;
+  std::shared_ptr<array::ArrayDesc> owned(descriptor, array::RetireDescriptor{}, descriptor_allocator);
+  owned->data = std::allocate_shared<array::Data>(
+      submission::GraphAllocator<array::Data>{quota}, c.backing, c.generation);
+  incoming.backing = nullptr;
+  owned->data_size = source.elements;
+  owned->flags = {true, true, source.elements <= 1 || source.elements == c.maximum};
+  void* destination = c.backing->buffer.raw_ptr();
+  if (source.kind == 0)
+    std::copy_n(static_cast<const uint32_t*>(source.data), source.elements, static_cast<uint32_t*>(destination));
+  else if (source.kind == 1)
+    std::copy_n(static_cast<const int32_t*>(source.data), source.elements, static_cast<int32_t*>(destination));
+  else
+    std::copy_n(static_cast<const float*>(source.data), source.elements, static_cast<float*>(destination));
+  c.memory = quota->allocate(sizeof(PreparedInputLeaf), alignof(PreparedInputLeaf));
+  output = ::new (c.memory) PreparedInputLeaf(array(std::move(owned)), quota);
+  return Cause::success;
+}
+void PreparedInputLeaf::destroy() noexcept {
+  auto* quota = quota_;
+  this->~PreparedInputLeaf();
+  quota->deallocate(this, sizeof(PreparedInputLeaf), alignof(PreparedInputLeaf));
+}
+} // namespace mlx::core
