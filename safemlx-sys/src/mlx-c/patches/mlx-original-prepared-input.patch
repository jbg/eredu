+  std::lock_guard<std::mutex> guard(mutex_);
+  facts = {page, std::numeric_limits<size_t>::max(), HostTransferStorageKind::cpu,
+      sizeof(std::lock_guard<std::mutex>) + sizeof(void*) + sizeof(size_t) * 3};
+  return true;
+}
+PreparedInputCause CommonAllocator::allocate_prepared_input(
+    size_t bytes, PreparedInputAllocation& output) noexcept {
+  if (!bytes || bytes > std::numeric_limits<size_t>::max() - sizeof(size_t) -
+          (host_transfer_page_size() - 1)) return PreparedInputCause::invalid;
+  const auto capacity = host_transfer_page_size() *
+      ((bytes + sizeof(size_t) + host_transfer_page_size() - 1) / host_transfer_page_size());
+  if (!mutex_.try_lock()) return PreparedInputCause::busy;
+  std::lock_guard<std::mutex> guard(mutex_, std::adopt_lock);
+  if (active_memory_ > std::numeric_limits<size_t>::max() - capacity)
+    return PreparedInputCause::capacity;
+#ifdef _WIN32
+  void* memory = VirtualAlloc(nullptr, capacity, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+#else
+  void* memory = ::mmap(nullptr, capacity, PROT_READ | PROT_WRITE,
+      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (memory == MAP_FAILED) memory = nullptr;
+#endif
+  if (!memory) return PreparedInputCause::allocation_failed;
+  *static_cast<size_t*>(memory) = capacity - sizeof(size_t);
+  output.buffer = Buffer{memory};
+  output.capacity = capacity;
+  output.allocator = this;
+  active_memory_ += capacity;
+  peak_memory_ = std::max(peak_memory_, active_memory_);
+  return PreparedInputCause::success;
+}
+void CommonAllocator::free_prepared_input(PreparedInputAllocation& input) noexcept {
+  if (!input.buffer.ptr()) return;
+  { std::lock_guard<std::mutex> guard(mutex_); active_memory_ -= input.capacity; }
+  free_host_transfer_pages(input.buffer.ptr(), input.capacity);
+  input.buffer = Buffer{nullptr};
