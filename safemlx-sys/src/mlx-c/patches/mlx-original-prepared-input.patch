+#pragma once
+#include "mlx/array.h"
+#include "mlx/graph_quota.h"
+
+namespace mlx::core {
+struct PreparedInputSlotLayout {
+  size_t metadata_bytes{0};
+  size_t backing_bytes{0};
+  size_t controls{0};
+};
+// Borrowed validated source input; no callback, erased owner or arbitrary array.
+struct PreparedInputSource {
+  const void* data;
+  const size_t* shape;
+  size_t rank;
+  size_t elements;
+  unsigned kind; // 0 U32, 1 I32, 2 F32
+};
+class MLX_API PreparedInputLeaf final {
+ public:
+  static bool layout(const allocator::PreparedInputFacts&, const PreparedInputSource&,
+      PreparedInputSlotLayout&) noexcept;
+  static allocator::PreparedInputCause create(allocator::Allocator&,
+      const allocator::PreparedInputFacts&, submission::GraphQuota*,
+      const PreparedInputSource&, PreparedInputLeaf*&) noexcept;
+  void destroy() noexcept;
+  const array& value() const noexcept { return value_; }
+ private:
+  PreparedInputLeaf(array&& value, submission::GraphQuota* quota) noexcept
+      : value_(std::move(value)), quota_(quota) {}
+  ~PreparedInputLeaf() = default;
+  static bool requests(size_t, submission::GraphQuota::Request*, size_t&) noexcept;
+  array value_;
+  submission::GraphQuota* quota_;
+};
+} // namespace mlx::core
