+// Copyright © 2026 Eredu contributors.
+#pragma once
+#include "mlx/api.h"
+#include "mlx/allocator.h"
+namespace mlx::core::submission {
+class Scope;
+// Retains only an actual configured scope; no allocator or execution authority
+// can be constructed from a stream, identity, or byte count.
+class MLX_API PhysicalFundingRef final {
+ public:
+  PhysicalFundingRef() noexcept = default;
+  PhysicalFundingRef(const PhysicalFundingRef&) noexcept;
+  PhysicalFundingRef(PhysicalFundingRef&&) noexcept;
+  PhysicalFundingRef& operator=(PhysicalFundingRef) noexcept;
+  ~PhysicalFundingRef();
+  Scope* get() const noexcept { return scope_; }
+ private:
+  friend PhysicalFundingRef current_physical_funding() noexcept;
+  explicit PhysicalFundingRef(Scope*) noexcept;
+  Scope* scope_{nullptr};
+};
+MLX_API PhysicalFundingRef current_physical_funding() noexcept;
+struct PhysicalFundingObserver {
+  void* context{nullptr};
+  allocator::PhysicalBackingObserver callback{nullptr};
+};
+MLX_API PhysicalFundingObserver current_physical_observer() noexcept;
+class MLX_API PhysicalFundingWorkerGuard final {
+ public:
+  explicit PhysicalFundingWorkerGuard(const PhysicalFundingRef&) noexcept;
+  ~PhysicalFundingWorkerGuard();
+  PhysicalFundingWorkerGuard(const PhysicalFundingWorkerGuard&) = delete;
+ private:
+  Scope* previous_;
+};
+} // namespace mlx::core::submission
