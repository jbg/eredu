+bool Scope::bind_physical_observer(void* context, allocator::PhysicalBackingObserver callback,
+    void (*release)(void*)) noexcept {
+  if (!context || !callback || !release || active_scope != this || !active_ ||
+      !on_owner_thread() || original_required_ || physical_callback_ ||
+      native_construction_started_ || activity_.load(std::memory_order_acquire) ||
+      pending_records_.load(std::memory_order_acquire)) return false;
+  physical_context_ = context;
+  physical_callback_ = callback;
+  physical_release_ = release;
+  return true;
+}
+PhysicalFundingObserver Scope::physical_observer() const noexcept {
+  for (auto* scope = this; scope; scope = scope->parent_) {
+    if (scope->physical_callback_) return {scope->physical_context_, scope->physical_callback_};
+  }
+  return {};
+}
+PhysicalFundingRef::PhysicalFundingRef(Scope* value) noexcept : scope_(value) {
+  if (scope_) scope_->retain();
+}
+PhysicalFundingRef::PhysicalFundingRef(const PhysicalFundingRef& other) noexcept
+    : PhysicalFundingRef(other.scope_) {}
+PhysicalFundingRef::PhysicalFundingRef(PhysicalFundingRef&& other) noexcept
+    : scope_(std::exchange(other.scope_, nullptr)) {}
+PhysicalFundingRef& PhysicalFundingRef::operator=(PhysicalFundingRef other) noexcept {
+  std::swap(scope_, other.scope_); return *this;
+}
+PhysicalFundingRef::~PhysicalFundingRef() { if (scope_) scope_->release(); }
+PhysicalFundingRef current_physical_funding() noexcept {
+  auto* scope = physical_worker_scope ? physical_worker_scope :
+      (active_dispatch ? active_dispatch->scope_ : active_scope);
+  if (!scope || !scope->physical_observer().callback) return {};
+  return PhysicalFundingRef(scope);
+}
+PhysicalFundingObserver current_physical_observer() noexcept {
+  auto* scope = physical_worker_scope ? physical_worker_scope :
+      (active_dispatch ? active_dispatch->scope_ : active_scope);
+  return scope ? scope->physical_observer() : PhysicalFundingObserver{};
+}
+PhysicalFundingWorkerGuard::PhysicalFundingWorkerGuard(const PhysicalFundingRef& funding) noexcept
+    : previous_(physical_worker_scope) { physical_worker_scope = funding.get(); }
+PhysicalFundingWorkerGuard::~PhysicalFundingWorkerGuard() { physical_worker_scope = previous_; }
 
