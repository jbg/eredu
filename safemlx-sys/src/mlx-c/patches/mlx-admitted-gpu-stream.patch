+// One concrete birth follows physical encoder, initial state and receipt
+// controls. The callback may retain state after publishing its idle frontier.
+struct EncoderBirth {
+  StreamRegistrationOwner owner;
+  std::atomic<size_t> references{1};
+  static_assert(std::atomic<size_t>::is_always_lock_free);
+  void retain() noexcept { references.fetch_add(1, std::memory_order_relaxed); }
+  void release() noexcept {
+    if (references.fetch_sub(1, std::memory_order_acq_rel) != 1) return;
+    const auto source = owner;
+    delete this;
+    if (source.value) source.retire(source.value);
+  }
+};
+struct ReleaseEncoderBirth {
+  void operator()(EncoderBirth* birth) const noexcept { birth->release(); }
+};
+struct EncoderBirthDeleter {
+  void operator()(CommandEncoder* encoder) const noexcept {
+    if (encoder->submission_idle()) delete encoder;
+    // Preserve the raw encoder and birth for ambiguous outstanding work, as the
+    // ordinary deleter does. The shared control may still physically retire.
+    else encoder->birth_->retain();
+  }
+};
+template <class T> struct EncoderBirthAllocator {
+  using value_type = T;
+  EncoderBirth* birth;
+  explicit EncoderBirthAllocator(EncoderBirth* value) noexcept : birth(value) {}
+  template <class U> EncoderBirthAllocator(const EncoderBirthAllocator<U>& other) noexcept
+      : birth(other.birth) {}
+  T* allocate(size_t n) {
+    auto* storage = std::allocator<T>{}.allocate(n);
+    birth->retain();
+    return storage;
+  }
+  void deallocate(T* p, size_t n) noexcept {
+    auto* source = birth;
+    std::allocator<T>{}.deallocate(p, n);
+    source->release(); // actual control storage precedes source retirement
+  }
+  template <class U> bool operator==(const EncoderBirthAllocator<U>& other) const noexcept {
+    return birth == other.birth;
+  }
+};
