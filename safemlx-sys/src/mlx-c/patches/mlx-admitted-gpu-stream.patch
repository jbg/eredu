+    // caller custody is not transferred into birth until control success.
+    std::shared_ptr<CommandEncoder> value(encoder, EncoderBirthDeleter{},
+        EncoderBirthAllocator<CommandEncoder>{birth.get()});
+    birth->owner = owner;
+    output = std::move(value);
+    birth.reset();
+    return Cause::success;
+  } catch (Cause cause) { return cause; }
