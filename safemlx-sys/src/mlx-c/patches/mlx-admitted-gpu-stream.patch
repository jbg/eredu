+GpuStreamRegistrationCause register_prepared_gpu_stream(
+    const GpuStreamRegistrationLayout& expected, uint64_t device_identity,
+    uint64_t scheduler_identity, StreamRegistrationOwner owner, Stream& output) noexcept {
+  using Cause = GpuStreamRegistrationCause;
+  if (!owner.value || !owner.retire || output.index != -1 ||
+      !submission::submission_context_empty()) return Cause::invalid;
+  const auto scheduler = scheduler::borrow_initialized_scheduler(scheduler_identity);
+  if (scheduler == scheduler::SchedulerInitializationCause::busy) return Cause::busy;
+  if (scheduler != scheduler::SchedulerInitializationCause::success) return Cause::identity_mismatch;
+  GpuStreamRegistrationLayout actual;
+  auto cause = gpu_stream_registration_layout(actual);
+  if (cause != Cause::success) return cause;
+  if (!(actual == expected)) return Cause::layout_changed;
+  try {
+    auto& registry = all_streams();
+    std::unique_lock lock(registry.mutex, std::try_to_lock);
+    if (!lock.owns_lock()) return Cause::busy;
+    const auto index = registry.next_index();
+    if (index < 0) return Cause::identity_exhausted;
+    std::unique_ptr<StreamEntry> entry(new (std::nothrow) StreamEntry(index, Device::gpu));
+    if (!entry) return Cause::allocation_failed;
+    cause = gpu::make_prepared_encoder(entry->value, device_identity, owner, entry->gpu_encoder);
+    if (cause != Cause::success) return cause;
+    // Ownership is now attached to the real encoder. Publication and output
+    // assignment cannot fail, and no map allocation follows Metal creation.
+    entry->owner = owner;
+    output = entry->value;
+    registry.append(entry.release());
+    return Cause::success;
+  } catch (...) { return Cause::construction_failed; }
+}
+namespace {
+GpuStreamRegistrationCause find_registered_encoder(
+    Stream stream, const void* expected_owner, std::shared_ptr<void>& output,
+    bool wait) noexcept {
+  using Cause = GpuStreamRegistrationCause;
+  if (output) return Cause::invalid;
+  if (stream.device != Device::gpu || stream.device.index != 0) return Cause::identity_mismatch;
+  auto* registry = published_registry.load(std::memory_order_acquire);
+  if (!registry) return Cause::identity_mismatch;
+  try {
+    std::shared_lock lock(registry->mutex, std::defer_lock);
+    if (wait) lock.lock();
+    else if (!lock.try_lock()) return Cause::busy;
+    auto* entry = registry->entries.find(stream.index);
+    if (!entry || entry->value != stream || !entry->owner.value || !entry->gpu_encoder ||
+        (expected_owner && entry->owner.value != expected_owner)) return Cause::identity_mismatch;
+    output = entry->gpu_encoder;
+    return Cause::success;
+  } catch (...) { return Cause::construction_failed; }
+}
+} // namespace
+GpuStreamRegistrationCause gpu::borrow_registered_encoder(
+    Stream stream, const void* expected_owner, std::shared_ptr<void>& output) noexcept {
+  return find_registered_encoder(stream, expected_owner, output, false);
+}
+std::shared_ptr<void> gpu::registered_encoder(Stream stream) noexcept {
+  std::shared_ptr<void> result;
+  // Ordinary use preserves the normal blocking directory loan. Original
+  // preflight uses borrow_registered_encoder and never waits on construction.
+  find_registered_encoder(stream, nullptr, result, true);
+  return result;
+}
