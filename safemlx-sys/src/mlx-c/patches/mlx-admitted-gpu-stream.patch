+GpuStreamRegistrationCause gpu_stream_registration_layout(
+    GpuStreamRegistrationLayout& output) noexcept {
+  using Cause = GpuStreamRegistrationCause;
+  StreamRegistrationLayout entry;
+  const auto base = stream_registration_layout(entry);
+  if (base != StreamRegistrationCause::success) return Cause::unsupported;
+  GpuStreamRegistrationLayout value;
+  const auto cause = gpu::encoder_registration_layout(value);
+  if (cause != Cause::success) return cause;
+  value.bytes[0] = entry.object_bytes;
+  value.alignments[0] = entry.object_alignment;
+  const auto controls = entry.controls + sizeof(value) + sizeof(entry) +
+      sizeof(std::shared_ptr<void>) * 3 + sizeof(StreamRegistrationOwner) +
+      sizeof(uint64_t) * 2 + sizeof(GpuStreamRegistrationCause) * 2 +
+      sizeof(StreamEntry*) * 2 + sizeof(std::shared_lock<std::shared_mutex>);
+  if (value.controls > SIZE_MAX - controls) return Cause::invalid;
+  value.controls += controls;
+  output = value;
