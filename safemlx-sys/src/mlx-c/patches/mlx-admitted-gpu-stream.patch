+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include "mlx/stream_registration.h"
+
+namespace mlx::core {
+enum class GpuStreamRegistrationCause : unsigned {
+  success = 0, unsupported = 1, invalid = 2, busy = 3,
+  allocation_failed = 4, queue_failed = 5, buffer_failed = 6,
+  identity_mismatch = 8, identity_exhausted = 9, construction_failed = 10,
+  layout_changed = 11,
+};
+struct GpuStreamRegistrationLayout {
+  // Entry, encoder, birth, encoder control, state control, initial receipt control.
+  size_t bytes[6]{}, alignments[6]{};
+  size_t controls{0};
+  size_t platform_queues{1}, platform_buffers{1}, autorelease_pools{1};
+  bool operator==(const GpuStreamRegistrationLayout&) const = default;
+};
+MLX_API GpuStreamRegistrationCause gpu_stream_registration_layout(
+    GpuStreamRegistrationLayout&) noexcept;
+MLX_API GpuStreamRegistrationCause register_prepared_gpu_stream(
+    const GpuStreamRegistrationLayout&, uint64_t device_identity,
+    uint64_t scheduler_identity, StreamRegistrationOwner, Stream&) noexcept;
+namespace gpu {
+// Owning adapter helpers; neither creates a registry nor promotes an old stream.
+MLX_API GpuStreamRegistrationCause encoder_registration_layout(
+    GpuStreamRegistrationLayout&) noexcept;
+MLX_API GpuStreamRegistrationCause make_prepared_encoder(Stream, uint64_t device_identity,
+    StreamRegistrationOwner, std::shared_ptr<void>&) noexcept;
+MLX_API GpuStreamRegistrationCause borrow_registered_encoder(
+    Stream, const void* expected_owner, std::shared_ptr<void>&) noexcept;
+MLX_API std::shared_ptr<void> registered_encoder(Stream) noexcept;
+}
+}
