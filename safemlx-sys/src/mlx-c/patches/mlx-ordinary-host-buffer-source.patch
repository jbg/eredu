+bool ordinary_host_buffer_observed_controls(
+    allocator::Allocator& selected, size_t rank, size_t& out) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106 && __cplusplus == 202002L
+  // Shape's existing inline constructor needs no heap destination here.
+  if (rank > Shape::inline_capacity) return false;
+  using Control = std::__shared_ptr_emplace<HostTransferStorage,
+      HostTransferControlAllocator<HostTransferStorage>>;
+  using Rebound = HostTransferControlAllocator<Control>;
+  const size_t fields[] = {
+      allocator::physical_backing_control_bytes(), Rebound::prefix,
+      sizeof(Control), selected.host_transfer_control_bytes(),
+      sizeof(HostTransferConstruction), sizeof(Rebound),
+      sizeof(std::shared_ptr<Control>), sizeof(size_t) * 4};
+  size_t total = 0;
+  for (auto field : fields) {
+    if (field > static_cast<size_t>(PTRDIFF_MAX) - total) return false;
+    total += field;
+  }
+  out = total;
+  return true;
+#else
+  return false;
+#endif
+}
