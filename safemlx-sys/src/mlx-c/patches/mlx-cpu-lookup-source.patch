diff --git a/mlx/backend/cpu/selection_storage.cpp b/mlx/backend/cpu/selection_storage.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/selection_storage.cpp
@@ -0,0 +1,98 @@
+#include "mlx/backend/cpu/selection_storage.h"
+#include "mlx/backend/cpu/copy.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <climits>
+#include <typeinfo>
+namespace mlx::core::cpu {
+namespace {
+bool canonical(Dtype dtype) noexcept {
+  return (dtype==bool_&&dtype.size()==sizeof(bool))||
+      (dtype==int32&&dtype.size()==4)||(dtype==uint32&&dtype.size()==4)||
+      (dtype==float32&&dtype.size()==4)||(dtype==bfloat16&&dtype.size()==2);
+}
+bool product(size_t a,size_t b,size_t& out) noexcept {
+  if(b&&a>size_t(PTRDIFF_MAX)/b)return false;out=a*b;return true;
+}
+bool add(size_t& total,size_t value) noexcept {
+  if(value>size_t(PTRDIFF_MAX)-total)return false;total+=value;return true;
+}
+bool common(Dtype dtype,size_t rank,size_t elements) noexcept {
+  size_t bytes=0;
+  return canonical(dtype)&&rank<=4&&elements&&elements<=size_t(INT_MAX)&&product(elements,dtype.size(),bytes);
+}
+bool shape(const array& input,size_t& elements) noexcept {
+  if(input.ndim()>4||input.strides().size()!=input.ndim())return false;
+  elements=1;
+  for(int extent:input.shape())if(extent<=0||!product(elements,size_t(extent),elements))return false;
+  return elements==input.size()&&elements<=size_t(INT_MAX);
+}
+bool row(const array& input,size_t elements) noexcept {
+  if(!input.flags().row_contiguous||input.data_size()!=elements)return false;
+  size_t stride=1;
+  for(size_t axis=input.ndim();axis--;) {
+    if(input.strides()[axis]<0||(input.shape(axis)>1&&size_t(input.strides()[axis])!=stride)||
+        !product(stride,size_t(input.shape(axis)),stride))return false;
+  }
+  return stride==elements;
+}
+}
+bool is_selection_eval_primitive(const array& output) noexcept {
+  return output.has_primitive()&&output.primitive().stream().device==Device::cpu&&
+      (typeid(output.primitive())==typeid(Select)||typeid(output.primitive())==typeid(Full));
+}
+bool select_eval_layout(Dtype dtype,size_t rank,size_t elements,bool tracer,CopyEvalStorage& out) noexcept {
+  if(!common(dtype,rank,elements))return false;
+  EvalDispatchStorage dispatch;SingleOutputEvalStorage common;
+  if(!select_dispatch_storage(rank,dispatch)||!single_output_eval_layout(rank,3,tracer,&dispatch,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  const size_t controls=sizeof(dtype)+sizeof(rank)+sizeof(elements)+sizeof(tracer)+sizeof(out)+
+      sizeof(dispatch)+sizeof(common)+sizeof(value)+sizeof(const array*)*5+sizeof(size_t)*14+
+      sizeof(int)*2+sizeof(bool)*4+sizeof(Dtype)*3+sizeof(submission::FixedEvalPrologueGuard*)+
+      sizeof(submission::Record*)+sizeof(submission::GraphQuota*)+
+      sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls))return false;
+  out=value;return true;
+}
+bool scalar_full_eval_layout(Dtype dtype,size_t rank,size_t elements,bool tracer,CopyEvalStorage& out) noexcept {
+  if(!common(dtype,rank,elements))return false;
+  CopyEvalStorage value;
+  if(!copy_eval_layout(rank,1,true,tracer,value))return false;
+  const size_t controls=sizeof(dtype)+sizeof(rank)+sizeof(elements)+sizeof(tracer)+sizeof(out)+
+      sizeof(value)+sizeof(const array*)*3+sizeof(size_t)*12+sizeof(int)*2+sizeof(bool)*4+
+      sizeof(CopyType)+sizeof(Stream)+sizeof(submission::FixedEvalPrologueGuard*)+
+      sizeof(submission::Record*)+sizeof(submission::GraphQuota*)+
+      sizeof(submission::GraphConstructionContext)+sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls))return false;
+  out=value;return true;
+}
+bool selection_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_selection_eval_primitive(output)||!output.siblings().empty()||!canonical(output.dtype()))return false;
+  size_t elements=0;if(!shape(output,elements))return false;
+  const bool full=typeid(output.primitive())==typeid(Full);
+  if(output.inputs().size()!=(full?1:3))return false;
+  for(size_t i=0;i!=output.inputs().size();++i) {
+    const auto& input=output.inputs()[i];size_t actual=0;
+    if(input.shape()!=output.shape()||!shape(input,actual)||actual!=elements||
+        input.dtype()!=(!full&&i==0?bool_:output.dtype())||!canonical(input.dtype()))return false;
+    if(full) {
+      if(input.data_size()!=1)return false;
+      for(size_t axis=0;axis!=size_t(input.ndim());++axis)
+        if(input.strides()[axis]<0||(input.shape(axis)>1&&input.strides()[axis]!=0))return false;
+    } else if(!row(input,elements))return false;
+  }
+  return full?scalar_full_eval_layout(output.dtype(),output.ndim(),elements,output.is_tracer(),out):
+      select_eval_layout(output.dtype(),output.ndim(),elements,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_selection_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::selection_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
