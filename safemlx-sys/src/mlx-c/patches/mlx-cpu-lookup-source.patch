+namespace cpu {
+bool select_dispatch_storage(size_t rank,EvalDispatchStorage& out) noexcept {
+  if(rank>4)return false;
+  DispatchLayout task;WeakCopyStorage weak;
+  using Body=SelectTask<::mlx::core::detail::Select>;
+  if(!CommandEncoder::dispatch_layout<Body>(task)||!PreparedInputLeaf::weak_copy_storage(rank,weak))return false;
+  EvalDispatchStorage value{task.task_bytes,task.task_alignment,0,0};
+  const size_t controls[]={task.controls,weak.controls,weak.controls,weak.controls,weak.controls,
+      sizeof(value)+sizeof(out)+sizeof(rank)+sizeof(task)+sizeof(weak)+sizeof(Body)*2+
+      sizeof(array)*5+sizeof(TernaryOpType)*3+sizeof(Stream)+sizeof(CommandEncoder*)+
+      sizeof(::mlx::core::detail::Select)*2+sizeof(size_t)*8+sizeof(void*)*8+sizeof(bool)*5+sizeof(float)*4+
+      sizeof(std::function<allocator::Buffer(size_t)>)+sizeof(array::Flags)+sizeof(Strides)};
+  value.controls=sizeof(controls);
+  for(size_t control:controls) {
+    if(control>SIZE_MAX-value.controls)return false;value.controls+=control;
+  }
+  out=value;return true;
+}
