+template<class T> bool ordinary_items(OrdinaryControlPopulation& out,
+    size_t items, size_t occurrences = 1) noexcept {
+  if (items > SIZE_MAX / sizeof(T) || items > size_t(PTRDIFF_MAX)) return false;
+  return !items || append_ordinary_control(out, items * sizeof(T), alignof(T), occurrences);
+}
+template<class T> bool ordinary_deque(OrdinaryControlPopulation& out, size_t pushes) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106
+  if (!pushes) return true;
+  // Pinned libc++ deque's one-element push allocates at most one fixed block.
+  // Map capacity only grows geometrically and never shrinks during this worker.
+  // Counting one block per push is a conservative finite source allowance;
+  // actual block reuse is charged only once by the physical observer.
+  constexpr size_t block = std::__deque_block_size<T, ptrdiff_t>::value;
+  if (!ordinary_items<T>(out, block, pushes)) return false;
+  size_t capacity = 1;
+  for (;;) {
+    if (!ordinary_items<T*>(out, capacity)) return false;
+    if (capacity >= pushes) break;
+    if (capacity > SIZE_MAX / 2) return false;
+    capacity *= 2;
+  }
+  return true;
+#else
+  return false;
+#endif
+}
+template<class V> bool ordinary_hash(OrdinaryControlPopulation& out,
+    size_t nodes, size_t attempts) noexcept {
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION == 210106
+  using Value = std::__hash_value_type<uintptr_t, V>;
+  using Node = std::__hash_node<Value, void*>;
+  if (!ordinary_items<Node>(out, 1, attempts)) return false;
+  if (!nodes) return true;
+  // __node_insert_unique_prepare grows to next_prime(max(2*buckets+1,size))
+  // at load factor one. Bound every growth by the last possible request; the
+  // preceding capacity at a growth is less than the selected node population.
+  if (nodes > (SIZE_MAX - 1) / 2) return false;
+  size_t buckets;
+  try { buckets = std::__next_prime(2 * nodes + 1); } catch (...) { return false; }
+  size_t grows = 1, threshold = 2;
+  while (threshold < nodes) {
+    if (threshold > SIZE_MAX / 2 || grows == SIZE_MAX) return false;
+    threshold *= 2; ++grows;
+  }
+  return ordinary_items<void*>(out, buckets, grows);
+#else
+  return false;
+#endif
+}
+}
+bool ordinary_cpu_wait_control_layout(OrdinaryControlPopulation& out) noexcept {
+  CompletionWaitRecordLayout record;
+  EventDispatchControlLayout dispatch;
+  if (!completion_wait_record_layout(record) || !event_dispatch_control_layout(dispatch)) return false;
+  OrdinaryControlPopulation value;
+  if (!append_ordinary_control(value, record.object_bytes, record.object_alignment) ||
+      !append_ordinary_control(value, record.capture_bytes, record.capture_alignment) ||
+      !append_ordinary_control(value, record.stream_bytes, record.stream_alignment) ||
+      !append_ordinary_control(value, dispatch.cpu_wait_bytes, dispatch.cpu_wait_alignment)) return false;
+  out = value; return true;
+}
+bool ordinary_cpu_eval_control_layout(OrdinaryEvalPopulation p,
+    OrdinaryControlPopulation& out) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return false;
+#else
+  if (!p.roots || !p.arrays || !p.tape || p.tape > p.arrays ||
+      p.streams != 1 || p.outputs < p.tape ||
+      p.roots > p.edges || p.arrays > size_t(INT_MAX) ||
+      p.edges > size_t(INT_MAX) || p.tape > size_t(INT_MAX)) return false;
+  RecordFrontierStorageLayout base;
+  EventControlLayout event;
+  EventDispatchControlLayout dispatch;
+  EvalGraphLayout graph;
+  if (!Record::frontier_storage_layout(p.streams, p.outputs, base) ||
+      !event_control_layout(event) || !event_dispatch_control_layout(dispatch) ||
+      !eval_graph_layout(graph)) return false;
+  OrdinaryControlPopulation value;
+  if (!append_ordinary_control(value, sizeof(EvalSubmissionRecord), alignof(EvalSubmissionRecord))) return false;
+  // Captures clear between primitives. libc++ emplace growth doubles the
+  // capacity, preserving every prior allocation's actual simultaneous lifetime.
+  size_t captures = base.fixed.capture_slots;
+  for (;;) {
+    if (!ordinary_items<std::shared_ptr<array::Data>>(value, captures)) return false;
+    if (captures >= p.captures) break;
+    if (captures > SIZE_MAX / 2) return false;
+    captures *= 2;
+  }
+  if (!append_ordinary_control(value, base.fixed.stream_bytes, base.fixed.stream_alignment) ||
+      !append_ordinary_control(value, base.output_bytes, base.output_alignment) ||
+      !ordinary_items<EvaluationStream>(value, p.streams) ||
+      !ordinary_items<std::shared_ptr<Primitive>>(value, p.tape) ||
+      !ordinary_deque<array>(value, p.tape) ||
+      !ordinary_hash<int>(value, p.arrays, p.arrays) ||
+      !ordinary_hash<EvalFenceValue>(value, p.arrays, p.edges)) return false;
+  size_t dfs_pushes;
+  if (!ordinary_add(p.arrays, p.edges, dfs_pushes) ||
+      !ordinary_deque<EvalDfsEntry>(value, dfs_pushes) ||
+      !ordinary_items<std::__tree_node<Stream, void*>>(value, 1, p.tape)) return false;
+  // Synchronizer, descriptor and shared descriptor owner. The fourth query
+  // request is its Event, included with the per-stream Event population below.
+  for (size_t i = 0; i < 3; ++i)
+    if (!append_ordinary_control(value, graph.request_bytes[i], graph.request_alignments[i])) return false;
+  if (!ordinary_items<array>(value, p.roots)) return false;
+  size_t events, waits;
+  if (!ordinary_add(p.streams, p.streams, events) ||
+      !ordinary_add(p.edges, p.streams, waits) ||
+      !append_ordinary_control(value, event.shared_bytes, event.shared_alignment, events) ||
+      !append_ordinary_control(value, dispatch.cpu_signal_bytes, dispatch.cpu_signal_alignment, events) ||
+      !append_ordinary_control(value, dispatch.cpu_wait_bytes, dispatch.cpu_wait_alignment, waits) ||
+      (event.platform_events && events > SIZE_MAX / event.platform_events)) return false;
+  value.platform_events = events * event.platform_events;
+  out = value; return true;
+#endif
+}
+}
