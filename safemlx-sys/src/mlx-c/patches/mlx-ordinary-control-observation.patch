+namespace mlx::core::submission {
+namespace {
+struct OrdinaryControlHeader { allocator::PhysicalBacking* root; };
+size_t ordinary_alignment(size_t alignment) noexcept {
+  return std::max(alignment, alignof(OrdinaryControlHeader));
+}
+}
+bool ordinary_control_layout(size_t bytes, size_t alignment, OrdinaryControlLayout& out) noexcept {
+  if (!alignment || (alignment & (alignment - 1))) return false;
+  const auto selected = ordinary_alignment(alignment);
+  if (sizeof(OrdinaryControlHeader) > SIZE_MAX - (selected - 1)) return false;
+  const auto prefix = (sizeof(OrdinaryControlHeader) + selected - 1) & ~(selected - 1);
+  if (bytes > SIZE_MAX - prefix) return false;
+  const auto extent = prefix + bytes;
+  const auto frames = sizeof(OrdinaryControlLayout) + sizeof(allocator::PhysicalBackingOwner) +
+      sizeof(PhysicalFundingWorkerGuard) + sizeof(PhysicalFundingRef) + 5 * sizeof(size_t) +
+      2 * sizeof(void*);
+  if (extent > SIZE_MAX - frames || extent + frames > SIZE_MAX - allocator::physical_backing_control_bytes()) return false;
+  out = {extent, selected, extent + frames + allocator::physical_backing_control_bytes()};
+  return true;
+}
+void* allocate_ordinary_control(size_t bytes, size_t alignment, const PhysicalFundingRef& funding) {
+  if (!funding.get()) throw GraphQuotaError(GraphFailure::foreign_parent);
+  OrdinaryControlLayout layout;
+  if (!ordinary_control_layout(bytes, alignment, layout)) throw GraphQuotaError(GraphFailure::invalid_layout);
+  PhysicalFundingWorkerGuard source(funding);
+  allocator::PhysicalBackingOwner root(allocator::prepare_physical_backing(
+      0, allocator::MemoryPlacement{1, -1, 0}, layout.host_controls - allocator::physical_backing_control_bytes()));
+  auto* memory = static_cast<char*>(::operator new(layout.extent, std::align_val_t(layout.alignment)));
+  try {
+    root->pointer = memory;
+    allocator::publish_physical_backing(root.get());
+  } catch (...) {
+    ::operator delete(memory, std::align_val_t(layout.alignment));
+    throw;
+  }
+  ::new(memory) OrdinaryControlHeader{root.release()};
+  return memory + layout.extent - bytes;
+}
+void deallocate_ordinary_control(void* value, size_t alignment) noexcept {
+  const auto selected = ordinary_alignment(alignment);
+  const auto prefix = (sizeof(OrdinaryControlHeader) + selected - 1) & ~(selected - 1);
+  auto* memory = static_cast<char*>(value) - prefix;
+  auto* root = reinterpret_cast<OrdinaryControlHeader*>(memory)->root;
+  ::operator delete(memory, std::align_val_t(selected));
+  allocator::destroy_physical_backing(root);
+}
+}
+
+namespace mlx::core::submission {
+bool append_ordinary_control(OrdinaryControlPopulation& out, size_t bytes,
+    size_t alignment, size_t count) noexcept {
+  if (!count) return true;
+  OrdinaryControlLayout one{};
+  if (!ordinary_control_layout(bytes, alignment, one) ||
+      count > SIZE_MAX / one.host_controls ||
+      count * one.host_controls > SIZE_MAX - out.observed_host_controls ||
+      count > SIZE_MAX - out.control_allocations) return false;
+  out.observed_host_controls += count * one.host_controls;
+  out.control_allocations += count;
+  return true;
+}
+bool ordinary_cpu_dispatch_envelope(size_t extents, OrdinaryControlPopulation& out) noexcept {
+  size_t minimum;
+  OrdinaryControlLayout overhead{};
+  if (!GraphQuota::allocation_extent(0, 1, minimum) || !minimum ||
+      !ordinary_control_layout(0, alignof(std::max_align_t), overhead)) return false;
+  const size_t attempts = extents / minimum;
+  if (attempts > SIZE_MAX / overhead.host_controls ||
+      attempts * overhead.host_controls > SIZE_MAX - extents) return false;
+  out = {extents + attempts * overhead.host_controls, attempts, 0};
+  return true;
+}
+bool ordinary_array_vector_control_layout(size_t elements, OrdinaryControlPopulation& out) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return false;
+#else
+  OrdinaryControlPopulation value;
+  if (elements) {
+    size_t capacity = 1;
+    for (;;) {
+      if (capacity > SIZE_MAX / sizeof(array) || capacity > size_t(PTRDIFF_MAX) ||
+          !append_ordinary_control(value, capacity * sizeof(array), alignof(array))) return false;
+      if (capacity >= elements) break;
+      if (capacity > SIZE_MAX / 2) return false;
+      capacity *= 2;
+    }
+  }
+  out = value; return true;
+#endif
+}
+bool ordinary_frontend_control_layout(size_t entries, size_t seeds,
+    size_t rank, size_t operands, OrdinaryControlPopulation& out) noexcept {
+  ResidentGraphLayout source;
+  if (!resident_graph_layout_with_shells(entries, seeds, rank, operands, 0, source)) return false;
+  OrdinaryControlPopulation value;
+  // Classes 0..5 are the shared native descriptor/control, primitive/seed Data,
+  // operand and rank-vector constructors. Classes 6/7 are original C-handle
+  // slots and original backing routing; neither executes in this source.
+  for (size_t i = 0; i < 6; ++i)
+    if (!append_ordinary_control(value, source.request_bytes[i],
+          source.request_alignments[i], source.request_counts[i])) return false;
+  out = value; return true;
+}
+}
