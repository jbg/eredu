@@ -0,0 +1,38 @@
+// Copyright © 2026 Eredu contributors.
+#pragma once
+#include <cstddef>
+#include "mlx/api.h"
+#include "mlx/physical_funding.h"
+namespace mlx::core::submission {
+struct OrdinaryControlLayout { size_t extent, alignment, host_controls; };
+// Exact one-allocation source. Container growth/occurrence populations belong
+// to the caller; this query supplies neither capacity nor execution authority.
+MLX_API bool ordinary_control_layout(size_t bytes, size_t alignment, OrdinaryControlLayout&) noexcept;
+MLX_API void* allocate_ordinary_control(size_t bytes, size_t alignment, const PhysicalFundingRef&);
+MLX_API void deallocate_ordinary_control(void*, size_t alignment) noexcept;
+}
+
+namespace mlx::core::submission {
+struct OrdinaryControlPopulation {
+  size_t observed_host_controls{0}, control_allocations{0}, platform_events{0};
+};
+MLX_API bool append_ordinary_control(OrdinaryControlPopulation&, size_t bytes,
+    size_t alignment, size_t count = 1) noexcept;
+// A conservative allowance from the selected SAME CPU worker's finite Graph
+// request sum. Original-only framing can overstate this ordinary allowance;
+// no original budget, observer, constructor or arena is created or authenticated.
+MLX_API bool ordinary_cpu_dispatch_envelope(size_t graph_extents,
+    OrdinaryControlPopulation&) noexcept;
+MLX_API bool ordinary_frontend_control_layout(size_t entries, size_t seeds,
+    size_t rank, size_t operands, OrdinaryControlPopulation&) noexcept;
+MLX_API bool ordinary_array_vector_control_layout(size_t elements,
+    OrdinaryControlPopulation&) noexcept;
+struct OrdinaryEvalPopulation {
+  size_t roots, arrays, tape, edges, outputs, streams, captures;
+};
+// Core CPU Eval only. Caller C shells, backend workers, payload backing and
+// platform-private event overhead remain separate source contributions.
+MLX_API bool ordinary_cpu_eval_control_layout(OrdinaryEvalPopulation,
+    OrdinaryControlPopulation&) noexcept;
+MLX_API bool ordinary_cpu_wait_control_layout(OrdinaryControlPopulation&) noexcept;
+}
