+#pragma once
+#include "mlx/backend/cpu/copy_storage.h"
+
+namespace mlx::core::cpu {
+// Selected F32 grouped matrix product through the existing SIMD tile worker.
+// These scalar facts grant no index, array, native bank or completion authority.
+MLX_API bool tiled_gather_mm_eval_layout(size_t lhs_rank, size_t rhs_rank,
+    size_t index_rank, size_t m, size_t n, size_t k, size_t batches,
+    bool tracer, CopyEvalStorage&) noexcept;
+MLX_API bool is_tiled_gather_mm_eval_primitive(const array&) noexcept;
+MLX_API bool tiled_gather_mm_eval_storage(const array&, CopyEvalStorage&) noexcept;
+void eval_tiled_gather_mm(const ArrayVector&, array&, Stream);
+} // namespace mlx::core::cpu
diff --git a/mlx/backend/cpu/gather_mm_storage.cpp b/mlx/backend/cpu/gather_mm_storage.cpp
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/gather_mm_storage.cpp
@@ -0,0 +1,182 @@
+#include "mlx/backend/cpu/gather_mm_storage.h"
+#include "mlx/backend/cpu/encoder.h"
+#include "mlx/backend/cpu/gemms/simd_gemm.h"
+#include "mlx/backend/cpu/matmul_storage.h"
+#include "mlx/primitives.h"
+#include "mlx/submission.h"
+#include <climits>
+#include <typeinfo>
+
+namespace mlx::core::cpu {
+namespace {
+bool product(size_t a, size_t b, size_t& out) noexcept {
+  if (b && a > size_t(PTRDIFF_MAX) / b) return false;
+  out = a * b; return true;
+}
+bool add(size_t& out, size_t value) noexcept {
+  if (value > size_t(PTRDIFF_MAX) - out) return false;
+  out += value; return true;
+}
+bool selected(CpuMatmulKernel kernel) noexcept {
+  return kernel == CpuMatmulKernel::Float32Tiles ||
+      kernel == CpuMatmulKernel::Float32AndFloat16Tiles;
+}
+bool readable(const array& value) noexcept {
+  if (value.ndim() > 5 || value.strides().size() != value.ndim()) return false;
+  size_t span = 1, elements = 1, delta = 0, bytes = 0;
+  for (size_t i = 0; i != size_t(value.ndim()); ++i) {
+    if (value.shape(i) <= 0 || value.strides()[i] < 0 ||
+        !product(elements, size_t(value.shape(i)), elements) ||
+        !product(size_t(value.shape(i) - 1), size_t(value.strides()[i]), delta) ||
+        !add(span, delta)) return false;
+  }
+  return elements == value.size() && elements <= size_t(INT_MAX) &&
+      span <= value.data_size() && product(span, value.itemsize(), bytes);
+}
+bool matrix(const array& value, bool& transposed, size_t& batches) noexcept {
+  const size_t rank = value.ndim();
+  if (rank < 2 || rank > 5 || value.dtype() != float32 || !readable(value)) return false;
+  const auto row = value.strides()[rank - 2], col = value.strides()[rank - 1];
+  if (row == value.shape(-1) && col == 1) transposed = false;
+  else if (row == 1 && col == value.shape(-2)) transposed = true;
+  else return false;
+  batches = 1;
+  for (size_t i = 0; i + 2 < rank; ++i)
+    if (!product(batches, size_t(value.shape(i)), batches)) return false;
+  return true;
+}
+struct Geometry {
+  size_t m, n, k, batches, lhs_batches, rhs_batches;
+  bool lhs_transposed, rhs_transposed;
+};
+bool geometry(const array& output, Geometry& value) noexcept {
+  if (!is_tiled_gather_mm_eval_primitive(output) || output.inputs().size() != 4 ||
+      !output.siblings().empty()) return false;
+  const auto& inputs = output.inputs();
+  const auto& a = inputs[0]; const auto& b = inputs[1];
+  const auto& lhs = inputs[2]; const auto& rhs = inputs[3];
+  if (!matrix(a, value.lhs_transposed, value.lhs_batches) ||
+      !matrix(b, value.rhs_transposed, value.rhs_batches) ||
+      lhs.dtype() != uint32 || rhs.dtype() != uint32 ||
+      lhs.ndim() > 3 || lhs.shape() != rhs.shape() ||
+      !readable(lhs) || !readable(rhs) || output.ndim() != lhs.ndim() + 2 ||
+      a.shape(-1) != b.shape(-2) || output.shape(-2) != a.shape(-2) ||
+      output.shape(-1) != b.shape(-1)) return false;
+  value.m = a.shape(-2); value.n = b.shape(-1); value.k = a.shape(-1);
+  value.batches = lhs.size();
+  for (size_t i = 0; i < size_t(lhs.ndim()); ++i)
+    if (output.shape(i) != lhs.shape(i)) return false;
+  size_t elements = 0;
+  return product(value.m, value.n, elements) && product(elements, value.batches, elements) &&
+      elements == output.size();
+}
+// The actual Eval cleanup retains four input owners and the output through this task.
+// Shape/stride ranks remain inside their native inline capacity; no route IDs
+// are read on the submitting thread and no selected weight bank is expanded.
+struct GatherMmTask {
+  const float* lhs; const float* rhs; float* output;
+  const uint32_t* lhs_indices; const uint32_t* rhs_indices;
+  Geometry dimensions;
+  Shape lhs_shape, rhs_shape, lhs_index_shape, rhs_index_shape;
+  Strides lhs_strides, rhs_strides, lhs_index_strides, rhs_index_strides;
+  void operator()() {
+    for (size_t batch = 0; batch != dimensions.batches; ++batch) {
+      const auto a = lhs_indices[elem_to_loc(batch, lhs_index_shape, lhs_index_strides)];
+      const auto b = rhs_indices[elem_to_loc(batch, rhs_index_shape, rhs_index_strides)];
+      if (a >= dimensions.lhs_batches || b >= dimensions.rhs_batches)
+        throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+      simd_gemm<float, float>(lhs + elem_to_loc(a, lhs_shape, lhs_strides),
+          rhs + elem_to_loc(b, rhs_shape, rhs_strides),
+          output + batch * dimensions.m * dimensions.n,
+          dimensions.lhs_transposed, dimensions.rhs_transposed,
+          int(dimensions.m), int(dimensions.n), int(dimensions.k), 1.0f, 0.0f);
+    }
+  }
+};
+bool dispatch_layout(EvalDispatchStorage& out) noexcept {
+  DispatchLayout task;
+  if (!CommandEncoder::dispatch_layout<GatherMmTask>(task)) return false;
+  // Same fixed simd_gemm/load_block arrays, SIMD values and scalar transports
+  // as selected Matmul; only the surrounding indexed task is distinct.
+  const size_t controls = sizeof(EvalDispatchStorage) + sizeof(task) + sizeof(out) +
+      sizeof(GatherMmTask) * 2 + sizeof(float[16 * 16]) * 3 +
+      sizeof(simd::Simd<float, simd::max_size<float>>) * 4 +
+      sizeof(int) * 25 + sizeof(float) * 6 + sizeof(bool) * 4 +
+      sizeof(float*) * 9 + sizeof(size_t) * 4 + sizeof(uint32_t) * 2 +
+      sizeof(ldiv_t) + sizeof(long) * 2 + sizeof(Shape*) * 4 + sizeof(Strides*) * 4 +
+      sizeof(submission::GraphQuotaError) + sizeof(submission::GraphFailure);
+  if (task.controls > SIZE_MAX - controls) return false;
+  out = {task.task_bytes, task.task_alignment, 0, task.controls + controls};
+  return true;
+}
+} // namespace
+
+bool is_tiled_gather_mm_eval_primitive(const array& output) noexcept {
+  return output.has_primitive() && output.primitive().stream().device == Device::cpu &&
+      typeid(output.primitive()) == typeid(GatherMM) && output.dtype() == float32 &&
+      selected(static_cast<const GatherMM&>(output.primitive()).cpu_matmul());
+}
+bool tiled_gather_mm_eval_layout(size_t lhs_rank, size_t rhs_rank, size_t index_rank,
+    size_t m, size_t n, size_t k, size_t batches, bool tracer, CopyEvalStorage& out) noexcept {
+  TiledMatmulFacts facts;
+  if (lhs_rank < 2 || lhs_rank > 5 || rhs_rank < 2 || rhs_rank > 5 || index_rank > 3 ||
+      (!index_rank && batches != 1) || !m || !n || !k || !batches ||
+      m > size_t(INT_MAX) - 15 || n > size_t(INT_MAX) - 15 ||
+      Shape::inline_capacity < 5 || Strides::inline_capacity < 5 ||
+      !tiled_matmul_facts(facts)) return false;
+  size_t left = 0, right = 0, result = 0, bytes = 0;
+  if (!product(m, k, left) || !product(k, n, right) || !product(m, n, result) ||
+      !product(result, batches, result) || left > size_t(INT_MAX) ||
+      right > size_t(INT_MAX) || result > size_t(INT_MAX) || batches > size_t(INT_MAX) ||
+      !product(result, sizeof(float), bytes)) return false;
+  EvalDispatchStorage task; SingleOutputEvalStorage common;
+  if (!dispatch_layout(task) || !single_output_raw_task_layout(index_rank + 2, 4, tracer, task, common)) return false;
+  CopyEvalStorage value; static_cast<SingleOutputEvalStorage&>(value) = common; value.copy = true;
+  const size_t controls = sizeof(value) + sizeof(common) + sizeof(task) + sizeof(facts) +
+      sizeof(lhs_rank) + sizeof(rhs_rank) + sizeof(index_rank) + sizeof(m) + sizeof(n) +
+      sizeof(k) + sizeof(batches) + sizeof(tracer) + sizeof(out) + sizeof(size_t) * 17 +
+      sizeof(Geometry) * 2 + sizeof(bool) * 3 + sizeof(int64_t) * 2 + sizeof(const array*) * 11 +
+      sizeof(const ArrayVector*) + sizeof(Shape) * 4 + sizeof(Strides) * 4 + sizeof(Stream) +
+      sizeof(CpuMatmulKernel) * 2 + sizeof(const GatherMM*) + sizeof(CommandEncoder*) +
+      sizeof(submission::FixedEvalPrologueGuard*) + sizeof(submission::Record*) +
+      sizeof(submission::GraphQuota*) + sizeof(submission::GraphConstructionContext) + sizeof(submission::GraphFailure);
+  if (!add(value.named_control_bytes, controls) || !submission::GraphConstruction::complete_layout(value)) return false;
+  out = value; return true;
+}
+bool tiled_gather_mm_eval_storage(const array& output, CopyEvalStorage& out) noexcept {
+  Geometry value;
+  if (!geometry(output, value)) return false;
+  return tiled_gather_mm_eval_layout(output.inputs()[0].ndim(), output.inputs()[1].ndim(),
+      output.inputs()[2].ndim(), value.m, value.n, value.k, value.batches, output.is_tracer(), out);
+}
+void eval_tiled_gather_mm(const ArrayVector& inputs, array& output, Stream stream) {
+  Geometry value; TiledMatmulFacts facts;
+  if (!geometry(output, value) || !tiled_matmul_facts(facts) ||
+      value.m > size_t(INT_MAX) - 15 || value.n > size_t(INT_MAX) - 15 ||
+      value.k > size_t(INT_MAX) || output.size() > size_t(INT_MAX))
+    throw submission::GraphQuotaError(submission::GraphFailure::invalid_layout);
+  output.allocate_data(output.nbytes());
+  const auto& a = inputs[0]; const auto& b = inputs[1];
+  const auto& lhs = inputs[2]; const auto& rhs = inputs[3];
+  auto& encoder = get_command_encoder(stream);
+  for (const auto& input : inputs) encoder.set_input_array(input);
+  encoder.set_output_array(output);
+  encoder.dispatch(GatherMmTask{a.data<float>(), b.data<float>(), output.data<float>(),
+      lhs.data<uint32_t>(), rhs.data<uint32_t>(), value,
+      Shape(a.shape().begin(), a.shape().end() - 2), Shape(b.shape().begin(), b.shape().end() - 2),
+      lhs.shape(), rhs.shape(), Strides(a.strides().begin(), a.strides().end() - 2),
+      Strides(b.strides().begin(), b.strides().end() - 2), lhs.strides(), rhs.strides()});
+}
+} // namespace mlx::core::cpu
+
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_tiled_gather_mm_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record = guard.record(); auto* graph = record.graph_quota(); auto context = current_graph_construction_context();
+  if (out || !graph || !guard.cpu() || !context.scope || context.worker ||
+      context.dispatch != &record || current_graph_quota() != graph) return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if (!cpu::tiled_gather_mm_eval_storage(guard.current(), actual)) return GraphFailure::invalid_layout;
+  return create_layout(*graph, context.scope, &record, actual, out, true);
+}
+} // namespace mlx::core::submission
