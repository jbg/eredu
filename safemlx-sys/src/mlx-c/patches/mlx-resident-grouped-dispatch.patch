diff --git a/mlx/backend/metal/sort_dispatch.h b/mlx/backend/metal/sort_dispatch.h
new file mode 100644
index 00000000..f112e8f9
--- /dev/null
+++ b/mlx/backend/metal/sort_dispatch.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace mlx::core::metal {
+struct SortDispatchLayout {
+  int block_threads;
+  int values_per_thread;
+  int blocks;
+  size_t kernel_attempts;
+};
+// Shared with gpu_merge_sort: one block-sort, two kernels per merge level,
+// and the final stride-preserving copy for the multi-block branch.
+inline bool sort_dispatch_layout(size_t length, size_t element_bytes,
+    SortDispatchLayout& out) noexcept {
+  if (!length || length > size_t(std::numeric_limits<int>::max()) || !element_bytes)
+    return false;
+  constexpr size_t tn = 4;
+  const size_t potential = length / tn + (length % tn != 0);
+  size_t bn = potential > 256 ? 512 : potential > 128 ? 256 :
+      potential > 64 ? 128 : potential > 32 ? 64 : 32;
+  if (bn == 512 && element_bytes > 4) bn = 256;
+  const size_t per_block = bn * tn;
+  const size_t blocks = length / per_block + (length % per_block != 0);
+  size_t attempts = 1;
+  if (blocks > 1) {
+    attempts = 2;
+    for (size_t tiles = 1; tiles < blocks; tiles *= 2) attempts += 2;
+  }
+  out = {int(bn), int(tn), int(blocks), attempts};
+  return true;
+}
+} // namespace mlx::core::metal
