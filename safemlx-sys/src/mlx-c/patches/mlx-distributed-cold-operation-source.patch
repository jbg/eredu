+bool cpu_distributed_storage(const array& output,CpuDistributedStorage& out) noexcept {
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_VERSION != 210106 || __cplusplus != 202002L
+  return false;
+#else
+  Source selected;
+  if(!source(output,selected) || !output.siblings().empty())return false;
+  const auto& group=selected.primitive->group();
+  GroupStorageInventory inventory;
+  // No fresh-submission terminal check: this is an already accepted primitive.
+  // EmptyGroup identities emit no primitive and do not become Ring evidence.
+  if(!group.storage_inventory(inventory) || inventory.kind!=GroupStorageKind::ring)return false;
+  const int members=group.size(),rank=group.rank();
+  if(members<=1 || rank<0 || rank>=members)return false;
+  const bool receive=selected.operation==GroupWorkerOperation::recv;
+  const bool gather=selected.operation==GroupWorkerOperation::gather;
+  const size_t inputs=receive?0:1;
+  if(output.inputs().size()!=inputs)return false;
+  const auto& input=receive?output:output.inputs()[0];
+  if(output.dtype()!=input.dtype())return false;
+  size_t input_bytes,output_bytes;
+  if(!bytes(input,input_bytes) || !bytes(output,output_bytes))return false;
+  if(gather) {
+    size_t expected;
+    if(!multiply(input_bytes,size_t(members),expected) || expected!=output_bytes ||
+        output.ndim()!=(input.ndim()?input.ndim():1))return false;
+    if(input.ndim()) {
+      if(input.shape()[0]>INT_MAX/members || output.shape()[0]!=input.shape()[0]*members)return false;
+      for(size_t d=1;d<input.ndim();++d)if(input.shape()[d]!=output.shape()[d])return false;
+    } else if(output.shape()[0]!=members)return false;
+  } else if(input.shape()!=output.shape() || input_bytes!=output_bytes)return false;
+
+  return prepare_storage(group,input,selected.operation,selected.peer,output.ndim(),
+      input_bytes,output_bytes,output.is_tracer(),cpu_distributed_storage_inspection_controls(output),out);
 #endif
+}
+
+size_t cpu_distributed_source_inspection_controls(const Group& group) noexcept {
+  size_t controls=inspection_frames();
+  if(!add(controls,constructor_storage_inspection_controls()) ||
+      !add(controls,group.dispatch_storage_inspection_controls()) ||
+      !add(controls,group.worker_storage_inspection_controls()) ||
+      !add(controls,sizeof(GroupConstructorStorage)+sizeof(const Group*)+sizeof(const array*)+
+          sizeof(GroupWorkerOperation)+sizeof(int)+sizeof(size_t)*3+sizeof(bool)*2))return SIZE_MAX;
+  return controls;
+}
+bool cpu_distributed_source_storage(const Group& group,const array& input,
+    GroupWorkerOperation operation,int peer,CpuDistributedStorage& out) noexcept {
+  GroupConstructorStorage construction;
+  // The original constructor refuses tracer leaves. This is an actual source
+  // condition, not a caller-provided output shape or optional primitive recipe.
+  if(input.is_tracer() || !constructor_storage(group,input,operation,peer,construction) ||
+      construction.primitives!=1)return false;
+  size_t input_bytes,output_bytes;
+  if(!bytes(input,input_bytes) || !multiply(construction.output_elements,input.itemsize(),output_bytes))return false;
+  const size_t controls=cpu_distributed_source_inspection_controls(group);
+  if(controls==SIZE_MAX)return false;
+  return prepare_storage(group,input,operation,peer,construction.output_rank,
+      input_bytes,output_bytes,false,controls,out);
 }
