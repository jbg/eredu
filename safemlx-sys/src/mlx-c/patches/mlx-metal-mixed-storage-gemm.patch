+bool metal::use_nax_matmul(Dtype dtype) {
+  return metal::is_nax_available() && !issubdtype(dtype, complexfloating) &&
+      (env::enable_tf32() || dtype != float32);
+}
+
+// One source of truth for native SIMD split-K dispatch and its partial buffer.
+int metal::simd_gemm_split_k_partitions(int M, int N, int K, const mlx::core::Device& dev) {
+  auto& d = metal::device(dev);
+  const char arch = d.get_architecture().back();
+  const int threshold = (arch == 's' || arch == 'd') ? 2048 : 1024;
+  const int tm16 = (M + 15) / 16, tn16 = (N + 15) / 16, tk = K / 16;
+  if (int64_t(tm16) * tn16 > threshold || tk < 8 || K < std::max(M, N)) {
+    return 1;
+  }
+  const int tm32 = (M + 31) / 32, tn32 = (N + 31) / 32;
+  return std::min(std::max(2, next_power_of_2(tk / (tm32 * tn32))), 32);
+}
 
