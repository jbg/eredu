+  static bool dispatch_layout(DispatchLayout& out) noexcept {
+    using Bound = decltype(std::bind(std::declval<F>(), std::declval<Args>()...));
+    using Node = scheduler::TaskNode<Bound>;
+    DispatchLayout value{};
+    value.task_bytes = sizeof(Node);
