+    if (!scheduler::task_graph_extent<Bound>(value.graph_extent)) return false;
+    value.controls = sizeof(DispatchLayout) * 2 + sizeof(F) + sizeof(Bound) +
+        sizeof(scheduler::TaskContext) + sizeof(scheduler::TaskOwner) * 2 +
+        sizeof(submission::GraphAllocator<Node>) + sizeof(Stream) +
+        sizeof(int) * 2 + sizeof(bool) * 3 + sizeof(void*) * 3;
+    out = value;
+    return true;
+  }
