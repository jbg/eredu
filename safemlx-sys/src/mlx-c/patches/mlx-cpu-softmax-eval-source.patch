+namespace cpu {
+bool softmax_dispatch_storage(EvalDispatchStorage& out) noexcept {
+  DispatchLayout task;
+  if(!CommandEncoder::dispatch_layout<SoftmaxTask<float,float>>(task))return false;
+  constexpr int N=std::min(simd::max_size<float>,simd::max_size<float>);
+  const size_t controls=sizeof(EvalDispatchStorage)+sizeof(task)+sizeof(out)+
+      sizeof(SoftmaxTask<float,float>)*2+sizeof(float*)*4+sizeof(int)*7+
+      sizeof(size_t)*3+sizeof(float)*20+sizeof(simd::Simd<float,N>)*6+sizeof(bool)*2;
+  if(task.controls>SIZE_MAX-controls)return false;
+  out={task.task_bytes,task.task_alignment,0,task.controls+controls};return true;
+}
+}
 
