+  size_t iterator_extent=0;
+  if(!CommandEncoder::dispatch_layout<GatherTask>(task)||
+      !PreparedInputLeaf::weak_copy_storage(source_rank+index_rank,weak)||
+      !contiguous_iterator_layout(index_rank,index_iterator)||
+      !contiguous_iterator_layout(source_rank,source_iterator)||
+      !submission::GraphQuota::allocation_extent(sizeof(ContiguousIterator),
+          alignof(ContiguousIterator),iterator_extent))return false;
+  EvalDispatchStorage value{task.task_bytes,task.task_alignment,0,0};
+  const size_t extents[]={iterator_extent,index_iterator.graph_extent_sum,
+      source_iterator.graph_extent_sum};
+  for(size_t extent:extents) {
+    if(extent>SIZE_MAX-value.worker_graph_extents)return false;
+    value.worker_graph_extents+=extent;
+  }
+  const size_t controls[]={task.controls,weak.controls,weak.controls,weak.controls,
+      index_iterator.controls,source_iterator.controls,
+      sizeof(value)+sizeof(out)+sizeof(source_rank)+sizeof(index_rank)+sizeof(task)+
+      sizeof(weak)+sizeof(index_iterator)+sizeof(source_iterator)+sizeof(iterator_extent)+
+      sizeof(extents)+sizeof(GatherTask)*2+sizeof(ArrayVector)*2+sizeof(array)*3+
+      sizeof(submission::GraphVector<ContiguousIterator>)+
+      sizeof(submission::GraphAllocator<ContiguousIterator>)+
+      sizeof(submission::GraphAllocator<array>)+sizeof(ContiguousIterator)+
+      sizeof(Shape)*2+sizeof(AxisView)+sizeof(Stream)+sizeof(CommandEncoder*)+
+      sizeof(ArrayVector::const_iterator)*2+sizeof(size_t)*13+sizeof(int64_t)*3+
+      sizeof(int)*7+sizeof(bool)*2+sizeof(void*)*5+sizeof(Dtype)*2};
+  value.controls=sizeof(controls);
+  for(size_t control:controls) {
+    if(control>SIZE_MAX-value.controls)return false;value.controls+=control;
+  }
+  out=value;return true;
+}
