+bool product(size_t a,size_t b,size_t& out) noexcept {
+  if(b&&a>size_t(PTRDIFF_MAX)/b)return false;out=a*b;return true;
+}
+bool add(size_t& total,size_t value) noexcept {
+  if(value>size_t(PTRDIFF_MAX)-total)return false;total+=value;return true;
+}
+bool geometry(const array& input,size_t& elements) noexcept {
+  if(input.ndim()>4||input.strides().size()!=input.ndim())return false;
+  elements=1;size_t span=1,delta=0,bytes=0;
+  for(size_t axis=0;axis!=size_t(input.ndim());++axis) {
+    if(input.shape(axis)<=0||input.strides()[axis]<0||
+        !product(elements,size_t(input.shape(axis)),elements)||
+        !product(size_t(input.strides()[axis]),size_t(input.shape(axis)-1),delta)||
+        !add(span,delta))return false;
+  }
+  return elements==input.size()&&elements<=size_t(INT_MAX)&&
+      span<=input.data_size()&&product(span,size_t(input.itemsize()),bytes);
+}
+}
+bool is_gather_eval_primitive(const array& output) noexcept {
+  return output.has_primitive()&&output.primitive().stream().device==Device::cpu&&
+      typeid(output.primitive())==typeid(Gather);
+}
+bool gather_eval_layout(Dtype source,Dtype index,size_t source_rank,
+    size_t index_rank,size_t source_elements,size_t index_elements,
+    size_t slice_elements,bool tracer,CopyEvalStorage& out) noexcept {
+  size_t output_elements=0,bytes=0;
+  if(!((source==float32&&source.size()==4)||(source==bfloat16&&source.size()==2))||
+      !((index==uint32&&index.size()==4)||(index==int32&&index.size()==4))||
+      !source_rank||source_rank>4||index_rank>4-source_rank||
+      !source_elements||source_elements>size_t(INT_MAX)||
+      !index_elements||index_elements>size_t(INT_MAX)||(!index_rank&&index_elements!=1)||
+      !slice_elements||slice_elements>source_elements||source_elements%slice_elements||
+      !product(index_elements,slice_elements,output_elements)||output_elements>size_t(INT_MAX)||
+      !product(source_elements,source.size(),bytes)||
+      !product(index_elements,index.size(),bytes)||!product(output_elements,source.size(),bytes))return false;
+  EvalDispatchStorage dispatch;SingleOutputEvalStorage common;
+  if(!gather_dispatch_storage(source_rank,index_rank,dispatch)||
+      !single_output_eval_layout(source_rank+index_rank,2,tracer,&dispatch,common))return false;
+  CopyEvalStorage value;static_cast<SingleOutputEvalStorage&>(value)=common;value.copy=true;
+  // The one-index ArrayVector grows once. Its actual backing stays in the
+  // queued task until task death. Worker iterator storage is independently
+  // charged through dispatch.worker_graph_extents under that task's Graph loan.
+  value.request_bytes[9]=sizeof(array);value.request_alignments[9]=alignof(array);
+  value.request_counts[9]=1;
+  const size_t controls=sizeof(source)+sizeof(index)+sizeof(source_rank)+sizeof(index_rank)+
+      sizeof(source_elements)+sizeof(index_elements)+sizeof(slice_elements)+sizeof(tracer)+
+      sizeof(out)+sizeof(output_elements)+sizeof(bytes)+sizeof(dispatch)+sizeof(common)+sizeof(value)+
+      sizeof(const array*)*4+sizeof(const Gather*)+sizeof(const Shape*)*2+sizeof(Dtype)*2+
+      sizeof(size_t)*18+sizeof(bool)*3+sizeof(int)*3+
+      sizeof(submission::FixedEvalPrologueGuard*)+sizeof(submission::Record*)+
+      sizeof(submission::GraphQuota*)+sizeof(submission::GraphConstructionContext)+
+      sizeof(submission::GraphFailure);
+  if(!add(value.named_control_bytes,controls)||!submission::GraphConstruction::complete_layout(value))return false;
+  out=value;return true;
+}
+bool gather_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(!is_gather_eval_primitive(output)||!output.siblings().empty()||output.inputs().size()!=2)return false;
+  const auto& source=output.inputs()[0];const auto& index=output.inputs()[1];
+  const size_t source_rank=source.ndim(),index_rank=index.ndim();
+  const auto& primitive=static_cast<const Gather&>(output.primitive());
+  const auto& axes=primitive.axes_ref();const auto& slices=primitive.slice_sizes_ref();
+  size_t source_elements=0,index_elements=0,slice_elements=1,output_elements=0;
+  if(axes.size()!=1||!source_rank||source_rank>4||index_rank>4-source_rank||
+      axes[0]<0||size_t(axes[0])>=source_rank||slices.size()!=source_rank||
+      output.ndim()!=source_rank+index_rank||output.dtype()!=source.dtype()||
+      output.itemsize()!=source.itemsize()||!geometry(source,source_elements)||
+      !geometry(index,index_elements))return false;
+  for(size_t axis=0;axis!=index_rank;++axis)
+    if(output.shape(axis)!=index.shape(axis))return false;
+  for(size_t axis=0;axis!=source_rank;++axis) {
+    if(slices[axis]!=(axis==size_t(axes[0])?1:source.shape(axis))||
+        output.shape(index_rank+axis)!=slices[axis]||
+        !product(slice_elements,size_t(slices[axis]),slice_elements))return false;
+  }
+  if(!product(index_elements,slice_elements,output_elements)||output_elements!=output.size())return false;
+  return gather_eval_layout(source.dtype(),index.dtype(),source_rank,index_rank,
+      source_elements,index_elements,slice_elements,output.is_tracer(),out);
+}
+}
+namespace mlx::core::submission {
+GraphFailure GraphConstruction::create_cpu_gather_eval(const FixedEvalPrologueGuard& guard,
+    GraphConstruction*& out) noexcept {
+  auto& record=guard.record();auto* graph=record.graph_quota();auto context=current_graph_construction_context();
+  if(out||!graph||!guard.cpu()||!context.scope||context.worker||context.dispatch!=&record||current_graph_quota()!=graph)
+    return GraphFailure::foreign_parent;
+  cpu::CopyEvalStorage actual;
+  if(!cpu::gather_eval_storage(guard.current(),actual))return GraphFailure::invalid_layout;
+  return create_layout(*graph,context.scope,&record,actual,out,true);
+}
+}
