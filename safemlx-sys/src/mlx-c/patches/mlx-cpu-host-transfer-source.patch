+// Both host workers execute the existing General copy task. Store first
+// attaches its separately accepted Host allocation; load allocates one output.
+// The optional Contiguous before store is a distinct ordinary Eval.
+bool host_transfer_eval_layout(Dtype dtype,size_t rank,bool store,bool tracer,
+    CopyEvalStorage& out) noexcept {
+  if(rank==0||rank>5||(dtype!=float32&&dtype!=float16&&dtype!=bfloat16&&dtype!=uint32&&dtype!=int32))return false;
+  CopyEvalStorage value;
+  if(!copy_eval_layout(rank,1,true,tracer,value))return false;
+  if(store)value.backing_births=0;
+  const size_t controls=sizeof(dtype)+sizeof(rank)+sizeof(store)+sizeof(tracer)+
+      sizeof(out)+sizeof(value)+sizeof(const array*)*3+sizeof(array*)+
+      sizeof(CopyToHostTransfer*)+sizeof(CopyFromHostTransfer*)+
+      sizeof(HostTransferBuffer)+sizeof(CopyType)+sizeof(Stream)+sizeof(size_t)*3+
+      sizeof(Shape::const_iterator)+sizeof(bool)*2;
+  if(!add(value.named_control_bytes,controls))return false;
+  out=value;return true;
+}
+static bool host_transfer_eval_storage(const array& output,CopyEvalStorage& out) noexcept {
+  if(output.inputs().size()!=1)return false;
+  const auto& input=output.inputs()[0];
+  if(input.dtype()!=output.dtype()||input.shape()!=output.shape()||
+      input.ndim()<1||input.ndim()>5||!input.flags().row_contiguous||
+      input.size()==0||input.size()>size_t(INT_MAX)||input.data_size()<input.size())return false;
+  for(const auto dimension:input.shape())if(dimension<=0)return false;
+  const bool store=typeid(output.primitive())==typeid(CopyToHostTransfer);
+  // The load's completed leaf must still be the actual retained Host owner.
+  // Store destination identity is authenticated by copy_to_host_into before
+  // any graph construction; its private primitive retains that exact buffer.
+  if(!store&&!host_transfer_allocation_info(input))return false;
+  return host_transfer_eval_layout(input.dtype(),input.ndim(),store,output.is_tracer(),out);
+}
