+  auto& encoder = cpu::get_command_encoder(stream());
+  auto w = ensure_row_contiguous(inputs[0], encoder, stream());
+  auto& out = outputs[0];
+  out.allocate_data(out.nbytes());
+
+  auto& scales = outputs[1];
+  auto& biases = outputs[2];
+  scales.allocate_data(scales.nbytes());
+  biases.allocate_data(biases.nbytes());
+  encoder.set_input_array(w);
+  encoder.set_input_array(scales);
+  encoder.set_input_array(biases);
+  encoder.set_output_array(out);
+  encoder.dispatch(AffineQuantizeTask{
+      array::unsafe_weak_copy(w), array::unsafe_weak_copy(out),
+      array::unsafe_weak_copy(scales), array::unsafe_weak_copy(biases),
+      group_size_, bits_});
 }
 
