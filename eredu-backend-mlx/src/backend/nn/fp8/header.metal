float fp8_e4m3_to_float(uint8_t bits) { if ((bits & 127) == 127) return as_type<float>(0x7fc00000u); uint16_t v = uint16_t(bits & 127) << 7; half converted = as_type<half>(v); converted *= 256.0h; return (bits & 128) ? -float(converted) : float(converted);}
uint8_t float_to_fp8_e4m3(float value) { if (isnan(value)) return uint8_t(0x7f); uint sign = (as_type<uint>(value) >> 24) & 0x80u; float magnitude = min(abs(value), 448.0f); if (magnitude == 0.0f) return uint8_t(sign); uint code; if (magnitude < 0.015625f) {  int mantissa = int(rint(magnitude * 512.0f));  if (mantissa < 0) mantissa = 0;  code = mantissa >= 8 ? 8u : uint(mantissa); } else {  int exponent = int(floor(log2(magnitude)));  float base = exp2(float(exponent));  int mantissa = int(rint((magnitude / base - 1.0f) * 8.0f));  if (mantissa == 8) { exponent += 1; mantissa = 0; }  code = uint((exponent + 7) * 8 + mantissa);  if (code > 0x7eu) code = 0x7eu; } return uint8_t(sign | code);}
