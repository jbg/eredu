+impl<'o, 's: 'o> Planned<'o, 's> {
+    /// Actual semantic payload geometry; no caller-selected size authorizes it.
+    pub fn requirements(&self) -> MaterializationRequirements {
+        self.owner.payload
+    }
+    /// Actual retained capacities before payload construction.
