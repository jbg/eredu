+            || self.recipes.len() == self.recipes.capacity()
+        {
+            return Err(Cause::Capacity);
+        }
+        let end = start.checked_add(len).ok_or(Cause::Overflow)?;
+        if list && end > self.requirements.operands {
+            return Err(Cause::Capacity);
