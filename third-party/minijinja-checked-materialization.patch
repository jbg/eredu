+                Literal::Int(x) => Descriptor::Scalar(Scalar::U64(*x)),
+                Literal::Int128(x) => Descriptor::Scalar(Scalar::U128(*x)),
+                Literal::Float(x) => Descriptor::Scalar(Scalar::F64(*x)),
+                Literal::Text(x) => Descriptor::Text((*x).into()),
+            },
