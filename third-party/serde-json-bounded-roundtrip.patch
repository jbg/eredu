+/// Shared exact small-power worker, also used by the finite float Bigint.
+/// Unlike the large-power route this creates no temporary limb vectors.
+pub(crate) fn imul_pow5_iterative(x: &mut Vec<Limb>, n: u32) {
+    let powers = POW5_LIMB;
+    let step = powers.len() - 1;
+    let power = powers[step];
+    let mut n = n as usize;
+    while n >= step {
+        small::imul(x, power);
+        n -= step;
+    }
+    small::imul(x, powers[n]);
+}
