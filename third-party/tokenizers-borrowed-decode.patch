+/// Read-only view of the concrete model and added-token decoding vocabulary.
+///
+/// Creating or querying this view does not allocate. Enumeration visits model
+/// forward-map IDs followed by added reverse-map IDs, in unspecified order,
+/// retaining duplicates. It never traverses the dense extent up to a maximum ID.
+/// Borrowed lookup has the same added-first normalized-cache semantics as
+/// `Tokenizer::id_to_token`; special membership applies to that returned spelling.
+pub struct DecodeVocabulary<'a> {
+    model: &'a ModelWrapper,
+    added: &'a AddedVocabulary,
+}
+
+impl DecodeVocabulary<'_> {
+    /// Iterates model forward-map IDs followed by added reverse-map IDs.
+    /// Duplicates and unspecified map order are preserved. The iterator borrows
+    /// these maps directly; it allocates nothing and invokes no user callback.
+    pub fn ids(&self) -> impl Iterator<Item = u32> + '_ {
+        self.model
+            .decode_ids()
+            .chain(self.added.get_added_tokens_decoder().keys().copied())
+    }
+
+    /// Visits exactly the ID population of model `get_vocab(false)` and added
+    /// reverse entries. The caller's callback may have its own side effects.
+    pub fn visit_ids(&self, visitor: &mut dyn FnMut(u32)) {
+        self.model.visit_decode_ids(visitor);
+        for id in self.added.get_added_tokens_decoder().keys() {
+            visitor(*id);
+        }
+    }
+
+    /// Borrows the canonical decoding spelling, including normalized added tokens.
+    pub fn id_to_token(&self, id: u32) -> Option<&str> {
+        self.added
+            .decode_token_ref(id)
+            .or_else(|| self.model.decode_token_ref(id))
+    }
+
+    /// Tests actual added-vocabulary special-token membership by spelling.
+    pub fn is_special_token(&self, token: &str) -> bool {
+        self.added.is_special_token(token)
+    }
+}
+
+impl std::fmt::Debug for DecodeVocabulary<'_> {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("DecodeVocabulary")
+            .finish_non_exhaustive()
+    }
+}
+
 impl Tokenizer {
+    /// Borrows the concrete vocabulary used by decoding without cloning tokens,
+    /// maps or normalization caches. The view cannot mutate the tokenizer.
+    pub fn decode_vocabulary(&self) -> DecodeVocabulary<'_> {
+        DecodeVocabulary {
+            model: &self.0.model,
+            added: &self.0.added_vocabulary,
+        }
+    }
