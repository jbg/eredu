+            Kind::DuplicateField,
+        ),
+        (r#"{"type":"Unigram","vocab":{},"merges":[]}"#, Kind::NotBpe),
+        (r#"{"vocab":{}}"#, Kind::MissingField),
+        (
+            r#"{"vocab":{},"merges":[["a","b"],"a b"]}"#,
+            Kind::InvalidMerge,
+        ),
