+impl<'a> Iterator for MergeIter<'a> {
+    type Item = (&'a Pair, &'a (u32, u32));
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::Legacy(iter) => iter.next(),
+            Self::Packed(iter) => iter.next().map(|e| (&e.pair, &e.value)),
+        }
+    }
+}
