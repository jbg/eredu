+            Err(Error::RuntimeError(RuntimeError::WorkspaceInputBoundary))
+        ));
+        assert_eq!(storage_identity(&workspace), before);
+        assert_eq!(prepared_spans(&mut workspace, "éa"), spans(&ordinary, "éa"));
