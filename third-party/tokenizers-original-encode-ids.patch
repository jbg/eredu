+/// Private reusable destinations for the same BPE symbol and merge workers.
+pub(crate) struct BpeScratch {
+    word: Word,
+    queue: QuaternaryHeap<Merge>,
+    skip: Vec<Merge>,
+}
+impl BpeScratch {
+    pub(crate) fn new() -> Self {
+        Self {
+            word: Word::new(),
+            queue: QuaternaryHeap::new(),
+            skip: Vec::new(),
+        }
+    }
+    pub(crate) fn buffer_bytes(symbols: usize, merges: usize) -> Option<usize> {
+        let symbols = std::alloc::Layout::array::<Symbol>(symbols).ok()?.size();
+        let merges = std::alloc::Layout::array::<Merge>(merges).ok()?.size();
+        symbols.checked_add(merges)
+    }
+    pub(crate) fn reserve_symbols(
+        &mut self,
+        capacity: usize,
+    ) -> Result<(), std::collections::TryReserveError> {
+        self.word.symbols.try_reserve_exact(capacity)
+    }
+    pub(crate) fn reserve_merges(
+        &mut self,
+        capacity: usize,
+    ) -> Result<(), std::collections::TryReserveError> {
+        self.queue.try_reserve_exact(capacity)
+    }
+    pub(crate) fn capacities(&self) -> (usize, usize) {
+        (self.word.symbols.capacity(), self.queue.capacity())
+    }
+    pub(crate) fn encode(
+        &mut self,
+        model: &super::BPE,
+        input: &str,
+        ids: &mut Vec<u32>,
+    ) -> Result<(), MissingUnknown> {
+        self.word.symbols.clear();
+        self.queue.clear();
+        debug_assert!(self.skip.is_empty());
+        if input.is_empty() {
+            return Ok(());
+        }
+        if model.ignore_merges {
+            if let Some(id) = model.storage.id(input) {
+                ids.push(*id);
+                return Ok(());
+            }
+        }
+        model.fill_word(input, &mut self.word)?;
+        self.word
+            .merge_all_with(&model.storage, None, &mut self.queue, &mut self.skip);
+        ids.extend(self.word.get_chars_iter());
+        Ok(())
+    }
+}
+impl std::fmt::Debug for BpeScratch {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("BpeScratch")
+            .field("capacities", &self.capacities())
+            .finish_non_exhaustive()
     }
 }
 
