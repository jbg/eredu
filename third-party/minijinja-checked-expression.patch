+                Token::TemplateData(raw) => {
+                    rv.push(ast::Stmt::EmitRaw(Spanned::new(ast::EmitRaw { raw }, span)))
+                }
+                Token::VariableStart => {
+                    let expr = ok!(self.parse_expr());
+                    rv.push(ast::Stmt::EmitExpr(Spanned::new(
+                        ast::EmitExpr { expr },
+                        self.stream.expand_span(span),
+                    )));
