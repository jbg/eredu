+
+/// The ordinary trim argument is a set of Unicode scalar values, not a substring.
+/// Both storage adapters borrow that set; no temporary character vector is needed.
+pub(crate) fn character_trim_range(value: &str, chars: &str) -> std::ops::Range<usize> {
+    fn contains(chars: &str, character: char) -> bool {
+        for candidate in chars.chars() {
+            if candidate == character {
+                return true;
+            }
+        }
+        false
+    }
+    let mut start = value.len();
+    for (at, character) in value.char_indices() {
+        if !contains(chars, character) {
+            start = at;
+            break;
+        }
+    }
+    let mut end = start;
+    for (at, character) in value[start..].char_indices().rev() {
+        if !contains(chars, character) {
+            end = start + at + character.len_utf8();
+            break;
+        }
+    }
+    start..end
+}
+
+/// Actual borrowed range/member iterator and scalar controls, without a heap owner.
+pub(crate) fn character_trim_control_bytes() -> Option<usize> {
+    use std::{
+        iter::Rev,
+        mem::size_of,
+        str::{CharIndices, Chars},
+    };
+    [
+        size_of::<(&str, &str)>(),
+        size_of::<[usize; 3]>(),
+        size_of::<CharIndices<'_>>(),
+        size_of::<Rev<CharIndices<'_>>>(),
+        size_of::<[Option<(usize, char)>; 2]>(),
+        size_of::<(char, bool, std::ops::Range<usize>)>(),
+        // Nested membership worker's argument, iterator, item and result.
+        size_of::<(&str, char, Chars<'_>, Option<char>, char, bool)>(),
+    ]
+    .into_iter()
+    .try_fold(0usize, usize::checked_add)
 }
 
