+// Owning controls for the existing non-roundtrip numeric branch. Every parser
+// method is the ordinary method above; this query introduces no numeric engine.
+pub(crate) fn bounded_number_control_bytes() -> Option<usize> {
+    use core::mem::size_of;
+    let parts = [
+        size_of::<Deserializer<SliceRead<'static>>>(),
+        size_of::<SliceRead<'static>>(),
+        size_of::<&mut Deserializer<SliceRead<'static>>>(),
+        size_of::<ParserNumber>(),
+        size_of::<Result<ParserNumber>>(),
+        size_of::<crate::Number>(),
+        size_of::<Result<crate::Number>>(),
+        // parse_integer/parse_number: signs, digit/significand and signed result.
+        size_of::<(bool, u8, u8, u64, u64, i64)>(),
+        // parse_long_integer: sign, retained significand and skipped exponent.
+        size_of::<(bool, u64, i32)>(),
+        // parse_decimal: sign, significand, before/after/final exponents, digit.
+        size_of::<(bool, u64, i32, i32, i32, u8, u64)>(),
+        // parse_decimal_overflow retains its exact three scalar inputs.
+        size_of::<(bool, u64, i32)>(),
+        // parse_exponent: inputs, exponent sign/digits, zero and saturated sum.
+        size_of::<(bool, u64, i32, bool, u8, i32, i32, bool, i32)>(),
+        // f64_from_parts and exponent overflow use no scratch allocation.
+        size_of::<(bool, u64, i32, f64, Option<&'static f64>)>(),
+        size_of::<(bool, bool, bool)>(),
+        // Read/peek/end and syntax-error positioning/return transports.
+        size_of::<(Option<u8>, Result<Option<u8>>, Result<u8>, Result<()>)>(),
+        size_of::<(crate::read::Position, ErrorCode, crate::Error)>(),
+        size_of::<(&str, core::str::Bytes<'static>, usize, Option<usize>)>(),
+    ];
+    parts
+        .into_iter()
+        .try_fold(core::mem::size_of_val(&parts), usize::checked_add)
+}
