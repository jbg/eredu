+        Some((Token::Mul, _)) => ast::BinOpKind::Mul,
+        Some((Token::Div, _)) => ast::BinOpKind::Div,
+        Some((Token::FloorDiv, _)) => ast::BinOpKind::FloorDiv,
+        Some((Token::Mod, _)) => ast::BinOpKind::Rem,
