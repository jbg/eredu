+                }
+                _ => break,
+            };
+            if !matches!(op, ast::CompareOpKind::NotIn) {
+                ok!(self.stream.next());
+            }
+            ops.push(ast::CompareOp {
+                op,
+                expr: ok!(self.parse_math1()),
+            });
+        }
