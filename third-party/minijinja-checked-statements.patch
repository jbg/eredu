+                    ast::IfExpr {
+                        test_expr: expr2,
+                        true_expr: expr,
+                        false_expr: expr3,
+                    },
+                    self.stream.expand_span(span),
+                ));
+                span = self.stream.last_span();
+            } else {
+                break;
+            }
+        }
+        Ok(expr)
+    }
