+                    x.checked_mul(-1)
+                        .ok_or_else(|| Error::new(ErrorKind::InvalidOperation, "overflow"))
+                        .map(int_as_value)
+                } else {
+                    Err(Error::from(ErrorKind::InvalidOperation))
+                }
+            }
+        }
+    } else {
+        Err(Error::from(ErrorKind::InvalidOperation))
+    }
