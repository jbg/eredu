+                    } else {
+                        vec!["left"]
+                    }
+                );
+            }
+        }
+    }
+    for source in [
+        "0 and 3",
+        "false or 1",
+        "'λ' and 2",
+        "true and ''",
+        "'' or 'λ'",
+        "1 in 2",
+        "1 not in 2",
+    ] {
+        let expr = crate::compiler::parser::parse_expr(source).unwrap();
+        exact(expr.as_const(), reference::expression(&expr));
