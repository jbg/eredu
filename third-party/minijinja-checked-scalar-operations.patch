+        (Some(Pair::F64(a, b)), Some(old::ops::CoerceResult::F64(x, y))) => {
+            assert_eq!((a.to_bits(), b.to_bits()), (x.to_bits(), y.to_bits()))
+        }
+        _ => panic!("different coercion representation"),
