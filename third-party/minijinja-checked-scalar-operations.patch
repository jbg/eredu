+                    Logical::And => {
+                        if a && b {
+                            Selection::Right
+                        } else {
+                            Selection::False
+                        }
+                    }
+                    Logical::Or => {
+                        if a {
+                            Selection::Left
+                        } else {
+                            Selection::Right
+                        }
+                    }
+                };
+                assert_eq!(selected, expected);
+                assert_eq!(
+                    *calls.borrow(),
+                    if matches!(op, Logical::And) && a {
