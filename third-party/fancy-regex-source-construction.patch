+SourceRecipe { pattern: "'s|'t|'re|'ve|'m|'ll|'d| ?\\p{L}+| ?\\p{N}+| ?[^\\s\\p{L}\\p{N}]+|\\s+(?!\\S)|\\s+", syntax: SyntaxRecipe { unicode: true, case_insensitive: false, multi_line: false, dot_matches_new_line: false, crlf: false, line_terminator: 10, swap_greed: false, ignore_whitespace: false, utf8: true, nest_limit: 250, octal: false }, backtrack_limit: 1000000, body:
