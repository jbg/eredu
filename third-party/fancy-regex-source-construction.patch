+InsnRecipe::Jmp(42),
+InsnRecipe::Split(14, 16),
+InsnRecipe::Lit("'ve"),
+InsnRecipe::Jmp(42),
+InsnRecipe::Split(17, 19),
+InsnRecipe::Lit("'m"),
+InsnRecipe::Jmp(42),
+InsnRecipe::Split(20, 22),
+InsnRecipe::Lit("'ll"),
+InsnRecipe::Jmp(42),
+InsnRecipe::Split(23, 25),
+InsnRecipe::Lit("'d"),
+InsnRecipe::Jmp(42),
+InsnRecipe::Split(26, 28),
+InsnRecipe::Pike { pattern: " ?\\p{L}+", ordinal: 0, capture_groups: None },
+InsnRecipe::Jmp(42),
+InsnRecipe::Split(29, 31),
+InsnRecipe::Pike { pattern: " ?\\p{N}+", ordinal: 1, capture_groups: None },
+InsnRecipe::Jmp(42),
+InsnRecipe::Split(32, 34),
+InsnRecipe::Pike { pattern: " ?[^\\s\\p{L}\\p{N}]+", ordinal: 2, capture_groups: None },
+InsnRecipe::Jmp(42),
